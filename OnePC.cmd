# ---------- en direct ----------
function Fmt-Dur($ms) { $t = [TimeSpan]::FromMilliseconds([double]$ms); '{0}:{1:00}:{2:00}' -f [int][math]::Floor($t.TotalHours), $t.Minutes, $t.Seconds }
function New-LiveTile($v, $l, $col) {
    $b = New-Object System.Windows.Controls.Border; $b.Width = 150; $b.Margin = New-Object System.Windows.Thickness 0, 0, 10, 10; $b.Padding = New-Object System.Windows.Thickness 12, 10, 12, 10; $b.CornerRadius = New-Object System.Windows.CornerRadius 10; $b.Background = $brush.ConvertFromString('#1C1C22')
    $sp = New-Object System.Windows.Controls.StackPanel
    $a = New-Object System.Windows.Controls.TextBlock; $a.Text = $v; $a.FontSize = 20; $a.FontWeight = 'Bold'; $a.Foreground = $brush.ConvertFromString($col)
    $c = New-Object System.Windows.Controls.TextBlock; $c.Text = $l; $c.FontSize = 11; $c.Foreground = $brush.ConvertFromString('#9C9CA6')
    [void]$sp.Children.Add($a); [void]$sp.Children.Add($c); $b.Child = $sp; $b
}
$script:liveLast = $null
function Update-Live {
    if (-not ($script:obsWs -and $script:obsWs.IsOpen)) { return }
    $st = Obs-Req 'GetStreamStatus' $null; $rs = Obs-Req 'GetRecordStatus' $null; $gs = Obs-Req 'GetStats' $null
    if (-not $st) { return }
    (UI 'ObsLiveTag').Visibility = $(if ($st.outputActive) { 'Visible' } else { 'Collapsed' })
    (UI 'ObsRecTag').Visibility = $(if ($rs -and $rs.outputActive) { 'Visible' } else { 'Collapsed' })
    (UI 'LiveStream').Content = $(if ($st.outputActive) { 'Arrêter le live' } else { 'Démarrer le live' })
    (UI 'LiveRec').Content = $(if ($rs -and $rs.outputActive) { "Arrêter l'enregistrement" } else { "Démarrer l'enregistrement" })
    $h = UI 'LiveStats'; $h.Children.Clear()
    if ($st.outputActive) {
        $kb = 0; $now = Get-Date
        if ($script:liveLast -and $script:liveLast.B -le [double]$st.outputBytes) { $dt = ($now - $script:liveLast.T).TotalSeconds; if ($dt -gt 0) { $kb = [int](([double]$st.outputBytes - $script:liveLast.B) * 8 / 1000 / $dt) } }
        $script:liveLast = @{ T = $now; B = [double]$st.outputBytes }
        $drop = 0.0; if ([double]$st.outputTotalFrames -gt 0) { $drop = [math]::Round(100 * [double]$st.outputSkippedFrames / [double]$st.outputTotalFrames, 1) }
        [void]$h.Children.Add((New-LiveTile (Fmt-Dur $st.outputDuration) 'durée du live' '#EF4444'))
        [void]$h.Children.Add((New-LiveTile "$kb kbit/s" 'débit envoyé' '#38BDF8'))
        [void]$h.Children.Add((New-LiveTile "$drop %" 'images perdues (réseau)' $(if ($drop -ge 1) { '#F87171' } else { '#34D399' })))
        (UI 'LiveInfo').Text = $(if ($drop -ge 1) { "Ton live perd des images : ta connexion n'arrive pas à suivre. Baisse le débit ou passe en câble." } elseif ($st.outputReconnecting) { 'Reconnexion en cours...' } else { 'Ton live tourne bien.' })
    } else { $script:liveLast = $null; (UI 'LiveInfo').Text = 'Pas de live en cours. Les chiffres s''affichent ici dès que tu lances ton live.' }
    if ($gs) {
        [void]$h.Children.Add((New-LiveTile ("" + [math]::Round([double]$gs.activeFps) + ' i/s') 'FPS d''OBS' '#A78BFA'))
        [void]$h.Children.Add((New-LiveTile ("" + [math]::Round([double]$gs.cpuUsage, 1) + ' %') 'processeur utilisé par OBS' '#FBBF24'))
