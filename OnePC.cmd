<# : partie batch
@echo off
set "SELF=%~f0"
start "" powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "iex (Get-Content -Raw -Encoding UTF8 -LiteralPath $env:SELF)"
exit /b
: fin batch #>

Add-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase
$appVersion = '1.3.1'
$updBase = 'https://raw.githubusercontent.com/milassfn/OnePC/main/'
$updUrl = $updBase + 'OnePC.cmd'
# Clé publique de licence : posée ici par l'Atelier au moment de fabriquer OnePC.exe (vide = fichier de travail, sans licence)
$licPub = '<RSAKeyValue><Modulus></Modulus><Exponent>AQAB</Exponent></RSAKeyValue>'
# Chemin de OnePC.exe quand l'appli tourne depuis l'exécutable (vide quand elle tourne depuis le fichier .cmd)
$hostExe = ''; try { if ($OnePcHostExe) { $hostExe = [string]$OnePcHostExe } } catch {}
$logoB64 = ''

$createdNew = $false
$mutex = New-Object System.Threading.Mutex($true, 'Local\OnePC.App', [ref]$createdNew)
$showEvt = New-Object System.Threading.EventWaitHandle($false, [System.Threading.EventResetMode]::AutoReset, 'Local\OnePC.Show')
if (-not $createdNew) { [void]$showEvt.Set(); return }

$splash = $null
try {
    $splash = [Windows.Markup.XamlReader]::Parse(@'
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="380" Height="250" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Border Margin="20" CornerRadius="16" Background="#0E0E11" BorderBrush="#2E2E36" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.6" Color="#000000"/></Border.Effect>
    <StackPanel VerticalAlignment="Center">
      <Image x:Name="SLogo" Width="78" Height="78"/>
      <TextBlock Text="OnePC" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,2"/>
      <TextBlock Text="Démarrage..." Foreground="#8E8E98" FontSize="12" HorizontalAlignment="Center"/>
      <Border Width="180" Height="4" CornerRadius="2" Background="#222228" Margin="0,14,0,0">
        <Border Width="110" HorizontalAlignment="Left" CornerRadius="2">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#38BDF8" Offset="0"/><GradientStop Color="#A78BFA" Offset="0.5"/><GradientStop Color="#FF5A3C" Offset="1"/></LinearGradientBrush></Border.Background>
        </Border>
      </Border>
    </StackPanel>
  </Border>
</Window>
'@)
    try {
        $sbi = New-Object System.Windows.Media.Imaging.BitmapImage
        $sbi.BeginInit(); $sbi.StreamSource = New-Object System.IO.MemoryStream (, [Convert]::FromBase64String($logoB64)); $sbi.CacheOption = 'OnLoad'; $sbi.DecodePixelWidth = 156; $sbi.EndInit()
        $splash.FindName('SLogo').Source = $sbi
    } catch {}
    $splash.Show()
    $splash.Dispatcher.Invoke([Action] {}, [System.Windows.Threading.DispatcherPriority]::Render)
} catch {}

