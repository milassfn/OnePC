# ---------- Mise à jour de l'appli ----------
$updCode = {
    param($a)
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $wc = New-Object System.Net.WebClient
        $wc.Headers['User-Agent'] = 'OnePC'; $wc.Headers['Cache-Control'] = 'no-cache'
        $bytes = $wc.DownloadData($a.Url + '?t=' + [DateTime]::UtcNow.Ticks)
        if ($bytes.Length -lt 100000) { 'ERR'; 'fichier incomplet'; return }
        $text = [System.Text.Encoding]::UTF8.GetString($bytes)
        $vm = [regex]::Match($text, "(?m)^\`$appVersion = '([\d\.]+)'")
        if (-not $vm.Success) { 'ERR'; 'version illisible'; return }
        $v = $vm.Groups[1].Value
        if (-not ([version]$v -gt [version]$a.Cur)) { 'SAME'; $v; return }
        # le fichier doit être complet et sans erreur avant d'être proposé
        if (-not $text.StartsWith('<# : partie batch') -or $text.TrimEnd() -notmatch '# FIN-ONEPC$') { 'ERR'; 'fichier incomplet'; return }
        $errs = $null; [void][System.Management.Automation.Language.Parser]::ParseInput($text, [ref]$null, [ref]$errs)
        if ($errs -and $errs.Count) { 'ERR'; 'fichier invalide'; return }
        [System.IO.File]::WriteAllBytes($a.Tmp, $bytes)
        'NEW'; $v
    } catch { 'ERR'; $_.Exception.Message }
}
# mode exécutable : version.txt, puis OnePC.exe et sa signature (vérifiée avec la clé publique avant toute installation)
$updExeCode = {
    param($a)
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $wc = New-Object System.Net.WebClient
        $wc.Headers['User-Agent'] = 'OnePC'
        $tick = '?t=' + [DateTime]::UtcNow.Ticks
        $v = ([string]$wc.DownloadString($a.Base + 'version.txt' + $tick)).Trim()
        if ($v -notmatch '^\d+(\.\d+){1,3}$') { 'ERR'; 'version illisible'; return }
        if (-not ([version]$v -gt [version]$a.Cur)) { 'SAME'; $v; return }
        $bytes = $wc.DownloadData($a.Base + 'OnePC.exe' + $tick)
        $sig = [Convert]::FromBase64String(([string]$wc.DownloadString($a.Base + 'OnePC.exe.sig' + $tick)).Trim())
        $rsa = $null; try { $rsa = New-Object System.Security.Cryptography.RSACng } catch { $rsa = [System.Security.Cryptography.RSA]::Create() }
        $rsa.FromXmlString($a.Pub)
        if (-not $rsa.VerifyData($bytes, $sig, [System.Security.Cryptography.HashAlgorithmName]::SHA256, [System.Security.Cryptography.RSASignaturePadding]::Pkcs1)) { 'ERR'; "la signature du fichier n'est pas bonne"; return }
        [System.IO.File]::WriteAllBytes($a.Tmp, $bytes)
        'NEW'; $v
    } catch { 'ERR'; $_.Exception.Message }
}
$licCheckCode = {
    param($a)
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $wc = New-Object System.Net.WebClient; $wc.Headers['User-Agent'] = 'OnePC'
        $t = [string]$wc.DownloadString($a.Base + 'revoked.txt?t=' + [DateTime]::UtcNow.Ticks)
        $ids = @($t -split "`n" | ForEach-Object { $_.Trim() } | Where-Object { $_ -match '^[A-Za-z0-9]{4,40}$' })
        [System.IO.File]::WriteAllLines($a.File, [string[]]$ids)
        'OK'; ($ids -join ',')
    } catch { 'ERR' }
}
$updTmp = Join-Path $appDir 'maj.tmp'; $updNewExe = Join-Path $appDir 'OnePC.nouveau.exe'
function Install-Update($v) {
    if ($hostExe) {
        try {
            if (-not (Test-Path -LiteralPath $updNewExe)) { throw 'fichier de mise à jour absent' }
            $dest = Join-Path $appDir 'OnePC.exe'
            Log ("OnePC mis à jour : " + $appVersion + " -> " + $v)
            $mv = "Copy-Item -LiteralPath '" + $updNewExe.Replace("'", "''") + "' -Destination '" + $dest.Replace("'", "''") + "' -Force; Remove-Item -LiteralPath '" + $updNewExe.Replace("'", "''") + "' -Force;"
            if (-not (Restart-App $mv)) { Toast "La mise à jour est téléchargée : ferme puis rouvre OnePC." }
        } catch { Toast ("La mise à jour n'a pas pu être installée : " + $_.Exception.Message) }
        return
    }
    try {
        $dest = Join-Path $appDir 'OnePC.cmd'
        if (-not (Test-Path -LiteralPath $updTmp)) { throw 'fichier de mise à jour absent' }
        if (Test-Path -LiteralPath $dest) { Copy-Item -LiteralPath $dest -Destination ($dest + '.avant') -Force }
        Copy-Item -LiteralPath $updTmp -Destination $dest -Force
        Remove-Item -LiteralPath $updTmp -Force -ErrorAction SilentlyContinue
        Log ("OnePC mis à jour : " + $appVersion + " -> " + $v)
        if (-not (Restart-App)) { Toast "Mise à jour installée : ferme puis rouvre OnePC avec le raccourci du Bureau." }
    } catch { Toast ("La mise à jour n'a pas pu être installée : " + $_.Exception.Message) }
}
function Check-Update([bool]$manual) {
    if ($script:updBusy) { return }
    $script:updBusy = $true; $script:updManual = $manual
    if ($manual) { (UI 'SetMsg').Text = 'Recherche de mise à jour...' }
    $code = $updCode; $arg = @{ Url = $updUrl; Cur = $appVersion; Tmp = $updTmp }
    if ($hostExe) { $code = $updExeCode; $arg = @{ Base = $updBase; Cur = $appVersion; Tmp = $updNewExe; Pub = $licPub } }
    Start-Bg $code $arg {
        param($r)
        $script:updBusy = $false; $manual = $script:updManual
        $kind = ''; if ($r.Count) { $kind = [string]$r[0] }
        if ($kind -eq 'NEW') {
            $v = [string]$r[1]
            $cfg.UpdAsked = (Get-Date).ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture); Save-Cfg
            if (Ask ("Une nouvelle version de OnePC est disponible : " + $v + " (tu as la " + $appVersion + ").`r`n`r`nL'installer maintenant ? L'appli redémarre toute seule, tes réglages sont gardés.")) { Install-Update $v }
            else { (UI 'SetMsg').Text = "Version $v disponible. Tu peux l'installer plus tard avec « Vérifier les mises à jour » dans Réglages." }
        } elseif ($manual) {
            if ($kind -eq 'SAME') { (UI 'SetMsg').Text = "Tu as déjà la dernière version (" + $appVersion + ")." }
            else { $why = ''; if ($r.Count -ge 2) { $why = [string]$r[1] }; (UI 'SetMsg').Text = "Impossible de vérifier les mises à jour pour le moment ($why)." }
        }
    }
}
