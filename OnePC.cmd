# ---------- Analyse du système ----------
$sysScanCode = {
    param($tmp)
    function NewRow($n, $d, $l) { [pscustomobject]@{ Name = $n; Detail = $d; Level = $l } }
    try {
        Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3" | Where-Object { $_.Size } | ForEach-Object {
            $p = [int](100 * $_.FreeSpace / $_.Size); $l = 0; if ($p -lt 20) { $l = 1 }; if ($p -lt 10) { $l = 2 }
            NewRow ("Espace libre sur " + $_.DeviceID) ("$p % libre, soit " + [math]::Round($_.FreeSpace / 1GB) + " Go") $l
        }
    } catch {}
    try {
        Get-PhysicalDisk -ErrorAction Stop | ForEach-Object {
            if ($_.HealthStatus -eq 'Healthy') { NewRow ("Santé de " + $_.FriendlyName) 'Aucun défaut signalé par le disque' 0 }
            else { NewRow ("Santé de " + $_.FriendlyName) ("Le disque signale un état : " + $_.HealthStatus + ". Sauvegarde tes fichiers.") 2 }
        }
    } catch {}
    try {
        $o = Get-CimInstance Win32_OperatingSystem
        $p = [int](100 * ($o.TotalVisibleMemorySize - $o.FreePhysicalMemory) / $o.TotalVisibleMemorySize)
        $l = 0; if ($p -ge 85) { $l = 1 }
        NewRow 'Mémoire' ("$p % utilisée en ce moment") $l
        $days = [int]((Get-Date) - $o.LastBootUpTime).TotalDays
        $l = 0; if ($days -ge 7) { $l = 1 }
        NewRow 'Dernier redémarrage' ("Il y a $days jour(s)" + $(if ($l) { ' : un redémarrage ferait du bien' } else { '' })) $l
    } catch {}
    try {
        Get-CimInstance Win32_VideoController | Where-Object { $_.Name -notmatch 'Microsoft|Virtual|Remote' -and $_.DriverDate } | ForEach-Object {
            $mo = [int](((Get-Date) - $_.DriverDate).TotalDays / 30); $l = 0; if ($mo -ge 6) { $l = 1 }
            NewRow 'Pilote graphique' ($_.Name + " : pilote de " + $_.DriverDate.ToString('MM/yyyy') + " ($mo mois)") $l
        }
    } catch {}
    try {
        $d = Get-MpComputerStatus -ErrorAction Stop
        if (-not $d.RealTimeProtectionEnabled) { NewRow 'Antivirus' 'Protection en temps réel de Defender désactivée (normal si tu as un autre antivirus)' 1 }
        elseif ($d.AntivirusSignatureAge -gt 3) { NewRow 'Antivirus' ("Defender actif, mais définitions vieilles de " + $d.AntivirusSignatureAge + " jours") 1 }
        else { NewRow 'Antivirus' 'Windows Defender actif et à jour' 0 }
    } catch { NewRow 'Antivirus' "État de Windows Defender illisible" 1 }
    $pending = (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired') -or (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending')
    if ($pending) { NewRow 'Mises à jour Windows' 'Un redémarrage est en attente pour finir une mise à jour' 1 } else { NewRow 'Mises à jour Windows' 'Aucun redémarrage en attente' 0 }
    try {
        $n = 0
        foreach ($k in 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run', 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run') {
            $i = Get-Item -LiteralPath $k -ErrorAction SilentlyContinue; if ($i) { $n += $i.ValueCount }
        }
        $l = 0; if ($n -gt 8) { $l = 1 }
        NewRow 'Programmes au démarrage' ("$n programme(s) enregistré(s)" + $(if ($l) { ' : va voir la page Démarrage' } else { '' })) $l
    } catch {}
    try {
        $sz = 0; $limit = (Get-Date).AddDays(-1)
        Get-ChildItem -LiteralPath $tmp -Recurse -Force -File -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -lt $limit } | ForEach-Object { $sz += $_.Length }
        $l = 0; if ($sz -gt 1GB) { $l = 1 }
        NewRow 'Fichiers temporaires' ("" + [math]::Round($sz / 1MB) + " Mo" + $(if ($l) { ' : un nettoyage est conseillé' } else { '' })) $l
    } catch {}
}
