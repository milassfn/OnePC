# ---------- Rafraîchissement de l'affichage ----------
$timer = New-Object System.Windows.Threading.DispatcherTimer
$timer.Interval = [TimeSpan]::FromSeconds(1)
$timer.Add_Tick({
    try {
        $hCpu.Add($sync.Cpu); if ($hCpu.Count -gt 3600) { $hCpu.RemoveAt(0) }
        $hGpu.Add($sync.Gpu); if ($hGpu.Count -gt 3600) { $hGpu.RemoveAt(0) }
        $hRam.Add($sync.Ram); if ($hRam.Count -gt 3600) { $hRam.RemoveAt(0) }
        (UI 'ValCpu').Text = [string]$sync.Cpu; Set-Gauge (UI 'ArcCpu') $sync.Cpu; Set-Line (UI 'LineCpu') $hCpu; Set-GaugeState 'StateCpu' $sync.Cpu $false
        if ($sync.GpuOk) { (UI 'ValGpu').Text = [string]$sync.Gpu } else { (UI 'ValGpu').Text = '-' }
        Set-Gauge (UI 'ArcGpu') $sync.Gpu; Set-Line (UI 'LineGpu') $hGpu; if ($sync.GpuOk) { Set-GaugeState 'StateGpu' $sync.Gpu $false } else { (UI 'StateGpu').Text = ' ' }
        (UI 'ValRam').Text = [string]$sync.Ram; Set-Gauge (UI 'ArcRam') $sync.Ram; Set-Line (UI 'LineRam') $hRam; Set-GaugeState 'StateRam' $sync.Ram $true
        (UI 'SubRam').Text = "" + $sync.RamUsed + " / $ramGo Go utilisés"
        (UI 'DiskC').Text = $sync.DiskC
        (UI 'ChipCpu').Text = "" + $sync.Cpu + " %"; (UI 'ChipRam').Text = "" + $sync.Ram + " %"
        if ($sync.GpuOk) { (UI 'ChipGpu').Text = "" + $sync.Gpu + " %" } else { (UI 'ChipGpu').Text = '-' }
        $sub = "" + $cpu.NumberOfCores + " coeurs / " + $cpu.NumberOfLogicalProcessors + " threads"
        if ($sync.Ghz -gt 0) { $sub += "  ·  " + $sync.Ghz + " GHz" }
        (UI 'SubCpu').Text = $sub
        if ($sync.CpuT -gt 0) { (UI 'TempCpu').Text = "" + $sync.CpuT + " °C (capteur carte mère)" } else { (UI 'TempCpu').Text = 'Température non fournie par Windows' }
        if ($vramGo -gt 0) { (UI 'SubGpu').Text = "Mémoire vidéo : " + $sync.Vram + " / $vramGo Go" }
        if ($sync.GpuT -gt 0) { (UI 'TempGpu').Text = "" + $sync.GpuT + " °C" } else { (UI 'TempGpu').Text = 'Température non fournie par Windows' }
        (UI 'ExtraRam').Text = "" + $sync.ProcCount + " processus en cours"
        (UI 'ProcBig').Text = [string]$sync.ProcCount
        $up = (Get-Date) - $os.LastBootUpTime
        (UI 'InfoUp').Text = "" + [int][math]::Floor($up.TotalHours) + " h " + $up.Minutes.ToString('00') + " min"
        if ((UI 'PageProc').Visibility -eq 'Visible' -and -not (UI 'ProcList').IsMouseOver) { (UI 'ProcList').ItemsSource = $sync.Procs }
        if ($sync.Ping -ge 0) { (UI 'PingVal').Text = "" + $sync.Ping + " ms" } else { (UI 'PingVal').Text = 'Hors ligne' }
        (UI 'DownVal').Text = (N $sync.Down); (UI 'UpVal').Text = (N $sync.Up)
        (UI 'NetInfo').Text = $sync.NetInfo
        $script:ticks++
        if ($showEvt.WaitOne(0)) { Show-Win }
        if ($script:ticks % 3 -eq 0 -and (UI 'PageDc').Visibility -eq 'Visible') { Show-Dc }
        if ($script:ticks % 3 -eq 0 -and (UI 'PageObs').Visibility -eq 'Visible') { Update-ObsState }
        if ($script:watch -and $script:ticks % 5 -eq 0) { Check-GameWatch }
        if ($script:play -and $script:ticks % 5 -eq 0) { Check-Play }
        if ($cfg.Alerts -and $script:ticks -gt 20 -and $script:ticks % 30 -eq 0) { Check-Alerts }
    } catch {}

    foreach ($j in @($script:jobs)) {
        if (-not $script:jobs.Contains($j)) { continue }
        if ($j.H.IsCompleted) {
            $r = @(); try { $r = @($j.P.EndInvoke($j.H)) } catch {}
            $j.P.Dispose(); $script:jobs.Remove($j)
            try { & $j.Done $r } catch {}
        }
    }

    if ($script:job -and $script:jobHandle.IsCompleted) {
        $res = @()
        try { $res = @($script:job.EndInvoke($script:jobHandle)) } catch { $res = @("ERREUR: " + $_.Exception.Message) }
        $script:job.Dispose(); $script:job = $null
        (UI 'BtnSearch').IsEnabled = $true
        if ($res.Count -eq 0) {
            $log.Text = "Aucune mise à jour de pilote proposée par Windows Update : tout est à jour de ce côté.`r`nPense à vérifier le site du fabricant pour la carte graphique."
        } elseif ([string]$res[0] -like 'ERREUR:*') {
            $log.Text = [string]$res[0]
        } else {
            $log.Text = "" + $res.Count + " pilote(s) disponible(s) :`r`n`r`n - " + ($res -join "`r`n - ")
            (UI 'BtnInstall').IsEnabled = $true
            (UI 'DrvDot').Visibility = 'Visible'
            Notify 'Pilotes' ("" + $res.Count + " mise(s) à jour de pilote disponible(s). Ouvre l'onglet Pilotes.")
        }
        if ($res.Count -eq 0) { (UI 'DrvDot').Visibility = 'Collapsed' }
    }
})

