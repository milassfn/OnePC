$tidyLog = Join-Path $appDir 'rangement.txt'
$script:tidyDir = ''; $script:tidyPlan = @()
function Get-TidyPlan($dir) {
    $plan = @()
    foreach ($f in @(Get-ChildItem -LiteralPath $dir -File -ErrorAction SilentlyContinue)) {
        $ext = $f.Extension.TrimStart('.').ToLower()
        if (-not $ext) { continue }
        foreach ($c in $tidyCats.Keys) { if ($tidyCats[$c] -contains $ext) { $plan += [pscustomobject]@{ File = $f; Cat = $c }; break } }
    }
    $plan
}
function Show-Tidy($dir) {
    if (-not $dir -or -not (Test-Path -LiteralPath $dir)) { (UI 'TidyMsg').Text = 'Dossier introuvable.'; return }
    $script:tidyDir = $dir; $script:tidyPlan = @(Get-TidyPlan $dir)
    (UI 'TidyPath').Text = $dir; (UI 'TidyMsg').Text = ' '; (UI 'TidyOpen').IsEnabled = $true
    $rows = @($script:tidyPlan | Group-Object Cat | ForEach-Object {
        $sz = 0; foreach ($p in $_.Group) { $sz += $p.File.Length }
        [pscustomobject]@{ Name = $_.Name; Count = "" + $_.Count + " fichier(s)"; Size = (Mo $sz); Sample = (($_.Group | Select-Object -First 4 | ForEach-Object { $_.File.Name }) -join ',  ') }
    })
    (UI 'TidyList').ItemsSource = $rows
    $all = @(Get-ChildItem -LiteralPath $dir -File -ErrorAction SilentlyContinue).Count
    if ($script:tidyPlan.Count -eq 0) { (UI 'TidyInfo').Text = "Rien à ranger ici : aucun fichier en vrac d'un type connu."; (UI 'TidyGo').IsEnabled = $false }
    else {
        (UI 'TidyInfo').Text = "" + $script:tidyPlan.Count + " fichier(s) sur $all seront déplacés dans des sous-dossiers de ce dossier. Les raccourcis, les sous-dossiers existants, les fichiers cachés et les types inconnus ne bougent pas."
        (UI 'TidyGo').IsEnabled = $true
    }
}
(UI 'TidyDl').Add_Click({ $p = ''; try { $p = (New-Object -ComObject Shell.Application).NameSpace('shell:Downloads').Self.Path } catch {}; if (-not $p) { $p = Join-Path $env:USERPROFILE 'Downloads' }; Show-Tidy $p })
(UI 'TidyDesk').Add_Click({ Show-Tidy ([Environment]::GetFolderPath('Desktop')) })
(UI 'TidyDocs').Add_Click({ Show-Tidy ([Environment]::GetFolderPath('MyDocuments')) })
(UI 'TidyOther').Add_Click({
    Add-Type -AssemblyName System.Windows.Forms
    $dlg = New-Object System.Windows.Forms.FolderBrowserDialog
    $dlg.Description = 'Choisis le dossier à ranger'
    if ($dlg.ShowDialog() -eq 'OK') {
        $p = $dlg.SelectedPath
        if (-not (Test-SafeFolder $p) -or (Test-Under $p $env:APPDATA) -or (Test-Under $p $env:LOCALAPPDATA)) { (UI 'TidyMsg').Text = "Ce dossier appartient à Windows ou à des programmes : je ne le range pas."; return }
        Show-Tidy $p
    }
})
(UI 'TidyOpen').Add_Click({ if ($script:tidyDir) { Start-Process explorer.exe -ArgumentList ('"' + $script:tidyDir + '"') } })
(UI 'TidyGo').Add_Click({
    if (-not $script:tidyDir -or $script:tidyPlan.Count -eq 0) { return }
    if (-not (Ask ("Ranger " + $script:tidyPlan.Count + " fichier(s) de ce dossier ?`r`n`r`n" + $script:tidyDir + "`r`n`r`nIls seront déplacés dans des sous-dossiers (Images, Vidéos, Documents...). Rien n'est supprimé."))) { return }
    $log = @(); $fail = 0
    foreach ($p in $script:tidyPlan) {
        try {
            $destDir = Join-Path $script:tidyDir $p.Cat
            if (-not (Test-Path -LiteralPath $destDir)) { New-Item -ItemType Directory -Path $destDir | Out-Null }
            $dest = Join-Path $destDir $p.File.Name; $i = 2
            while (Test-Path -LiteralPath $dest) { $dest = Join-Path $destDir ($p.File.BaseName + " ($i)" + $p.File.Extension); $i++ }
            Move-Item -LiteralPath $p.File.FullName -Destination $dest -ErrorAction Stop
            $log += $p.File.FullName + '|' + $dest
        } catch { $fail++ }
    }
    if ($log.Count) { try { Set-Content -LiteralPath $tidyLog -Value $log -Encoding UTF8 } catch {} }
    $done = $log.Count
    Show-Tidy $script:tidyDir
    Log ("Rangement : $done fichier(s) déplacés dans des sous-dossiers de " + $script:tidyDir); $t = "$done fichier(s) rangés."; if ($fail) { $t += " $fail n'ont pas pu être déplacés (ouverts dans un programme ?)." }
    (UI 'TidyMsg').Text = $t
})
(UI 'TidyUndo').Add_Click({
    if (-not (Test-Path -LiteralPath $tidyLog)) { (UI 'TidyMsg').Text = 'Aucun rangement à annuler.'; return }
    $lines = @(Get-Content -LiteralPath $tidyLog -Encoding UTF8 | Where-Object { $_ })
    if (-not (Ask ("Remettre " + $lines.Count + " fichier(s) à leur place d'origine ?"))) { return }
    $back = 0; $dirs = @{}
    foreach ($l in $lines) {
        $p = $l -split '\|'
        if ($p.Count -ne 2) { continue }
        try {
            if ((Test-Path -LiteralPath $p[1]) -and -not (Test-Path -LiteralPath $p[0])) {
                Move-Item -LiteralPath $p[1] -Destination $p[0] -ErrorAction Stop; $back++
                $dirs[(Split-Path -Parent $p[1])] = 1
            }
        } catch {}
    }
    foreach ($d in $dirs.Keys) { try { if (-not (Get-ChildItem -LiteralPath $d -Force | Select-Object -First 1)) { Remove-Item -LiteralPath $d -Force } } catch {} }
    Remove-Item -LiteralPath $tidyLog -Force -ErrorAction SilentlyContinue
    if ($script:tidyDir) { Show-Tidy $script:tidyDir }
    Log "Rangement annulé : $back fichier(s) remis à leur place"; (UI 'TidyMsg').Text = "$back fichier(s) remis à leur place sur " + $lines.Count + "."
})

