# ---------- Restes d'applications ----------
$leftCode = {
    param($known)
    $skip = '^(Microsoft.*|Windows.*|Common Files|Internet Explorer|Packages|Temp|Programs|Package Cache|USOShared|USOPrivate|ssh|regid.*|Reference Assemblies|MSBuild|dotnet|ModifiableWindowsApps|Intel.*|AMD.*|ATI.*|NVIDIA.*|Realtek.*|D3DSCache|CrashDumps|ConnectedDevicesPlatform|PlaceholderTileLogoFolder|Publishers|VirtualStore|Comms|PeerDistRepub|SoftwareDistribution|Desktop|Documents|Application Data|Start Menu|Templates|OnePC|Epic.*|Steam.*|Google|Mozilla|Adobe|Apple.*|Oracle|Java|Python.*|nodejs|npm.*|pip|Git.*|\..*|.*\.tmp)$'
    $limit = (Get-Date).AddDays(-60)
    $running = @(Get-Process | ForEach-Object { try { $_.Path } catch {} } | Where-Object { $_ })
    $out = @()
    foreach ($root in $env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:ProgramData, $env:APPDATA, $env:LOCALAPPDATA) {
        if (-not $root) { continue }
        foreach ($d in @(Get-ChildItem -LiteralPath $root -Directory -ErrorAction SilentlyContinue)) {
            if ($d.Name -match $skip -or $d.LastWriteTime -gt $limit) { continue }
            $n = $d.Name.ToLower(); $used = $false
            foreach ($k in $known) { if ($k.Contains($n) -or ($k.Length -ge 4 -and $n.Contains($k))) { $used = $true; break } }
            if ($used) { continue }
            if ($running | Where-Object { $_ -like ($d.FullName + '\*') }) { continue }
            $sz = 0; $recent = $false
            foreach ($f in @(Get-ChildItem -LiteralPath $d.FullName -Recurse -Force -File -ErrorAction SilentlyContinue)) { $sz += $f.Length; if ($f.LastWriteTime -gt $limit) { $recent = $true; break } }
            if ($recent -or $sz -lt 1MB) { continue }
            $out += [pscustomobject]@{ S = $sz; Name = $d.Name; Path = $d.FullName; Date = $d.LastWriteTime.ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture) }
        }
    }
    $out | Sort-Object S -Descending | Select-Object -First 40
}
(UI 'LeftScan').Add_Click({
    if (-not $script:apps) { Load-AppList }
    $known = New-Object 'System.Collections.Generic.List[string]'
    foreach ($a in $script:apps) {
        foreach ($t in $a.Name, $a.Publisher) { if ($t) { $known.Add($t.ToLower()); $w = ($t -split '[\s,\.]')[0].ToLower(); if ($w.Length -ge 4) { $known.Add($w) } } }
    }
    (UI 'LeftScan').IsEnabled = $false; (UI 'LeftMsg').Text = 'Recherche en cours, cela peut prendre une minute...'; (UI 'LeftList').ItemsSource = $null
    Start-Bg $leftCode $known.ToArray() {
        param($r)
        (UI 'LeftScan').IsEnabled = $true
        $rows = @($r | Where-Object { $_.Path } | ForEach-Object { [pscustomobject]@{ A = (Mo $_.S); B = $_.Name; C = ($_.Path + "   ·   inchangé depuis le " + $_.Date); Path = $_.Path } })
        (UI 'LeftList').ItemsSource = $rows
        if ($rows.Count) { (UI 'LeftMsg').Text = "" + $rows.Count + " dossier(s) qui ressemblent à des restes. « Ouvrir » te montre le contenu : à toi de décider." }
        else { (UI 'LeftMsg').Text = "Aucun reste évident trouvé." }
    }
})
