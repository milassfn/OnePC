# ---------- Dossiers vides ----------
$emptyCode = {
    param($roots)
    $all = New-Object 'System.Collections.Generic.List[string]'
    $stack = New-Object 'System.Collections.Generic.Stack[string]'
    foreach ($r in $roots) { if ($r -and (Test-Path -LiteralPath $r)) { $stack.Push($r) } }
    $rootSet = @{}; foreach ($r in $roots) { if ($r) { $rootSet[$r.TrimEnd('\').ToLower()] = 1 } }
    while ($stack.Count -gt 0) {
        $p = $stack.Pop()
        try {
            foreach ($d in (New-Object System.IO.DirectoryInfo $p).GetDirectories()) {
                if ($d.Attributes -band ([System.IO.FileAttributes]::ReparsePoint -bor [System.IO.FileAttributes]::Hidden -bor [System.IO.FileAttributes]::System)) { continue }
                $all.Add($d.FullName); $stack.Push($d.FullName)
            }
        } catch {}
    }
    $empty = @{}
    foreach ($d in ($all | Sort-Object { $_.Length } -Descending)) {
        try {
            if ([System.IO.Directory]::GetFiles($d).Length -gt 0) { continue }
            $full = $true
            foreach ($sub in [System.IO.Directory]::GetDirectories($d)) { if (-not $empty.ContainsKey($sub)) { $full = $false; break } }
            if ($full -and -not $rootSet.ContainsKey($d.TrimEnd('\').ToLower())) { $empty[$d] = 1 }
        } catch {}
    }
    $empty.Keys | Sort-Object
}
$script:emptyDirs = @()
function Start-Empty($roots) {
    (UI 'EmptyScan').IsEnabled = $false; (UI 'EmptyOther').IsEnabled = $false; (UI 'EmptyDel').IsEnabled = $false
    (UI 'EmptyMsg').Text = 'Recherche en cours...'; (UI 'EmptyList').ItemsSource = $null
    Start-Bg $emptyCode $roots {
        param($r)
        (UI 'EmptyScan').IsEnabled = $true; (UI 'EmptyOther').IsEnabled = $true
        $script:emptyDirs = @($r | ForEach-Object { [string]$_ })
        if ($script:emptyDirs.Count -eq 0) { (UI 'EmptyMsg').Text = "Aucun dossier vide trouvé."; return }
        (UI 'EmptyMsg').Text = "" + $script:emptyDirs.Count + " dossier(s) vide(s) trouvé(s). Les 40 premiers :"
        (UI 'EmptyList').ItemsSource = @($script:emptyDirs | Select-Object -First 40 | ForEach-Object { Row (Split-Path -Leaf $_) (Split-Path -Parent $_) '' })
        (UI 'EmptyDel').IsEnabled = $true
    }
}
