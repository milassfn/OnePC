    Add-Type -Namespace PCM -Name Shell -MemberDefinition '[DllImport("shell32.dll", CharSet = CharSet.Unicode)] public static extern int SetCurrentProcessExplicitAppUserModelID(string id);'
    [void][PCM.Shell]::SetCurrentProcessExplicitAppUserModelID('OnePC.App')
} catch {}
function Get-LaunchCmd { if ($appExe -and (Test-Path -LiteralPath $appExe)) { '"' + $appExe + '"' } else { 'wscript.exe "' + $vbs + '"' } }
function Start-Self { if ($appExe -and (Test-Path -LiteralPath $appExe)) { Start-Process -FilePath $appExe } else { Start-Process wscript.exe -ArgumentList ('"' + $vbs + '"') } }
