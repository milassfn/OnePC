$tidyCats = [ordered]@{
    'Images'        = 'jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'heic', 'svg', 'tif', 'tiff'
    'Vidéos'        = 'mp4', 'mkv', 'mov', 'avi', 'webm', 'wmv', 'flv', 'm4v'
