function Set-Wall($path) {
    if (-not ('PCM.Wall' -as [type])) {
        Add-Type -Namespace PCM -Name Wall -MemberDefinition '[DllImport("user32.dll", CharSet = CharSet.Unicode, SetLastError = true)] public static extern bool SystemParametersInfo(int uAction, int uParam, string lpvParam, int fuWinIni);'
    }
    Set-ItemProperty -LiteralPath 'HKCU:\Control Panel\Desktop' -Name WallpaperStyle -Value '10'
    Set-ItemProperty -LiteralPath 'HKCU:\Control Panel\Desktop' -Name TileWallpaper -Value '0'
    [PCM.Wall]::SystemParametersInfo(20, 0, $path, 3)
}
function WCol($hex, $a) { $c = [System.Drawing.ColorTranslator]::FromHtml($hex); [System.Drawing.Color]::FromArgb([int]$a, $c.R, $c.G, $c.B) }
function WPt($x, $y) { New-Object System.Drawing.PointF([single]$x, [single]$y) }
function WGrad($g, $w, $h, $c1, $c2, $vertical) {
    if ($c1 -eq $c2) { $g.Clear((WCol $c1 255)); return }
    $end = if ($vertical) { WPt 0 $h } else { WPt $w $h }
    $br = New-Object System.Drawing.Drawing2D.LinearGradientBrush((WPt 0 0), $end, (WCol $c1 255), (WCol $c2 255))
    $g.FillRectangle($br, 0, 0, [int]$w, [int]$h); $br.Dispose()
}
function WGlow($g, $cx, $cy, $r, $hex, $a) {
    $path = New-Object System.Drawing.Drawing2D.GraphicsPath
    $path.AddEllipse([single]($cx - $r), [single]($cy - $r), [single](2 * $r), [single](2 * $r))
    $pb = New-Object System.Drawing.Drawing2D.PathGradientBrush -ArgumentList $path
    $pb.CenterColor = WCol $hex $a
    $pb.SurroundColors = [System.Drawing.Color[]]@((WCol $hex 0))
    $g.FillPath($pb, $path); $pb.Dispose(); $path.Dispose()
}
function WPoly($g, $pts, $hex, $a) {
    $b = New-Object System.Drawing.SolidBrush (WCol $hex $a)
    $g.FillPolygon($b, [System.Drawing.PointF[]]$pts.ToArray()); $b.Dispose()
}
function Draw-Wall($g, $w, $h, $d) {
    $g.SmoothingMode = 'AntiAlias'
    $c = $d.C; $u = $h / 1080.0
    switch ($d.T) {
        'grad' { WGrad $g $w $h $c[0] $c[1] $false }
        'glow' {
            WGrad $g $w $h $c[0] $c[1] $true
            WGlow $g ($w * 0.70) ($h * 0.40) ($h * 0.85) $c[2] 150
        }
        'aurora' {
            $g.Clear((WCol $c[0] 255))
            WGlow $g ($w * 0.18) ($h * 0.30) ($h * 0.75) $c[1] 120
            WGlow $g ($w * 0.78) ($h * 0.22) ($h * 0.70) $c[2] 115
            WGlow $g ($w * 0.55) ($h * 1.00) ($h * 0.65) $c[3] 100
        }
        'waves' {
            WGrad $g $w $h $c[0] $c[1] $true
            for ($i = 0; $i -lt 4; $i++) {
                $pts = New-Object 'System.Collections.Generic.List[System.Drawing.PointF]'
                for ($k = 0; $k -le 80; $k++) {
                    $x = $w * $k / 80
                    $y = $h * (0.52 + 0.11 * $i) + [math]::Sin($k / 80 * 2 * [math]::PI * (1 + 0.35 * $i) + $i * 1.4) * $h * 0.045
                    $pts.Add((WPt $x $y))
                }
                $pts.Add((WPt $w $h)); $pts.Add((WPt 0 $h))
                WPoly $g $pts $c[2] (38 + 34 * $i)
            }
        }
        'peaks' {
            WGrad $g $w $h $c[0] $c[1] $true
            WGlow $g ($w * 0.68) ($h * 0.44) ($h * 0.42) $c[3] 170
            $sb = New-Object System.Drawing.SolidBrush (WCol $c[3] 255); $sr = $h * 0.055
            $g.FillEllipse($sb, [single]($w * 0.68 - $sr), [single]($h * 0.44 - $sr), [single](2 * $sr), [single](2 * $sr)); $sb.Dispose()
            $alphas = 120, 190, 255
            for ($i = 0; $i -lt 3; $i++) {
                $rnd = New-Object System.Random (21 + $i)
                $pts = New-Object 'System.Collections.Generic.List[System.Drawing.PointF]'
                $n = 10 + 3 * $i
                for ($k = 0; $k -le $n; $k++) { $pts.Add((WPt ($w * $k / $n) ($h * (0.62 + 0.12 * $i) - $h * (0.24 - 0.06 * $i) * $rnd.NextDouble()))) }
                $pts.Add((WPt $w $h)); $pts.Add((WPt 0 $h))
                WPoly $g $pts $c[2] $alphas[$i]
            }
        }
        'horizon' {
            WGrad $g $w $h $c[0] $c[1] $true
            $hy = $h * 0.64
            WGlow $g ($w * 0.5) $hy ($h * 0.60) $c[2] 120
            $sr = $h * 0.20
            $sun = New-Object System.Drawing.Drawing2D.LinearGradientBrush((WPt 0 ($hy - $sr)), (WPt 0 ($hy + $sr)), (WCol $c[3] 255), (WCol $c[2] 255))
            $g.FillEllipse($sun, [single]($w * 0.5 - $sr), [single]($hy - $sr), [single](2 * $sr), [single](2 * $sr)); $sun.Dispose()
            $gb = New-Object System.Drawing.SolidBrush (WCol $c[0] 255)
            $g.FillRectangle($gb, 0, [int]$hy, [int]$w, [int]($h - $hy + 1)); $gb.Dispose()
            for ($k = 0; $k -le 7; $k++) {
                $y = $hy + ($h - $hy) * [math]::Pow($k / 7.0, 2)
                $al = 200; if ($k -gt 0) { $al = 55 }
                $pen = New-Object System.Drawing.Pen((WCol $c[2] $al), [single][math]::Max(1, 2 * $u))
                $g.DrawLine($pen, [single]0, [single]$y, [single]$w, [single]$y); $pen.Dispose()
            }
        }
        'stars' {
            WGrad $g $w $h $c[0] $c[1] $true
            WGlow $g ($w * 0.80) ($h * 0.18) ($h * 0.60) $c[2] 70
            $rnd = New-Object System.Random 11
            for ($k = 0; $k -lt 240; $k++) {
                $x = $rnd.NextDouble() * $w; $y = $rnd.NextDouble() * $h; $r = [math]::Max(0.6, (0.6 + $rnd.NextDouble() * 1.7) * $u)
                $b = New-Object System.Drawing.SolidBrush (WCol '#FFFFFF' (60 + $rnd.Next(170)))
                $g.FillEllipse($b, [single]($x - $r), [single]($y - $r), [single](2 * $r), [single](2 * $r)); $b.Dispose()
            }
        }
        'grid' {
            $g.Clear((WCol $c[0] 255))
            WGlow $g ($w * 0.5) ($h * 0.5) ($h * 0.85) $c[1] 85
            $pen = New-Object System.Drawing.Pen((WCol $c[1] 30), [single][math]::Max(1, $u))
            $step = $h / 16.0
            for ($x = $step; $x -lt $w; $x += $step) { $g.DrawLine($pen, [single]$x, [single]0, [single]$x, [single]$h) }
            for ($y = $step; $y -lt $h; $y += $step) { $g.DrawLine($pen, [single]0, [single]$y, [single]$w, [single]$y) }
            $pen.Dispose()
        }
        'rings' {
            WGrad $g $w $h $c[0] $c[1] $false
            for ($k = 1; $k -le 10; $k++) {
                $r = $k * $h * 0.13
                $pen = New-Object System.Drawing.Pen((WCol $c[2] (95 - 8 * $k)), [single][math]::Max(1, 3 * $u))
                $g.DrawEllipse($pen, [single]($w * 0.85 - $r), [single]($h * 0.92 - $r), [single](2 * $r), [single](2 * $r)); $pen.Dispose()
            }
        }
        'stripes' {
            $g.Clear((WCol $c[0] 255))
            $bw = $w / 6.0; $sk = $h * 0.6
            for ($i = 0; $i -le 8; $i++) {
                $x0 = $i * $bw
                $pts = New-Object 'System.Collections.Generic.List[System.Drawing.PointF]'
                $pts.Add((WPt $x0 0)); $pts.Add((WPt ($x0 + $bw * 0.5) 0)); $pts.Add((WPt ($x0 + $bw * 0.5 - $sk) $h)); $pts.Add((WPt ($x0 - $sk) $h))
                WPoly $g $pts $c[1] (8 + ($i % 3) * 9)
            }
        }
    }
}
function Apply-Wall($d) {
    try {
        if (-not (Test-Path -LiteralPath $wallPrev)) {
            $cur = [string](Get-ItemProperty -LiteralPath 'HKCU:\Control Panel\Desktop' -ErrorAction SilentlyContinue).WallPaper
            if (-not $cur -or -not (Test-Path -LiteralPath $cur)) {
                $keep = Join-Path $appDir 'fond-origine.jpg'
                try { Copy-Item -LiteralPath (Join-Path $env:APPDATA 'Microsoft\Windows\Themes\TranscodedWallpaper') -Destination $keep -Force -ErrorAction Stop; $cur = $keep } catch {}
            }
            Set-Content -LiteralPath $wallPrev -Value $cur -Encoding UTF8
        }
        $sw = 1920; $sh = 1080
        try { if ($mainGpu.CurrentHorizontalResolution -gt 0) { $sw = [int]$mainGpu.CurrentHorizontalResolution; $sh = [int]$mainGpu.CurrentVerticalResolution } } catch {}
        $bmp = New-Object System.Drawing.Bitmap $sw, $sh
        $g = [System.Drawing.Graphics]::FromImage($bmp)
        Draw-Wall $g $sw $sh $d
        $g.Dispose()
        $file = Join-Path $appDir 'fond.png'
        $bmp.Save($file, [System.Drawing.Imaging.ImageFormat]::Png); $bmp.Dispose()
        if (Set-Wall $file) { Log ("Fond d'écran : " + $d.N); (UI 'WallMsg').Text = "Fond « " + $d.N + " » appliqué (" + $sw + " x " + $sh + ")." }
        else { (UI 'WallMsg').Text = "Windows a refusé de changer le fond d'écran." }
    } catch { (UI 'WallMsg').Text = "Impossible d'appliquer ce fond : " + $_.Exception.Message }
}
$script:wallsLoaded = $false
function Load-Walls {
    if ($script:wallsLoaded) { return }
    $script:wallsLoaded = $true
    Add-Type -AssemblyName System.Drawing
    foreach ($d in $walls) {
        $prev = New-Object System.Windows.Controls.Border
        $prev.Width = 176; $prev.Height = 99; $prev.CornerRadius = New-Object System.Windows.CornerRadius 8
        $prev.BorderBrush = $brush.ConvertFromString('#34343C'); $prev.BorderThickness = New-Object System.Windows.Thickness 1
        try {
            $bmp = New-Object System.Drawing.Bitmap 352, 198
            $g = [System.Drawing.Graphics]::FromImage($bmp); Draw-Wall $g 352 198 $d; $g.Dispose()
            $ms = New-Object System.IO.MemoryStream
            $bmp.Save($ms, [System.Drawing.Imaging.ImageFormat]::Png); $bmp.Dispose(); $ms.Position = 0
            $bi = New-Object System.Windows.Media.Imaging.BitmapImage
            $bi.BeginInit(); $bi.StreamSource = $ms; $bi.CacheOption = 'OnLoad'; $bi.EndInit(); $bi.Freeze()
            $prev.Background = New-Object System.Windows.Media.ImageBrush $bi
        } catch { $prev.Background = $brush.ConvertFromString($d.C[0]) }
        $lab = New-Object System.Windows.Controls.TextBlock; $lab.Text = $d.N; $lab.HorizontalAlignment = 'Center'
        $lab.Margin = New-Object System.Windows.Thickness 0, 8, 0, 0
        $sp = New-Object System.Windows.Controls.StackPanel
        [void]$sp.Children.Add($prev); [void]$sp.Children.Add($lab)
        $bt = New-Object System.Windows.Controls.Button
        $bt.Style = $win.FindResource('Ghost'); $bt.Content = $sp; $bt.Tag = $d
        $bt.Margin = New-Object System.Windows.Thickness 0, 0, 12, 12
        $bt.Add_Click({ param($sender, $e) Apply-Wall $sender.Tag })
        if ($d.T -eq 'grad') { [void](UI 'WallHost').Children.Add($bt) } else { [void](UI 'WallHostA').Children.Add($bt) }
    }
}
