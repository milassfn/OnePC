function Test-Under($p, $root) {
    # vrai si $p est $root ou un de ses sous-dossiers (comparaison de texte simple : les crochets dans les noms ne posent pas de problème)
    if (-not $p -or -not $root) { return $false }
    $a = ([string]$p).TrimEnd('\') + '\'; $b = ([string]$root).TrimEnd('\') + '\'
    return $a.StartsWith($b, [StringComparison]::OrdinalIgnoreCase)
}
function Test-SafeFolder($p) {
    if (-not $p -or $p.TrimEnd('\').Length -le 2) { return $false }
    foreach ($bad in $env:windir, $env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:ProgramData) { if (Test-Under $p $bad) { return $false } }
    return $true
}

# ---------- Sortie audio (menu près de l'horloge) ----------
function Ensure-Audio {
    if ('PcmAudio.Dev' -as [type]) { return }
    Add-Type -TypeDefinition @'
using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;
namespace PcmAudio {
    [ComImport, Guid("BCDE0395-E52F-467C-8E3D-C4579291692E")] class EnumeratorCom { }
    [ComImport, Guid("870af99c-171d-4f9e-af0d-e63df40c2bc9")] class PolicyCom { }
    [StructLayout(LayoutKind.Sequential)] struct PKey { public Guid fmtid; public int pid; }
    [StructLayout(LayoutKind.Explicit)] struct PVar { [FieldOffset(0)] public short vt; [FieldOffset(8)] public IntPtr p; [FieldOffset(16)] public IntPtr p2; }
    [ComImport, Guid("886d8eeb-8cf2-4446-8d02-cdba1dbdcf99"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
    interface IPropertyStore {
        [PreserveSig] int GetCount(out int c);
        [PreserveSig] int GetAt(int i, out PKey k);
        [PreserveSig] int GetValue(ref PKey k, out PVar v);
    }
    [ComImport, Guid("D666063F-1587-4E43-81F1-B948E807363F"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
    interface IMMDevice {
        [PreserveSig] int Activate(ref Guid iid, int ctx, IntPtr prm, out IntPtr o);
        [PreserveSig] int OpenPropertyStore(int access, out IPropertyStore ps);
        [PreserveSig] int GetId([MarshalAs(UnmanagedType.LPWStr)] out string id);
    }
    [ComImport, Guid("0BD7A1BE-7A1A-44DB-8397-CC5392387B5E"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
    interface IMMDeviceCollection {
        [PreserveSig] int GetCount(out int c);
        [PreserveSig] int Item(int i, out IMMDevice d);
    }
    [ComImport, Guid("A95664D2-9614-4F35-A746-DE8DB63617E6"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
    interface IMMDeviceEnumerator {
        [PreserveSig] int EnumAudioEndpoints(int flow, int mask, out IMMDeviceCollection c);
        [PreserveSig] int GetDefaultAudioEndpoint(int flow, int role, out IMMDevice d);
    }
    [ComImport, Guid("f8679f50-850a-41cf-9c72-430f290290c8"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
    interface IPolicyConfig {
        [PreserveSig] int A1(); [PreserveSig] int A2(); [PreserveSig] int A3(); [PreserveSig] int A4(); [PreserveSig] int A5();
        [PreserveSig] int A6(); [PreserveSig] int A7(); [PreserveSig] int A8(); [PreserveSig] int A9(); [PreserveSig] int A10();
        [PreserveSig] int SetDefaultEndpoint([MarshalAs(UnmanagedType.LPWStr)] string id, int role);
    }
    public static class Dev {
        public static List<string[]> List() {
            List<string[]> res = new List<string[]>();
            IMMDeviceEnumerator en = (IMMDeviceEnumerator)(new EnumeratorCom());
            string def = ""; IMMDevice dd;
            if (en.GetDefaultAudioEndpoint(0, 1, out dd) == 0 && dd != null) dd.GetId(out def);
            IMMDeviceCollection col;
            if (en.EnumAudioEndpoints(0, 1, out col) != 0) return res;
            int n; col.GetCount(out n);
            for (int i = 0; i < n; i++) {
                IMMDevice d; if (col.Item(i, out d) != 0) continue;
                string id; d.GetId(out id);
                string name = id; IPropertyStore ps;
                if (d.OpenPropertyStore(0, out ps) == 0) {
                    PKey k = new PKey(); k.fmtid = new Guid("a45c254e-df1c-4efd-8020-67d146a850e0"); k.pid = 14;
                    PVar v; if (ps.GetValue(ref k, out v) == 0 && v.vt == 31) name = Marshal.PtrToStringUni(v.p);
                }
                res.Add(new string[] { id, name, id == def ? "1" : "0" });
            }
            return res;
        }
        public static void Set(string id) {
            IPolicyConfig pc = (IPolicyConfig)(new PolicyCom());
            pc.SetDefaultEndpoint(id, 0); pc.SetDefaultEndpoint(id, 1); pc.SetDefaultEndpoint(id, 2);
        }
    }
}
'@
}

