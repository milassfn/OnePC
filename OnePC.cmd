    $top = $items[0]; $id = $top.D + '|' + $top.T
    if ([string]$cfg.NewsSeen -ne $id) { (UI 'HomeNewsText').Text = $top.T; (UI 'HomeNews').Visibility = 'Visible'; (UI 'NewsDot').Visibility = 'Visible' }
