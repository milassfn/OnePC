# ---------- Mesures en arrière-plan (la fenêtre reste fluide) ----------
$sync = [hashtable]::Synchronized(@{ Run = $true; Cpu = 0; Gpu = 0; GpuOk = $true; Ram = 0; RamUsed = 0; DiskC = ''; Procs = @(); Ping = -1; Down = 0; Up = 0; NetInfo = 'Lecture en cours...'; Ghz = 0; Vram = 0; DiskFree = 100; CpuT = -1; GpuT = -1; ProcCount = 0 })
$sampler = [powershell]::Create()
[void]$sampler.AddScript({
    param($sync)
    $loop = 0
    $gpuTempOk = $false
    try {
        Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public static class PcmGpu {
    [StructLayout(LayoutKind.Sequential)] public struct LUID { public uint Low; public int High; }
    [StructLayout(LayoutKind.Sequential)] public struct OpenArg { public LUID Luid; public uint hAdapter; }
    [StructLayout(LayoutKind.Sequential)] public struct QueryArg { public uint hAdapter; public int Type; public IntPtr Data; public uint Size; }
    [StructLayout(LayoutKind.Sequential)] public struct CloseArg { public uint hAdapter; }
    [StructLayout(LayoutKind.Sequential)] public struct Perf {
        public uint PhysicalAdapterIndex; public ulong MemoryFrequency; public ulong MaxMemoryFrequency; public ulong MaxMemoryFrequencyOC;
        public ulong MemoryBandwidth; public ulong PCIEBandwidth; public uint FanRPM; public uint Power; public uint Temperature; public byte PowerStateOverride;
    }
    [DllImport("gdi32.dll")] static extern int D3DKMTOpenAdapterFromLuid(ref OpenArg a);
    [DllImport("gdi32.dll")] static extern int D3DKMTQueryAdapterInfo(ref QueryArg a);
    [DllImport("gdi32.dll")] static extern int D3DKMTCloseAdapter(ref CloseArg a);
    public static double Temp(uint low, int high) {
        OpenArg o = new OpenArg(); o.Luid.Low = low; o.Luid.High = high;
        if (D3DKMTOpenAdapterFromLuid(ref o) != 0) return -1;
        int size = Marshal.SizeOf(typeof(Perf));
        IntPtr p = Marshal.AllocHGlobal(size);
        try {
            for (int i = 0; i < size; i++) Marshal.WriteByte(p, i, 0);
            QueryArg q = new QueryArg(); q.hAdapter = o.hAdapter; q.Type = 62; q.Data = p; q.Size = (uint)size;
            if (D3DKMTQueryAdapterInfo(ref q) != 0) return -1;
            Perf r = (Perf)Marshal.PtrToStructure(p, typeof(Perf));
            return r.Temperature / 10.0;
        } finally {
            Marshal.FreeHGlobal(p);
            CloseArg c = new CloseArg(); c.hAdapter = o.hAdapter; D3DKMTCloseAdapter(ref c);
        }
    }
}
'@
        $gpuTempOk = $true
    } catch {}
    $maxMhz = 0; try { $maxMhz = (Get-CimInstance Win32_Processor | Select-Object -First 1).MaxClockSpeed } catch {}
    while ($sync.Run) {
        try {
            $sync.Cpu = [int](Get-CimInstance Win32_PerfFormattedData_PerfOS_Processor -Filter "Name='_Total'").PercentProcessorTime
            $o = Get-CimInstance Win32_OperatingSystem
            $used = $o.TotalVisibleMemorySize - $o.FreePhysicalMemory
            $sync.Ram = [int](100 * $used / $o.TotalVisibleMemorySize)
            $sync.RamUsed = [math]::Round($used / 1MB, 1)
        } catch {}
        try {
            $g = (Get-CimInstance Win32_PerfFormattedData_GPUPerformanceCounters_GPUEngine -ErrorAction Stop |
                  Where-Object { $_.Name -like '*engtype_3D*' } |
                  Measure-Object UtilizationPercentage -Sum).Sum
            $sync.Gpu = [math]::Min(100, [int]$g); $sync.GpuOk = $true
        } catch { $sync.GpuOk = $false }
        try {
            $d = Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='C:'"
            if ($d -and $d.Size) {
                $sync.DiskFree = [int](100 * $d.FreeSpace / $d.Size)
                $sync.DiskC = "C: " + [math]::Round($d.FreeSpace / 1GB) + " Go libres sur " + [math]::Round($d.Size / 1GB) + " Go"
            }
            if ($loop % 3 -eq 0) {
                $wdir = $env:windir
                $sync.Procs = @(Get-Process | Where-Object { $_.Path -and -not $_.Path.StartsWith($wdir, [StringComparison]::OrdinalIgnoreCase) } |
                    Group-Object ProcessName | ForEach-Object {
                        $mem = 0; foreach ($p in $_.Group) { $mem += $p.WorkingSet64 }
                        [pscustomobject]@{ Raw = $_.Name; Count = $_.Count; Bytes = $mem; Path = [string]$_.Group[0].Path }
                    } | Sort-Object Bytes -Descending | Select-Object -First 30 | ForEach-Object {
                        $n = $_.Raw; if ($_.Count -gt 1) { $n = $_.Raw + "  (x" + $_.Count + ")" }
                        $mm = "" + [math]::Round($_.Bytes / 1MB) + " Mo"; if ($_.Bytes -ge 1GB) { $mm = ([math]::Round($_.Bytes / 1GB, 1)).ToString([cultureinfo]'fr-FR') + " Go" }
                        $ico = $null
                        try {
                            $idir = Join-Path $env:LOCALAPPDATA 'OnePC\icons'
                            $f = Join-Path $idir (($_.Path.ToLower().GetHashCode()).ToString('x8') + '.png')
                            if (-not (Test-Path -LiteralPath $f)) {
                                if (-not (Test-Path -LiteralPath $idir)) { New-Item -ItemType Directory -Path $idir -Force | Out-Null }
                                Add-Type -AssemblyName System.Drawing
                                $i = [System.Drawing.Icon]::ExtractAssociatedIcon($_.Path)
                                $b = $i.ToBitmap(); $b.Save($f, [System.Drawing.Imaging.ImageFormat]::Png); $b.Dispose(); $i.Dispose()
                            }
                            $ico = $f
                        } catch {}
                        [pscustomobject]@{ Raw = $_.Raw; Name = $n; Mem = $mm; Ico = $ico }
                    })
            }
        } catch {}
        try {
            $r = (New-Object System.Net.NetworkInformation.Ping).Send('1.1.1.1', 1000)
            if ($r.Status -eq 'Success') { $sync.Ping = [int]$r.RoundtripTime } else { $sync.Ping = -1 }
        } catch { $sync.Ping = -1 }
        try {
            $n = Get-CimInstance Win32_PerfFormattedData_Tcpip_NetworkInterface
            $sync.Down = [math]::Round((($n | Measure-Object BytesReceivedPersec -Sum).Sum) * 8 / 1000000, 1)
            $sync.Up   = [math]::Round((($n | Measure-Object BytesSentPersec -Sum).Sum) * 8 / 1000000, 1)
        } catch {}
        try {
            $pp = (Get-CimInstance Win32_PerfFormattedData_Counters_ProcessorInformation -Filter "Name='_Total'" -ErrorAction Stop).PercentProcessorPerformance
            if ($pp -and $maxMhz) { $sync.Ghz = [math]::Round($maxMhz * $pp / 100000, 2) }
        } catch {}
        try {
            $mem = @(Get-CimInstance Win32_PerfFormattedData_GPUPerformanceCounters_GPUAdapterMemory -ErrorAction Stop)
            $sync.Vram = [math]::Round((($mem | Measure-Object DedicatedUsage -Maximum).Maximum) / 1GB, 1)
            $best = -1
            if ($gpuTempOk) {
                foreach ($a in $mem) {
                    if ($a.Name -match 'luid_0x([0-9A-Fa-f]+)_0x([0-9A-Fa-f]+)') {
                        $t = [PcmGpu]::Temp([Convert]::ToUInt32($Matches[2], 16), [Convert]::ToInt32($Matches[1], 16))
                        if ($t -gt 5 -and $t -lt 125 -and $t -gt $best) { $best = $t }
                    }
                }
            }
            $sync.GpuT = [math]::Round($best)
        } catch {}
        try {
            $z = @(Get-CimInstance Win32_PerfFormattedData_Counters_ThermalZoneInformation -ErrorAction Stop)
            $k = ($z | Measure-Object HighPrecisionTemperature -Maximum).Maximum
            if ($k -gt 2500 -and $k -lt 4000) { $sync.CpuT = [math]::Round($k / 10 - 273.15) } else { $sync.CpuT = -1 }
        } catch { $sync.CpuT = -1 }
        try { $sync.ProcCount = @(Get-Process).Count } catch {}
        if ($loop % 30 -eq 0) {
            try {
                $c = Get-NetIPConfiguration -ErrorAction Stop | Where-Object { $_.IPv4DefaultGateway } | Select-Object -First 1
                if ($c) {
                    $dns = ($c.DNSServer | Where-Object { $_.AddressFamily -eq 2 } | ForEach-Object { $_.ServerAddresses }) -join ', '
                    $sync.NetInfo = "Carte réseau : " + $c.InterfaceAlias + "`r`nAdresse IP locale : " + (($c.IPv4Address | ForEach-Object { $_.IPAddress }) -join ', ') +
                                    "`r`nPasserelle (box) : " + (($c.IPv4DefaultGateway | ForEach-Object { $_.NextHop }) -join ', ') + "`r`nServeurs DNS : " + $dns
                } else { $sync.NetInfo = 'Aucune connexion détectée.' }
            } catch { $sync.NetInfo = 'Informations réseau non disponibles.' }
        }
        $loop++
        Start-Sleep -Milliseconds 1000
    }
}).AddArgument($sync)
[void]$sampler.BeginInvoke()

# ---------- Jauges et courbes ----------
$script:gauge = @{}
function Draw-Gauge($path, $p) {
    if ($p -lt 0.5) { $path.Data = $null; return }
    $a = $p / 100 * 2 * [math]::PI
    $x = 55 + 51 * [math]::Sin($a); $y = 55 - 51 * [math]::Cos($a)
    $large = 0; if ($p -gt 50) { $large = 1 }
    $path.Data = [System.Windows.Media.Geometry]::Parse("M 55,4 A 51,51 0 $large 1 $(N $x),$(N $y)")
    $col = '#34D399'; if ($p -ge 85) { $col = '#F87171' } elseif ($p -ge 60) { $col = '#FBBF24' }
    $g = $script:gauge[$path.Name]
    if ($g.Col -ne $col) {
        $g.Col = $col
        try {
            $path.Stroke = $brush.ConvertFromString($col)
            $fx = New-Object System.Windows.Media.Effects.DropShadowEffect
            $fx.Color = [System.Windows.Media.ColorConverter]::ConvertFromString($col); $fx.BlurRadius = 14; $fx.ShadowDepth = 0; $fx.Opacity = 0.75
            $path.Effect = $fx
        } catch {}
    }
}
$gaugeTimer = New-Object System.Windows.Threading.DispatcherTimer
$gaugeTimer.Interval = [TimeSpan]::FromMilliseconds(33)
$gaugeTimer.Add_Tick({
    $busy = $false
    foreach ($g in $script:gauge.Values) {
        $d = $g.To - $g.Cur
        if ([math]::Abs($d) -lt 0.15) { if ($g.Cur -ne $g.To) { $g.Cur = $g.To; Draw-Gauge $g.Path $g.Cur }; continue }
        $g.Cur += $d * 0.16; $busy = $true
        Draw-Gauge $g.Path $g.Cur
    }
    if (-not $busy) { $gaugeTimer.Stop() }
})
function Set-Gauge($path, $pct) {
    $p = [math]::Max(0, [math]::Min(99.9, [double]$pct))
    if (-not $script:gauge.ContainsKey($path.Name)) { $script:gauge[$path.Name] = @{ Path = $path; Cur = 0.0; To = 0.0; Col = '' } }
    $g = $script:gauge[$path.Name]; $g.To = $p
    if (-not $win.IsVisible -or (UI 'PageHome').Visibility -ne 'Visible') { $g.Cur = $p; Draw-Gauge $path $p; return }
    if (-not $gaugeTimer.IsEnabled) { $gaugeTimer.Start() }
}
function Set-GaugeState($name, $pct, $isRam) {
    $p = [int]$pct
    if ($isRam) {
        if ($p -ge 90) { $t = 'Saturée'; $c = '#FB923C' } elseif ($p -ge 75) { $t = 'Bien remplie'; $c = '#FBBF24' } else { $t = 'OK'; $c = '#34D399' }
    } else {
        if ($p -ge 90) { $t = 'À fond'; $c = '#FB923C' } elseif ($p -ge 60) { $t = 'Ça travaille'; $c = '#FBBF24' } else { $t = 'Tranquille'; $c = '#34D399' }
    }
    $u = UI $name; $u.Text = $t; $u.Foreground = $brush.ConvertFromString($c)
}
$script:span = 60
function Set-Line($poly, $hist) {
    if ((UI 'PageHome').Visibility -ne 'Visible') { return }
    $n = $script:span; $cnt = $hist.Count
    $pts = for ($i = 0; $i -lt 60; $i++) {
        $from = $cnt - $n + [int][math]::Floor($i * $n / 60); $to = $cnt - $n + [int][math]::Floor(($i + 1) * $n / 60) - 1
        $sum = 0.0; $k = 0
        for ($j = $from; $j -le $to; $j++) { if ($j -ge 0) { $sum += $hist[$j]; $k++ } }
        $v = 0; if ($k) { $v = $sum / $k }
        "$(N ($i * 240 / 59)),$(N (44 - $v / 100 * 42))"
    }
    $poly.Points = [System.Windows.Media.PointCollection]::Parse($pts -join ' ')
    $area = UI ($poly.Name -replace 'Line', 'Area')
    if ($area) { $area.Points = [System.Windows.Media.PointCollection]::Parse(($pts -join ' ') + ' 240,46 0,46') }
}
