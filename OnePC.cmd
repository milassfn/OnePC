$script:obsWs = $null; $script:obsPort = 4455; $script:obsReqN = 0
function Get-ObsPassword {
    if ([string]$cfg.ObsPass) { return [string]$cfg.ObsPass }
    $b = New-Object byte[] 12; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b)
    $cfg.ObsPass = ([Convert]::ToBase64String($b) -replace '[^A-Za-z0-9]', 'x'); Save-Cfg
    [string]$cfg.ObsPass
}
function Get-ObsPasswords {
    # le mot de passe de OnePC (passé à OBS quand OnePC le lance) puis celui réglé dans OBS, s'il est lisible
    $l = @(Get-ObsPassword)
    try { $j = Get-Content -LiteralPath (Join-Path $obsCfgDir 'plugin_config\obs-websocket\config.json') -Raw -Encoding UTF8 -ErrorAction Stop | ConvertFrom-Json
        if ($j.server_password) { $l += [string]$j.server_password }; if ($j.server_port) { $script:obsPort = [int]$j.server_port } } catch {}
    try { $g = Read-Ini (Join-Path $obsCfgDir 'global.ini'); if ($g['OBSWebSocket.ServerPassword']) { $l += [string]$g['OBSWebSocket.ServerPassword'] }; if ($g['OBSWebSocket.ServerPort']) { $script:obsPort = [int]$g['OBSWebSocket.ServerPort'] } } catch {}
    @($l | Select-Object -Unique)
}
function Sha64($s) { [Convert]::ToBase64String(([System.Security.Cryptography.SHA256]::Create()).ComputeHash([Text.Encoding]::UTF8.GetBytes($s))) }
function Connect-Obs {
    if ($script:obsWs -and $script:obsWs.IsOpen) { return $true }
    if (-not (Get-Process -Name 'obs64' -ErrorAction SilentlyContinue)) { return $false }
    try { Init-ObsWs } catch { return $false }
    foreach ($pw in (Get-ObsPasswords)) {
        $w = New-Object PCM.ObsWs
        if (-not $w.Open(('ws://127.0.0.1:' + $script:obsPort), 1500)) { $w.Close(); return $false }
        $hello = $w.Recv(1500); if (-not $hello) { $w.Close(); continue }
        try { $h = $hello | ConvertFrom-Json } catch { $w.Close(); continue }
        $d = @{ rpcVersion = 1; eventSubscriptions = 0 }
        if ($h.d.authentication) { $d.authentication = Sha64 ((Sha64 ($pw + $h.d.authentication.salt)) + $h.d.authentication.challenge) }
        [void]$w.Send((@{ op = 1; d = $d } | ConvertTo-Json -Compress -Depth 5), 1500)
        $r = $w.Recv(1500)
        if ($r -and $r -match '"op"\s*:\s*2') { $script:obsWs = $w; return $true }
        $w.Close()
        if (-not $h.d.authentication) { return $false }
    }
    $false
}
function Obs-Req($type, $data) {
    if (-not (Connect-Obs)) { return $null }
    $script:obsReqN++; $id = 'onepc' + $script:obsReqN
    $d = @{ requestType = $type; requestId = $id }; if ($data) { $d.requestData = $data }
    if (-not $script:obsWs.Send((@{ op = 6; d = $d } | ConvertTo-Json -Compress -Depth 10), 2000)) { $script:obsWs.Close(); $script:obsWs = $null; return $null }
    for ($i = 0; $i -lt 20; $i++) {
        $m = $script:obsWs.Recv(3000)
        if (-not $m) { $script:obsWs.Close(); $script:obsWs = $null; return $null }
        try { $j = $m | ConvertFrom-Json } catch { continue }
        if ($j.op -eq 7 -and $j.d.requestId -eq $id) {
            if ($j.d.requestStatus.result) { if ($j.d.responseData) { return $j.d.responseData } else { return [pscustomobject]@{ ok = $true } } }
            $script:obsLastErr = [string]$j.d.requestStatus.comment; return $null
        }
    }
    $null
}
# ---------- OBS : analyse du PC et recommandations ----------
function Get-ObsHw {
    $g = [string]$mainGpu.Name; $vendor = 'cpu'
    if ($g -match '(?i)nvidia|geforce|rtx|gtx|quadro') { $vendor = 'nvidia' } elseif ($g -match '(?i)radeon|amd') { $vendor = 'amd' } elseif ($g -match '(?i)intel|arc') { $vendor = 'intel' }
    $threads = 4; try { $threads = [int](Get-CimInstance Win32_Processor -ErrorAction Stop | Measure-Object NumberOfLogicalProcessors -Sum).Sum } catch {}
    $wifi = $false; try { $na = Get-NetAdapter -Physical -ErrorAction Stop | Where-Object { $_.Status -eq 'Up' } | Select-Object -First 1; if ($na -and $na.PhysicalMediaType -match '802\.11|Wireless|Native') { $wifi = $true } } catch {}
    $sw = 1920; $sh = 1080; try { Add-Type -AssemblyName System.Windows.Forms; $b = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds; $sw = $b.Width; $sh = $b.Height } catch {}
    [pscustomobject]@{ Gpu = $g; Vendor = $vendor; Threads = $threads; Wifi = $wifi; W = $sw; H = $sh }
}
function Enc-Of($vendor) { switch ($vendor) { 'nvidia' { 'nvenc' } 'amd' { 'amd' } 'intel' { 'qsv' } default { 'x264' } } }
function Enc-Name($e) {
    $e = [string]$e
    if ($e -match '(?i)nvenc') { return 'NVIDIA NVENC (carte graphique)' }
    if ($e -match '(?i)amd|amf|h264_texture_amf') { return 'AMD (carte graphique)' }
    if ($e -match '(?i)qsv') { return 'Intel QuickSync (carte graphique)' }
    if ($e -match '(?i)x264') { return 'x264 (processeur)' }
    if ($e) { return $e }; 'inconnu'
}
function Get-ObsRec($use, $hw, $upMbps, $obsVer) {
    $enc = Enc-Of $hw.Vendor; $gpuEnc = ($enc -ne 'x264')
    $avail = 0; if ($upMbps -gt 0) { $avail = [int]($upMbps * 1000 * 0.75) }
    $r = [ordered]@{ Use = $use; Enc = $enc; BaseW = $hw.W; BaseH = $hw.H; OutW = 1920; OutH = 1080; Fps = 60; Kbps = 6000; Rec = 'Small'; Fmt = 'mkv'; Why = '' }
    if ($obsVer -and [version]('0' + ($obsVer -replace '[^\d\.]', '')) -ge [version]'30.2') { $r.Fmt = 'hybrid_mp4' }
    switch ($use) {
        'twitch' {
            $cap = 6000; if ($avail -gt 0) { $cap = [math]::Min(6000, $avail) }
            if ($cap -ge 6000 -and ($gpuEnc -or $hw.Threads -ge 12)) { $r.OutW = 1920; $r.OutH = 1080; $r.Fps = 60; $r.Kbps = 6000 }
            elseif ($cap -ge 4500) { $r.OutW = 1280; $r.OutH = 720; $r.Fps = 60; $r.Kbps = 4500 }
            elseif ($cap -ge 3000) { $r.OutW = 1280; $r.OutH = 720; $r.Fps = 30; $r.Kbps = 3000 }
            else { $r.OutW = 1280; $r.OutH = 720; $r.Fps = 30; $r.Kbps = [math]::Max(1500, $cap) }
            $r.Why = 'Twitch limite le débit à environ 6000 kbit/s : au-delà, tes viewers saccadent.'
        }
        'youtube' {
            $cap = 9000; if ($avail -gt 0) { $cap = [math]::Min(9000, $avail) }
            if ($cap -ge 6000) { $r.OutW = 1920; $r.OutH = 1080; $r.Fps = 60; $r.Kbps = $cap } else { $r.OutW = 1280; $r.OutH = 720; $r.Fps = 60; $r.Kbps = [math]::Max(2500, $cap) }
            $r.Why = 'YouTube accepte plus de débit que Twitch : plus il est haut, plus l''image est propre.'
        }
        'tiktok' {
            $cap = 6000; if ($avail -gt 0) { $cap = [math]::Min(6000, $avail) }
            $r.BaseW = 1080; $r.BaseH = 1920; $r.OutW = 1080; $r.OutH = 1920; $r.Fps = 30; $r.Kbps = [math]::Max(2500, $cap)
            if (-not $gpuEnc) { $r.OutW = 720; $r.OutH = 1280 }
            $r.Why = "Format vertical 9:16 pour TikTok : OnePC le met dans un profil à part pour ne pas casser tes scènes habituelles."
        }
        default {
            $r.OutW = $hw.W; $r.OutH = $hw.H; $r.Fps = 60; $r.Kbps = 0
            $r.Why = "Pour l'enregistrement, la qualité compte plus que le débit : enregistrement « haute qualité, taille moyenne » avec ta carte graphique."
        }
    }
    if (-not $gpuEnc -and $use -ne 'record' -and $hw.Threads -lt 12) { $r.OutW = [math]::Min($r.OutW, 1280); $r.OutH = [math]::Min($r.OutH, $(if ($use -eq 'tiktok') { 1280 } else { 720 })); $r.Fps = [math]::Min($r.Fps, 30) }
    [pscustomobject]$r
}
function Get-ObsCur {
    $p = Get-ObsProfile; if (-not $p) { return $null }
    $adv = ($p['Output.Mode'] -eq 'Advanced')
    $c = [ordered]@{ Name = [string]$p['_Name']; Adv = $adv; Enc = ''; Kbps = 0; OutW = [int]$p['Video.OutputCX']; OutH = [int]$p['Video.OutputCY']; BaseW = [int]$p['Video.BaseCX']; BaseH = [int]$p['Video.BaseCY']; Fps = 30 }
    $fps = $p['Video.FPSCommon']; if ($p['Video.FPSType'] -eq '1' -and $p['Video.FPSInt']) { $fps = $p['Video.FPSInt'] }
    if ($fps) { try { $c.Fps = [int][double]([string]$fps).Split(' ')[0] } catch {} }
    if ($adv) {
        $c.Enc = [string]$p['AdvOut.Encoder']
        try { $se = Join-Path (Join-Path (Join-Path $obsCfgDir 'basic\profiles') ([string]$p['_Dir'])) 'streamEncoder.json'
            if (Test-Path -LiteralPath $se) { $j = Get-Content -LiteralPath $se -Raw -ErrorAction Stop | ConvertFrom-Json; if ($j.bitrate) { $c.Kbps = [int]$j.bitrate } } } catch {}
    } else { $c.Enc = [string]$p['SimpleOutput.StreamEncoder']; if (-not $c.Enc) { $c.Enc = 'x264' }; $c.Kbps = [int]$p['SimpleOutput.VBitrate']; if (-not $c.Kbps) { $c.Kbps = 2500 } }
    if (-not $c.OutW) { $c.OutW = 1280; $c.OutH = 720 }
    [pscustomobject]$c
}
