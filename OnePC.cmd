function New-Check($text, $tag, $width) {
    $cb = New-Object System.Windows.Controls.CheckBox
    $cb.Content = $text; $cb.Tag = $tag; $cb.Width = $width
    $cb.Foreground = $brush.ConvertFromString($light)
    $cb.Margin = New-Object System.Windows.Thickness 0, 0, 10, 10
    $cb
}
function Load-Apps {
    $host2 = UI 'LightApps'; $host2.Children.Clear()
    $wdir = $env:windir
    $groups = @(Get-Process | Where-Object { $_.Path -and -not $_.Path.StartsWith($wdir, [StringComparison]::OrdinalIgnoreCase) } | Group-Object ProcessName |
        Where-Object { $_.Name -notmatch $keepRx -and -not ($_.Group | Where-Object { $_.MainWindowHandle -ne 0 }) } |
        ForEach-Object { $mem = 0; foreach ($p in $_.Group) { $mem += $p.WorkingSet64 }; [pscustomobject]@{ Raw = $_.Name; Count = $_.Count; Bytes = $mem } } |
        Sort-Object Bytes -Descending)
    foreach ($g in $groups) {
        $t = $g.Raw + "   ·   " + $g.Count + " processus, " + [math]::Round($g.Bytes / 1MB) + " Mo"
        [void]$host2.Children.Add((New-Check $t $g.Raw 330))
    }
    if ($groups.Count -eq 0) { (UI 'LightMsg').Text = "Aucune application en arrière-plan trouvée." }
}
function Load-Services {
    $host2 = UI 'LightSvc'; $host2.Children.Clear()
    $defs = @(
        @('DiagTrack', "Télémétrie Microsoft (envoi de statistiques d'utilisation)"),
        @('MapsBroker', 'Cartes hors connexion'),
        @('PhoneSvc', 'Lien avec le téléphone'),
        @('WMPNetworkSvc', 'Partage réseau du Lecteur Windows Media'),
        @('Fax', 'Télécopie'),
        @('RetailDemo', 'Mode démonstration magasin'),
        @('Spooler', "Impression (seulement si tu n'as pas d'imprimante)")
    )
    foreach ($d in $defs) {
        $sv = Get-Service -Name $d[0] -ErrorAction SilentlyContinue
        if (-not $sv) { continue }
        $state = 'arrêté'; if ($sv.Status -eq 'Running') { $state = 'en cours' }
        [void]$host2.Children.Add((New-Check ($d[1] + "   ·   " + $state) $d[0] 500))
    }
}
function Load-Light { Load-Apps; Load-Services }
(UI 'LightRefresh').Add_Click({ (UI 'LightMsg').Text = ' '; Load-Light })
(UI 'GoStart').Add_Click({ Show-Page 'Start' })
(UI 'LightAll').Add_Click({
    $all = @((UI 'LightApps').Children)
    $target = [bool](@($all | Where-Object { -not $_.IsChecked }).Count)
    foreach ($c in $all) { $c.IsChecked = $target }
})
(UI 'LightClose').Add_Click({
    $sel = @((UI 'LightApps').Children | Where-Object { $_.IsChecked } | ForEach-Object { [string]$_.Tag })
    if ($sel.Count -eq 0) { (UI 'LightMsg').Text = "Coche d'abord au moins une application."; return }
    if (-not (Ask ("Fermer ces " + $sel.Count + " application(s) ?`r`n`r`n" + ($sel -join ', ') + "`r`n`r`nCe qui n'est pas enregistré dedans sera perdu."))) { return }
    $before = @(Get-Process).Count; $fail = 0
    foreach ($n in $sel) { try { Stop-Process -Name $n -Force -ErrorAction Stop } catch { $fail++ } }
    Start-Sleep -Milliseconds 800
    $gain = [math]::Max(0, $before - @(Get-Process).Count)
    Load-Apps
    Log ("Applications fermées : " + ($sel -join ', ')); $t = "$gain processus en moins."; if ($fail) { $t += " $fail application(s) n'ont pas pu être fermées." }
    (UI 'LightMsg').Text = $t
})
$svcFile = Join-Path $appDir 'services.txt'
(UI 'SvcStop').Add_Click({
    $sel = @((UI 'LightSvc').Children | Where-Object { $_.IsChecked } | ForEach-Object { [string]$_.Tag })
    if ($sel.Count -eq 0) { (UI 'SvcMsg').Text = "Coche d'abord au moins un service."; return }
    $noms = @((UI 'LightSvc').Children | Where-Object { $_.IsChecked } | ForEach-Object { ([string]$_.Content -split '   ·   ')[0] })
    if (-not (Ask ("Mettre ces " + $sel.Count + " service(s) en manuel ?`r`n`r`n - " + ($noms -join "`r`n - ") + "`r`n`r`nCes services sont sûrs à désactiver. Rien n'est supprimé : le bouton « Rétablir » les remet comme avant quand tu veux. Windows demandera les droits administrateur."))) { return }
    $code = @'
$file = '__FILE__'
foreach ($n in @(__NAMES__)) {
    $s = Get-Service -Name $n -ErrorAction SilentlyContinue
    if (-not $s) { continue }
    $st = [string]$s.StartType
    if ($st -eq 'Automatic') { try { if ((Get-ItemProperty -LiteralPath ("HKLM:\SYSTEM\CurrentControlSet\Services\" + $n) -Name DelayedAutostart -ErrorAction Stop).DelayedAutostart -eq 1) { $st = 'AutomaticDelayed' } } catch {} }
    if (-not (Select-String -LiteralPath $file -Pattern ("^" + [regex]::Escape($n) + "=") -Quiet -ErrorAction SilentlyContinue)) { Add-Content -LiteralPath $file -Value ($n + "=" + $st) }
    Set-Service -Name $n -StartupType Manual -ErrorAction SilentlyContinue
    Stop-Service -Name $n -Force -ErrorAction SilentlyContinue
}
'@
    $code = $code.Replace('__FILE__', $svcFile.Replace("'", "''")).Replace('__NAMES__', (($sel | ForEach-Object { "'" + $_ + "'" }) -join ','))
    if (Run-Console $code -HiddenWait) { Log ("Services arrêtés (passés en manuel) : " + ($sel -join ', ')); Load-Services; (UI 'SvcMsg').Text = 'Services arrêtés et passés en manuel.' }
    else { (UI 'SvcMsg').Text = 'Annulé (droits administrateur refusés).' }
})
(UI 'SvcRestore').Add_Click({
    if (-not (Test-Path -LiteralPath $svcFile)) { (UI 'SvcMsg').Text = "Rien à rétablir : aucun service n'a été modifié par OnePC."; return }
    $code = @'
$file = '__FILE__'
foreach ($l in (Get-Content -LiteralPath $file)) {
    $p = $l -split '='
    if ($p.Count -ne 2) { continue }
    if ($p[1] -eq 'AutomaticDelayed') { Set-Service -Name $p[0] -StartupType Automatic -ErrorAction SilentlyContinue; & sc.exe config $p[0] start= delayed-auto | Out-Null; Start-Service -Name $p[0] -ErrorAction SilentlyContinue }
    else {
        Set-Service -Name $p[0] -StartupType $p[1] -ErrorAction SilentlyContinue
        if ($p[1] -eq 'Automatic') { Start-Service -Name $p[0] -ErrorAction SilentlyContinue }
    }
}
Remove-Item -LiteralPath $file -Force
'@
    $code = $code.Replace('__FILE__', $svcFile.Replace("'", "''"))
    if (Run-Console $code -HiddenWait) { Log 'Services remis comme avant'; Load-Services; (UI 'SvcMsg').Text = 'Services remis comme avant.' }
    else { (UI 'SvcMsg').Text = 'Annulé (droits administrateur refusés).' }
})

# ---------- Applications installées ----------
$script:apps = $null; $script:appsBySize = $false
function Show-Apps {
    $q = (UI 'AppSearch').Text.Trim()
    if ($q) { (UI 'AppHint').Visibility = 'Collapsed' } else { (UI 'AppHint').Visibility = 'Visible' }
    $rows = @($script:apps)
    if ($q) { $rows = @($rows | Where-Object { $_.Name.IndexOf($q, [StringComparison]::OrdinalIgnoreCase) -ge 0 -or $_.Publisher.IndexOf($q, [StringComparison]::OrdinalIgnoreCase) -ge 0 }) }
    if ($script:appsBySize) { $rows = @($rows | Sort-Object Kb -Descending) } else { $rows = @($rows | Sort-Object Name) }
    (UI 'AppList').ItemsSource = $rows
    $script:appSel = @{}; Update-AppSel
}
$script:appSel = @{}
function Update-AppSel {
    $n = $script:appSel.Count
    (UI 'AppUnSel').IsEnabled = ($n -gt 0 -and -not $script:batch)
    if ($n -gt 0) { (UI 'AppUnSel').Content = "Désinstaller la sélection ($n)" } else { (UI 'AppUnSel').Content = 'Désinstaller la sélection' }
}
function Get-UninstCmd($it) {
    $u = [string]$it.Cmd; $auto = $false
    if ($u -match 'msiexec') {
        $g = [regex]::Match($u, '\{[0-9A-Fa-f\-]{36}\}').Value
        if ($g) { $u = "msiexec.exe /x $g /passive /norestart"; $auto = $true } else { $u = $u -replace '/I\s*\{', '/X{' }
    } elseif ($it.Quiet) { $u = [string]$it.Quiet; $auto = $true }
    @{ U = $u; Auto = $auto }
}
function Find-SteamGame($id) {
    try {
        $steam = [string](Get-ItemProperty -LiteralPath 'HKCU:\Software\Valve\Steam' -ErrorAction Stop).SteamPath
        if (-not $steam) { return $null }
        $steam = $steam.Replace('/', '\')
        $libs = @($steam)
        $vdf = Join-Path $steam 'steamapps\libraryfolders.vdf'
        if (Test-Path -LiteralPath $vdf) { foreach ($mm in [regex]::Matches((Get-Content -LiteralPath $vdf -Raw), '"path"\s+"([^"]+)"')) { $libs += $mm.Groups[1].Value.Replace('\\', '\') } }
        foreach ($lib in ($libs | Select-Object -Unique)) {
            $mf = Join-Path $lib ("steamapps\appmanifest_" + $id + ".acf")
            if (-not (Test-Path -LiteralPath $mf)) { continue }
            $t = Get-Content -LiteralPath $mf -Raw
            if ($t -notmatch '"installdir"\s+"([^"]+)"') { continue }
            $name = $Matches[1]
            # nom de dossier strict : pas de séparateur, pas d'espace ni de point en début ou en fin
            if (-not $name -or $name -ne $name.Trim(' ', '.') -or $name -match '[\\/:*?"<>|]') { continue }
            try {
                $common = [System.IO.Path]::GetFullPath((Join-Path $lib 'steamapps\common')).TrimEnd('\') + '\'
                $dir = [System.IO.Path]::GetFullPath((Join-Path $lib ("steamapps\common\" + $name)))
            } catch { continue }
            if ($dir.Length -le $common.Length -or -not $dir.StartsWith($common, [StringComparison]::OrdinalIgnoreCase)) { continue }
            # dossier partagé avec un autre jeu Steam (ex. famille Half-Life) : on ne le supprime pas nous-mêmes
            $sharedDir = $false
            foreach ($om in @(Get-ChildItem -LiteralPath (Join-Path $lib 'steamapps') -Filter 'appmanifest_*.acf' -File -ErrorAction SilentlyContinue)) {
                if ($om.Name -ieq ("appmanifest_" + $id + ".acf")) { continue }
                try { $ot = Get-Content -LiteralPath $om.FullName -Raw; if ($ot -match '"installdir"\s+"([^"]+)"' -and $Matches[1] -ieq $name) { $sharedDir = $true; break } } catch {}
            }
            if ($sharedDir) { return $null }
            return @{ Lib = $lib; Manifest = $mf; Dir = $dir; Id = [string]$id }
        }
    } catch {}
    return $null
}
$steamDelCode = {
    param($a)
    try {
        # suppression qui ne suit jamais un lien (jonction / lien symbolique) vers un autre dossier
        function RmTree($d) {
            $di = New-Object System.IO.DirectoryInfo $d
            if ($di.Attributes -band [System.IO.FileAttributes]::ReparsePoint) { $di.Delete(); return }
            foreach ($f in $di.GetFiles()) { try { $f.Attributes = 'Normal' } catch {}; $f.Delete() }
            foreach ($sd in $di.GetDirectories()) { RmTree $sd.FullName }
            try { $di.Attributes = 'Directory' } catch {}
            $di.Delete()
        }
        if (Test-Path -LiteralPath $a.Dir) {
            try { [System.IO.Directory]::Delete($a.Dir, $true) } catch { RmTree $a.Dir }
        }
        Remove-Item -LiteralPath $a.Manifest -Force -ErrorAction SilentlyContinue
        foreach ($sub in 'workshop\content', 'shadercache', 'downloading', 'temp') {
            $x = Join-Path $a.Lib ("steamapps\" + $sub + "\" + $a.Id)
            if (Test-Path -LiteralPath $x) { try { [System.IO.Directory]::Delete($x, $true) } catch {} }
        }
        'OK'
    } catch { 'ERR'; $_.Exception.Message }
}
function Remove-SteamGame($it, $id) {
    $g = Find-SteamGame $id
    if (-not $g) {
        if (Ask ("Je ne retrouve pas le dossier de « " + $it.Name + " » dans tes bibliothèques Steam.`r`nOuvrir Steam pour le désinstaller ?")) { Start-Process ("steam://uninstall/" + $id) }
        return
    }
    $dirPrefix = $g.Dir.TrimEnd('\') + '\'
    if (Get-Process | Where-Object { try { $_.Path -and $_.Path.StartsWith($dirPrefix, [StringComparison]::OrdinalIgnoreCase) } catch { $false } }) { (UI 'AppsMsg').Text = "« " + $it.Name + " » est en cours d'exécution : ferme le jeu avant de le désinstaller."; return }
    if (-not (Ask ("Désinstaller « " + $it.Name + " » directement, sans ouvrir Steam ?`r`n`r`nCe dossier sera supprimé définitivement :`r`n" + $g.Dir + "`r`n`r`nTes sauvegardes dans le cloud Steam et le jeu dans ta bibliothèque ne sont pas touchés : tu pourras le réinstaller quand tu veux."))) { return }
    $script:unApp = $it; $script:unBusy = $true
    (UI 'AppsMsg').Text = "Suppression de « " + $it.Name + " » en cours... Les gros jeux prennent une ou deux minutes."
    Start-Bg $steamDelCode $g {
        param($r)
        $it = $script:unApp; $script:unBusy = $false
        if ($r.Count -eq 0 -or $r[0] -ne 'OK') {
            $why = ''; if ($r.Count -ge 2) { $why = [string]$r[1] }
            (UI 'AppsMsg').Text = "La suppression de « " + $it.Name + " » n'a pas abouti : $why"
            return
        }
        # retirer aussi l'entrée du jeu dans la liste des programmes de Windows
        $key = 'Registry::' + [string]$it.RegKey
        if ($it.RegKey -and (Test-Path -LiteralPath $key)) {
            try { Remove-Item -LiteralPath $key -Recurse -Force -ErrorAction Stop }
            catch { [void](Run-Console ("Remove-Item -LiteralPath '" + $key.Replace("'", "''") + "' -Recurse -Force") -HiddenWait) }
        }
        Log ("Jeu Steam désinstallé directement : " + $it.Name)
        Load-AppList
        $tail = ''; if (Get-Process -Name 'steam' -ErrorAction SilentlyContinue) { $tail = " Steam l'affichera comme désinstallé à son prochain redémarrage." }
        (UI 'AppsMsg').Text = "« " + $it.Name + " » est désinstallé." + $tail
    }
}
$uninstCode = {
    param($cmd)
    $cmd = [string]$cmd
    if ($cmd -notmatch '^\s*"' -and $cmd -notmatch '^\s*msiexec' -and $cmd -match '^(.+?\.exe)(\s.*)?$' -and (Test-Path -LiteralPath $Matches[1])) { $cmd = '"' + $Matches[1] + '"' + $Matches[2] }
    try { Start-Process -FilePath $env:ComSpec -ArgumentList ('/c "' + $cmd + '"') -WindowStyle Hidden -Wait } catch {}
    Start-Sleep -Seconds 3
    'fini'
}
function Test-LeftoverSafe($p) {
    $p = [string]$p
    try { $full = [System.IO.Path]::GetFullPath($p) } catch { return $false }
    if ($full.TrimEnd('\') -ne $p.TrimEnd('\')) { return $false }
    try { if ((Get-Item -LiteralPath $p -Force -ErrorAction Stop).Attributes -band [System.IO.FileAttributes]::ReparsePoint) { return $false } } catch { return $false }
    foreach ($root in $env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:ProgramData, $env:LOCALAPPDATA, $env:APPDATA) {
        if (-not $root) { continue }
        $r = $root.TrimEnd('\') + '\'
        if ($p.Length -gt $r.Length -and $p.StartsWith($r, [StringComparison]::OrdinalIgnoreCase)) {
            $parts = @($p.Substring($r.Length) -split '\\' | Where-Object { $_ })
            if ($parts.Count -eq 0) { return $false }
            if ($parts[0] -match '^(Microsoft.*|Windows.*|WindowsApps|Packages|Temp|OnePC)$') { return $false }
            if ($parts[0] -match '^(Common Files|Programs)$' -and $parts.Count -lt 2) { return $false }
            return $true
        }
    }
    return $false
}
function Test-LocShared($loc) {
    # vrai si une application encore installée utilise ce dossier, un de ses sous-dossiers ou un dossier parent
    $lp = ([string]$loc).TrimEnd('\') + '\'
    foreach ($o in @($script:apps)) {
        $ol = ([string]$o.Loc).Trim().Trim('"').TrimEnd('\'); if (-not $ol) { continue }
        $op = $ol + '\'
        if ($op.StartsWith($lp, [StringComparison]::OrdinalIgnoreCase) -or $lp.StartsWith($op, [StringComparison]::OrdinalIgnoreCase)) { return $true }
    }
    return $false
}
function Get-StartLinks {
    $h = @{}
    foreach ($d in [Environment]::GetFolderPath('CommonPrograms'), [Environment]::GetFolderPath('Programs')) {
        if (-not $d) { continue }
        foreach ($l in @(Get-ChildItem -LiteralPath $d -Recurse -Filter *.lnk -ErrorAction SilentlyContinue)) {
            if ($l.BaseName -notmatch 'uninstall|sinstaller|readme|help|aide|website|site web|manual|license') { $h[$l.BaseName.ToLower()] = $l.FullName }
        }
    }
    $h
}
$icoDir = Join-Path $appDir 'icons'
try { if (-not (Test-Path -LiteralPath $icoDir)) { New-Item -ItemType Directory -Path $icoDir -Force | Out-Null } } catch {}
$script:wsh = $null
function Get-IcoPng($path) {
    # renvoie le chemin d'une petite image de l'icône du programme (gardée en cache), ou rien
    try {
        $p = [string]$path
        if (-not $p -or -not (Test-Path -LiteralPath $p)) { return $null }
        if ($p -match '\.(ico|png)$') { return $p }
        $f = Join-Path $icoDir (($p.ToLower().GetHashCode()).ToString('x8') + '.png')
        if (Test-Path -LiteralPath $f) { return $f }
        $src = $p
        if ($p -match '\.lnk$') {
            if (-not $script:wsh) { $script:wsh = New-Object -ComObject WScript.Shell }
            $lk = $script:wsh.CreateShortcut($p)
            $ic = ([string]$lk.IconLocation -replace ',\s*-?\d+$', '').Trim()
            $ic = [Environment]::ExpandEnvironmentVariables($ic)
            if ($ic -match '\.ico$' -and (Test-Path -LiteralPath $ic)) { return $ic }
            if ($ic -match '\.exe$' -and (Test-Path -LiteralPath $ic)) { $src = $ic }
            elseif ($lk.TargetPath -and (Test-Path -LiteralPath $lk.TargetPath)) { $src = [string]$lk.TargetPath }
        }
        $i = [System.Drawing.Icon]::ExtractAssociatedIcon($src)
        $b = $i.ToBitmap(); $b.Save($f, [System.Drawing.Imaging.ImageFormat]::Png); $b.Dispose(); $i.Dispose()
        return $f
    } catch { return $null }
}
function Load-AppList {
    $links = Get-StartLinks
    $seen = @{}; $list = @()
    $roots = 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall', 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall'
    foreach ($root in $roots) {
        foreach ($k in @(Get-ChildItem -LiteralPath $root -ErrorAction SilentlyContinue)) {
            try {
                $name = [string]$k.GetValue('DisplayName'); $un = [string]$k.GetValue('UninstallString')
                if (-not $name -or -not $un) { continue }
                if ($k.GetValue('SystemComponent') -eq 1 -or $k.GetValue('ParentKeyName') -or $k.GetValue('ReleaseType')) { continue }
                if ($seen.ContainsKey($name)) { continue }
                $seen[$name] = 1
                $kb = 0; try { $kb = [double]$k.GetValue('EstimatedSize') } catch {}
                $size = '-'; if ($kb -ge 1048576) { $size = ([math]::Round($kb / 1048576, 1)).ToString([cultureinfo]'fr-FR') + " Go" } elseif ($kb -gt 0) { $size = "" + [math]::Max(1, [math]::Round($kb / 1024)) + " Mo" }
                $date = ''; $d = [string]$k.GetValue('InstallDate')
                if ($d -match '^(\d{4})(\d{2})(\d{2})$' -and [int]$Matches[2] -ge 1 -and [int]$Matches[2] -le 12 -and [int]$Matches[3] -ge 1 -and [int]$Matches[3] -le 31) { $date = $Matches[3] + '/' + $Matches[2] + '/' + $Matches[1] }
                $run = ''; $ln = $name.ToLower()
                if ($links.ContainsKey($ln)) { $run = $links[$ln] }
                else { if ($ln.Length -ge 4 -and $ln -notmatch 'runtime|webview|redistributable|driver|pilote|sdk|helper|service|update|chipset') { foreach ($lk in $links.Keys) { if ($lk.Length -ge 4 -and (($ln.StartsWith($lk + ' ')) -or ($lk.StartsWith($ln + ' ')))) { $run = $links[$lk]; break } } } }
                if (-not $run) {
                    $ic = (([string]$k.GetValue('DisplayIcon')) -replace ',\s*-?\d+$', '').Trim('"')
                    if ($ic -match '\.exe$' -and $ic -notmatch 'unins|uninst|setup|install|msiexec' -and (Test-Path -LiteralPath $ic)) { $run = $ic }
                }
                $icoSrc = $run
                if (-not $icoSrc) { $icoSrc = (([string]$k.GetValue('DisplayIcon')) -replace ',\s*-?\d+$', '').Trim('"') }
                $list += [pscustomobject]@{ Ico = (Get-IcoPng $icoSrc); Run = $run; RegKey = [string]$k.Name; Quiet = [string]$k.GetValue('QuietUninstallString'); Loc = [string]$k.GetValue('InstallLocation'); Name = $name; Version = [string]$k.GetValue('DisplayVersion'); Publisher = [string]$k.GetValue('Publisher'); Kb = $kb; Size = $size; Date = $date; Cmd = $un }
            } catch {}
        }
    }
    $script:apps = $list
    $tot = ($list | Measure-Object Kb -Sum).Sum
    (UI 'AppsInfo').Text = "" + $list.Count + " applications, environ " + ([math]::Round($tot / 1048576, 1)).ToString([cultureinfo]'fr-FR') + " Go au total (les applis du Microsoft Store et les jeux installés par un lanceur ne sont pas tous comptés)."
    Show-Apps
}
(UI 'AppSearch').Add_TextChanged({ if ($script:apps) { Show-Apps } })
(UI 'AppRefresh').Add_Click({ Load-AppList; (UI 'AppsMsg').Text = 'Liste actualisée.' })
(UI 'AppStore').Add_Click({ Open-Settings 'ms-settings:appsfeatures' })
(UI 'AppSort').Add_Click({
    $script:appsBySize = -not $script:appsBySize
    if ($script:appsBySize) { (UI 'AppSort').Content = 'Trier par nom' } else { (UI 'AppSort').Content = 'Trier par taille' }
    Show-Apps
})
(UI 'AppList').AddHandler([System.Windows.Controls.Primitives.ButtonBase]::ClickEvent, [System.Windows.RoutedEventHandler] {
    param($sender, $e)
    $it = $e.OriginalSource.DataContext
    if (-not $it -or -not $it.Cmd) { return }
    if ($e.OriginalSource -is [System.Windows.Controls.CheckBox]) {
        $key = [string]$it.RegKey
        if ($e.OriginalSource.IsChecked) { $script:appSel[$key] = $it } else { $script:appSel.Remove($key) }
        Update-AppSel; return
    }
    if ($script:batch) { (UI 'AppsMsg').Text = "Une désinstallation groupée est en cours : attends qu'elle finisse."; return }
    if ($script:unBusy -and [string]$e.OriginalSource.Content -ne 'Lancer') { (UI 'AppsMsg').Text = "Une désinstallation est déjà en cours : attends qu'elle finisse avant d'en lancer une autre."; return }
    if ([string]$e.OriginalSource.Content -eq 'Lancer') {
        if (-not $it.Run) { (UI 'AppsMsg').Text = "Je n'ai pas trouvé comment lancer « " + $it.Name + " » : cherche-la dans le menu Démarrer."; return }
        try { Start-Process -FilePath $it.Run; (UI 'AppsMsg').Text = "Lancement de « " + $it.Name + " »..." }
        catch { (UI 'AppsMsg').Text = "Impossible de lancer « " + $it.Name + " »." }
        return
    }
    $u = [string]$it.Cmd; $auto = $false
    if ($u -match 'steam://uninstall/(\d+)') { Remove-SteamGame $it $Matches[1]; return }
    if ($u -match 'msiexec') {
        $g = [regex]::Match($u, '\{[0-9A-Fa-f\-]{36}\}').Value
        if ($g) { $u = "msiexec.exe /x $g /passive /norestart"; $auto = $true } else { $u = $u -replace '/I\s*\{', '/X{' }
    } elseif ($it.Quiet) { $u = [string]$it.Quiet; $auto = $true }
    $how = "Son programme de désinstallation va s'ouvrir : suis ses étapes."
    if ($auto) { $how = "La désinstallation se fait toute seule, sans questions." }
    if (-not (Ask ("Désinstaller « " + $it.Name + " » ?`r`n$how"))) { return }
    $script:unApp = $it; $script:unBusy = $true
    (UI 'AppsMsg').Text = "Désinstallation de « " + $it.Name + " » en cours..."
    Start-Bg $uninstCode $u {
        param($r)
        $it = $script:unApp; $script:unBusy = $false
        Load-AppList
        if ($script:apps | Where-Object { $_.Name -eq $it.Name }) {
            (UI 'AppsMsg').Text = "« " + $it.Name + " » est encore dans la liste : la désinstallation a été annulée, ou elle n'a pas fini. Clique sur Actualiser dans un instant."
            return
        }
        Log ("Application désinstallée : " + $it.Name)
        (UI 'AppsMsg').Text = "« " + $it.Name + " » est désinstallée."
        $loc = ([string]$it.Loc).Trim().Trim('"').TrimEnd('\')
        if ($loc -and (Test-Path -LiteralPath $loc) -and (Test-LeftoverSafe $loc) -and -not (Test-LocShared $loc)) {
            $sz = 0; try { Get-ChildItem -LiteralPath $loc -Recurse -Force -File -ErrorAction SilentlyContinue | ForEach-Object { $sz += $_.Length } } catch {}
            if (Ask ("« " + $it.Name + " » a laissé son dossier derrière elle :`r`n$loc`r`n(" + (Mo $sz) + ")`r`n`r`nLe supprimer aussi ?")) {
                $ok = $false
                try { [System.IO.Directory]::Delete($loc, $true); $ok = $true }
                catch { $ok = (Run-Console ("[System.IO.Directory]::Delete('" + $loc.Replace("'", "''") + "', `$true)") -HiddenWait) -and -not (Test-Path -LiteralPath $loc) }
                if ($ok) { Log ("Dossier restant supprimé : " + $loc); (UI 'AppsMsg').Text = "« " + $it.Name + " » est désinstallée et son dossier est supprimé." }
                else { (UI 'AppsMsg').Text = "« " + $it.Name + " » est désinstallée, mais son dossier n'a pas pu être supprimé." }
            }
        }
    }
})

# ---------- Applications : désinstaller plusieurs applis d'un coup ----------
$script:batch = $null; $script:unBusy = $false
function Step-Batch {
    try { Step-BatchCore } catch { $script:batch = $null; try { Load-AppList } catch {}; (UI 'AppsMsg').Text = "La désinstallation groupée s'est arrêtée sur une erreur : " + $_.Exception.Message }
}
function Step-BatchCore {
    $b = $script:batch
    if ($b.Queue.Count -eq 0) {
        $script:batch = $null
        Load-AppList
        $left = @($b.All | Where-Object { $n = $_.Name; $script:apps | Where-Object { $_.Name -eq $n } })
        $gone = $b.All.Count - $left.Count
        foreach ($x in $b.All) { if ($left -notcontains $x) { Log ("Application désinstallée : " + $x.Name) } }
        $msg = "$gone application(s) désinstallée(s) sur " + $b.All.Count + "."
        if ($left.Count) { $msg += " Encore présentes (annulées ou pas finies) : " + (($left | ForEach-Object { $_.Name }) -join ', ') + "." }
        (UI 'AppsMsg').Text = $msg
        return
    }
    $it = $b.Queue[0]; $b.Queue.RemoveAt(0); $b.Cur = $it
    $pos = $b.All.Count - $b.Queue.Count
    (UI 'AppsMsg').Text = "Désinstallation $pos sur " + $b.All.Count + " : « " + $it.Name + " »..."
    if ([string]$it.Cmd -match 'steam://uninstall/(\d+)') {
        $g = Find-SteamGame $Matches[1]
        $running = $false
        if ($g) { $pre = $g.Dir.TrimEnd('\') + '\'; $running = [bool](Get-Process | Where-Object { try { $_.Path -and $_.Path.StartsWith($pre, [StringComparison]::OrdinalIgnoreCase) } catch { $false } }) }
        if (-not $g -or $running) { Step-Batch; return }
        Start-Bg $steamDelCode $g {
            param($r)
            $it = $script:batch.Cur
            if ($r.Count -gt 0 -and $r[0] -eq 'OK') {
                $key = 'Registry::' + [string]$it.RegKey
                if ($it.RegKey -and (Test-Path -LiteralPath $key)) { try { Remove-Item -LiteralPath $key -Recurse -Force -ErrorAction Stop } catch { [void](Run-Console ("Remove-Item -LiteralPath '" + $key.Replace("'", "''") + "' -Recurse -Force") -HiddenWait) } }
            }
            Step-Batch
        }
        return
    }
    Start-Bg $uninstCode (Get-UninstCmd $it).U { param($r) Step-Batch }
}
(UI 'AppUnSel').Add_Click({
    $sel = @($script:appSel.Values | Sort-Object Name)
    if ($sel.Count -eq 0 -or $script:batch) { return }
    if ($script:unBusy) { (UI 'AppsMsg').Text = "Une désinstallation est déjà en cours : attends qu'elle finisse."; return }
    $lines = @($sel | ForEach-Object {
        $how = 'ouvre son propre désinstalleur'
        if ([string]$_.Cmd -match 'steam://uninstall/') { $how = 'jeu Steam, dossier supprimé directement' } elseif ((Get-UninstCmd $_).Auto) { $how = 'automatique' }
        " - " + $_.Name + "  (" + $how + ")"
    })
    $shown = $lines; if ($lines.Count -gt 14) { $shown = @($lines[0..12]) + (" ... et " + ($lines.Count - 13) + " autres") }
    if (-not (Ask ("Désinstaller ces " + $sel.Count + " applications, l'une après l'autre ?`r`n`r`n" + ($shown -join "`r`n") + "`r`n`r`nCelles marquées « ouvre son propre désinstalleur » te demanderont de cliquer dans leur fenêtre."))) { return }
    $q = New-Object System.Collections.ArrayList; foreach ($x in $sel) { [void]$q.Add($x) }
    $script:batch = @{ Queue = $q; All = $sel; Cur = $null }
    (UI 'AppUnSel').IsEnabled = $false
    Step-Batch
})

# ---------- Conseils d'upgrade : uniquement à partir de ce qui est mesuré sur ce PC ----------
$upgCode = {
    param($a)
    function NewRow($n, $d, $l) { [pscustomobject]@{ Name = $n; Detail = $d; Level = $l } }
    # --- disque système ---
    try {
        $sys = ([string]$env:SystemDrive).TrimEnd(':')
        $num = (Get-Partition -DriveLetter $sys -ErrorAction Stop | Select-Object -First 1).DiskNumber
        $pd = Get-PhysicalDisk -ErrorAction Stop | Where-Object { [string]$_.DeviceId -eq [string]$num } | Select-Object -First 1
        if ($pd) {
            $mt = [string]$pd.MediaType; $bus = [string]$pd.BusType
            if ($mt -eq 'HDD') { NewRow 'Disque de Windows' ("Windows est installé sur un disque dur mécanique (" + $pd.FriendlyName + "). Le remplacer par un SSD est le changement qui se sent le plus : démarrage, chargements, tout.") 2 }
            elseif ($mt -eq 'SSD' -and $bus -eq 'NVMe') { NewRow 'Disque de Windows' ("SSD NVMe (" + $pd.FriendlyName + ") : c'est le type le plus rapide, rien à changer.") 0 }
            elseif ($mt -eq 'SSD') { NewRow 'Disque de Windows' ("SSD " + $bus + " (" + $pd.FriendlyName + ") : largement suffisant. Passer en NVMe ne change presque rien en jeu.") 0 }
            else { NewRow 'Disque de Windows' ("Type de disque non reconnu par Windows (" + $pd.FriendlyName + ") : pas de conseil possible.") 0 }
        }
        $v = Get-CimInstance Win32_LogicalDisk -Filter ("DeviceID='" + $sys + ":'")
        if ($v.Size) {
            $freePct = [math]::Round($v.FreeSpace * 100 / $v.Size)
            if ($freePct -lt 10) { NewRow 'Place sur le disque' ("Il ne reste que $freePct % de libre sur " + $sys + ": (" + [math]::Round($v.FreeSpace / 1GB) + " Go). Fais du ménage, ou ajoute un deuxième disque pour les jeux.") 2 }
            elseif ($freePct -lt 20) { NewRow 'Place sur le disque' ("Il reste $freePct % de libre sur " + $sys + ": . Ça passe, mais un deuxième disque pour les jeux serait confortable.") 1 }
        }
    } catch { NewRow 'Disque de Windows' "Windows n'a pas donné le type du disque : pas de conseil possible." 0 }
    # --- mémoire ---
    try {
        $mods = @(Get-CimInstance Win32_PhysicalMemory)
        $tot = 0; foreach ($x in $mods) { $tot += [double]$x.Capacity }
        $go = [math]::Round($tot / 1GB)
        $slots = 0; try { foreach ($ar in @(Get-CimInstance Win32_PhysicalMemoryArray)) { $slots += [int]$ar.MemoryDevices } } catch {}
        $free = ''; if ($slots -gt $mods.Count) { $free = ' Il reste ' + ($slots - $mods.Count) + ' emplacement(s) libre(s) sur la carte mère.' }
        $peak = ''; if ($a.RamPeak -gt 0) { $peak = " Pic mesuré depuis l'ouverture de OnePC : " + $a.RamPeak + ' %.' }
        if ($go -lt 12) { NewRow 'Mémoire (RAM)' ("$go Go : c'est juste pour jouer aujourd'hui, la plupart des jeux récents demandent 16 Go." + $peak + $free) 2 }
        elseif ($go -lt 24 -and $a.RamPeak -ge 88) { NewRow 'Mémoire (RAM)' ("$go Go, et elle s'est remplie à " + $a.RamPeak + " % : en ajouter serait utile, surtout si tu joues avec Discord, un navigateur ou OBS ouverts." + $free) 1 }
        else { NewRow 'Mémoire (RAM)' ("$go Go : suffisant." + $peak) 0 }
        if ($mods.Count -eq 1 -and $go -ge 8) { NewRow 'Barrettes de RAM' ("Une seule barrette de $go Go : la mémoire tourne en simple canal. Ajouter une barrette identique active le double canal et donne des FPS plus réguliers, surtout avec un processeur AMD ou une puce graphique intégrée." + $free) 1 }
        $slow = @($mods | Where-Object { [int]$_.Speed -gt 0 -and [int]$_.ConfiguredClockSpeed -gt 0 -and ([int]$_.Speed - [int]$_.ConfiguredClockSpeed) -ge 200 })
        if ($slow.Count) { NewRow 'Vitesse de la RAM' ("Tes barrettes sont données pour " + $slow[0].Speed + " MHz mais tournent à " + $slow[0].ConfiguredClockSpeed + " MHz. Active le profil XMP / EXPO / DOCP dans le BIOS : c'est gratuit.") 1 }
    } catch {}
    # --- carte graphique / processeur : seulement à partir de l'utilisation mesurée ---
    if ($a.GameMin -ge 5) {
        $base = "Mesuré sur " + $a.GameMin + " min de jeu pendant cette session : carte graphique à " + $a.GpuAvg + " % en moyenne, processeur à " + $a.CpuAvg + " %."
        if ($a.GpuAvg -ge 93) { NewRow 'Carte graphique' ($base + " Elle tourne à fond : c'est elle qui fixe tes FPS. Si tu veux plus de FPS, c'est elle qu'il faut changer ; changer le processeur n'apporterait presque rien.") 1 }
        elseif ($a.GpuAvg -lt 80) { NewRow 'Processeur / limite de FPS' ($base + " La carte graphique n'est pas utilisée à fond : quelque chose la freine. Si tu as une limite de FPS ou la V-Sync, c'est normal. Sinon c'est le processeur qui limite, et c'est lui qu'il faudrait changer en premier.") 1 }
        else { NewRow 'Carte graphique et processeur' ($base + " Les deux sont bien équilibrés pour ce jeu.") 0 }
    } else {
        NewRow 'Carte graphique et processeur' "Pas encore assez de mesures. Joue au moins 5 minutes avec OnePC ouverte (réduite, ça marche), puis reclique ici : l'appli te dira lequel des deux limite tes FPS." 0
    }
    # --- températures ---
    if ($a.CpuT -ge 90) { NewRow 'Refroidissement du processeur' ("" + $a.CpuT + " °C en ce moment : c'est trop. Dépoussière, vérifie le ventilateur, et pense à changer la pâte thermique ou le ventirad avant tout autre achat.") 2 }
    if ($a.GpuT -ge 88) { NewRow 'Refroidissement de la carte graphique' ("" + $a.GpuT + " °C en ce moment : c'est chaud. Dépoussière le boîtier et vérifie que l'air circule avant tout autre achat.") 2 }
}
(UI 'BtnUpg').Add_Click({
    (UI 'BtnUpg').IsEnabled = $false
    (UI 'ScanSummary').Text = 'Analyse de ton matériel en cours...'
    $n = 0; $sg = 0.0; $sc = 0.0
