(UI 'BackGo').Add_Click({
    $src = [string]$cfg.BackSrc; $dst = [string]$cfg.BackDst
    if (-not $src -or -not $dst -or -not (Test-Path -LiteralPath $src) -or -not (Test-Path -LiteralPath $dst)) { (UI 'BackInfo').Text = "Choisis d'abord un dossier et une destination qui existent (clé branchée ?)."; return }
    if ($src.TrimEnd('\') -match '^[A-Za-z]:$') { (UI 'BackInfo').Text = "Choisis un dossier précis à sauvegarder, pas un disque entier."; return }
    if (Test-Under $dst $src) { (UI 'BackInfo').Text = "La destination ne peut pas être à l'intérieur du dossier à sauvegarder."; return }
    $target = Join-Path $dst (Split-Path -Leaf $src.TrimEnd('\'))
