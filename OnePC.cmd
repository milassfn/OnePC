    try {
        $all = @(Get-PnpDevice -PresentOnly -ErrorAction Stop)
        foreach ($d in @($all | Where-Object { $_.Class -eq 'Mouse' -and $_.Status -eq 'OK' })) {
            $iid = [string]$d.InstanceId; $vid = ''; $pid2 = ''; $bt = $false
            if ($iid -match '(?i)VID_([0-9A-F]{4})&PID_([0-9A-F]{4})') { $vid = $Matches[1].ToUpper(); $pid2 = $Matches[2].ToUpper() }
            elseif ($iid -match '(?i)VID&\w*?([0-9A-F]{4})_PID&([0-9A-F]{4})') { $vid = $Matches[1].ToUpper(); $pid2 = $Matches[2].ToUpper(); $bt = $true }
            $desc = ''
            if ($vid -and -not $bt) {
                $usb = $all | Where-Object { [string]$_.InstanceId -match ('(?i)^USB\\VID_' + $vid + '&PID_' + $pid2 + '\\') } | Select-Object -First 1
                if ($usb) { try { $desc = [string](Get-PnpDeviceProperty -InstanceId $usb.InstanceId -KeyName 'DEVPKEY_Device_BusReportedDeviceDesc' -ErrorAction Stop).Data } catch {} }
            }
            $fn = [string]$d.FriendlyName
            $txt = $desc + ' ' + $fn
            $score = 0
            if ($txt -match $kbRx) { $score -= 6 }
            if ($txt -match $mouseRx) { $score += 5 }
            if ($txt -match $wlRx) { $score += 2 }
            if ($vid -and $vendors.ContainsKey($vid)) { $score += 1 } elseif (-not $vid) { $score -= 2 }
            if ($score -gt $bestScore) { $bestScore = $score; $best = [pscustomobject]@{ Vid = $vid; Desc = $desc; Wireless = ($bt -or $txt -match $wlRx); Bt = $bt } }
        }
    } catch {}
    $r = [pscustomobject]@{ Name = ''; Brand = ''; Soft = ''; Color = '#38BDF8'; Conn = '' }
    if (-not $best) { $r.Name = 'Aucune souris trouvée'; return $r }
    if ($best.Vid -and $vendors.ContainsKey($best.Vid)) { $v = $vendors[$best.Vid]; $r.Brand = $v[0]; $r.Soft = $v[1]; $r.Color = $v[2] }
    $n = $best.Desc
    if (-not $n -or $n -match $wlRx -or $n -match '(?i)^(usb|hid|usb input device|composite|gaming mouse)$|HID|USB Input|Composite') { $n = '' }
    if ($n -and $r.Brand -and $n -notmatch [regex]::Escape($r.Brand)) { $n = $r.Brand + ' ' + $n }
    if (-not $n) { if ($r.Brand) { $n = 'Souris ' + $r.Brand } else { $n = 'Souris connectée' } }
    $r.Name = $n
    if ($best.Bt) { $r.Conn = 'Sans fil (Bluetooth)  ·  pour jouer, préfère le récepteur USB ou le câble' }
    elseif ($best.Wireless) { $r.Conn = 'Sans fil (récepteur USB)' }
    else { $r.Conn = 'Filaire (USB)' }
    $r
}
function Get-LogiName {
    # lecture seule, protocole HID++ de Logitech ; jamais plus de 6 secondes
    $res = [pscustomobject]@{ Name = ''; Diag = '' }
    try {
            if (-not ('PCM.LogiHid' -as [type])) {
                Add-Type -TypeDefinition @"
using System;
using System.Text;
using System.Threading;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using Microsoft.Win32.SafeHandles;
namespace PCM {
public static class LogiHid {
    [StructLayout(LayoutKind.Sequential)] struct IfData { public int cbSize; public Guid g; public int flags; public IntPtr r; }
    [StructLayout(LayoutKind.Sequential)] struct Caps { public ushort Usage, UsagePage, InLen, OutLen, FeatLen; [MarshalAs(UnmanagedType.ByValArray, SizeConst = 17)] public ushort[] Res; public ushort n1, n2, n3, n4, n5, n6, n7, n8, n9, n10; }
    [StructLayout(LayoutKind.Sequential)] struct Ovl { public IntPtr Internal, InternalHigh; public int Offset, OffsetHigh; public IntPtr hEvent; }
    [DllImport("hid.dll")] static extern void HidD_GetHidGuid(out Guid g);
    [DllImport("hid.dll")] static extern bool HidD_GetPreparsedData(SafeFileHandle h, out IntPtr p);
    [DllImport("hid.dll")] static extern bool HidD_FreePreparsedData(IntPtr p);
    [DllImport("hid.dll")] static extern int HidP_GetCaps(IntPtr p, ref Caps c);
    [DllImport("setupapi.dll", CharSet = CharSet.Unicode)] static extern IntPtr SetupDiGetClassDevs(ref Guid g, IntPtr e, IntPtr h, int f);
    [DllImport("setupapi.dll")] static extern bool SetupDiEnumDeviceInterfaces(IntPtr s, IntPtr d, ref Guid g, int i, ref IfData da);
    [DllImport("setupapi.dll", CharSet = CharSet.Unicode)] static extern bool SetupDiGetDeviceInterfaceDetail(IntPtr s, ref IfData da, IntPtr det, int size, out int req, IntPtr di);
    [DllImport("setupapi.dll")] static extern bool SetupDiDestroyDeviceInfoList(IntPtr s);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern SafeFileHandle CreateFile(string n, uint a, uint s, IntPtr sa, uint c, uint f, IntPtr t);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool WriteFile(SafeFileHandle h, IntPtr buf, int n, IntPtr done, IntPtr ovl);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool ReadFile(SafeFileHandle h, IntPtr buf, int n, IntPtr done, IntPtr ovl);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool GetOverlappedResult(SafeFileHandle h, IntPtr ovl, out int n, bool wait);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode)] static extern IntPtr CreateEvent(IntPtr a, bool manual, bool init, string name);
    [DllImport("kernel32.dll")] static extern uint WaitForSingleObject(IntPtr h, uint ms);
    [DllImport("kernel32.dll")] static extern bool CancelIo(SafeFileHandle h);
    [DllImport("kernel32.dll")] static extern bool CloseHandle(IntPtr h);
    [DllImport("kernel32.dll")] static extern bool ResetEvent(IntPtr h);
    public static StringBuilder Diag = new StringBuilder();
    static List<string> Paths() {
        List<string> l = new List<string>(); Guid g; HidD_GetHidGuid(out g);
        IntPtr s = SetupDiGetClassDevs(ref g, IntPtr.Zero, IntPtr.Zero, 0x12);
        if (s == IntPtr.Zero || s == new IntPtr(-1)) return l;
        for (int i = 0; i < 256; i++) {
            IfData d = new IfData(); d.cbSize = Marshal.SizeOf(d);
            if (!SetupDiEnumDeviceInterfaces(s, IntPtr.Zero, ref g, i, ref d)) break;
            int req; SetupDiGetDeviceInterfaceDetail(s, ref d, IntPtr.Zero, 0, out req, IntPtr.Zero);
            if (req <= 0) continue;
            IntPtr buf = Marshal.AllocHGlobal(req);
            try { Marshal.WriteInt32(buf, IntPtr.Size == 8 ? 8 : 6); if (SetupDiGetDeviceInterfaceDetail(s, ref d, buf, req, out req, IntPtr.Zero)) l.Add(Marshal.PtrToStringUni(new IntPtr(buf.ToInt64() + 4))); }
            finally { Marshal.FreeHGlobal(buf); }
        }
        SetupDiDestroyDeviceInfoList(s); return l;
    }
    // échanges HID avec un délai à chaque étape : rien ne peut rester bloqué
    class Dev : IDisposable {
        SafeFileHandle h; int inLen, outLen; IntPtr evt, ovl, buf;
        public int Writes, Reads;
        public Dev(SafeFileHandle handle, int il, int ol) {
            h = handle; inLen = il; outLen = ol;
            evt = CreateEvent(IntPtr.Zero, true, false, null);
            ovl = Marshal.AllocHGlobal(Marshal.SizeOf(typeof(Ovl)));
            buf = Marshal.AllocHGlobal(Math.Max(il, ol) + 8);
        }
        bool Io(bool write, int len, int ms, out int n) {
            n = 0;
            Ovl o = new Ovl(); o.hEvent = evt; ResetEvent(evt); Marshal.StructureToPtr(o, ovl, false);
            bool ok = write ? WriteFile(h, buf, len, IntPtr.Zero, ovl) : ReadFile(h, buf, len, IntPtr.Zero, ovl);
            if (!ok) {
                int err = Marshal.GetLastWin32Error();
                if (err != 997) { Diag.AppendLine((write ? "  écriture" : "  lecture") + " refusée (" + err + ")"); return false; }
                if (WaitForSingleObject(evt, (uint)ms) != 0) { CancelIo(h); int x; GetOverlappedResult(h, ovl, out x, true); return false; }
            }
            return GetOverlappedResult(h, ovl, out n, false);
        }
        public bool Send(byte[] data) {
            for (int i = 0; i < outLen; i++) Marshal.WriteByte(buf, i, i < data.Length ? data[i] : (byte)0);
            int n; bool ok = Io(true, outLen, 300, out n); if (ok) Writes++; return ok;
        }
        public byte[] Recv(int ms) {
            int n; if (!Io(false, inLen, ms, out n) || n <= 0) return null;
            Reads++; byte[] r = new byte[n]; Marshal.Copy(buf, r, 0, n); return r;
        }
        public void Dispose() { try { CancelIo(h); } catch { } Marshal.FreeHGlobal(ovl); Marshal.FreeHGlobal(buf); CloseHandle(evt); h.Dispose(); }
    }
    static byte[] Req(Dev d, byte dev, byte feat, byte fn, byte[] args) {
        byte[] o = new byte[20]; o[0] = 0x11; o[1] = dev; o[2] = feat; o[3] = (byte)((fn << 4) | 0x0A);
        if (args != null) Array.Copy(args, 0, o, 4, Math.Min(args.Length, 16));
        if (!d.Send(o)) return null;
        DateTime end = DateTime.UtcNow.AddMilliseconds(400);
        while (DateTime.UtcNow < end) {
            byte[] r = d.Recv(Math.Max(1, (int)(end - DateTime.UtcNow).TotalMilliseconds));
            if (r == null) return null;
            if (r.Length < 5 || r[1] != dev) continue;
            if (r[2] == 0xFF && r[3] == feat) return null;
            if (r[0] == 0x10 && r[2] == 0x8F) return null;
            if (r[0] == 0x11 && r[2] == feat && r[3] == o[3]) return r;
        }
        return null;
    }
    static string Name(Dev d, byte dev) {
        byte[] r = Req(d, dev, 0x00, 0, new byte[] { 0x00, 0x05 });
        if (r == null || r[4] == 0) return null;
        byte fi = r[4];
        r = Req(d, dev, fi, 2, null);
        if (r != null && r[4] != 3 && r[4] != 4 && r[4] != 5) { Diag.AppendLine("  index " + dev + " : pas une souris (type " + r[4] + ")"); return null; }
        r = Req(d, dev, fi, 0, null);
        if (r == null) return null;
        int cnt = r[4]; if (cnt <= 0 || cnt > 64) return null;
        StringBuilder sb = new StringBuilder(); int guard = 0;
        while (sb.Length < cnt && guard++ < 8) {
            r = Req(d, dev, fi, 1, new byte[] { (byte)sb.Length });
            if (r == null) break;
            bool stop = false;
            for (int k = 4; k < 20 && sb.Length < cnt; k++) { if (r[k] == 0) { stop = true; break; } sb.Append((char)r[k]); }
            if (stop) break;
        }
        return sb.ToString().Trim();
    }
    public static string GetNameTimeout(int ms) {
        string res = "";
        Thread th = new Thread(delegate () { try { res = GetName(); } catch (Exception e) { Diag.AppendLine("erreur: " + e.Message); } });
        th.IsBackground = true; th.Start();
        if (th.Join(ms)) return res;
        Diag.AppendLine("délai dépassé (" + ms + " ms)");
        return "";
    }
    public static string GetName() {
        DateTime limit = DateTime.UtcNow.AddSeconds(5);
        foreach (string p in Paths()) {
            if (DateTime.UtcNow > limit) break;
            if (p.IndexOf("vid_046d", StringComparison.OrdinalIgnoreCase) < 0) continue;
            SafeFileHandle h = CreateFile(p, 0xC0000000, 3, IntPtr.Zero, 3, 0x40000000, IntPtr.Zero);
            if (h.IsInvalid) { Diag.AppendLine("ouverture refusée (" + Marshal.GetLastWin32Error() + ")"); h.Dispose(); continue; }
            IntPtr pp; Caps c = new Caps();
            if (!HidD_GetPreparsedData(h, out pp)) { h.Dispose(); continue; }
            HidP_GetCaps(pp, ref c); HidD_FreePreparsedData(pp);
            Diag.AppendLine("HID page=" + c.UsagePage.ToString("X4") + " out=" + c.OutLen + " in=" + c.InLen);
            if ((c.UsagePage & 0xFF00) != 0xFF00 || c.OutLen != 20 || c.InLen < 20) { h.Dispose(); continue; }
            using (Dev d = new Dev(h, c.InLen, c.OutLen)) {
                foreach (byte di in new byte[] { 0xFF, 1, 2, 3, 4, 5, 6 }) {
                    if (DateTime.UtcNow > limit) break;
                    string n = Name(d, di);
                    Diag.AppendLine("  index " + di + " -> " + (n ?? "pas de réponse") + "  (envois " + d.Writes + ", réponses " + d.Reads + ")");
                    if (!string.IsNullOrEmpty(n)) return n;
                }
            }
        }
        return "";
    }
}
}
"@
            }
            $res.Name = [string][PCM.LogiHid]::GetNameTimeout(6000)
            $res.Diag = [PCM.LogiHid]::Diag.ToString()
    } catch { $res.Diag = 'erreur : ' + $_.Exception.Message }
    $res
}
function Show-MouseSpeed($s) {
    (UI 'MouseSpeedVal').Text = [string]$s
    if ($s -eq 10) { (UI 'MouseSpeedTip').Text = "10 = neutre : ta souris bouge exactement selon son DPI. C'est le réglage conseillé pour jouer." }
    elseif ($s -lt 10) { (UI 'MouseSpeedTip').Text = "Plus lent que neutre : Windows freine ta souris. Pour jouer, mets plutôt 10 et baisse le DPI dans le logiciel de ta souris." }
    else { (UI 'MouseSpeedTip').Text = "Plus rapide que neutre : Windows saute des pixels, la visée est moins précise. Pour jouer, mets plutôt 10 et monte le DPI." }
}
function Refresh-MouseSettings {
    try {
        Init-MouseApi
        Show-MouseSpeed ([PCM.Mouse]::GetSpeed())
        if ([PCM.Mouse]::GetAccel()) { (UI 'MouseAccelVal').Text = 'Activée'; (UI 'MouseAccelVal').Foreground = $brush.ConvertFromString('#FBBF24'); (UI 'MouseAccel').Content = 'Désactiver' }
        else { (UI 'MouseAccelVal').Text = 'Désactivée ✓'; (UI 'MouseAccelVal').Foreground = $brush.ConvertFromString('#34D399'); (UI 'MouseAccel').Content = 'Réactiver' }
    } catch { (UI 'MouseMsg').Text = "Les réglages de la souris n'ont pas pu être lus sur ce PC." }
}
$script:mouseBusy = $false
function Detect-Mouse($auto) {
    if ($script:mouseBusy) { return }
    $script:mouseBusy = $true
    Load-DevImages
    (UI 'MouseName').Text = 'Analyse de ta souris...'; (UI 'MouseConn').Text = ' '; (UI 'MouseDetect').IsEnabled = $false
    Start-Bg ${function:Get-MouseInfo} 0 {
        param($m)
        $script:mouseBusy = $false; (UI 'MouseDetect').IsEnabled = $true
        $m = @($m)[0]
        if (-not $m) { $m = [pscustomobject]@{ Name = 'Souris connectée'; Brand = ''; Soft = ''; Color = '#38BDF8'; Conn = '' } }
        (UI 'MouseName').Text = $m.Name
        (UI 'MouseConn').Text = $m.Conn
        if ($m.Brand) { (UI 'MouseBrand').Text = ([string]$m.Brand).ToUpper() } else { (UI 'MouseBrand').Text = 'SOURIS' }
        try { (UI 'MouseBrand').Foreground = $brush.ConvertFromString($m.Color) } catch {}
        Set-DevColor 'MouseGlow' 'MouseHalo' $m.Color
        Set-DevImage 'MouseImg' 'MouseGlow' 'mouse' (Mouse-Model $m.Name)
        $soft = $m.Soft; if (-not $soft) { $soft = 'le logiciel de ta souris' }
        (UI 'MouseDpiTip').Text = "Le DPI et la fréquence (Hz) sont enregistrés dans la souris : ils se changent dans " + $soft + ". Conseil pour la plupart des jeux : 800 DPI et 1000 Hz. Au-dessus de 2000 Hz, beaucoup de PC perdent des FPS."
        if ($script:devAuto) { (UI 'MouseMsg').Text = 'Souris détectée : ' + $m.Name; $script:devAuto = $false }
        if ($m.Brand -eq 'Logitech') {
            # 2e étape : le nom exact, demandé à la souris ; la page reste utilisable pendant ce temps
            $script:logiConn = [string]$m.Conn
            (UI 'MouseConn').Text = $script:logiConn + '  ·  recherche du modèle exact...'
            Start-Bg ${function:Get-LogiName} 0 {
                param($x)
                $x = @($x)[0]
                (UI 'MouseConn').Text = $script:logiConn
                try { [System.IO.File]::WriteAllText((Join-Path $appDir 'souris-diagnostic.txt'), ("OnePC " + $appVersion + "  " + (Get-Date) + "`r`n" + [string]$x.Diag)) } catch {}
                if ($x -and $x.Name) {
                    $nm = [string]$x.Name; if ($nm -notmatch '(?i)logitech') { $nm = 'Logitech ' + $nm }
                    (UI 'MouseName').Text = $nm
                    Set-DevImage 'MouseImg' 'MouseGlow' 'mouse' (Mouse-Model $nm)
                }
            }
        }
    }
}
function Update-Mouse { Refresh-MouseSettings; Detect-Mouse $false }
function Save-MouseOrig {
    if ($cfg.MouseOrig) { return }
    try { Init-MouseApi; $a = 0; if ([PCM.Mouse]::GetAccel()) { $a = 1 }; $cfg.MouseOrig = [string]([PCM.Mouse]::GetSpeed()) + ';' + $a; Save-Cfg } catch {}
}
(UI 'MouseDetect').Add_Click({ Detect-Mouse $false })
(UI 'MousePhoto').Add_Click({ Pick-UserPhoto 'MouseImg' 'MouseGlow' 'MouseMsg' 'souris' })
(UI 'MousePhotoDel').Add_Click({ Remove-UserPhoto 'MouseImg' 'MouseGlow' 'MouseMsg' })
(UI 'MouseMinus').Add_Click({ try { Init-MouseApi; Save-MouseOrig; [PCM.Mouse]::SetSpeed([PCM.Mouse]::GetSpeed() - 1); Refresh-MouseSettings } catch {} })
(UI 'MousePlus').Add_Click({ try { Init-MouseApi; Save-MouseOrig; [PCM.Mouse]::SetSpeed([PCM.Mouse]::GetSpeed() + 1); Refresh-MouseSettings } catch {} })
(UI 'MouseAccel').Add_Click({
    try { Init-MouseApi; Save-MouseOrig; $on = [PCM.Mouse]::GetAccel(); [PCM.Mouse]::SetAccel(-not $on); Refresh-MouseSettings
        if ($on) { Log 'Souris : accélération désactivée'; (UI 'MouseMsg').Text = 'Accélération désactivée.' } else { (UI 'MouseMsg').Text = 'Accélération réactivée.' } } catch {}
})
(UI 'MouseGaming').Add_Click({
    try { Init-MouseApi; Save-MouseOrig; [PCM.Mouse]::SetSpeed(10); [PCM.Mouse]::SetAccel($false); Refresh-MouseSettings
        Log 'Souris : réglage gaming (vitesse 10, accélération désactivée)'; (UI 'MouseMsg').Text = 'Réglage gaming appliqué : vitesse neutre (10) et accélération désactivée. Ça marche tout de suite, sans redémarrer.' } catch {}
})
(UI 'MouseOrig').Add_Click({
    if (-not $cfg.MouseOrig) { (UI 'MouseMsg').Text = "Rien à remettre : OnePC n'a pas encore modifié ta souris."; return }
    try { Init-MouseApi; $p = ([string]$cfg.MouseOrig).Split(';'); [PCM.Mouse]::SetSpeed([int]$p[0]); [PCM.Mouse]::SetAccel($p[1] -eq '1'); $cfg.MouseOrig = ''; Save-Cfg; Refresh-MouseSettings
        Log 'Souris : réglages remis comme avant'; (UI 'MouseMsg').Text = 'Réglages de la souris remis comme avant.' } catch {}
})
# ---------- Manette : reconnaissance ----------
function Get-PadInfo {
    $vendors = @{
        '045E' = @('Xbox', '#22C55E'); '054C' = @('PlayStation', '#3B82F6'); '057E' = @('Nintendo', '#EF4444'); '2DC8' = @('8BitDo', '#F59E0B')
        '0E6F' = @('PDP', '#A78BFA'); '24C6' = @('PowerA', '#A78BFA'); '20D6' = @('PowerA', '#A78BFA'); '0F0D' = @('HORI', '#EF4444'); '1532' = @('Razer', '#44D62C')
        '044F' = @('Thrustmaster', '#A78BFA'); '3537' = @('GameSir', '#F97316'); '146B' = @('Nacon', '#3B82F6'); '0738' = @('Mad Catz', '#EF4444'); '2563' = @('Manette', '#A78BFA')
    }
    $models = @{
        '054C_0CE6' = 'DualSense (PS5)'; '054C_0DF2' = 'DualSense Edge (PS5)'; '054C_05C4' = 'DualShock 4 (PS4)'; '054C_09CC' = 'DualShock 4 (PS4)'; '054C_0BA0' = 'DualShock 4 (adaptateur sans fil)'; '054C_0268' = 'DualShock 3 (PS3)'
        '045E_0B12' = 'Manette Xbox Series X|S'; '045E_0B13' = 'Manette Xbox Series X|S'; '045E_0B20' = 'Manette Xbox Series X|S'; '045E_0B21' = 'Manette Xbox Series X|S'
        '045E_0B00' = 'Manette Xbox Elite Series 2'; '045E_0B05' = 'Manette Xbox Elite Series 2'; '045E_0B22' = 'Manette Xbox Elite Series 2'; '045E_02E3' = 'Manette Xbox Elite'
        '045E_02D1' = 'Manette Xbox One'; '045E_02DD' = 'Manette Xbox One'; '045E_02EA' = 'Manette Xbox One S'; '045E_02E0' = 'Manette Xbox One S'; '045E_02FD' = 'Manette Xbox One S'
        '045E_028E' = 'Manette Xbox 360'; '045E_0719' = 'Manette Xbox 360 (sans fil)'
        '057E_2009' = 'Manette Pro Nintendo Switch'; '057E_2006' = 'Joy-Con (gauche)'; '057E_2007' = 'Joy-Con (droit)'
    }
    $tips = @{
        'Xbox' = "Manette Xbox : reconnue par Windows et tous les jeux PC. L'appli Xbox Accessories (gratuite, Microsoft Store) permet de la mettre à jour, ce qui corrige souvent les déconnexions."
        'PlayStation' = "Manette PlayStation : sur PC, lance tes jeux via Steam (Paramètres > Manette > activer PlayStation) pour qu'elle marche partout, gâchettes et vibrations comprises."
        'Nintendo' = "Manette Nintendo : sur PC, elle marche le mieux via Steam (Paramètres > Manette > activer Switch)."
    }
    $padRx = '(?i)controller|gamepad|manette|dualsense|dualshock|xbox|8bitdo|switch pro|joy-con|joystick|xinput|contr[ôo]leur de jeu'
    $notRx = '(?i)keyboard|clavier|mouse|souris|audio|headset|casque|receiver|adapter|adaptateur|bus|enumerator|game bar|ethernet|gbe|network|r[ée]seau|wi-?fi|wlan|lan |host|xhci|ehci|sata|ahci|nvme|storage|stockage|raid|pci|smbus|thunderbolt|bluetooth|realtek|intel|amd|nvidia|usb root|hub'
    $okClass = '^(HIDClass|XnaComposite|XboxComposite|XboxGipSvc|Gamepad)$'
    $best = $null; $bestScore = -999; $count = 0; $adapter = $false
    try {
        $all = @(Get-PnpDevice -PresentOnly -ErrorAction Stop | Where-Object { $_.Status -eq 'OK' })
        if ($all | Where-Object { [string]$_.InstanceId -match '(?i)VID_045E&PID_(02FE|02E6|0B1D)' }) { $adapter = $true }
        $seen = @{}
        foreach ($d in $all) {
            $iid = [string]$d.InstanceId; $fn = [string]$d.FriendlyName; $vid = ''; $pid2 = ''; $bt = $false
            if ($iid -match '(?i)VID_([0-9A-F]{4})&PID_([0-9A-F]{4})') { $vid = $Matches[1].ToUpper(); $pid2 = $Matches[2].ToUpper() }
            elseif ($iid -match '(?i)VID&\w*?([0-9A-F]{4})_PID&([0-9A-F]{4})') { $vid = $Matches[1].ToUpper(); $pid2 = $Matches[2].ToUpper(); $bt = $true }
            $key = $vid + '_' + $pid2
            $known = $models.ContainsKey($key)
            if ($d.Class -match '^(Net|SCSIAdapter|HDCController|System|DiskDrive|Bluetooth|Display|AudioEndpoint|MEDIA)$') { continue }
            if (-not $known -and ($d.Class -notmatch $okClass -or $fn -notmatch $padRx -or $fn -match $notRx)) { continue }
            if ($vid -and $seen.ContainsKey($key)) { continue }
            if ($vid) { $seen[$key] = 1 }
            $count++
            $score = 0; if ($known) { $score += 5 }; if ($vendors.ContainsKey($vid)) { $score += 2 }; if ($fn -match '(?i)xinput') { $score -= 1 }
            if ($iid -match '(?i)BTH|\{00001124|\{00001812') { $bt = $true }
            if ($score -gt $bestScore) { $bestScore = $score; $best = [pscustomobject]@{ Vid = $vid; Key = $key; Friendly = $fn; Bt = $bt; Iid = $iid } }
        }
    } catch {}
    $r = [pscustomobject]@{ Found = $false; Name = 'Aucune manette détectée'; Brand = ''; Color = '#A78BFA'; Conn = "Branche-la en USB ou allume-la : elle s'affichera ici toute seule."; Tip = ' '; More = 0; Key = '' }
    if (-not $best) { return $r }
    $r.Found = $true; $r.More = [math]::Max(0, $count - 1); $r.Key = $best.Key
    if ($vendors.ContainsKey($best.Vid)) { $r.Brand = $vendors[$best.Vid][0]; $r.Color = $vendors[$best.Vid][1] }
    if ($models.ContainsKey($best.Key)) { $r.Name = $models[$best.Key] }
    elseif ($best.Friendly -and $best.Friendly -notmatch '(?i)HID|compatible|XINPUT') { $r.Name = $best.Friendly }
    elseif ($best.Friendly -match '(?i)XINPUT') { $r.Name = 'Manette compatible Xbox' }
    else { $r.Name = 'Manette ' + $r.Brand }
    if ($r.Brand -and $r.Name -notmatch [regex]::Escape($r.Brand) -and $r.Brand -notin @('Xbox', 'PlayStation', 'Nintendo')) { $r.Name = $r.Brand + ' ' + $r.Name }
    if ($best.Bt) { $r.Conn = "Sans fil (Bluetooth)  ·  c'est ce qui ajoute le plus de lag : branche-la en USB pour jouer" }
    elseif ($adapter -and $r.Brand -eq 'Xbox' -and $best.Iid -notmatch '(?i)^USB\\|^HID\\VID') { $r.Conn = 'Sans fil (adaptateur Xbox)' }
    else { $r.Conn = 'Filaire (USB)  ·  le moins de lag possible' }
    if ($tips.ContainsKey($r.Brand)) { $r.Tip = $tips[$r.Brand] } else { $r.Tip = "Si un jeu ne la reconnaît pas, lance-le via Steam : il traduit presque toutes les manettes." }
    $r
}
