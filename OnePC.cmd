# ---------- Disques ----------
function Load-Disks {
    $health = @{ Healthy = 'Bon état'; Warning = 'À surveiller'; Unhealthy = 'Mauvais état' }
    try {
        $rows = @(Get-PhysicalDisk -ErrorAction Stop | ForEach-Object {
            $h = [string]$_.HealthStatus; if ($health.ContainsKey($h)) { $h = $health[$h] }
            $k = [string]$_.MediaType; if ($k -notmatch 'SSD|HDD') { $k = '-' }
            [pscustomobject]@{ Name = [string]$_.FriendlyName; Kind = $k; Size = "" + [math]::Round($_.Size / 1GB) + " Go"; Health = $h }
        })
        (UI 'PhysList').ItemsSource = $rows; (UI 'PhysMsg').Text = ''
    } catch { (UI 'PhysMsg').Text = "L'état de santé n'est pas disponible sur ce PC." }
    $vh = UI 'VolHost'; $vh.Children.Clear()
    foreach ($v in @(Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3" | Where-Object { $_.Size })) {
        $pct = [int][math]::Round(100 * ($v.Size - $v.FreeSpace) / $v.Size)
        $col = '#3DDC84'; if ($pct -ge 75) { $col = '#FBBF24' }; if ($pct -ge 90) { $col = '#FF5A6E' }
        $cb = $brush.ConvertFromString($col)
        $row = New-Object System.Windows.Controls.StackPanel; $row.Margin = New-Object System.Windows.Thickness 0, 0, 0, 14
        $head = New-Object System.Windows.Controls.DockPanel
        $t1 = New-Object System.Windows.Controls.TextBlock; $t1.Text = "$pct % utilisé"; $t1.Foreground = $cb; $t1.FontWeight = 'SemiBold'; $t1.Margin = New-Object System.Windows.Thickness 14, 0, 0, 0
        $t2 = New-Object System.Windows.Controls.TextBlock; $t2.Foreground = $brush.ConvertFromString('#8E8E98')
        $t2.Text = "" + [math]::Round($v.FreeSpace / 1GB) + " Go libres sur " + [math]::Round($v.Size / 1GB) + " Go"
        $t3 = New-Object System.Windows.Controls.TextBlock; $t3.Text = $v.DeviceID + "  " + $v.VolumeName
        [System.Windows.Controls.DockPanel]::SetDock($t1, 'Right'); [System.Windows.Controls.DockPanel]::SetDock($t2, 'Right')
        [void]$head.Children.Add($t1); [void]$head.Children.Add($t2); [void]$head.Children.Add($t3)
        $bar = New-Object System.Windows.Controls.Grid; $bar.Height = 10; $bar.Margin = New-Object System.Windows.Thickness 0, 7, 0, 0
        $c1 = New-Object System.Windows.Controls.ColumnDefinition; $c1.Width = New-Object System.Windows.GridLength ([double]$pct), ([System.Windows.GridUnitType]::Star)
        $c2 = New-Object System.Windows.Controls.ColumnDefinition; $c2.Width = New-Object System.Windows.GridLength ([double](100 - $pct)), ([System.Windows.GridUnitType]::Star)
        $bar.ColumnDefinitions.Add($c1); $bar.ColumnDefinitions.Add($c2)
        $track = New-Object System.Windows.Controls.Border; $track.Background = $brush.ConvertFromString('#28282E'); $track.CornerRadius = New-Object System.Windows.CornerRadius 5
        [System.Windows.Controls.Grid]::SetColumnSpan($track, 2)
        $fill = New-Object System.Windows.Controls.Border; $fill.Background = $cb; $fill.CornerRadius = New-Object System.Windows.CornerRadius 5
        [System.Windows.Controls.Grid]::SetColumn($fill, 0)
        [void]$bar.Children.Add($track); [void]$bar.Children.Add($fill)
        [void]$row.Children.Add($head); [void]$row.Children.Add($bar)
        [void]$vh.Children.Add($row)
    }
}

