    if ($files.Count -eq 0) { $e = New-Object System.Windows.Controls.TextBlock; $e.Text = 'Aucune vidéo pour l''instant.'; $e.Foreground = $brush.ConvertFromString('#8E8E98'); [void]$cl.Children.Add($e) }
