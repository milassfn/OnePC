# ---------- Infos matériel (lues une fois) ----------
$cpu   = Get-CimInstance Win32_Processor | Select-Object -First 1
$gpus  = @(Get-CimInstance Win32_VideoController)
$os    = Get-CimInstance Win32_OperatingSystem
$mb    = Get-CimInstance Win32_BaseBoard
$bios  = Get-CimInstance Win32_BIOS
$disks = @(Get-CimInstance Win32_DiskDrive)
$ramGo = [math]::Round($os.TotalVisibleMemorySize / 1MB, 1)
$gpuNames = ($gpus | ForEach-Object { $_.Name }) -join ' | '
$mainGpu = $gpus | Where-Object { $_.Name -notmatch 'Microsoft|Virtual|Remote' } | Select-Object -First 1
if (-not $mainGpu) { $mainGpu = $gpus | Select-Object -First 1 }

$classKey = 'HKLM:\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}'
$gpuReg = @(Get-ItemProperty -Path "$classKey\0*" -ErrorAction SilentlyContinue)
$vramGo = 0
foreach ($k in $gpuReg) { try { $q = [double]$k.'HardwareInformation.qwMemorySize'; if ($q / 1GB -gt $vramGo) { $vramGo = [math]::Round($q / 1GB, 1) } } catch {} }
$nvGpu  = $gpus | Where-Object { $_.Name -match 'NVIDIA' } | Select-Object -First 1
$amdGpu = $gpus | Where-Object { $_.Name -match 'AMD|Radeon' } | Select-Object -First 1
