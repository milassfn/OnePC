}

(UI 'NameCpu').Text = $cpu.Name.Trim()
(UI 'SubCpu').Text  = "" + $cpu.NumberOfCores + " coeurs / " + $cpu.NumberOfLogicalProcessors + " threads"
(UI 'NameGpu').Text = [string]$mainGpu.Name
(UI 'SubGpu').Text  = "Pilote " + $mainGpu.DriverVersion
(UI 'NameRam').Text = "$ramGo Go installés"
(UI 'InfoOs').Text  = $os.Caption + " (build " + $os.BuildNumber + ")"
(UI 'InfoPc').Text  = $env:COMPUTERNAME
