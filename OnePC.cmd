    if ($keys -contains 'clean') { Start-CalItem 'clean' $true }
    if ($keys -contains 'drv') { Start-CalItem 'drv' $true } else { Show-Cal }
})
function Check-CalReminder {
    try {
        if (-not $cfg.Alerts) { return }
        $last = [datetime]::MinValue; try { $last = [datetime]::ParseExact([string]$cfg.CalTold, 'dd/MM/yyyy', [cultureinfo]::InvariantCulture) } catch {}
        if (((Get-Date) - $last).TotalDays -lt 3) { return }
        $lateItems = @(Get-CalState | Where-Object { $_.Level -eq 2 })
        if ($lateItems.Count -eq 0) { return }
        $cfg.CalTold = (Get-Date).ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture); Save-Cfg
        $txt = "Entretien en retard : " + (($lateItems | ForEach-Object { $_.Item.N + ' (' + ($_.When -replace '\s+\(.*$', '') + ')' }) -join ', ') + ". Va voir l'onglet Entretien."
        Toast $txt; Notify "OnePC" $txt
    } catch {}
}

# ---------- Cache des navigateurs ----------
function Get-BrowserCaches {
    $defs = @(
        @{ N = 'Chrome'; R = "$env:LOCALAPPDATA\Google\Chrome\User Data"; K = 'c' }, @{ N = 'Edge'; R = "$env:LOCALAPPDATA\Microsoft\Edge\User Data"; K = 'c' },
        @{ N = 'Brave'; R = "$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\User Data"; K = 'c' }, @{ N = 'Opera GX'; R = "$env:LOCALAPPDATA\Opera Software\Opera GX Stable"; K = 'c' },
        @{ N = 'Firefox'; R = "$env:LOCALAPPDATA\Mozilla\Firefox\Profiles"; K = 'f' }
    )
    foreach ($b in $defs) {
        if (-not (Test-Path -LiteralPath $b.R)) { continue }
        $dirs = @()
        $profiles = @($b.R) + @(Get-ChildItem -LiteralPath $b.R -Directory -ErrorAction SilentlyContinue | ForEach-Object { $_.FullName })
        foreach ($p in $profiles) {
            $subs = 'Cache', 'Code Cache', 'GPUCache'; if ($b.K -eq 'f') { $subs = @('cache2') }
            foreach ($sub in $subs) { $d = Join-Path $p $sub; if (Test-Path -LiteralPath $d) { $dirs += $d } }
        }
        if ($dirs.Count) { @{ N = $b.N; D = $dirs } }
    }
}
$cacheCode = {
    param($arg)
    foreach ($b in $arg.List) {
        $sz = 0; $del = 0
        foreach ($d in $b.D) {
            $files = New-Object 'System.Collections.Generic.List[System.IO.FileInfo]'
            $st = New-Object 'System.Collections.Generic.Stack[string]'; $st.Push([string]$d)
            while ($st.Count -gt 0) {
                $cur = $st.Pop()
                try {
                    $di = New-Object System.IO.DirectoryInfo $cur
                    foreach ($f in $di.GetFiles()) { $files.Add($f) }
                    foreach ($sd in $di.GetDirectories()) { if (-not ($sd.Attributes -band [System.IO.FileAttributes]::ReparsePoint)) { $st.Push($sd.FullName) } }
                } catch {}
            }
            foreach ($f in $files) {
                if ($arg.Clean) { try { $len = $f.Length; Remove-Item -LiteralPath $f.FullName -Force -ErrorAction Stop; $del += $len } catch { $sz += $f.Length } }
                else { $sz += $f.Length }
            }
        }
        [pscustomobject]@{ N = $b.N; S = $sz; Del = $del }
    }
}
function Start-Cache($clean) {
    $list = @(Get-BrowserCaches)
    if ($list.Count -eq 0) { (UI 'CacheMsg').Text = "Aucun navigateur reconnu sur ce PC."; return }
    (UI 'CacheScan').IsEnabled = $false; (UI 'CacheClean').IsEnabled = $false; (UI 'CacheMsg').Text = 'En cours...'
    $script:cacheClean = $clean
    Start-Bg $cacheCode @{ List = $list; Clean = $clean } {
        param($r)
        (UI 'CacheScan').IsEnabled = $true; (UI 'CacheClean').IsEnabled = $true
        if ($script:cacheClean) {
            (UI 'CacheList').ItemsSource = @($r | ForEach-Object { Row $_.N ((Mo $_.Del) + " libérés") $(if ($_.S -gt 0) { (Mo $_.S) + " en cours d'utilisation" } else { '' }) })
            Log 'Cache des navigateurs vidé'; (UI 'CacheMsg').Text = "Cache vidé : " + (Mo (($r | Measure-Object Del -Sum).Sum)) + " libérés."
        } else {
            (UI 'CacheList').ItemsSource = @($r | ForEach-Object { Row $_.N (Mo $_.S) '' })
            (UI 'CacheMsg').Text = "Total : " + (Mo (($r | Measure-Object S -Sum).Sum)) + " de cache."
        }
    }
}
