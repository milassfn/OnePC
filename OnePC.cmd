function Pick-UserPhoto($img, $glow, $msg, $what) {
    $dlg = New-Object Microsoft.Win32.OpenFileDialog
    $dlg.Title = 'Choisis une photo de ta ' + $what; $dlg.Filter = 'Images|*.png;*.jpg;*.jpeg;*.bmp;*.webp'
    if (-not $dlg.ShowDialog()) { return }
    try {
        Add-Type -AssemblyName System.Drawing
        $src = [System.Drawing.Image]::FromFile($dlg.FileName)
        $k = [math]::Min(1.0, [math]::Min(600.0 / $src.Width, 600.0 / $src.Height))
        $w = [int]([math]::Max(1, $src.Width * $k)); $h = [int]([math]::Max(1, $src.Height * $k))
        $out = New-Object System.Drawing.Bitmap $w, $h, ([System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
        $g = [System.Drawing.Graphics]::FromImage($out); $g.InterpolationMode = 'HighQualityBicubic'; $g.DrawImage($src, 0, 0, $w, $h); $g.Dispose(); $src.Dispose()
        if (-not (Test-Path -LiteralPath $appDir)) { [void](New-Item -ItemType Directory -Path $appDir -Force) }
        $out.Save($devPhoto[$img], [System.Drawing.Imaging.ImageFormat]::Png); $out.Dispose()
        $lm = $script:lastModel[$img]; Set-DevImage $img $glow $lm[0] $lm[1]
        (UI $msg).Text = 'Ta photo est enregistrée : elle s''affichera à chaque fois.'
