$discordGuild = '1558996661039013900'; $discordTickets = '1558997171481743521'
function Get-Diag($a) {
    $L = New-Object System.Collections.Generic.List[string]
    $L.Add('Diagnostic OnePC ' + $a.Ver + '  -  ' + (Get-Date).ToString('dd/MM/yyyy HH:mm'))
    try { $os = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop
        $L.Add('Windows      : ' + ($os.Caption -replace 'Microsoft ', '') + ' (build ' + $os.BuildNumber + ', ' + $os.OSArchitecture + ')')
        $up = (Get-Date) - $os.LastBootUpTime; $L.Add('Allumé depuis: ' + [int]$up.TotalHours + ' h')
        $tot = [math]::Round($os.TotalVisibleMemorySize / 1MB, 1); $used = [math]::Round(100 - 100 * $os.FreePhysicalMemory / $os.TotalVisibleMemorySize)
        $L.Add('RAM          : ' + $tot + ' Go, ' + $used + ' % utilisée') } catch {}
    try { $c = Get-CimInstance Win32_Processor -ErrorAction Stop | Select-Object -First 1; $L.Add('Processeur   : ' + (([string]$c.Name) -replace '\(TM\)|\(R\)', '' -replace '\s+', ' ').Trim()) } catch {}
    try { foreach ($g in @(Get-CimInstance Win32_VideoController -ErrorAction Stop | Where-Object { $_.Name -notmatch 'Microsoft|Virtual|Remote' })) {
            $dd = ''; try { $dd = ([datetime]$g.DriverDate).ToString('MM/yyyy') } catch {}
            $hz = ''; if ($g.CurrentRefreshRate) { $hz = ', écran ' + $g.CurrentHorizontalResolution + 'x' + $g.CurrentVerticalResolution + ' à ' + $g.CurrentRefreshRate + ' Hz' }
            $L.Add('Carte graph. : ' + $g.Name + ' (pilote ' + $g.DriverVersion + ' du ' + $dd + ')' + $hz) } } catch {}
    try { foreach ($d in @(Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3' -ErrorAction Stop)) {
            $L.Add('Disque ' + $d.DeviceID + '    : ' + [math]::Round($d.FreeSpace / 1GB) + ' Go libres sur ' + [math]::Round($d.Size / 1GB) + ' Go') } } catch {}
    try { $mt = @(Get-PhysicalDisk -ErrorAction Stop | ForEach-Object { [string]$_.MediaType + ' ' + [string]$_.HealthStatus }); if ($mt.Count) { $L.Add('Stockage     : ' + ($mt -join ', ')) } } catch {}
    try { $p = (& powercfg /getactivescheme) -join ' '; if ($p -match '\((.+)\)') { $L.Add('Alimentation : ' + $Matches[1]) } } catch {}
    try { $av = @(Get-CimInstance -Namespace root/SecurityCenter2 -ClassName AntiVirusProduct -ErrorAction Stop | ForEach-Object { $_.displayName }); if ($av.Count) { $L.Add('Antivirus    : ' + (($av | Select-Object -Unique) -join ', ')) } } catch {}
    try { $na = Get-NetAdapter -Physical -ErrorAction Stop | Where-Object { $_.Status -eq 'Up' } | Select-Object -First 1
        if ($na) { $k = 'Câble'; if ($na.PhysicalMediaType -match '802\.11|Wireless|Native') { $k = 'Wi-Fi' }; $L.Add('Connexion    : ' + $k + ' (' + $na.LinkSpeed + ')') } } catch {}
    try { $pg = New-Object System.Net.NetworkInformation.Ping; $t = @(); foreach ($i in 1..4) { try { $r = $pg.Send('1.1.1.1', 1500); if ($r.Status -eq 'Success') { $t += $r.RoundtripTime } } catch {} }
        if ($t.Count) { $L.Add('Ping internet: ' + [math]::Round(($t | Measure-Object -Average).Average) + ' ms (' + $t.Count + '/4 réponses)') } else { $L.Add('Ping internet: pas de réponse') } } catch {}
    try { $since = (Get-Date).AddDays(-30); $ev = @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; Id = 41, 1001; StartTime = $since } -MaxEvents 80 -ErrorAction Stop)
        $bs = @($ev | Where-Object { $_.Id -eq 1001 -and $_.ProviderName -match 'BugCheck|WER-SystemErrorReporting' }).Count; $kp = @($ev | Where-Object { $_.Id -eq 41 }).Count
        $L.Add('30 derniers j: ' + $bs + ' écran(s) bleu(s), ' + $kp + ' arrêt(s) brutal(aux)') } catch { $L.Add('30 derniers j: aucun plantage enregistré') }
    try { $bad = @(Get-PnpDevice -PresentOnly -ErrorAction Stop | Where-Object { $_.Status -eq 'Error' } | Select-Object -First 4)
        if ($bad.Count) { $L.Add('Périph. en erreur : ' + (($bad | ForEach-Object { $_.FriendlyName }) -join ' ; ')) } else { $L.Add('Périphériques: aucun en erreur') } } catch {}
    if ($a.Pending) { $L.Add('Pilotes      : ' + $a.Pending) }
    $L.Add('État OnePC   : ' + $a.State)
    "``````" + "`n" + ($L -join "`n") + "`n" + "``````"
}
