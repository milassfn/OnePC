function Restart-App($before = '') {
    # un petit assistant caché attend que cette fenêtre soit vraiment fermée, puis relance l'appli
    $target = ''
    if ($appExe -and (Test-Path -LiteralPath $appExe)) { $target = "Start-Process -FilePath '" + $appExe.Replace("'", "''") + "'" }
    elseif ($vbs -and (Test-Path -LiteralPath $vbs)) { $target = "Start-Process wscript.exe -ArgumentList '`"" + $vbs.Replace("'", "''") + "`"'" }
    elseif ($env:SELF -and (Test-Path -LiteralPath $env:SELF)) { $target = "Start-Process -FilePath '" + $env:SELF.Replace("'", "''") + "' -WindowStyle Hidden" }
    if (-not $target) { return $false }
    $helper = "try { Wait-Process -Id $PID -Timeout 15 -ErrorAction SilentlyContinue } catch {}; Start-Sleep -Milliseconds 600; $before $target"
    $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($helper))
    try { Start-Process powershell -WindowStyle Hidden -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-WindowStyle', 'Hidden', '-EncodedCommand', $enc } catch { return $false }
    try { $mutex.ReleaseMutex() } catch {}
    try { $mutex.Close() } catch {}
    $script:quit = $true; $script:restarting = $true
    $win.Close()
    return $true
}
