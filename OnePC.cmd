        $d.Tag = $false
        $inBox = $d.FindName('In')
        if ($null -ne $inputDefault) {
            $inBox.Visibility = 'Visible'; $inBox.Text = [string]$inputDefault; $d.FindName('YesT').Text = 'OK'; $d.FindName('No').Child.Text = 'Annuler'
            $d.Add_ContentRendered({ [void]$inBox.Focus(); $inBox.SelectAll() }.GetNewClosure())
        }
