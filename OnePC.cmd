$searchNorm = @($searchIndex | ForEach-Object { Norm ($_[0] + ' ' + $_[2] + ' ' + $pages[$_[1]][2]) })
function Go-Search($key) { (UI 'SearchPop').IsOpen = $false; (UI 'SearchBox').Text = ''; Show-Page $key }
(UI 'SearchBox').Add_TextChanged({
    $raw = (UI 'SearchBox').Text
    if ($raw) { (UI 'SearchHint').Visibility = 'Collapsed' } else { (UI 'SearchHint').Visibility = 'Visible' }
    $sh = UI 'SearchHost'; $sh.Children.Clear(); $script:searchFirst = ''
    $words = @((Norm $raw.Trim()) -split '\s+' | Where-Object { $_.Length -ge 2 })
    if ($words.Count -eq 0) { (UI 'SearchPop').IsOpen = $false; return }
    $n = 0
    for ($i = 0; $i -lt $searchIndex.Count -and $n -lt 8; $i++) {
        $ok = $true; foreach ($w in $words) { if (-not $searchNorm[$i].Contains($w)) { $ok = $false; break } }
        if (-not $ok) { continue }
        $n++; if (-not $script:searchFirst) { $script:searchFirst = $searchIndex[$i][1] }
        $bt = New-Object System.Windows.Controls.Button
        $bt.Style = $win.FindResource('Nav'); $bt.Focusable = $false; $bt.Tag = $searchIndex[$i][1]
        $bt.Content = $searchIndex[$i][0] + "    ›  " + $pages[$searchIndex[$i][1]][2]
        $bt.Foreground = $brush.ConvertFromString('#E8E8EC')
        $bt.Add_Click({ param($sender, $e) Go-Search ([string]$sender.Tag) })
        [void]$sh.Children.Add($bt)
    }
    if ($n -eq 0) {
        $none = New-Object System.Windows.Controls.TextBlock; $none.Text = 'Aucun résultat'; $none.Foreground = $brush.ConvertFromString('#8E8E98')
        $none.Margin = New-Object System.Windows.Thickness 8, 6, 8, 6; [void]$sh.Children.Add($none)
    }
    (UI 'SearchPop').IsOpen = $true
})
(UI 'SearchBox').Add_KeyDown({
    param($sender, $e)
    if ($e.Key -eq 'Return' -and $script:searchFirst) { Go-Search $script:searchFirst }
    elseif ($e.Key -eq 'Escape') { (UI 'SearchPop').IsOpen = $false; (UI 'SearchBox').Text = '' }
})

# ---------- Discord ----------
$dcData = Join-Path $env:APPDATA 'discord'
$dcUpdate = Join-Path $env:LOCALAPPDATA 'Discord\Update.exe'
$dcSettings = Join-Path $dcData 'settings.json'
$dcRunAp = "HKCU:\$apKey\Run"
function Get-Dc { @(Get-Process -Name 'Discord' -ErrorAction SilentlyContinue) }
function Show-Dc {
    $p = Get-Dc
    $inst = Test-Path -LiteralPath $dcUpdate
    (UI 'DcRun').IsEnabled = ($inst -and $p.Count -eq 0); (UI 'DcRestart').IsEnabled = ($p.Count -gt 0); (UI 'DcQuit').IsEnabled = ($p.Count -gt 0)
    if ($p.Count) {
        $mem = 0; foreach ($x in $p) { $mem += $x.WorkingSet64 }
        (UI 'DcState').Text = "Discord est ouvert  ·  " + (Mo $mem) + " de mémoire"
        $prio = 'normale'; try { if (@($p | Where-Object { $_.PriorityClass -eq 'BelowNormal' }).Count -eq $p.Count) { $prio = 'basse' } } catch {}
        (UI 'DcSub').Text = "" + $p.Count + " processus  ·  priorité $prio"
        (UI 'DcPrioInfo').Text = "Actuellement : priorité $prio"
        if ($prio -eq 'basse') { (UI 'DcPrio').Content = 'Priorité normale' } else { (UI 'DcPrio').Content = 'Priorité basse' }
        (UI 'DcPrio').IsEnabled = $true
    } else {
        if ($inst) { (UI 'DcState').Text = 'Discord est fermé'; (UI 'DcSub').Text = 'Il ne consomme rien pour le moment.' }
        else { (UI 'DcState').Text = "Discord n'est pas installé"; (UI 'DcSub').Text = "Cet onglet ne gère que l'application Discord pour Windows, pas la version navigateur." }
        (UI 'DcPrioInfo').Text = 'Discord doit être ouvert'; (UI 'DcPrio').IsEnabled = $false
    }
}
function Start-Dc { if (Test-Path -LiteralPath $dcUpdate) { Start-Process -FilePath $dcUpdate -ArgumentList '--processStart', 'Discord.exe' } }
function Stop-Dc {
    Get-Dc | ForEach-Object { try { $_.Kill() } catch {} }
    for ($i = 0; $i -lt 20 -and (Get-Dc).Count; $i++) { Start-Sleep -Milliseconds 150 }
}
function Get-DcHw {
    try { $j = Get-Content -LiteralPath $dcSettings -Raw -Encoding UTF8 -ErrorAction Stop | ConvertFrom-Json; if ($j.PSObject.Properties['enableHardwareAcceleration'] -and $j.enableHardwareAcceleration -eq $false) { return $false } } catch {}
    return $true
}
function Get-DcCacheDirs { @('Cache', 'Code Cache', 'GPUCache', 'DawnCache', 'DawnGraphiteCache', 'DawnWebGPUCache' | ForEach-Object { Join-Path $dcData $_ } | Where-Object { Test-Path -LiteralPath $_ }) }
function Show-DcOptions {
    if (Get-DcHw) { (UI 'DcHwInfo').Text = 'Actuellement : activée'; (UI 'DcHw').Content = 'Désactiver' } else { (UI 'DcHwInfo').Text = 'Actuellement : désactivée'; (UI 'DcHw').Content = 'Réactiver' }
    (UI 'DcHw').IsEnabled = (Test-Path -LiteralPath $dcSettings)
    $hasRun = $false; try { $hasRun = [bool]((Get-Item -LiteralPath "HKCU:\$runKey" -ErrorAction Stop).GetValue('Discord')) } catch {}
    if (-not $hasRun) { (UI 'DcBootInfo').Text = "Actuellement : Discord ne se lance pas avec Windows"; (UI 'DcBoot').IsEnabled = $false }
    else {
        (UI 'DcBoot').IsEnabled = $true
        if (Test-StartEnabled $dcRunAp 'Discord') { (UI 'DcBootInfo').Text = 'Actuellement : se lance avec Windows'; (UI 'DcBoot').Content = 'Désactiver' }
        else { (UI 'DcBootInfo').Text = 'Actuellement : désactivé'; (UI 'DcBoot').Content = 'Réactiver' }
    }
    $dirs = Get-DcCacheDirs
    if ($dirs.Count -eq 0) { (UI 'DcCacheInfo').Text = 'Aucun cache trouvé'; return }
    (UI 'DcCacheInfo').Text = 'Calcul de la taille...'
    Start-Bg $cacheCode @{ List = @(@{ N = 'Discord'; D = $dirs }); Clean = $false } {
        param($r)
        if ($r.Count) { (UI 'DcCacheInfo').Text = "Taille actuelle : " + (Mo $r[0].S) }
    }
}
(UI 'DcRun').Add_Click({ Start-Dc; (UI 'DcMsg').Text = 'Lancement de Discord...' })
(UI 'DcQuit').Add_Click({ if (Ask "Quitter complètement Discord ?`r`nSi tu es en vocal, tu seras déconnecté.") { Stop-Dc; Show-Dc; (UI 'DcMsg').Text = 'Discord est fermé : sa mémoire est libérée.' } })
(UI 'DcRestart').Add_Click({
