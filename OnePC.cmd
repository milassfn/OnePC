function B64uDec($t) { $t = ([string]$t).Replace('-', '+').Replace('_', '/'); while ($t.Length % 4) { $t += '=' }; [Convert]::FromBase64String($t) }
function Get-MachineCode {
    $mg = ''; try { $mg = [string](Get-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Cryptography' -Name MachineGuid -ErrorAction Stop).MachineGuid } catch {}
    if (-not $mg) { $mg = [string]$env:COMPUTERNAME }
    $sha = [System.Security.Cryptography.SHA256]::Create()
    $h = $sha.ComputeHash([System.Text.Encoding]::UTF8.GetBytes('OnePC|' + $mg.ToLower()))
    $hex = (($h[0..4] | ForEach-Object { $_.ToString('X2') }) -join '')
    $hex.Substring(0, 5) + '-' + $hex.Substring(5, 5)
}
function Test-Lic($text) {
    # renvoie @{ Ok; Why; Id; Client; Exp; Machine }
    $r = @{ Ok = $false; Why = ''; Id = ''; Client = ''; Exp = ''; Machine = '' }
    try {
        $k = (([string]$text) -replace '\s', '')
        $p = $k.Split('.')
        if ($p.Count -ne 3 -or $p[0] -ne 'ONEPC1') { $r.Why = "Ce n'est pas une clé OnePC."; return $r }
        $data = B64uDec $p[1]; $sig = B64uDec $p[2]
        $rsa = $null; try { $rsa = New-Object System.Security.Cryptography.RSACng } catch { $rsa = [System.Security.Cryptography.RSA]::Create() }
        $rsa.FromXmlString($licPub)
        if (-not $rsa.VerifyData($data, $sig, [System.Security.Cryptography.HashAlgorithmName]::SHA256, [System.Security.Cryptography.RSASignaturePadding]::Pkcs1)) { $r.Why = "Cette clé n'est pas valide."; return $r }
        $f = [System.Text.Encoding]::UTF8.GetString($data).Split('|')
        if ($f.Count -lt 4) { $r.Why = "Cette clé n'est pas valide."; return $r }
        $r.Id = $f[0]; $r.Client = $f[1]; $r.Exp = $f[2]; $r.Machine = $f[3]
        if ($r.Machine -ne '*' -and $r.Machine -ne (Get-MachineCode)) { $r.Why = "Cette clé a été créée pour un autre PC (code " + $r.Machine + ")."; return $r }
        if ($r.Exp -ne '0') {
            $d = [datetime]::ParseExact($r.Exp, 'yyyyMMdd', [cultureinfo]::InvariantCulture)
            if ((Get-Date).Date -gt $d) { $r.Why = "Cette clé a expiré le " + $d.ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture) + "."; return $r }
        }
        $rev = @(); try { $rev = @(Get-Content -LiteralPath $licRevFile -ErrorAction Stop | ForEach-Object { $_.Trim() }) } catch {}
        if ($rev -contains $r.Id) { $r.Why = "Cette clé a été désactivée."; return $r }
        $r.Ok = $true
    } catch { $r.Why = "Cette clé n'est pas lisible : vérifie que tu l'as copiée en entier." }
    $r
}
