    if ($gpuNames -match 'Intel')      { Start-Process 'https://www.intel.fr/content/www/fr/fr/support/detect.html'; $opened = $true }
    if (-not $opened) { $log.Text = "Fabricant non reconnu : $gpuNames" }
})
