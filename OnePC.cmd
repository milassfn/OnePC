$obsBackFile = Join-Path $appDir 'obs-anciens-reglages.json'
$obsKeys = @(@('Output', 'Mode'), @('SimpleOutput', 'StreamEncoder'), @('SimpleOutput', 'VBitrate'), @('SimpleOutput', 'ABitrate'), @('SimpleOutput', 'RecEncoder'), @('SimpleOutput', 'RecQuality'), @('SimpleOutput', 'RecFormat2'), @('SimpleOutput', 'NVENCPreset2'), @('SimpleOutput', 'Preset'))
function Need-Obs($msgTb) {
    if (-not (Get-Process -Name 'obs64' -ErrorAction SilentlyContinue)) { $msgTb.Text = "Ouvre OBS avec le bouton « Lancer OBS » plus haut, puis recommence."; return $false }
    if (-not (Connect-Obs)) { $msgTb.Text = "OnePC n'arrive pas à parler à OBS. Clique sur « Connecter OnePC à OBS » en haut de la page."; return $false }
    $true
}
function Apply-ObsRec {
    $r = $script:obsRecom; $m = $script:obsWizMsg
    if (-not (Need-Obs $m)) { return }
    $st = Obs-Req 'GetStreamStatus' $null; $rs = Obs-Req 'GetRecordStatus' $null
    if (($st -and $st.outputActive) -or ($rs -and $rs.outputActive)) { $m.Text = "Arrête d'abord ton live et ton enregistrement : OBS ne peut pas changer la vidéo pendant qu'ils tournent."; return }
    if ($r.Use -eq 'tiktok') { New-ObsProfile 'OnePC - TikTok vertical' $r $m; return }
    # sauvegarde une seule fois, avant la toute première modification
    if (-not (Test-Path -LiteralPath $obsBackFile)) {
        $bk = @{ Params = @(); Video = $null }
        foreach ($k in $obsKeys) { $v = Obs-Req 'GetProfileParameter' @{ parameterCategory = $k[0]; parameterName = $k[1] }; if ($v) { $bk.Params += @{ C = $k[0]; N = $k[1]; V = [string]$v.parameterValue } } }
        $bk.Video = Obs-Req 'GetVideoSettings' $null
        try { ($bk | ConvertTo-Json -Depth 6) | Set-Content -LiteralPath $obsBackFile -Encoding UTF8 } catch {}
    }
    Set-ObsParams $r
    $vok = Obs-Req 'SetVideoSettings' @{ baseWidth = [int]$r.BaseW; baseHeight = [int]$r.BaseH; outputWidth = [int]$r.OutW; outputHeight = [int]$r.OutH; fpsNumerator = [int]$r.Fps; fpsDenominator = 1 }
    if ($vok) { $m.Text = 'C''est réglé ! Les nouveaux réglages sont actifs dans OBS. Lance un live ou un enregistrement pour en profiter.'; Log ('OBS réglé par l''assistant (' + $r.Use + ')') }
    else { $m.Text = 'Réglages appliqués, sauf la résolution : ' + $script:obsLastErr }
    (UI 'ObsUndo').Visibility = 'Visible'
    Show-Obs; Update-ObsScore
}
function Set-ObsParams($r) {
    $enc = $r.Enc
    $pairs = @(@('Output', 'Mode', 'Simple'), @('SimpleOutput', 'StreamEncoder', $enc), @('SimpleOutput', 'RecEncoder', $enc), @('SimpleOutput', 'ABitrate', '160'), @('SimpleOutput', 'RecQuality', $r.Rec), @('SimpleOutput', 'RecFormat2', $r.Fmt))
    if ($r.Kbps -gt 0) { $pairs += , @('SimpleOutput', 'VBitrate', [string]$r.Kbps) }
    if ($enc -eq 'nvenc') { $pairs += , @('SimpleOutput', 'NVENCPreset2', 'p5') } elseif ($enc -eq 'x264') { $pairs += , @('SimpleOutput', 'Preset', 'veryfast') }
    foreach ($p in $pairs) { [void](Obs-Req 'SetProfileParameter' @{ parameterCategory = $p[0]; parameterName = $p[1]; parameterValue = [string]$p[2] }) }
}
function New-ObsProfile($name, $r, $m) {
    $cur = Obs-Req 'GetProfileList' $null
    if ($cur -and @($cur.profiles) -contains $name) { [void](Obs-Req 'SetCurrentProfile' @{ profileName = $name }) } else { [void](Obs-Req 'CreateProfile' @{ profileName = $name }) }
    Start-Sleep -Milliseconds 400
    Set-ObsParams $r
    [void](Obs-Req 'SetVideoSettings' @{ baseWidth = [int]$r.BaseW; baseHeight = [int]$r.BaseH; outputWidth = [int]$r.OutW; outputHeight = [int]$r.OutH; fpsNumerator = [int]$r.Fps; fpsDenominator = 1 })
    if ($cur -and $cur.currentProfileName -and $cur.currentProfileName -ne $name) { [void](Obs-Req 'SetCurrentProfile' @{ profileName = [string]$cur.currentProfileName }) }
    if ($m) { $m.Text = "Profil « $name » créé. Dans OBS, choisis-le dans le menu Profil quand tu en as besoin : tes réglages habituels n'ont pas bougé." }
    Log ('OBS : profil créé (' + $name + ')')
}
(UI 'ObsUndo').Add_Click({
    if (-not (Test-Path -LiteralPath $obsBackFile)) { (UI 'ObsMsg').Text = 'Aucune sauvegarde à remettre.'; return }
    if (-not (Need-Obs (UI 'ObsMsg'))) { return }
    try {
        $bk = Get-Content -LiteralPath $obsBackFile -Raw -Encoding UTF8 | ConvertFrom-Json
        foreach ($p in @($bk.Params)) { [void](Obs-Req 'SetProfileParameter' @{ parameterCategory = [string]$p.C; parameterName = [string]$p.N; parameterValue = [string]$p.V }) }
        if ($bk.Video) { $v = $bk.Video; [void](Obs-Req 'SetVideoSettings' @{ baseWidth = [int]$v.baseWidth; baseHeight = [int]$v.baseHeight; outputWidth = [int]$v.outputWidth; outputHeight = [int]$v.outputHeight; fpsNumerator = [int]$v.fpsNumerator; fpsDenominator = [int]$v.fpsDenominator }) }
        Remove-Item -LiteralPath $obsBackFile -Force -ErrorAction SilentlyContinue
        (UI 'ObsUndo').Visibility = 'Collapsed'; (UI 'ObsMsg').Text = 'Tes anciens réglages OBS sont remis.'; Log 'OBS : anciens réglages remis'
        Show-Obs; Update-ObsScore
    } catch { (UI 'ObsMsg').Text = 'Impossible de remettre les anciens réglages.' }
})
