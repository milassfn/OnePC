        if ($days -eq 0) { $w = ($r.When -replace '\s+\(.*$', ''); if ($age -lt 0) { $w = 'jamais' }; $opt += ($r.Item.N + ' : ' + $w); continue }
        # couleur et phrase selon le temps écoulé
        $col = '#3DDC84'; $ratio = 0.0; $big = ''; $sub = ''
        if ($days -eq 0) {
            $col = '#8E8E98'
            if ($age -lt 0) { $big = 'Pas encore lancée' } else { $big = ($r.When -replace '\s+\(.*$', ''); $big = $big.Substring(0, 1).ToUpper() + $big.Substring(1) }
            $sub = 'À lancer seulement quand le PC bugge'
        } elseif ($age -lt 0) {
            $col = '#FBBF24'; $ratio = 1.0; $late++
            $big = 'Jamais fait'; $sub = "Conseillé tous les $days jours"
        } else {
            $ratio = [math]::Min(1.0, $age / [double]$days)
            $big = ($r.When -replace '\s+\(.*$', ''); $big = $big.Substring(0, 1).ToUpper() + $big.Substring(1)
            $left = $days - $age
            if ($left -lt 0) { $col = '#FF5A6E'; $late++; $sub = 'En retard de ' + (-$left) + ' jour(s)' }
            elseif ($left -le [math]::Max(2, [int]($days * 0.2))) { $col = '#FBBF24'; $sub = "À refaire dans $left jour(s)" }
            else { $sub = "Prochain dans $left jours" }
        }
        $card = New-Object System.Windows.Controls.Border
        $card.Width = $inner + 32; $card.Margin = New-Object System.Windows.Thickness 0, 0, 12, 12; $card.Padding = New-Object System.Windows.Thickness 16, 14, 16, 14
        $card.Background = $brush.ConvertFromString('#1D1D22'); $card.BorderBrush = $brush.ConvertFromString('#2E2E35'); $card.BorderThickness = New-Object System.Windows.Thickness 1
        $card.CornerRadius = New-Object System.Windows.CornerRadius 12
        $sp = New-Object System.Windows.Controls.StackPanel
        # en-tête : icône + nom
        $head = New-Object System.Windows.Controls.StackPanel; $head.Orientation = 'Horizontal'
        $ib = New-Object System.Windows.Controls.Border; $ib.Width = 34; $ib.Height = 34; $ib.CornerRadius = New-Object System.Windows.CornerRadius 9
        $ib.Background = $brush.ConvertFromString('#26262C'); $ib.Margin = New-Object System.Windows.Thickness 0, 0, 10, 0
        $ic = New-Object System.Windows.Controls.TextBlock; $ic.Text = [string][char]$icons[$r.Item.K]; $ic.FontFamily = New-Object System.Windows.Media.FontFamily 'Segoe MDL2 Assets'
        $ic.FontSize = 16; $ic.Foreground = $brush.ConvertFromString($col); $ic.HorizontalAlignment = 'Center'; $ic.VerticalAlignment = 'Center'
        $ib.Child = $ic
        $nm = New-Object System.Windows.Controls.TextBlock; $nm.Text = $r.Item.N; $nm.FontWeight = 'SemiBold'; $nm.VerticalAlignment = 'Center'; $nm.TextTrimming = 'CharacterEllipsis'; $nm.MaxWidth = $inner - 46
        [void]$head.Children.Add($ib); [void]$head.Children.Add($nm)
        # grand texte + sous-texte
        $tb = New-Object System.Windows.Controls.TextBlock; $tb.Text = $big; $tb.FontSize = 20; $tb.FontWeight = 'Bold'; $tb.Margin = New-Object System.Windows.Thickness 0, 12, 0, 0
        $ts = New-Object System.Windows.Controls.TextBlock; $ts.Text = $sub; $ts.Foreground = $brush.ConvertFromString($col); $ts.FontSize = 12; $ts.Margin = New-Object System.Windows.Thickness 0, 2, 0, 10
        # barre de temps écoulé
        $track = New-Object System.Windows.Controls.Border; $track.Height = 6; $track.Width = $inner; $track.HorizontalAlignment = 'Left'
        $track.CornerRadius = New-Object System.Windows.CornerRadius 3; $track.Background = $brush.ConvertFromString('#2A2A31')
        $fill = New-Object System.Windows.Controls.Border; $fill.Height = 6; $fill.HorizontalAlignment = 'Left'; $fill.CornerRadius = New-Object System.Windows.CornerRadius 3
        $fill.Width = [math]::Max(0, [math]::Round($inner * $ratio)); $fill.Background = $brush.ConvertFromString($col)
        $track.Child = $fill
        # pied : date + bouton
        $foot = New-Object System.Windows.Controls.DockPanel; $foot.Margin = New-Object System.Windows.Thickness 0, 12, 0, 0
        $bt = New-Object System.Windows.Controls.Button; $bt.Style = $win.FindResource('Mini'); $bt.Tag = [string]$r.Item.K
        $bt.Content = 'Faire maintenant'
        $bt.Add_Click({ param($sender, $e) Start-CalItem ([string]$sender.Tag) $false; Show-Cal })
        [System.Windows.Controls.DockPanel]::SetDock($bt, 'Right')
        $dt = New-Object System.Windows.Controls.TextBlock; $dt.Foreground = $brush.ConvertFromString('#6C6C76'); $dt.FontSize = 11.5; $dt.VerticalAlignment = 'Center'
        if ($r.Date) { $dt.Text = 'Le ' + $r.Date.ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture) } else { $dt.Text = ' ' }
        [void]$foot.Children.Add($bt); [void]$foot.Children.Add($dt)
        foreach ($el in $head, $tb, $ts) { [void]$sp.Children.Add($el) }
        if ($days -gt 0) { [void]$sp.Children.Add($track) }
        [void]$sp.Children.Add($foot)
        $card.Child = $sp; $card.ToolTip = $r.Item.Tip
        [void]$hostP.Children.Add($card)
    }
    $script:calLate = $late
    if ($late -eq 0) { (UI 'CalInfo').Text = "Ton PC est bien entretenu : rien à faire pour le moment." }
    else { (UI 'CalInfo').Text = "$late chose(s) à faire. La barre se remplit avec le temps écoulé depuis la dernière fois." }
    (UI 'CalOpt').Text = 'Optionnel, quand tu en as besoin :   ' + ($opt -join '   ·   ')
}
function Start-CalItem($k, $noAsk) {
    switch ($k) {
        'clean' { if ($noAsk) { Start-Clean -NoAsk } else { Start-Clean } }
        'cache' { if ($noAsk) { Start-Cache $true } elseif (Ask "Vider le cache des navigateurs ?`r`nFerme-les avant pour tout nettoyer. Mots de passe, favoris et historique ne sont pas touchés.") { Start-Cache $true } }
        'drv'   { Show-Page 'Drv'; if ((UI 'DrvAutoGo').IsEnabled) { (UI 'DrvAutoGo').RaiseEvent((New-Object System.Windows.RoutedEventArgs ([System.Windows.Controls.Primitives.ButtonBase]::ClickEvent))) } }
    }
}
(UI 'CalAll').Add_Click({
    $todo = @(Get-CalState | Where-Object { $_.Item.Days -gt 0 -and $_.Level -gt 0 })
    $all = $false
    if ($todo.Count -eq 0) {
        if (-not (Ask "Rien n'est en retard. Tout refaire quand même ?`r`n`r`n - Nettoyage du PC (temporaires, cache Windows Update, corbeille vidée définitivement)`r`n - Cache des navigateurs`r`n - Vérification des pilotes")) { return }
        $all = $true; $todo = @(Get-CalState | Where-Object { $_.Item.Days -gt 0 })
    } else {
        $lines = @($todo | ForEach-Object { ' - ' + $_.Item.N + '  (' + $_.Item.Tip + ')' })
        if (-not (Ask ("Faire maintenant ce qui est à faire ?`r`n`r`n" + ($lines -join "`r`n") + "`r`n`r`nLe nettoyage vide la corbeille définitivement et ouvre une fenêtre administrateur. Pour les pilotes, l'appli vérifie d'abord et te redemande avant d'installer."))) { return }
    }
    $keys = @($todo | ForEach-Object { $_.Item.K })
    if ($keys -contains 'cache') { Start-CalItem 'cache' $true }
    if ($keys -contains 'clean') { Start-CalItem 'clean' $true }
    if ($keys -contains 'drv') { Start-CalItem 'drv' $true } else { Show-Cal }
})
function Check-CalReminder {
    try {
        if (-not $cfg.Alerts) { return }
        $last = [datetime]::MinValue; try { $last = [datetime]::ParseExact([string]$cfg.CalTold, 'dd/MM/yyyy', [cultureinfo]::InvariantCulture) } catch {}
        if (((Get-Date) - $last).TotalDays -lt 3) { return }
        $lateItems = @(Get-CalState | Where-Object { $_.Level -eq 2 })
        if ($lateItems.Count -eq 0) { return }
        $cfg.CalTold = (Get-Date).ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture); Save-Cfg
        $txt = "Entretien en retard : " + (($lateItems | ForEach-Object { $_.Item.N + ' (' + ($_.When -replace '\s+\(.*$', '') + ')' }) -join ', ') + ". Va voir l'onglet Entretien."
        Toast $txt; Notify "OnePC" $txt
    } catch {}
}

# ---------- Cache des navigateurs ----------
function Get-BrowserCaches {
    $defs = @(
        @{ N = 'Chrome'; R = "$env:LOCALAPPDATA\Google\Chrome\User Data"; K = 'c' }, @{ N = 'Edge'; R = "$env:LOCALAPPDATA\Microsoft\Edge\User Data"; K = 'c' },
        @{ N = 'Brave'; R = "$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\User Data"; K = 'c' }, @{ N = 'Opera GX'; R = "$env:LOCALAPPDATA\Opera Software\Opera GX Stable"; K = 'c' },
        @{ N = 'Firefox'; R = "$env:LOCALAPPDATA\Mozilla\Firefox\Profiles"; K = 'f' }
    )
    foreach ($b in $defs) {
        if (-not (Test-Path -LiteralPath $b.R)) { continue }
        $dirs = @()
        $profiles = @($b.R) + @(Get-ChildItem -LiteralPath $b.R -Directory -ErrorAction SilentlyContinue | ForEach-Object { $_.FullName })
        foreach ($p in $profiles) {
            $subs = 'Cache', 'Code Cache', 'GPUCache'; if ($b.K -eq 'f') { $subs = @('cache2') }
            foreach ($sub in $subs) { $d = Join-Path $p $sub; if (Test-Path -LiteralPath $d) { $dirs += $d } }
        }
        if ($dirs.Count) { @{ N = $b.N; D = $dirs } }
    }
}
$cacheCode = {
    param($arg)
    foreach ($b in $arg.List) {
        $sz = 0; $del = 0
        foreach ($d in $b.D) {
            $files = New-Object 'System.Collections.Generic.List[System.IO.FileInfo]'
            $st = New-Object 'System.Collections.Generic.Stack[string]'; $st.Push([string]$d)
            while ($st.Count -gt 0) {
                $cur = $st.Pop()
                try {
                    $di = New-Object System.IO.DirectoryInfo $cur
                    foreach ($f in $di.GetFiles()) { $files.Add($f) }
                    foreach ($sd in $di.GetDirectories()) { if (-not ($sd.Attributes -band [System.IO.FileAttributes]::ReparsePoint)) { $st.Push($sd.FullName) } }
                } catch {}
            }
            foreach ($f in $files) {
                if ($arg.Clean) { try { $len = $f.Length; Remove-Item -LiteralPath $f.FullName -Force -ErrorAction Stop; $del += $len } catch { $sz += $f.Length } }
                else { $sz += $f.Length }
            }
        }
        [pscustomobject]@{ N = $b.N; S = $sz; Del = $del }
    }
}
function Start-Cache($clean) {
    $list = @(Get-BrowserCaches)
    if ($list.Count -eq 0) { (UI 'CacheMsg').Text = "Aucun navigateur reconnu sur ce PC."; return }
    (UI 'CacheScan').IsEnabled = $false; (UI 'CacheClean').IsEnabled = $false; (UI 'CacheMsg').Text = 'En cours...'
    $script:cacheClean = $clean
    Start-Bg $cacheCode @{ List = $list; Clean = $clean } {
        param($r)
        (UI 'CacheScan').IsEnabled = $true; (UI 'CacheClean').IsEnabled = $true
        if ($script:cacheClean) {
            (UI 'CacheList').ItemsSource = @($r | ForEach-Object { Row $_.N ((Mo $_.Del) + " libérés") $(if ($_.S -gt 0) { (Mo $_.S) + " en cours d'utilisation" } else { '' }) })
            Log 'Cache des navigateurs vidé'; (UI 'CacheMsg').Text = "Cache vidé : " + (Mo (($r | Measure-Object Del -Sum).Sum)) + " libérés."
        } else {
            (UI 'CacheList').ItemsSource = @($r | ForEach-Object { Row $_.N (Mo $_.S) '' })
            (UI 'CacheMsg').Text = "Total : " + (Mo (($r | Measure-Object S -Sum).Sum)) + " de cache."
        }
    }
}
(UI 'CacheScan').Add_Click({ Start-Cache $false })
(UI 'CacheClean').Add_Click({ if (Ask "Vider le cache des navigateurs ?`r`nFerme-les avant pour tout nettoyer. Mots de passe, favoris et historique ne sont pas touchés.") { Start-Cache $true } })

# ---------- Dossiers vides ----------
$emptyCode = {
    param($roots)
    $all = New-Object 'System.Collections.Generic.List[string]'
    $stack = New-Object 'System.Collections.Generic.Stack[string]'
    foreach ($r in $roots) { if ($r -and (Test-Path -LiteralPath $r)) { $stack.Push($r) } }
    $rootSet = @{}; foreach ($r in $roots) { if ($r) { $rootSet[$r.TrimEnd('\').ToLower()] = 1 } }
    while ($stack.Count -gt 0) {
        $p = $stack.Pop()
        try {
            foreach ($d in (New-Object System.IO.DirectoryInfo $p).GetDirectories()) {
                if ($d.Attributes -band ([System.IO.FileAttributes]::ReparsePoint -bor [System.IO.FileAttributes]::Hidden -bor [System.IO.FileAttributes]::System)) { continue }
                $all.Add($d.FullName); $stack.Push($d.FullName)
            }
        } catch {}
    }
    $empty = @{}
    foreach ($d in ($all | Sort-Object { $_.Length } -Descending)) {
        try {
            if ([System.IO.Directory]::GetFiles($d).Length -gt 0) { continue }
            $full = $true
            foreach ($sub in [System.IO.Directory]::GetDirectories($d)) { if (-not $empty.ContainsKey($sub)) { $full = $false; break } }
            if ($full -and -not $rootSet.ContainsKey($d.TrimEnd('\').ToLower())) { $empty[$d] = 1 }
        } catch {}
    }
    $empty.Keys | Sort-Object
}
$script:emptyDirs = @()
function Start-Empty($roots) {
    (UI 'EmptyScan').IsEnabled = $false; (UI 'EmptyOther').IsEnabled = $false; (UI 'EmptyDel').IsEnabled = $false
    (UI 'EmptyMsg').Text = 'Recherche en cours...'; (UI 'EmptyList').ItemsSource = $null
    Start-Bg $emptyCode $roots {
        param($r)
        (UI 'EmptyScan').IsEnabled = $true; (UI 'EmptyOther').IsEnabled = $true
        $script:emptyDirs = @($r | ForEach-Object { [string]$_ })
        if ($script:emptyDirs.Count -eq 0) { (UI 'EmptyMsg').Text = "Aucun dossier vide trouvé."; return }
        (UI 'EmptyMsg').Text = "" + $script:emptyDirs.Count + " dossier(s) vide(s) trouvé(s). Les 40 premiers :"
        (UI 'EmptyList').ItemsSource = @($script:emptyDirs | Select-Object -First 40 | ForEach-Object { Row (Split-Path -Leaf $_) (Split-Path -Parent $_) '' })
        (UI 'EmptyDel').IsEnabled = $true
    }
}
(UI 'EmptyScan').Add_Click({
    $dl = ''; try { $dl = (New-Object -ComObject Shell.Application).NameSpace('shell:Downloads').Self.Path } catch {}
    Start-Empty @([Environment]::GetFolderPath('MyDocuments'), [Environment]::GetFolderPath('Desktop'), $dl, [Environment]::GetFolderPath('MyPictures'), [Environment]::GetFolderPath('MyVideos'), [Environment]::GetFolderPath('MyMusic'))
})
(UI 'EmptyOther').Add_Click({
    $p = Pick-Folder 'Choisis le dossier où chercher les dossiers vides'
    if (-not $p) { return }
    if (-not (Test-SafeFolder $p) -or (Test-Under $p $env:APPDATA) -or (Test-Under $p $env:LOCALAPPDATA)) { (UI 'EmptyMsg').Text = "Ce dossier appartient à Windows ou à des programmes : je n'y touche pas."; return }
    Start-Empty @($p)
})
(UI 'EmptyDel').Add_Click({
    if (-not (Ask ("Supprimer ces " + $script:emptyDirs.Count + " dossier(s) vide(s) ?`r`nSeuls les dossiers encore vides au moment de la suppression sont retirés."))) { return }
    $n = 0
    foreach ($d in ($script:emptyDirs | Sort-Object { $_.Length } -Descending)) {
        try { if ((Test-Path -LiteralPath $d) -and [System.IO.Directory]::GetFileSystemEntries($d).Length -eq 0) { [System.IO.Directory]::Delete($d); $n++ } } catch {}
    }
    $script:emptyDirs = @(); (UI 'EmptyList').ItemsSource = $null; (UI 'EmptyDel').IsEnabled = $false
    Log "Dossiers vides : $n supprimé(s)"; (UI 'EmptyMsg').Text = "$n dossier(s) vide(s) supprimé(s)."
})

# ---------- Restes d'applications ----------
$leftCode = {
    param($known)
    $skip = '^(Microsoft.*|Windows.*|Common Files|Internet Explorer|Packages|Temp|Programs|Package Cache|USOShared|USOPrivate|ssh|regid.*|Reference Assemblies|MSBuild|dotnet|ModifiableWindowsApps|Intel.*|AMD.*|ATI.*|NVIDIA.*|Realtek.*|D3DSCache|CrashDumps|ConnectedDevicesPlatform|PlaceholderTileLogoFolder|Publishers|VirtualStore|Comms|PeerDistRepub|SoftwareDistribution|Desktop|Documents|Application Data|Start Menu|Templates|OnePC|Epic.*|Steam.*|Google|Mozilla|Adobe|Apple.*|Oracle|Java|Python.*|nodejs|npm.*|pip|Git.*|\..*|.*\.tmp)$'
    $limit = (Get-Date).AddDays(-60)
    $running = @(Get-Process | ForEach-Object { try { $_.Path } catch {} } | Where-Object { $_ })
    $out = @()
    foreach ($root in $env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:ProgramData, $env:APPDATA, $env:LOCALAPPDATA) {
        if (-not $root) { continue }
        foreach ($d in @(Get-ChildItem -LiteralPath $root -Directory -ErrorAction SilentlyContinue)) {
            if ($d.Name -match $skip -or $d.LastWriteTime -gt $limit) { continue }
            $n = $d.Name.ToLower(); $used = $false
            foreach ($k in $known) { if ($k.Contains($n) -or ($k.Length -ge 4 -and $n.Contains($k))) { $used = $true; break } }
            if ($used) { continue }
            if ($running | Where-Object { $_ -like ($d.FullName + '\*') }) { continue }
            $sz = 0; $recent = $false
            foreach ($f in @(Get-ChildItem -LiteralPath $d.FullName -Recurse -Force -File -ErrorAction SilentlyContinue)) { $sz += $f.Length; if ($f.LastWriteTime -gt $limit) { $recent = $true; break } }
            if ($recent -or $sz -lt 1MB) { continue }
            $out += [pscustomobject]@{ S = $sz; Name = $d.Name; Path = $d.FullName; Date = $d.LastWriteTime.ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture) }
        }
    }
    $out | Sort-Object S -Descending | Select-Object -First 40
}
(UI 'LeftScan').Add_Click({
    if (-not $script:apps) { Load-AppList }
    $known = New-Object 'System.Collections.Generic.List[string]'
    foreach ($a in $script:apps) {
        foreach ($t in $a.Name, $a.Publisher) { if ($t) { $known.Add($t.ToLower()); $w = ($t -split '[\s,\.]')[0].ToLower(); if ($w.Length -ge 4) { $known.Add($w) } } }
    }
    (UI 'LeftScan').IsEnabled = $false; (UI 'LeftMsg').Text = 'Recherche en cours, cela peut prendre une minute...'; (UI 'LeftList').ItemsSource = $null
    Start-Bg $leftCode $known.ToArray() {
        param($r)
        (UI 'LeftScan').IsEnabled = $true
        $rows = @($r | Where-Object { $_.Path } | ForEach-Object { [pscustomobject]@{ A = (Mo $_.S); B = $_.Name; C = ($_.Path + "   ·   inchangé depuis le " + $_.Date); Path = $_.Path } })
        (UI 'LeftList').ItemsSource = $rows
        if ($rows.Count) { (UI 'LeftMsg').Text = "" + $rows.Count + " dossier(s) qui ressemblent à des restes. « Ouvrir » te montre le contenu : à toi de décider." }
        else { (UI 'LeftMsg').Text = "Aucun reste évident trouvé." }
    }
})
(UI 'LeftList').AddHandler([System.Windows.Controls.Primitives.ButtonBase]::ClickEvent, [System.Windows.RoutedEventHandler] {
    param($sender, $e)
    $it = $e.OriginalSource.DataContext
    if ($it -and $it.Path) { Start-Process explorer.exe -ArgumentList ('"' + $it.Path + '"') }
})

# ---------- Plantages ----------
$crashCode = {
    param($x)
    $since = (Get-Date).AddDays(-30)
    $out = @()
    try {
        Get-WinEvent -FilterHashtable @{ LogName = 'System'; Id = 41, 1001, 6008; StartTime = $since } -MaxEvents 60 -ErrorAction Stop | ForEach-Object {
            if ($_.Id -eq 41 -and $_.ProviderName -match 'Kernel-Power') { $out += [pscustomobject]@{ T = $_.TimeCreated; K = 'Arrêt brutal'; D = "Le PC s'est éteint sans s'arrêter proprement (coupure, plantage ou bouton d'alimentation)." } }
            elseif ($_.Id -eq 1001 -and $_.ProviderName -match 'BugCheck|WER-SystemErrorReporting') {
                $code = ''; try { $code = [string]$_.Properties[0].Value } catch {}
                $out += [pscustomobject]@{ T = $_.TimeCreated; K = 'Écran bleu'; D = "Code d'erreur : " + ($code -split ' ')[0] }
            }
            elseif ($_.Id -eq 6008) { $out += [pscustomobject]@{ T = $_.TimeCreated; K = 'Arrêt inattendu'; D = "Windows signale que l'arrêt précédent n'était pas prévu." } }
        }
    } catch {}
    try {
        Get-WinEvent -FilterHashtable @{ LogName = 'Application'; ProviderName = 'Application Error', 'Application Hang'; StartTime = $since } -MaxEvents 60 -ErrorAction Stop | ForEach-Object {
            $app = ''; try { $app = [string]$_.Properties[0].Value } catch {}
            $kind = 'Application plantée'; if ($_.ProviderName -eq 'Application Hang') { $kind = 'Application bloquée' }
            $out += [pscustomobject]@{ T = $_.TimeCreated; K = $kind; D = $app }
        }
    } catch {}
    $out | Sort-Object T -Descending | Select-Object -First 80
}
function Load-Crashes {
    (UI 'CrashScan').IsEnabled = $false; (UI 'CrashMsg').Text = 'Lecture du journal de Windows...'
    Start-Bg $crashCode 0 {
        param($r)
        (UI 'CrashScan').IsEnabled = $true
        $rows = @($r | Where-Object { $_.K } | ForEach-Object { Row $_.T.ToString('dd/MM/yyyy HH:mm', [cultureinfo]::InvariantCulture) $_.D $_.K })
        (UI 'CrashList').ItemsSource = $rows
        $sys = @($r | Where-Object { $_.K -in 'Écran bleu', 'Arrêt brutal', 'Arrêt inattendu' }).Count
        if ($rows.Count -eq 0) { (UI 'CrashMsg').Text = "Aucun plantage enregistré sur les 30 derniers jours." }
        else { (UI 'CrashMsg').Text = "" + $rows.Count + " événement(s), dont $sys concernant Windows lui-même (écrans bleus, arrêts brutaux). La même application qui revient souvent mérite une réinstallation ou une mise à jour." }
    }
}
(UI 'CrashScan').Add_Click({ Load-Crashes })

# ---------- Réseau : applications connectées ----------
$connCode = {
    param($a)
    try {
        Get-NetTCPConnection -State Established -ErrorAction Stop |
            Where-Object { $_.RemoteAddress -notmatch '^(127\.|::1|0\.0\.0\.0|::$)' } | Group-Object OwningProcess | ForEach-Object {
                $pn = ''; try { $pn = (Get-Process -Id $_.Name -ErrorAction Stop).ProcessName } catch { $pn = "processus " + $_.Name }
                [pscustomobject]@{ P = $pn; N = $_.Count; H = @($_.Group | Select-Object -ExpandProperty RemoteAddress -Unique).Count }
            } | Group-Object P | ForEach-Object {
                [pscustomobject]@{ P = $_.Name; N = ($_.Group | Measure-Object N -Sum).Sum; H = ($_.Group | Measure-Object H -Sum).Sum }
            } | Sort-Object N -Descending
    } catch { 'ERR' }
}
(UI 'ConnScan').Add_Click({
    (UI 'ConnScan').IsEnabled = $false
    (UI 'ConnList').ItemsSource = @((Row 'Lecture en cours...' '' ''))
    Start-Bg $connCode $null {
        param($r)
        (UI 'ConnScan').IsEnabled = $true
        if ($r.Count -eq 1 -and [string]$r[0] -eq 'ERR') { (UI 'ConnList').ItemsSource = @((Row 'Indisponible' 'Windows ne fournit pas cette liste sur ce PC.' '')); return }
        $rows = @($r | Where-Object { $_.P } | ForEach-Object { Row $_.P ("" + $_.N + " connexion(s) vers " + $_.H + " serveur(s)") '' })
        if ($rows.Count -eq 0) { $rows = @((Row 'Aucune connexion' "Aucun programme n'utilise internet en ce moment." '')) }
        (UI 'ConnList').ItemsSource = $rows
    }
})

# ---------- Réseau : appareils ----------
$devCode = {
    param($x)
    $c = Get-NetIPConfiguration -ErrorAction SilentlyContinue | Where-Object { $_.IPv4DefaultGateway } | Select-Object -First 1
    if (-not $c) { return }
    $ip = [string]@($c.IPv4Address)[0].IPAddress; $gw = [string]@($c.IPv4DefaultGateway)[0].NextHop
    $base = (($ip -split '\.')[0..2]) -join '.'
    $tasks = New-Object 'System.Collections.Generic.List[System.Threading.Tasks.Task]'
    foreach ($i in 1..254) { try { $tasks.Add((New-Object System.Net.NetworkInformation.Ping).SendPingAsync("$base.$i", 700)) } catch {} }
    try { [void][System.Threading.Tasks.Task]::WaitAll($tasks.ToArray(), 5000) } catch {}
    $found = @(Get-NetNeighbor -InterfaceIndex $c.InterfaceIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue |
        Where-Object { $_.IPAddress -like "$base.*" -and $_.State -ne 'Unreachable' -and $_.State -ne 'Incomplete' -and $_.LinkLayerAddress -and $_.LinkLayerAddress -notmatch '^(FF-FF-FF|00-00-00-00-00-00|01-00-5E)' })
    $names = @{}
    $look = @{}; foreach ($n in $found) { try { $look[$n.IPAddress] = [System.Net.Dns]::GetHostEntryAsync($n.IPAddress) } catch {} }
    try { [void][System.Threading.Tasks.Task]::WaitAll([System.Threading.Tasks.Task[]]@($look.Values), 4000) } catch {}
    foreach ($k in $look.Keys) { try { if ($look[$k].Status -eq 'RanToCompletion') { $names[$k] = $look[$k].Result.HostName } } catch {} }
    [pscustomobject]@{ IP = $ip; Mac = ''; Name = $env:COMPUTERNAME; Note = 'Ce PC' }
    foreach ($n in $found) {
        $note = ''; if ($n.IPAddress -eq $gw) { $note = 'Box / routeur' }
        [pscustomobject]@{ IP = $n.IPAddress; Mac = $n.LinkLayerAddress; Name = [string]$names[$n.IPAddress]; Note = $note }
    }
}
