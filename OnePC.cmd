            <Border Style="{StaticResource Card}" Padding="20">
              <StackPanel>
                <TextBlock Text="ÉTAT" Style="{StaticResource Tag}" Foreground="#38BDF8"/>
                <TextBlock x:Name="DcState" Text="..." FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="DcSub" Style="{StaticResource Dim}" Margin="0,3,0,14"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="DcRun" Style="{StaticResource Action}" Content="Lancer Discord"/>
                  <Button x:Name="DcRestart" Style="{StaticResource Ghost}" Content="Redémarrer Discord"/>
                  <Button x:Name="DcQuit" Style="{StaticResource Ghost}" Content="Quitter complètement"/>
                </StackPanel>
                <TextBlock x:Name="DcMsg" Text="Redémarrer Discord libère la mémoire qu'il a accumulée : utile quand il dépasse 1 Go." Foreground="#B8B8C0" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="ALLÉGER DISCORD" Style="{StaticResource Tag}" Foreground="#34D399"/>
                <Border BorderBrush="#222227" BorderThickness="0,1,0,0" Padding="0,12">
                  <DockPanel>
                    <Button x:Name="DcCache" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Vider le cache" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel>
                      <TextBlock Text="Vider le cache" FontWeight="SemiBold"/>
                      <TextBlock Text="Images, GIF et vidéos déjà vus que Discord garde sur le disque. Tes messages, serveurs et réglages ne sont pas touchés. Discord est fermé puis relancé." Foreground="#8E8E98" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      <TextBlock x:Name="DcCacheInfo" Text=" " Foreground="#FBBF24" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border BorderBrush="#222227" BorderThickness="0,1,0,0" Padding="0,12">
                  <DockPanel>
                    <Button x:Name="DcHw" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Désactiver" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel>
                      <TextBlock Text="Accélération matérielle" FontWeight="SemiBold"/>
                      <TextBlock Text="Désactivée, Discord n'utilise plus la carte graphique : un peu plus de FPS en jeu, mais les vidéos et partages d'écran sont moins fluides. Discord est fermé puis relancé." Foreground="#8E8E98" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      <TextBlock x:Name="DcHwInfo" Text=" " Foreground="#FBBF24" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border BorderBrush="#222227" BorderThickness="0,1,0,0" Padding="0,12">
                  <DockPanel>
                    <Button x:Name="DcBoot" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Désactiver" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel>
                      <TextBlock Text="Lancement avec Windows" FontWeight="SemiBold"/>
                      <TextBlock Text="Empêche Discord de s'ouvrir tout seul à chaque démarrage du PC." Foreground="#8E8E98" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      <TextBlock x:Name="DcBootInfo" Text=" " Foreground="#FBBF24" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border BorderBrush="#222227" BorderThickness="0,1,0,0" Padding="0,12">
                  <DockPanel>
                    <Button x:Name="DcPrio" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Priorité basse" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel>
                      <TextBlock Text="Priorité pendant le jeu" FontWeight="SemiBold"/>
                      <TextBlock Text="Passe Discord en priorité basse : le jeu passe avant lui quand le processeur est chargé. Si les voix grésillent, remets en normal. Revient en normal au prochain lancement de Discord." Foreground="#8E8E98" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      <TextBlock x:Name="DcPrioInfo" Text=" " Foreground="#FBBF24" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="À RÉGLER DANS DISCORD (PARAMÈTRES UTILISATEUR)" Style="{StaticResource Tag}" Foreground="#FBBF24"/>
                <ItemsControl x:Name="DcTips" ItemTemplate="{StaticResource Row3}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== Réglages ===== -->
        <ScrollViewer x:Name="PageSet" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,8" Visibility="Collapsed">
          <StackPanel Margin="26,4,22,12" MaxWidth="1250">
            <TextBlock Text="Réglages" Style="{StaticResource H}" Margin="0,0,0,2"/>
            <TextBlock x:Name="SetMsg" Text="Les changements sont enregistrés tout de suite." Style="{StaticResource Dim}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="APPARENCE" Style="{StaticResource Tag}" Foreground="#38BDF8"/>
                <TextBlock Text="La couleur d'accent et la page d'ouverture se règlent maintenant dans « Mon profil »." Foreground="#CACAD2" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="SetRestart" Style="{StaticResource Ghost}" Content="Redémarrer OnePC"/>
                  <Button x:Name="SetWelcome" Style="{StaticResource Ghost}" Content="Revoir la présentation"/>
                  <Button x:Name="SetFolder" Style="{StaticResource Ghost}" Content="Ouvrir le dossier de l'appli"/>
                  <Button x:Name="SetUpdate" Style="{StaticResource Ghost}" Content="Vérifier les mises à jour"/>
                </StackPanel>
                <TextBlock x:Name="LicInfo" Foreground="#8E8E98" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="COMPORTEMENT" Style="{StaticResource Tag}" Foreground="#34D399"/>
                <CheckBox x:Name="SetAuto" Foreground="#E8E8EC" Margin="0,0,0,10" Content="Lancer OnePC au démarrage de Windows"/>
                <CheckBox x:Name="SetTray" Foreground="#E8E8EC" Margin="0,0,0,10" Content="Quand je ferme la fenêtre, garder OnePC près de l'horloge (pour les alertes et le menu rapide)"/>
                <CheckBox x:Name="SetDrv" Foreground="#E8E8EC" Margin="0,0,0,10" Content="Rechercher les nouveaux pilotes à chaque lancement"/>
                <CheckBox x:Name="SetDrvAlert" Foreground="#E8E8EC" Content="M'avertir près de l'horloge quand un nouveau pilote graphique sort (vérifié chaque jour, même appli fermée)"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="ALERTES" Style="{StaticResource Tag}" Foreground="#FBBF24"/>
                <CheckBox x:Name="SetAlerts" Foreground="#E8E8EC" Margin="0,0,0,12" Content="M'envoyer une notification Windows en cas de problème"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Carte graphique au-dessus de" Width="230" VerticalAlignment="Center" Foreground="#CACAD2"/>
                  <TextBox x:Name="SetGpu" Width="56" Background="#1D1D22" Foreground="#E8E8EC" BorderBrush="#2E2E35" Padding="6,4" CaretBrush="#E8E8EC"/>
                  <TextBlock Text="°C" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#8E8E98"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Mémoire RAM au-dessus de" Width="230" VerticalAlignment="Center" Foreground="#CACAD2"/>
                  <TextBox x:Name="SetRam" Width="56" Background="#1D1D22" Foreground="#E8E8EC" BorderBrush="#2E2E35" Padding="6,4" CaretBrush="#E8E8EC"/>
                  <TextBlock Text="%" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#8E8E98"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="Disque C: avec moins de" Width="230" VerticalAlignment="Center" Foreground="#CACAD2"/>
                  <TextBox x:Name="SetDisk" Width="56" Background="#1D1D22" Foreground="#E8E8EC" BorderBrush="#2E2E35" Padding="6,4" CaretBrush="#E8E8EC"/>
                  <TextBlock Text="% de libre" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#8E8E98"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="SetSave" Style="{StaticResource Action}" Content="Enregistrer les seuils"/>
                  <Button x:Name="SetTest" Style="{StaticResource Ghost}" Content="Tester une notification"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="TOUT REMETTRE COMME AVANT" Style="{StaticResource Tag}" Foreground="#FB923C"/>
                <TextBlock TextWrapping="Wrap" Foreground="#CACAD2" Margin="0,0,0,10" Text="Annule d'un coup les réglages que OnePC a changés sur ce PC : profil d'alimentation, services arrêtés, DNS, programmes désactivés au démarrage, fond d'écran, thème de Windows, nettoyage automatique et lancement avec Windows. Tu vois la liste exacte avant de confirmer."/>
                <StackPanel Orientation="Horizontal"><Button x:Name="ResetAll" Style="{StaticResource Action}" Content="Tout remettre comme avant"/></StackPanel>
                <TextBlock x:Name="ResetMsg" Text="Ce bouton ne peut pas faire revenir ce qui a été supprimé (nettoyages, applications désinstallées). Pour les fichiers rangés, utilise « Annuler le dernier rangement »." Foreground="#8E8E98" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="WelHost" Grid.ColumnSpan="2" Background="#D90A0A0D" Visibility="Collapsed">
        <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#16161A" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="16">
          <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" Color="#000000"/></Border.Effect>
          <StackPanel Margin="34,30,34,26">
            <Border Width="76" Height="76" CornerRadius="20" Background="#2A1712" HorizontalAlignment="Center">
              <Grid>
                <TextBlock x:Name="WelIcon" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#FF7A5C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="WelLogo" Width="60" Height="60"/>
              </Grid>
            </Border>
            <TextBlock x:Name="WelStep" Style="{StaticResource Tag}" Foreground="#FF7A5C" HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock x:Name="WelTitle" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="WelText" Foreground="#CACAD2" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" MinHeight="88"/>
            <StackPanel x:Name="WelNameBox" HorizontalAlignment="Center" Margin="0,10,0,0">
              <TextBlock Text="Ton pseudo (optionnel)" Foreground="#8E8E98" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,6"/>
              <TextBox x:Name="WelName" Width="240" Padding="8,6" Background="#0E0E11" Foreground="#FFFFFF" BorderBrush="#34343C" CaretBrush="#FFFFFF" FontSize="13.5" MaxLength="24" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="WelDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,18"/>
            <DockPanel>
              <Button x:Name="WelSkip" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Passer"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="WelBack" Style="{StaticResource Ghost}" Content="Retour"/>
                <Button x:Name="WelNext" Style="{StaticResource Action}" Content="Suivant" Margin="0"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>
      <StackPanel x:Name="ToastHost" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22" IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
'@

$appDir = Join-Path $env:LOCALAPPDATA 'OnePC'
if (-not (Test-Path -LiteralPath $appDir)) { New-Item -ItemType Directory -Path $appDir -Force | Out-Null }
$cfgFile = Join-Path $appDir 'reglages.json'
# Ancien nom de l'appli : on reprend ses réglages et ses données avant de charger quoi que ce soit (le plus récent d'abord)
$script:migRun = $false; $script:migCare = $false; $script:migDrv = $false
foreach ($oldName in @(('Sal' + 'Info'), ('Kon' + 'trol'), ('Tweak' + 'Milass'))) {
    $oldHome = Join-Path $env:LOCALAPPDATA $oldName
    $oldCfg = Join-Path $oldHome 'reglages.json'
    if (-not (Test-Path -LiteralPath $oldCfg) -or ("$env:SELF" -like "$oldHome*")) { continue }
    foreach ($f in @(Get-ChildItem -LiteralPath $oldHome -File -ErrorAction SilentlyContinue)) {
        if ($f.Name -like "$oldName*" -or $f.Name -like 'logo*' -or $f.Name -like '*.ico' -or $f.Name -like '*.vbs' -or $f.Name -like '*.ps1' -or $f.Name -like '*.log' -or $f.Name -eq 'exe.v') { continue }
        $dest = Join-Path $appDir $f.Name
        if (-not (Test-Path -LiteralPath $dest)) { try { Copy-Item -LiteralPath $f.FullName -Destination $dest -Force } catch {} }
    }
    # ce qui était activé sous l'ancien nom sera réactivé sous le nouveau
    try { if (Get-ItemProperty -LiteralPath 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name $oldName -ErrorAction Stop) { $script:migRun = $true } } catch {}
    try { if (Get-ScheduledTask -TaskName ($oldName + ' Entretien') -ErrorAction Stop) { $script:migCare = $true } } catch {}
    try { if (Get-ScheduledTask -TaskName ($oldName + ' Pilotes') -ErrorAction Stop) { $script:migDrv = $true } } catch {}
}
$cfg = @{ Accent = 'Rouge'; StartPage = 'Home'; Tray = $false; DrvCheck = $true; Alerts = $true; GpuMax = 85; RamMax = 92; DiskMin = 10; GameApps = @(); BackSrc = ''; BackDst = ''; Games = @(); DnsAlias = ''; StartOff = @(); PlanOrig = ''; AccentHex = ''; NamesClean = $false; Welcome = $false; CalTold = ''; Pseudo = ''; Banner = 0; Since = ''; UpdAsked = ''; ThemeOrig = -1; FastOrig = -1; PadDone = $false }
try {
    $saved = Get-Content -LiteralPath $cfgFile -Raw -Encoding UTF8 -ErrorAction Stop | ConvertFrom-Json
    foreach ($p in $saved.PSObject.Properties) { if ($cfg.ContainsKey($p.Name)) { $cfg[$p.Name] = $p.Value } }
} catch {}
$cfg.GameApps = @($cfg.GameApps | Where-Object { $_ })
function Save-Cfg { try { $cfg | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath $cfgFile -Encoding UTF8 } catch {} }
$logFile = Join-Path $appDir 'journal.txt'
$calFile = Join-Path $appDir 'calendrier.txt'
$calItems = @(
    @{ K = 'clean';   N = 'Nettoyage du PC';             Rx = '^Nettoyage du PC lancé';                                                  Days = 14;  Page = 'Opti'; Tip = 'Fichiers temporaires, cache Windows Update, corbeille' },
    @{ K = 'drv';     N = 'Pilotes vérifiés';            Rx = '^Pilotes vérifiés|^Mise à jour des pilotes lancée|^Installation des pilotes'; Days = 30;  Page = 'Drv';  Tip = 'Carte graphique, processeur, puis le reste' },
    @{ K = 'backup';  N = 'Sauvegarde de tes fichiers';  Rx = '^Sauvegarde : ';                                                          Days = 0;   Page = 'Tidy'; Tip = "Copie d'un dossier important vers un autre disque" },
    @{ K = 'restore'; N = 'Point de restauration';       Rx = '^Point de restauration créé';                                                   Days = 0;   Page = 'Opti'; Tip = 'Pour revenir en arrière si Windows déraille' },
    @{ K = 'cache';   N = 'Cache des navigateurs';       Rx = '^Cache des navigateurs vidé';                                             Days = 30;  Page = 'Care'; Tip = 'Chrome, Edge, Brave, Opera GX, Firefox' },
    @{ K = 'repair';  N = 'Vérification de Windows';     Rx = 'réparation de Windows';                                                   Days = 0;   Page = 'Opti'; Tip = 'DISM + SFC : seulement quand le PC bugge' }
)
function Get-Cal {
    $h = @{}
    try { foreach ($l in @(Get-Content -LiteralPath $calFile -Encoding UTF8 -ErrorAction Stop)) { if ($l -match '^(\w+)=(\d{2}/\d{2}/\d{4} \d{2}:\d{2})$') { $h[$Matches[1]] = [datetime]::ParseExact($Matches[2], 'dd/MM/yyyy HH:mm', [cultureinfo]::InvariantCulture) } } } catch {}
    $h
}
function Set-Cal($h) { try { Set-Content -LiteralPath $calFile -Encoding UTF8 -Value ($h.Keys | ForEach-Object { $_ + '=' + $h[$_].ToString('dd/MM/yyyy HH:mm', [cultureinfo]::InvariantCulture) }) } catch {} }
function Log($t) {
    try { Add-Content -LiteralPath $logFile -Encoding UTF8 -Value ((Get-Date).ToString('dd/MM/yyyy HH:mm', [cultureinfo]::InvariantCulture) + '   ' + $t) } catch {}
    try { foreach ($c in $calItems) { if ([string]$t -match $c.Rx) { $h = Get-Cal; $h[$c.K] = Get-Date; Set-Cal $h } } } catch {}
    try { foreach ($k in $statRx.Keys) { if ([string]$t -match $statRx[$k]) { Add-Stat $k 1 } } } catch {}
}
# compteurs du profil et temps de jeu : petits fichiers « clé=valeur »
$statFile = Join-Path $appDir 'compteurs.txt'; $playFile = Join-Path $appDir 'temps-jeu.txt'
$statRx = @{ clean = '^Nettoyage du PC lancé'; drv = '^Pilotes vérifiés|^Mise à jour des pilotes lancée|^Installation des pilotes'; uninst = '^Application désinstallée|^Jeu Steam désinstallé' }
function Read-Kv($file) {
    $h = @{}
    try { foreach ($l in @(Get-Content -LiteralPath $file -Encoding UTF8 -ErrorAction Stop)) { $i = $l.LastIndexOf('='); if ($i -gt 0) { $v = 0.0; if ([double]::TryParse($l.Substring($i + 1), [System.Globalization.NumberStyles]::Float, [System.Globalization.CultureInfo]::InvariantCulture, [ref]$v)) { $h[$l.Substring(0, $i)] = $v } } } } catch {}
    $h
}
function Write-Kv($file, $h) { try { Set-Content -LiteralPath $file -Encoding UTF8 -Value (@($h.GetEnumerator()) | ForEach-Object { $_.Key + '=' + ([double]$_.Value).ToString('0.##', [System.Globalization.CultureInfo]::InvariantCulture) }) } catch {} }
function Add-Stat($k, $n) { $h = Read-Kv $statFile; $h[$k] = [double]$h[$k] + $n; Write-Kv $statFile $h }
# première fois : on compte ce qui est déjà dans le journal, et on retient la date de première utilisation
try {
    $jl = @(); if (Test-Path -LiteralPath $logFile) { $jl = @(Get-Content -LiteralPath $logFile -Encoding UTF8 -ErrorAction Stop) }
    if (-not (Test-Path -LiteralPath $statFile)) {
        $h = @{}
        foreach ($l in $jl) { if ($l -match '^\d{2}/\d{2}/\d{4} \d{2}:\d{2}\s+(.*)$') { $tx = $Matches[1]; foreach ($k in $statRx.Keys) { if ($tx -match $statRx[$k]) { $h[$k] = [double]$h[$k] + 1 } } } }
        Write-Kv $statFile $h
    }
    if (-not [string]$cfg.Since) {
        $d0 = Get-Date
        foreach ($l in $jl) { if ($l -match '^(\d{2}/\d{2}/\d{4}) ') { try { $dd = [datetime]::ParseExact($Matches[1], 'dd/MM/yyyy', [cultureinfo]::InvariantCulture); if ($dd -lt $d0) { $d0 = $dd } } catch {} } }
        $cfg.Since = $d0.ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture); Save-Cfg
    }
} catch {}
# première fois : on reprend les dates déjà présentes dans le journal
try {
    if (-not (Test-Path -LiteralPath $calFile) -and (Test-Path -LiteralPath $logFile)) {
        $h = @{}
        foreach ($l in @(Get-Content -LiteralPath $logFile -Encoding UTF8 -ErrorAction Stop)) {
            if ($l -match '^(\d{2}/\d{2}/\d{4} \d{2}:\d{2})\s+(.*)$') { $d = [datetime]::ParseExact($Matches[1], 'dd/MM/yyyy HH:mm', [cultureinfo]::InvariantCulture); $tx = $Matches[2]; foreach ($c in $calItems) { if ($tx -match $c.Rx) { $h[$c.K] = $d } } }
        }
        Set-Cal $h
    }
} catch {}
function Get-CalState {
    $h = Get-Cal
    # le nettoyage automatique du dimanche compte aussi
    try { $al = [string](Get-Content -LiteralPath (Join-Path $appDir 'entretien.log') -Encoding UTF8 -ErrorAction Stop | Select-Object -Last 1); if ($al -match '^(\d{2}/\d{2}/\d{4} \d{2}:\d{2})') { $d = [datetime]::ParseExact($Matches[1], 'dd/MM/yyyy HH:mm', [cultureinfo]::InvariantCulture); if (-not $h['clean'] -or $d -gt $h['clean']) { $h['clean'] = $d } } } catch {}
    foreach ($c in $calItems) {
        $d = $h[$c.K]; $age = -1; if ($d) { $age = [int][math]::Floor(((Get-Date) - $d).TotalDays) }
        $lvl = 0
        if ($c.Days -gt 0) { if ($age -lt 0) { $lvl = 1 } elseif ($age -gt $c.Days) { $lvl = 2 } }
        $when = "jamais fait avec OnePC"
        if ($age -eq 0) { $when = "aujourd'hui" } elseif ($age -eq 1) { $when = 'hier' } elseif ($age -gt 1) { $when = "il y a $age jours" }
        if ($d) { $when += '  (' + $d.ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture) + ')' }
        $st = 'OK'; if ($lvl -eq 1) { $st = 'À faire' } elseif ($lvl -eq 2) { $st = 'En retard' }
        if ($c.Days -eq 0) { $st = 'Au besoin' }
        $rule = 'au besoin'; if ($c.Days -gt 0) { $rule = 'tous les ' + $c.Days + ' jours' }
        @{ Item = $c; When = $when; Level = $lvl; Status = $st; Rule = $rule; Age = $age; Date = $d }
    }
}
$cfg.StartOff = @($cfg.StartOff | Where-Object { $_.Key } | ForEach-Object { @{ Ap = [string]$_.Ap; Key = [string]$_.Key; Admin = [bool]$_.Admin; Name = [string]$_.Name } })
$cfg.Games = @($cfg.Games | Where-Object { $_.Path } | ForEach-Object { @{ Name = [string]$_.Name; Path = [string]$_.Path } })
$accents = [ordered]@{
    'Rouge' = '#FF5A3C', '#FF7A5C', '#2A1712'; 'Bleu' = '#3B82F6', '#60A5FA', '#121C30'; 'Vert' = '#22C55E', '#4ADE80', '#10241A'
    'Jaune' = '#F59E0B', '#FBBF24', '#2A2010'; 'Rose' = '#EC4899', '#F472B6', '#2A1220'; 'Cyan' = '#06B6D4', '#22D3EE', '#0E2227'
    'Violet' = '#8B5CF6', '#A78BFA', '#1C1630'; 'Orange' = '#F97316', '#FB923C', '#2A1A0E'; 'Or' = '#EAB308', '#FACC15', '#28220C'
    'Turquoise' = '#14B8A6', '#2DD4BF', '#0E2421'; 'Blanc' = '#9CA3AF', '#E5E7EB', '#202024'
}
function Mix-Hex($hex, $with, $t) {
    $o = '#'
    for ($i = 1; $i -lt 7; $i += 2) {
        $a = [Convert]::ToInt32($hex.Substring($i, 2), 16); $b = [Convert]::ToInt32($with.Substring($i, 2), 16)
        $o += ([int][math]::Round($a + ($b - $a) * $t)).ToString('X2')
    }
    $o
}
if ([string]$cfg.AccentHex -match '^#[0-9A-Fa-f]{6}$') {
    $hx = ([string]$cfg.AccentHex).ToUpper()
    $accents['Perso'] = $hx, (Mix-Hex $hx '#FFFFFF' 0.25), (Mix-Hex '#121216' $hx 0.14)
}
if (-not $accents.Contains([string]$cfg.Accent)) { $cfg.Accent = 'Rouge' }
