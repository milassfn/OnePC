function Update-ObsScore {
    if (-not $script:obsHw) { $script:obsHw = Get-ObsHw }
    $hw = $script:obsHw; $cur = Get-ObsCur
    $use = [string]$cfg.ObsUse; if (-not $use) { $use = 'twitch' }
    $rec = Get-ObsRec $use $hw $script:obsUp ''
    $pts = 0
    if (-not $cur) {
        foreach ($n in 'Enc', 'Qual', 'Net') { Set-Tile $n 'none' '—' "OBS n'a pas encore de réglages : lance-le une fois." '' '' '' }
        (UI 'ObsScore').Text = '--'; (UI 'ObsScoreTxt').Text = 'Lance OBS une première fois'; return
    }
    # encodeur
    $curGpu = ($cur.Enc -notmatch '(?i)x264'); $canGpu = ($hw.Vendor -ne 'cpu')
    if ($curGpu -or -not $canGpu) { Set-Tile 'Enc' 'ok' (Enc-Name $cur.Enc) 'Bon choix pour ton PC.' 'Encodeur' "OBS encode avec $(Enc-Name $cur.Enc). C'est le bon choix : ton jeu garde ses FPS." ''; $pts += 34 }
    else { Set-Tile 'Enc' 'bad' (Enc-Name $cur.Enc) 'Ton processeur fait tout le travail : le jeu perd des FPS.' 'Encodeur' "OBS utilise ton processeur (x264) alors que ta carte graphique ($($hw.Gpu)) a une puce faite exprès pour ça. En passant dessus, ton jeu garde ses FPS et le live ne saccade plus." 'wizard'; $pts += 8 }
    # qualité
    $qState = 'ok'; $qTxt = 'Adapté à ton PC et à ta connexion.'; $qDet = "Sortie $($cur.OutW)x$($cur.OutH) à $($cur.Fps) images/s, $($cur.Kbps) kbit/s."
    if ($use -eq 'twitch' -and $cur.Kbps -gt 6500) { $qState = 'warn'; $qTxt = 'Débit trop haut pour Twitch.'; $qDet += " Twitch limite le débit à environ 6000 kbit/s : au-dessus, une partie de tes viewers voit ton live saccader." }
    elseif ($script:obsUp -gt 0 -and $cur.Kbps -gt $script:obsUp * 1000 * 0.8) { $qState = 'bad'; $qTxt = 'Débit plus haut que ta connexion.'; $qDet += " Ta connexion envoie environ $([math]::Round($script:obsUp,1)) Mbit/s : c'est trop juste pour ce débit, ton live va perdre des images." }
    elseif ($cur.OutH -gt 0 -and $rec.OutH -gt 0 -and $cur.OutH -lt $rec.OutH -and $cur.Kbps -lt $rec.Kbps) { $qState = 'warn'; $qTxt = 'Ton PC peut faire mieux.'; $qDet += " Ton PC et ta connexion permettent $($rec.OutW)x$($rec.OutH) à $($rec.Fps) images/s." }
    $ptsQ = @{ ok = 33; warn = 20; bad = 6 }[$qState]; $pts += $ptsQ
    Set-Tile 'Qual' $qState ("$($cur.OutH)p$($cur.Fps) · $($cur.Kbps) kbit/s") $qTxt 'Qualité vidéo' $qDet $(if ($qState -ne 'ok') { 'wizard' } else { '' })
    # connexion
    if ($script:obsUp -le 0) { Set-Tile 'Net' 'none' $(if ($hw.Wifi) { 'Wi-Fi' } else { 'Câble' }) 'Clique pour tester ton débit d''envoi.' 'Connexion' "Le débit d'envoi (upload) décide de la qualité maximale de ton live. Le test envoie quelques Mo et prend 10 secondes." 'uptest'; $pts += 20 }
    else {
        $u = [math]::Round($script:obsUp, 1); $need = [math]::Max(1, $cur.Kbps) / 1000.0
        if ($u -lt $need * 1.25) { Set-Tile 'Net' 'bad' "$u Mbit/s en envoi" 'Trop juste pour ton débit.' 'Connexion' "Ton live envoie $need Mbit/s mais ta connexion n'en envoie que $u. Baisse le débit (l'assistant le fait pour toi) ou branche-toi en câble." 'wizard'; $pts += 5 }
        elseif ($hw.Wifi) { Set-Tile 'Net' 'warn' "$u Mbit/s en Wi-Fi" 'Le Wi-Fi peut couper ton live.' 'Connexion' "Le débit est bon, mais le Wi-Fi a des micro-coupures qui font perdre des images en live. Un câble Ethernet entre le PC et la box règle ça." 'uptest'; $pts += 22 }
        else { Set-Tile 'Net' 'ok' "$u Mbit/s en câble" 'Parfait pour streamer.' 'Connexion' "Câble et $u Mbit/s en envoi : largement assez pour ton live." 'uptest'; $pts += 33 }
    }
    (UI 'ObsScore').Text = [string][math]::Min(100, $pts)
    $col = '#34D399'; if ($pts -lt 80) { $col = '#FBBF24' }; if ($pts -lt 50) { $col = '#F87171' }
    (UI 'ObsScore').Foreground = $brush.ConvertFromString($col)
    (UI 'ObsScoreTxt').Text = $(if ($pts -ge 80) { 'Setup au top' } elseif ($pts -ge 50) { 'Peut mieux faire' } else { 'À régler' })
}
