                <TextBlock x:Name="TempGpu" Text=" " Foreground="#FBBF24" HorizontalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
              <StackPanel>
                <Grid Width="110" Height="110">
