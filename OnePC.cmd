function Get-WallBrush($d) {
    $bmp = New-Object System.Drawing.Bitmap 352, 198
    $g = [System.Drawing.Graphics]::FromImage($bmp); Draw-Wall $g 352 198 $d; $g.Dispose()
    $ms = New-Object System.IO.MemoryStream
    $bmp.Save($ms, [System.Drawing.Imaging.ImageFormat]::Png); $bmp.Dispose(); $ms.Position = 0
    $bi = New-Object System.Windows.Media.Imaging.BitmapImage
    $bi.BeginInit(); $bi.StreamSource = $ms; $bi.CacheOption = 'OnLoad'; $bi.EndInit(); $bi.Freeze()
    New-Object System.Windows.Media.ImageBrush $bi
}
function Update-Cust {
    foreach ($h in 'CustA', 'CustB') {
        $sel = $script:custA; if ($h -eq 'CustB') { $sel = $script:custB }
        foreach ($c in (UI $h).Children) {
            if ([string]$c.Tag -eq $sel) { $c.BorderBrush = $brush.ConvertFromString($accent); $c.BorderThickness = New-Object System.Windows.Thickness 3 }
            else { $c.BorderBrush = $brush.ConvertFromString('#34343C'); $c.BorderThickness = New-Object System.Windows.Thickness 1 }
        }
    }
    try { (UI 'CustPrev').Background = Get-WallBrush (Get-CustDesign) } catch {}
}
$script:custReady = $false
function Load-Cust {
    if ($script:custReady) { return }
    $script:custReady = $true
    foreach ($h in 'CustA', 'CustB') {
        foreach ($col in $custColors) {
            $sw = New-Object System.Windows.Controls.Border
            $sw.Width = 28; $sw.Height = 28; $sw.CornerRadius = New-Object System.Windows.CornerRadius 7
            $sw.Margin = New-Object System.Windows.Thickness 0, 0, 6, 6
            $sw.Background = $brush.ConvertFromString($col); $sw.Tag = $col; $sw.Cursor = [System.Windows.Input.Cursors]::Hand
            $sw.Add_MouseLeftButtonUp({
                param($sender, $e)
                if ($sender.Parent.Name -eq 'CustA') { $script:custA = [string]$sender.Tag } else { $script:custB = [string]$sender.Tag }
                Update-Cust
            })
            [void](UI $h).Children.Add($sw)
        }
    }
    foreach ($t in $custTypes) { $ci = New-Object System.Windows.Controls.ComboBoxItem; $ci.Content = $t[0]; $ci.Tag = $t[1]; [void](UI 'CustType').Items.Add($ci) }
    (UI 'CustType').SelectedIndex = 1
    (UI 'CustType').Add_SelectionChanged({ Update-Cust })
    Update-Cust
}
