                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                  <TextBlock x:Name="MouseBrand" Text="SOURIS" Style="{StaticResource Tag}" Foreground="#38BDF8"/>
                  <TextBlock x:Name="MouseName" Text="Détection de la souris..." FontSize="24" FontWeight="SemiBold" Margin="0,2,0,2" TextTrimming="CharacterEllipsis"/>
