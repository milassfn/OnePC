                  </StackPanel>
                  <TextBlock Text="Branche ou allume ta manette : OnePC la reconnaît tout seul quand cette page est ouverte." Style="{StaticResource Dim}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>
              <Border Style="{StaticResource Card}" BorderBrush="#A78BFA" BorderThickness="1.5">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <Button x:Name="BtnPad" Style="{StaticResource Action}" Content="Optimiser ma manette"/>
                    <Button x:Name="BtnPadOrig" Style="{StaticResource Ghost}" Content="Remettre d'origine" ToolTip="Réactive la veille des ports USB comme avant"/>
                  </StackPanel>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,7,0"/>
                      <TextBlock Text="MANETTE — ANTI-LAG" Style="{StaticResource Tag}" Foreground="#A78BFA"/>
                    </StackPanel>
                    <TextBlock x:Name="PadInfo" Text="..." FontSize="16" FontWeight="SemiBold" Margin="0,2,0,6"/>
                    <TextBlock x:Name="PadMsg" TextWrapping="Wrap" Foreground="#CACAD2" LineHeight="20"
                               Text="Enlève le délai que Windows ajoute à la manette : empêche la mise en veille des ports USB et garde le PC réactif. Pour le moins de lag possible, branche ta manette en filaire (USB). Réversible, et un redémarrage finalise le réglage."/>
                  </StackPanel>
                </DockPanel>
              </Border>
          </StackPanel>
        </ScrollViewer>
        <!-- ===== Souris ===== -->
        <ScrollViewer x:Name="PageMouse" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,8" Visibility="Collapsed">
          <StackPanel Margin="26,4,22,12" MaxWidth="1250">
            <TextBlock Text="Souris" Style="{StaticResource H}" Margin="0,0,0,2"/>
            <TextBlock Text="Règle ta souris pour viser juste : vitesse du curseur et accélération de Windows" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
            <TextBlock x:Name="MouseMsg" Text=" " Foreground="#B8B8C0" FontSize="12" Margin="0,0,0,8"/>
            <Border Style="{StaticResource Card}" Padding="22">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
