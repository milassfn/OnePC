$speedCode = {
    param($x)
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $down = 0; $up = 0
    try {
        $buf = New-Object byte[] 262144; $tot = 0; $sw = $null
        while ($tot -lt 250000000 -and (-not $sw -or $sw.Elapsed.TotalSeconds -lt 8)) {
            $req = [Net.HttpWebRequest]::Create('https://speed.cloudflare.com/__down?bytes=25000000')
            $req.Timeout = 10000; $req.ReadWriteTimeout = 10000; $req.UserAgent = 'Mozilla/5.0 OnePC'
            $resp = $req.GetResponse(); $st = $resp.GetResponseStream()
            if (-not $sw) { $sw = [Diagnostics.Stopwatch]::StartNew() }
            while ($sw.Elapsed.TotalSeconds -lt 8) { $n = $st.Read($buf, 0, $buf.Length); if ($n -le 0) { break }; $tot += $n }
            try { $req.Abort() } catch {}; try { $resp.Close() } catch {}
        }
        if ($sw -and $sw.Elapsed.TotalSeconds -gt 0.2) { $down = [math]::Round($tot * 8 / $sw.Elapsed.TotalSeconds / 1000000, 1) }
    } catch {}
    try {
        $req = [Net.HttpWebRequest]::Create('https://speed.cloudflare.com/__up')
        $req.Method = 'POST'; $req.SendChunked = $true; $req.AllowWriteStreamBuffering = $false
        $req.Timeout = 10000; $req.ReadWriteTimeout = 10000; $req.UserAgent = 'OnePC'
        $st = $req.GetRequestStream()
        $buf = New-Object byte[] 65536; (New-Object Random).NextBytes($buf); $tot = 0
        $sw = [Diagnostics.Stopwatch]::StartNew()
        while ($sw.Elapsed.TotalSeconds -lt 6 -and $tot -lt 100000000) { $st.Write($buf, 0, $buf.Length); $tot += $buf.Length }
        $sw.Stop(); try { $req.Abort() } catch {}
        if ($sw.Elapsed.TotalSeconds -gt 0.2) { $up = [math]::Round($tot * 8 / $sw.Elapsed.TotalSeconds / 1000000, 1) }
    } catch {}
    $down; $up
}
