            foreach ($l in @(& netsh wlan show profile ("name=" + $n) key=clear 2>$null)) { if ($l -match 'Key Content|Contenu de la cl' -and $l -match ':\s(.+)$') { $key = $Matches[1].Trim() } }
            [pscustomobject]@{ N = [string]$n; K = [string]$key }
