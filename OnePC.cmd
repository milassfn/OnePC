function Show-Page($key) {
    foreach ($k in $pages.Keys) {
        $nav = UI $pages[$k][0]; $page = UI $pages[$k][1]
        if ($k -eq $key) {
            if ($page.Visibility -ne 'Visible' -and $win.IsVisible) {
                try {
                    $ease = New-Object System.Windows.Media.Animation.CubicEase
                    $d1 = New-Object System.Windows.Media.Animation.DoubleAnimation
                    $d1.From = 0.0; $d1.To = 1.0; $d1.Duration = [System.Windows.Duration][TimeSpan]::FromMilliseconds(220)
                    $page.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $d1)
                    $tt = New-Object System.Windows.Media.TranslateTransform
                    $page.RenderTransform = $tt
                    $d2 = New-Object System.Windows.Media.Animation.DoubleAnimation
                    $d2.From = 14.0; $d2.To = 0.0; $d2.Duration = [System.Windows.Duration][TimeSpan]::FromMilliseconds(260); $d2.EasingFunction = $ease
                    $tt.BeginAnimation([System.Windows.Media.TranslateTransform]::YProperty, $d2)
                } catch {}
            }
            $page.Visibility = 'Visible'
            $nav.Background = $brush.ConvertFromString($accentDark); $nav.Foreground = $brush.ConvertFromString($accentLight)
            (UI 'PageTitle').Text = $pages[$k][2]
        } else {
            $page.Visibility = 'Collapsed'
            $nav.Background = $brush.ConvertFromString('Transparent'); $nav.Foreground = $brush.ConvertFromString('#9C9CA6')
        }
    }
    $toastWas = $script:toastOn; $script:toastOn = $false
    try {
        if ($key -eq 'Start') { Load-Startup }
        if ($key -eq 'Disk')  { Load-Disks }
        if ($key -eq 'Opti')  { Update-Power; Show-Fast; Update-Pad }
        if ($key -eq 'Light') { Load-Light }
        if ($key -eq 'Wall')  { Load-Walls; Load-Cust }
        if ($key -eq 'Crash') { Load-Crashes }
        if ($key -eq 'Drv' -and -not $script:drvLoaded) { $script:drvLoaded = $true; Load-Drivers }
        if ($key -eq 'Care')  { Show-CareState; Show-Cal }
        if ($key -eq 'Me')    { Show-Me }
        if ($key -eq 'Home' -and [string]$cfg.Pseudo) { $hello = 'Bonjour'; $hr = (Get-Date).Hour; if ($hr -ge 18 -or $hr -lt 5) { $hello = 'Bonsoir' }; (UI 'PageTitle').Text = $hello + ' ' + [string]$cfg.Pseudo }
        if ($key -eq 'Hist')  { Load-Log }
        if ($key -eq 'Obs')   { Show-Obs }
        if ($key -eq 'Dc')    { Show-Dc; Show-DcOptions }
        if ($key -eq 'Tools') { Update-HzBtn }
        if ($key -eq 'Apps' -and -not $script:apps) { Load-AppList }
        if ($key -eq 'Proc')  { (UI 'ProcList').ItemsSource = $sync.Procs }
    } catch {}
    $script:toastOn = $toastWas
}
