# ---------- OBS : connexion (websocket intégré à OBS 28+) ----------
function Init-ObsWs {
    if ('PCM.ObsWs' -as [type]) { return }
    Add-Type -TypeDefinition @"
using System;
using System.Text;
using System.Threading;
using System.Net.WebSockets;
namespace PCM {
public class ObsWs {
    ClientWebSocket ws;
    public bool Open(string url, int ms) {
        try { ws = new ClientWebSocket(); var t = ws.ConnectAsync(new Uri(url), CancellationToken.None); return t.Wait(ms) && ws.State == WebSocketState.Open; } catch { return false; }
    }
    public bool IsOpen { get { return ws != null && ws.State == WebSocketState.Open; } }
    public bool Send(string s, int ms) {
        try { var b = Encoding.UTF8.GetBytes(s); return ws.SendAsync(new ArraySegment<byte>(b), WebSocketMessageType.Text, true, CancellationToken.None).Wait(ms); } catch { return false; }
    }
    public string Recv(int ms) {
        try {
            var buf = new byte[65536]; var sb = new StringBuilder();
            var cts = new CancellationTokenSource(ms);
            while (true) {
                var t = ws.ReceiveAsync(new ArraySegment<byte>(buf), cts.Token); t.Wait();
                sb.Append(Encoding.UTF8.GetString(buf, 0, t.Result.Count));
                if (t.Result.EndOfMessage) break;
            }
            return sb.ToString();
        } catch { return null; }
    }
    public void Close() { try { if (ws != null) ws.Abort(); } catch { } ws = null; }
