    if (Connect-Obs) { $script:obsWait.Stop(); (UI 'ObsAutoLink').IsEnabled = $true; Show-ObsLink; (UI 'ObsMsg').Text = 'Connecté à OBS ! Tu peux maintenant régler OBS, ton micro et suivre ton live.' }
    elseif ($script:obsWaitN -ge 8) { $script:obsWait.Stop(); (UI 'ObsAutoLink').IsEnabled = $true; Show-ObsLink; (UI 'ObsSetupState').Text = 'Pas encore connecté.'; (UI 'ObsSetupHelp').Visibility = 'Visible' }
})
