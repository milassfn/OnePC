    'Documents'     = 'pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'txt', 'odt', 'ods', 'csv', 'rtf', 'md'
    'Archives'      = 'zip', 'rar', '7z', 'tar', 'gz', 'iso'
