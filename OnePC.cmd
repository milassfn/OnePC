(UI 'HistClear').Add_Click({ if (Ask "Vider l'historique des modifications ?`r`nCela n'annule rien, la liste est seulement effacée.") { Remove-Item -LiteralPath $logFile -Force -ErrorAction SilentlyContinue; Load-Log } })
