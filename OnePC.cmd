$typeNames = @{ DISPLAY = 'Graphique'; PROCESSOR = 'Processeur'; NET = 'Réseau'; MEDIA = 'Audio'; BLUETOOTH = 'Bluetooth'; HDC = 'Stockage'; SCSIADAPTER = 'Stockage' }
function Load-Drivers {
    $seen = @{}
    $rows = @(Get-CimInstance Win32_PnPSignedDriver |
        Where-Object { $typeNames.ContainsKey([string]$_.DeviceClass) -and $_.DeviceName } |
        Sort-Object @{ Expression = { if ($_.DeviceClass -eq 'DISPLAY') { 0 } elseif ($_.DeviceClass -eq 'PROCESSOR') { 1 } else { 2 } } }, DeviceClass, DeviceName |
        ForEach-Object {
            $key = $_.DeviceName + '|' + $_.DriverVersion
            if (-not $seen.ContainsKey($key)) {
                $seen[$key] = 1
                $dt = ''; if ($_.DriverDate) { $dt = ([datetime]$_.DriverDate).ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture) }
                [pscustomobject]@{ Type = $typeNames[[string]$_.DeviceClass]; Device = [string]$_.DeviceName; Maker = [string]$_.Manufacturer; Version = [string]$_.DriverVersion; Date = $dt }
            }
        })
    (UI 'DrvList').ItemsSource = $rows
}
