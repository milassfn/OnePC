    $hasTheme = ([int]$cfg.ThemeOrig -ne -1)
    if ($hasTheme) { $todo += "Thème de Windows remis en " + $(if ([int]$cfg.ThemeOrig) { 'clair' } else { 'sombre' }) }
    $hasTask = [bool](Get-ScheduledTask -TaskName $careTask -ErrorAction SilentlyContinue)
