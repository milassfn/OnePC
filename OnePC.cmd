            $w2.Write([uint32]40); $w2.Write([int32]$sz); $w2.Write([int32]($sz * 2)); $w2.Write([uint16]1); $w2.Write([uint16]32)
            $w2.Write([uint32]0); $w2.Write([uint32]0); $w2.Write([int32]0); $w2.Write([int32]0); $w2.Write([uint32]0); $w2.Write([uint32]0)
            for ($y = $sz - 1; $y -ge 0; $y--) { $w2.Write($raw, $y * $sz * 4, $sz * 4) }
            $mask = New-Object byte[] ([int]([math]::Ceiling($sz / 32.0) * 4) * $sz)
            $w2.Write($mask, 0, $mask.Length); $w2.Flush()
            $blobs += , $m2.ToArray()
        }
        $fs2 = [System.IO.File]::Create($ico2); $bw2 = New-Object System.IO.BinaryWriter $fs2
        $bw2.Write([uint16]0); $bw2.Write([uint16]1); $bw2.Write([uint16]$sizes.Count)
        $off = 6 + 16 * $sizes.Count
        for ($i = 0; $i -lt $sizes.Count; $i++) {
            $bw2.Write([byte]($sizes[$i] -band 0xFF)); $bw2.Write([byte]($sizes[$i] -band 0xFF)); $bw2.Write([byte]0); $bw2.Write([byte]0)
            $bw2.Write([uint16]1); $bw2.Write([uint16]32); $bw2.Write([uint32]$blobs[$i].Length); $bw2.Write([uint32]$off)
            $off += $blobs[$i].Length
        }
        foreach ($bl in $blobs) { $bw2.Write($bl, 0, $bl.Length) }
        $bw2.Close(); $fs2.Close()
    }
    # Vrai exécutable : un petit lanceur compilé sur place, sans fenêtre noire
    $exe = Join-Path $appDir 'OnePC.exe'; $appExe = $exe; $exeMark = Join-Path $appDir 'exe.v'
    if ($hostExe) {
        if ($hostExe -ne $exe) {
            $instV = $null; try { $instV = [version]([System.Diagnostics.FileVersionInfo]::GetVersionInfo($exe).FileVersion) } catch {}
            $markNow = [string](Get-Content -LiteralPath $exeMark -ErrorAction SilentlyContinue)
            if ($markNow -eq 'H' -and $instV -and $instV -gt [version]($appVersion + '.0')) { $script:oldFile = $true }
            else { try { Copy-Item -LiteralPath $hostExe -Destination $exe -Force; Set-Content -LiteralPath $exeMark -Value 'H' } catch {} }
        } else { try { Set-Content -LiteralPath $exeMark -Value 'H' } catch {} }
        foreach ($oldF in 'OnePC.cmd', 'OnePC.cmd.avant', 'OnePC.vbs', 'maj.tmp') { Remove-Item -LiteralPath (Join-Path $appDir $oldF) -Force -ErrorAction SilentlyContinue }
    } elseif (-not (Test-Path -LiteralPath $exe) -or ([string](Get-Content -LiteralPath $exeMark -ErrorAction SilentlyContinue) -ne '2')) {
        try {
            $cs = @'
using System;
using System.Diagnostics;
using System.IO;
using System.Reflection;
[assembly: AssemblyTitle("OnePC")]
[assembly: AssemblyProduct("OnePC")]
[assembly: AssemblyVersion("1.0.0.0")]
static class Launcher {
