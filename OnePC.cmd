    Start-Bg $reportCode @{ Dir = $dir; Accent = $accent; CpuT = [int]$sync.CpuT; GpuT = [int]$sync.GpuT; Cpu = [int]$sync.Cpu; Gpu = [int]$sync.Gpu; Ram = [int]$sync.Ram } {
