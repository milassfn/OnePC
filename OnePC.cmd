function Update-ObsState {
    $running = [bool](Get-Process -Name 'obs64' -ErrorAction SilentlyContinue)
    foreach ($b in 'ObsRun', 'ObsRec', 'ObsStream', 'ObsReplay') { (UI $b).IsEnabled = ([bool]$script:obsExe -and -not $running) }
    (UI 'ObsClose').IsEnabled = $running
    if ($script:obsExe) { if ($running) { (UI 'ObsState').Text = 'OBS est ouvert' } else { (UI 'ObsState').Text = 'OBS est fermé' } }
}
(UI 'ObsClose').Add_Click({
    $p = @(Get-Process -Name 'obs64' -ErrorAction SilentlyContinue)
    if ($p.Count -eq 0) { Update-ObsState; return }
    foreach ($x in $p) { try { [void]$x.CloseMainWindow() } catch {} }
    for ($i = 0; $i -lt 25 -and (Get-Process -Name 'obs64' -ErrorAction SilentlyContinue); $i++) { Start-Sleep -Milliseconds 200 }
    if (Get-Process -Name 'obs64' -ErrorAction SilentlyContinue) {
        if (Ask "OBS ne s'est pas fermé tout seul : il demande sans doute une confirmation parce qu'un enregistrement ou un stream est en cours.`r`n`r`nForcer la fermeture ? L'enregistrement en cours peut être perdu ou abîmé.") {
            Get-Process -Name 'obs64' -ErrorAction SilentlyContinue | ForEach-Object { try { $_.Kill() } catch {} }
            Start-Sleep -Milliseconds 500
            (UI 'ObsMsg').Text = 'OBS a été fermé de force.'
        } else { (UI 'ObsMsg').Text = "OBS est resté ouvert : regarde sa fenêtre, il attend ta réponse." }
    } else { (UI 'ObsMsg').Text = 'OBS est fermé.' }
    Update-ObsState
})
