function Get-MicNames {
    $n = @(); $sp = Obs-Req 'GetSpecialInputs' $null
    if ($sp) { foreach ($k in 'mic1', 'mic2', 'mic3', 'mic4') { if ($sp.$k) { $n += [string]$sp.$k } } }
    $il = Obs-Req 'GetInputList' @{ inputKind = 'wasapi_input_capture' }
    if ($il) { foreach ($i in @($il.inputs)) { $n += [string]$i.inputName } }
    @($n | Select-Object -Unique)
}
$micFilters = @(
    @{ N = 'OnePC - Suppression du bruit'; K = 'noise_suppress_filter_v2'; S = @{ method = 'rnnoise' } },
    @{ N = 'OnePC - Coupure auto'; K = 'noise_gate_filter'; S = @{ open_threshold = -26.0; close_threshold = -32.0; attack_time = 25; hold_time = 200; release_time = 150 } },
    @{ N = 'OnePC - Voix égalisée'; K = 'compressor_filter'; S = @{ ratio = 4.0; threshold = -18.0; attack_time = 6; release_time = 60; output_gain = 0.0 } },
    @{ N = 'OnePC - Anti-saturation'; K = 'limiter_filter'; S = @{ threshold = -6.0; release_time = 60 } }
)
(UI 'MicFix').Add_Click({
    if (-not (Need-Obs (UI 'MicMsg'))) { return }
    $mics = Get-MicNames
    if ($mics.Count -eq 0) { (UI 'MicMsg').Text = "OBS n'a pas de micro : ajoute ton micro dans OBS (Paramètres > Audio > Micro/Auxiliaire) puis recommence."; return }
    $done = 0
    foreach ($mic in $mics) {
        $ex = @(); $fl = Obs-Req 'GetSourceFilterList' @{ sourceName = $mic }; if ($fl) { $ex = @($fl.filters | ForEach-Object { [string]$_.filterName }) }
        foreach ($f in $micFilters) { if ($ex -notcontains $f.N) { if (Obs-Req 'CreateSourceFilter' @{ sourceName = $mic; filterName = $f.N; filterKind = $f.K; filterSettings = $f.S }) { $done++ } } }
    }
    (UI 'MicMsg').Text = "C'est fait sur : " + ($mics -join ', ') + ". Parle dans ton micro : le bruit de fond est coupé. Tu les vois dans OBS (clic droit sur le micro > Filtres)."
    Log 'OBS : filtres micro ajoutés'
})
(UI 'MicUndo').Add_Click({
    if (-not (Need-Obs (UI 'MicMsg'))) { return }
    foreach ($mic in (Get-MicNames)) { foreach ($f in $micFilters) { [void](Obs-Req 'RemoveSourceFilter' @{ sourceName = $mic; filterName = $f.N }) } }
    (UI 'MicMsg').Text = 'Filtres de OnePC retirés du micro.'
})
