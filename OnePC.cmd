# ---------- Réseau : appareils ----------
$devCode = {
    param($x)
    $c = Get-NetIPConfiguration -ErrorAction SilentlyContinue | Where-Object { $_.IPv4DefaultGateway } | Select-Object -First 1
    if (-not $c) { return }
    $ip = [string]@($c.IPv4Address)[0].IPAddress; $gw = [string]@($c.IPv4DefaultGateway)[0].NextHop
    $base = (($ip -split '\.')[0..2]) -join '.'
    $tasks = New-Object 'System.Collections.Generic.List[System.Threading.Tasks.Task]'
    foreach ($i in 1..254) { try { $tasks.Add((New-Object System.Net.NetworkInformation.Ping).SendPingAsync("$base.$i", 700)) } catch {} }
    try { [void][System.Threading.Tasks.Task]::WaitAll($tasks.ToArray(), 5000) } catch {}
    $found = @(Get-NetNeighbor -InterfaceIndex $c.InterfaceIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue |
        Where-Object { $_.IPAddress -like "$base.*" -and $_.State -ne 'Unreachable' -and $_.State -ne 'Incomplete' -and $_.LinkLayerAddress -and $_.LinkLayerAddress -notmatch '^(FF-FF-FF|00-00-00-00-00-00|01-00-5E)' })
    $names = @{}
    $look = @{}; foreach ($n in $found) { try { $look[$n.IPAddress] = [System.Net.Dns]::GetHostEntryAsync($n.IPAddress) } catch {} }
    try { [void][System.Threading.Tasks.Task]::WaitAll([System.Threading.Tasks.Task[]]@($look.Values), 4000) } catch {}
    foreach ($k in $look.Keys) { try { if ($look[$k].Status -eq 'RanToCompletion') { $names[$k] = $look[$k].Result.HostName } } catch {} }
    [pscustomobject]@{ IP = $ip; Mac = ''; Name = $env:COMPUTERNAME; Note = 'Ce PC' }
    foreach ($n in $found) {
        $note = ''; if ($n.IPAddress -eq $gw) { $note = 'Box / routeur' }
        [pscustomobject]@{ IP = $n.IPAddress; Mac = $n.LinkLayerAddress; Name = [string]$names[$n.IPAddress]; Note = $note }
    }
}
(UI 'DevScan').Add_Click({
    (UI 'DevScan').IsEnabled = $false; (UI 'DevMsg').Text = 'Recherche en cours, environ 10 secondes...'
    Start-Bg $devCode 0 {
        param($r)
        (UI 'DevScan').IsEnabled = $true
        $rows = @($r | Where-Object { $_.IP } | Sort-Object { [int](($_.IP -split '\.')[-1]) } | ForEach-Object {
            $label = $_.Name; if (-not $label) { $label = 'Nom inconnu' }; if ($_.Note) { $label = $_.Note + "  ·  " + $label }
            Row $_.IP $label $_.Mac
        })
        (UI 'DevList').ItemsSource = $rows
        if ($rows.Count) { (UI 'DevMsg').Text = "" + $rows.Count + " appareil(s) trouvé(s). Ceux qui sont en veille peuvent ne pas répondre." } else { (UI 'DevMsg').Text = "Aucun réseau local détecté." }
    }
})

# ---------- Réseau : DNS ----------
function Set-Dns($servers, $label) {
    $alias = ''; try { $alias = [string](Get-NetIPConfiguration | Where-Object { $_.IPv4DefaultGateway } | Select-Object -First 1).InterfaceAlias } catch {}
    if (-not $alias) { (UI 'DnsMsg').Text = "Aucune connexion active trouvée."; return }
    $a = $alias.Replace("'", "''")
    if ($servers) { $code = "Set-DnsClientServerAddress -InterfaceAlias '$a' -ServerAddresses (" + (($servers | ForEach-Object { "'" + $_ + "'" }) -join ',') + "); Clear-DnsClientCache" }
    else { $code = "Set-DnsClientServerAddress -InterfaceAlias '$a' -ResetServerAddresses; Clear-DnsClientCache" }
    if (Run-Console $code -HiddenWait) { Log "DNS : $label (connexion $alias)"; if ($servers) { $cfg.DnsAlias = $alias } else { $cfg.DnsAlias = '' }; Save-Cfg; (UI 'DnsMsg').Text = "DNS réglé sur $label pour « $alias ». L'encadré Connexion se met à jour dans quelques secondes." }
    else { (UI 'DnsMsg').Text = 'Annulé (droits administrateur refusés).' }
}
(UI 'DnsCf').Add_Click({ Set-Dns @('1.1.1.1', '1.0.0.1') 'Cloudflare' })
(UI 'DnsGoogle').Add_Click({ Set-Dns @('8.8.8.8', '8.8.4.4') 'Google' })
