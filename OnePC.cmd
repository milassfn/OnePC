$connCode = {
    param($a)
    try {
        Get-NetTCPConnection -State Established -ErrorAction Stop |
            Where-Object { $_.RemoteAddress -notmatch '^(127\.|::1|0\.0\.0\.0|::$)' } | Group-Object OwningProcess | ForEach-Object {
                $pn = ''; try { $pn = (Get-Process -Id $_.Name -ErrorAction Stop).ProcessName } catch { $pn = "processus " + $_.Name }
                [pscustomobject]@{ P = $pn; N = $_.Count; H = @($_.Group | Select-Object -ExpandProperty RemoteAddress -Unique).Count }
            } | Group-Object P | ForEach-Object {
                [pscustomobject]@{ P = $_.Name; N = ($_.Group | Measure-Object N -Sum).Sum; H = ($_.Group | Measure-Object H -Sum).Sum }
            } | Sort-Object N -Descending
    } catch { 'ERR' }
}
