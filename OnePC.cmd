function Run-Faq($t) {
    if ($t -notmatch '^cmd:') { Show-Page $t; return }
    switch ($t) {
        'cmd:sound' { try { Start-Process 'ms-settings:sound' } catch {} }
        'cmd:net'   { try { Start-Process 'ms-settings:network-status' } catch {} }
        'cmd:notif' { try { Start-Process 'ms-settings:notifications' } catch {} }
        'cmd:dns'   { try { & ipconfig /flushdns | Out-Null; (UI 'HelpMsg').Text = 'Cache DNS vidé.'; Log 'Cache DNS vidé (Aide)' } catch {} }
        'cmd:audio' { if (Run-Console "Restart-Service -Name AudioEndpointBuilder -Force; Start-Service -Name Audiosrv" -HiddenWait) { (UI 'HelpMsg').Text = 'Service son de Windows relancé.'; Log 'Service son relancé (Aide)' } else { (UI 'HelpMsg').Text = 'Annulé (droits administrateur refusés).' } }
    }
}
