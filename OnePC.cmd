function Show-News($lines) {
    $host3 = UI 'NewsList'; $host3.Children.Clear()
    $items = @()
    foreach ($l in @($lines)) { $p = ([string]$l).Split('|'); if ($p.Count -ge 2 -and $p[0].Trim() -match '^\d') { $items += [pscustomobject]@{ D = $p[0].Trim(); T = $p[1].Trim(); X = $(if ($p.Count -ge 3) { ($p[2..($p.Count - 1)] -join '|').Trim() } else { '' }) } } }
    if ($items.Count -eq 0) { $e = New-Object System.Windows.Controls.TextBlock; $e.Text = "Pas d'annonce pour l'instant."; $e.Foreground = $brush.ConvertFromString('#8E8E98'); [void]$host3.Children.Add($e); return }
    $first = $true
    foreach ($it in @($items | Select-Object -First 6)) {
        $bd = New-Object System.Windows.Controls.Border; $bd.Padding = New-Object System.Windows.Thickness 0, 10, 0, 10
        if (-not $first) { $bd.BorderBrush = $brush.ConvertFromString('#222227'); $bd.BorderThickness = New-Object System.Windows.Thickness 0, 1, 0, 0 }
        $sp = New-Object System.Windows.Controls.StackPanel
        $h = New-Object System.Windows.Controls.TextBlock; $h.Text = $it.T; $h.FontWeight = 'SemiBold'; $h.FontSize = 14; $h.TextWrapping = 'Wrap'; if ($first) { $h.Foreground = $brush.ConvertFromString($accentLight) }
        $d = New-Object System.Windows.Controls.TextBlock; $d.Text = $it.D; $d.Foreground = $brush.ConvertFromString('#8E8E98'); $d.FontSize = 11
        [void]$sp.Children.Add($h); [void]$sp.Children.Add($d)
        if ($it.X) { $x = New-Object System.Windows.Controls.TextBlock; $x.Text = $it.X; $x.Foreground = $brush.ConvertFromString('#CACAD2'); $x.TextWrapping = 'Wrap'; $x.Margin = New-Object System.Windows.Thickness 0, 4, 0, 0; [void]$sp.Children.Add($x) }
        $bd.Child = $sp; [void]$host3.Children.Add($bd); $first = $false
