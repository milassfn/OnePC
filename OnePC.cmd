                  <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="MouseDetect" Style="{StaticResource Ghost}" Content="Détecter ma souris"/>
                    <Button x:Name="MousePhoto" Style="{StaticResource Ghost}" Content="Mettre ma photo"/>
                    <Button x:Name="MousePhotoDel" Style="{StaticResource Ghost}" Content="Retirer ma photo" Visibility="Collapsed"/>
                  </StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1C1C22" CornerRadius="10" Padding="16,12">
                      <StackPanel>
                        <TextBlock Text="Vitesse du curseur" Foreground="#CACAD2" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                          <Button x:Name="MouseMinus" Style="{StaticResource Ghost}" Content="−" Width="40" Margin="0,0,12,0"/>
                          <TextBlock x:Name="MouseSpeedVal" Text="10" FontSize="34" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                          <TextBlock Text=" / 20" Foreground="#8E8E98" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,12,8"/>
                          <Button x:Name="MousePlus" Style="{StaticResource Ghost}" Content="+" Width="40"/>
