# ---------- Fréquence de l'écran ----------
function Ensure-Disp {
    if ('PcmDisp.Disp' -as [type]) { return }
    Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
namespace PcmDisp {
    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Ansi)]
    public struct DEVMODE {
        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string dmDeviceName;
        public short dmSpecVersion; public short dmDriverVersion; public short dmSize; public short dmDriverExtra; public int dmFields;
        public int dmPositionX; public int dmPositionY; public int dmDisplayOrientation; public int dmDisplayFixedOutput;
        public short dmColor; public short dmDuplex; public short dmYResolution; public short dmTTOption; public short dmCollate;
        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string dmFormName;
        public short dmLogPixels; public int dmBitsPerPel; public int dmPelsWidth; public int dmPelsHeight; public int dmDisplayFlags; public int dmDisplayFrequency;
        public int dmICMMethod; public int dmICMIntent; public int dmMediaType; public int dmDitherType; public int dmReserved1; public int dmReserved2;
        public int dmPanningWidth; public int dmPanningHeight;
    }
    public static class Disp {
        [DllImport("user32.dll", CharSet = CharSet.Ansi)] static extern bool EnumDisplaySettings(string dev, int mode, ref DEVMODE dm);
        [DllImport("user32.dll", CharSet = CharSet.Ansi)] static extern int ChangeDisplaySettings(ref DEVMODE dm, int flags);
        static DEVMODE Fresh() { DEVMODE d = new DEVMODE(); d.dmSize = (short)Marshal.SizeOf(typeof(DEVMODE)); return d; }
        // largeur, hauteur, fréquence actuelle, fréquence maximale à cette résolution
        public static int[] Info() {
            DEVMODE cur = Fresh();
            if (!EnumDisplaySettings(null, -1, ref cur)) return new int[] { 0, 0, 0, 0 };
            int max = cur.dmDisplayFrequency;
            for (int i = 0; i < 4000; i++) {
                DEVMODE d = Fresh();
                if (!EnumDisplaySettings(null, i, ref d)) break;
                if (d.dmPelsWidth == cur.dmPelsWidth && d.dmPelsHeight == cur.dmPelsHeight && d.dmBitsPerPel == cur.dmBitsPerPel && d.dmDisplayFrequency > max) max = d.dmDisplayFrequency;
            }
            return new int[] { cur.dmPelsWidth, cur.dmPelsHeight, cur.dmDisplayFrequency, max };
        }
        public static int Set(int hz) {
            DEVMODE d = Fresh();
            if (!EnumDisplaySettings(null, -1, ref d)) return -99;
            d.dmDisplayFrequency = hz; d.dmFields = 0x80000 | 0x100000 | 0x400000;
            int t = ChangeDisplaySettings(ref d, 2);
            if (t != 0) return t;
            return ChangeDisplaySettings(ref d, 1);
        }
    }
}
'@
}
$script:hzBtn = $null
function Update-HzBtn {
    try {
        Ensure-Disp; $i = [PcmDisp.Disp]::Info()
        if ($script:hzBtn -and $i[2] -gt 0) {
            if ($i[3] -gt $i[2]) { $script:hzBtn.Content = "Fréquence de l'écran : " + $i[2] + " Hz (peut monter à " + $i[3] + " Hz)" }
            else { $script:hzBtn.Content = "Fréquence de l'écran : " + $i[2] + " Hz" }
        }
    } catch {}
}
function Use-Hz {
    try {
        Ensure-Disp; $i = [PcmDisp.Disp]::Info()
        if ($i[2] -le 0) { throw 'x' }
        $res = "" + $i[0] + " x " + $i[1]
        if (($i[3] - $i[2]) -ge 2) {
            if (Ask ("Ton écran principal est réglé sur " + $i[2] + " Hz en $res, alors qu'il accepte " + $i[3] + " Hz.`r`n`r`nPasser à " + $i[3] + " Hz maintenant ? L'écran devient noir une seconde.")) {
                $r = [PcmDisp.Disp]::Set($i[3])
                if ($r -eq 0) { Log ("Fréquence de l'écran : " + $i[2] + " Hz -> " + $i[3] + " Hz"); (UI 'ToolsMsg').Text = "Écran passé à " + $i[3] + " Hz." }
                else { (UI 'ToolsMsg').Text = "Windows a refusé ce changement. Règle-le dans la page Écran de Windows, rubrique « Affichage avancé »."; Open-Settings 'ms-settings:display-advanced' }
            }
        } else { (UI 'ToolsMsg').Text = "Ton écran principal est à " + $i[2] + " Hz en $res : c'est le maximum qu'il accepte à cette résolution." }
        Update-HzBtn
    } catch { (UI 'ToolsMsg').Text = "Impossible de lire la fréquence de l'écran : ouverture de la page Écran de Windows."; Open-Settings 'ms-settings:display-advanced' }
}

# ---------- Icônes du Bureau : masquer / afficher ----------
function Switch-DeskIcons {
    try {
        if (-not ('PcmDesk.Desk' -as [type])) {
            $cs = @'
using System; using System.Runtime.InteropServices;
namespace PcmDesk {
  public static class Desk {
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] static extern IntPtr FindWindow(string c, string w);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] static extern IntPtr FindWindowEx(IntPtr p, IntPtr a, string c, string w);
    [DllImport("user32.dll")] static extern IntPtr SendMessage(IntPtr h, uint m, IntPtr w, IntPtr l);
    [DllImport("user32.dll")] static extern bool IsWindowVisible(IntPtr h);
    static IntPtr View() {
      IntPtr v = FindWindowEx(FindWindow("Progman", null), IntPtr.Zero, "SHELLDLL_DefView", null);
      if (v == IntPtr.Zero) {
        IntPtr w = IntPtr.Zero;
        while ((w = FindWindowEx(IntPtr.Zero, w, "WorkerW", null)) != IntPtr.Zero) { v = FindWindowEx(w, IntPtr.Zero, "SHELLDLL_DefView", null); if (v != IntPtr.Zero) break; }
      }
      return v;
    }
    public static int Shown() {
      IntPtr v = View(); if (v == IntPtr.Zero) return -1;
      IntPtr l = FindWindowEx(v, IntPtr.Zero, "SysListView32", null); if (l == IntPtr.Zero) return -1;
      return IsWindowVisible(l) ? 1 : 0;
    }
    public static bool Toggle() { IntPtr v = View(); if (v == IntPtr.Zero) return false; SendMessage(v, 0x111, (IntPtr)0x7402, IntPtr.Zero); return true; }
  }
}
'@
            Add-Type -TypeDefinition $cs
        }
        $before = [PcmDesk.Desk]::Shown()
        if (-not [PcmDesk.Desk]::Toggle()) { (UI 'ToolsMsg').Text = "Le Bureau de Windows n'a pas répondu : fais clic droit sur le Bureau > Affichage > Afficher les éléments du Bureau."; return }
        Start-Sleep -Milliseconds 250
        $after = [PcmDesk.Desk]::Shown()
        if ($after -eq 0) { (UI 'ToolsMsg').Text = "Icônes du Bureau masquées. Tes fichiers sont toujours là : reclique pour les réafficher."; Log 'Icônes du Bureau masquées' }
        elseif ($after -eq 1) { (UI 'ToolsMsg').Text = 'Icônes du Bureau affichées.'; Log 'Icônes du Bureau affichées' }
        else { (UI 'ToolsMsg').Text = 'Affichage des icônes du Bureau basculé.' }
    } catch { (UI 'ToolsMsg').Text = "Impossible de basculer les icônes du Bureau : clic droit sur le Bureau > Affichage > Afficher les éléments du Bureau." }
}

# ---------- Raccourcis Windows ----------
function Open-Tool($c) {
    (UI 'ToolsMsg').Text = ' '
    try {
        switch ($c) {
            '!explorer' {
                if (-not (Ask "Redémarrer l'Explorateur Windows ?`r`nLa barre des tâches et le Bureau disparaissent 2 secondes puis reviennent. Utile quand la barre des tâches bugge.")) { return }
                Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 2
                if (-not (Get-Process -Name explorer -ErrorAction SilentlyContinue)) { Start-Process explorer }
                return
            }
            '!bios' {
                if (-not (Ask "Redémarrer le PC directement dans le BIOS ?`r`nEnregistre ton travail avant : le PC redémarre dans 5 secondes.")) { return }
                if (-not (Run-Console 'shutdown /r /fw /t 5' -Admin)) { (UI 'ToolsMsg').Text = 'Annulé (droits administrateur refusés).' }
                return
            }
            '!advboot' {
                if (-not (Ask "Redémarrer sur le menu de dépannage de Windows (mode sans échec, restauration...) ?`r`nEnregistre ton travail avant : le PC redémarre dans 5 secondes.")) { return }
                Start-Process shutdown -ArgumentList '/r /o /t 5' -WindowStyle Hidden; return
            }
            '!hz' { Use-Hz; return }
            '!deskicons' { Switch-DeskIcons; return }
            '!clip' { [System.Windows.Clipboard]::Clear(); (UI 'ToolsMsg').Text = 'Presse-papiers vidé.'; return }
        }
        if ($c -like '!page:*') { Show-Page $c.Substring(6); return }
        if ($c -like 'ms-settings:*') { Open-Settings $c; return }
        $p = $c -split '\|', 2
        $f = [Environment]::ExpandEnvironmentVariables($p[0])
        if ($p.Count -gt 1) { Start-Process -FilePath $f -ArgumentList $p[1] } else { Start-Process -FilePath $f }
    } catch { (UI 'ToolsMsg').Text = "Ce raccourci n'existe pas sur cette version de Windows." }
}
