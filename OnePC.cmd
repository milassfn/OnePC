# Autres jeux ajoutés par l'utilisateur
function Start-Game($g, $boost) {
    if (-not (Test-Path -LiteralPath $g.Path)) { (UI 'GameMsg2').Text = "Le fichier de « " + $g.Name + " » est introuvable : retire-le puis ajoute-le de nouveau."; return }
    $closed = 0
    if ($boost) {
        $proc = Get-GameProc $g.Path
        $closed = Start-Boost $g.Name $proc
    }
    try {
        Start-Process -FilePath $g.Path -WorkingDirectory (Split-Path -Parent $g.Path)
        Start-PlayTrack $g.Name (Get-GameProc $g.Path)
        if ($boost) { (UI 'GameMsg2').Text = "Profil Jeu activé, $closed application(s) fermée(s), lancement de " + $g.Name + "..." } else { (UI 'GameMsg2').Text = "Lancement de " + $g.Name + "..." }
    } catch { (UI 'GameMsg2').Text = "Impossible de lancer " + $g.Name + "." }
}
function Get-NiceName($path) {
    # nom propre pour l'affichage : « SpotifySetup » -> « Spotify », « lghub_installer » -> « Logitech G HUB »
    $base = [System.IO.Path]::GetFileNameWithoutExtension([string]$path)
    $n = ''
    try {
        $t = [string]$path
        if ($t -match '\.lnk$') { $n = $base }
        elseif ($t -match '\.exe$' -and (Test-Path -LiteralPath $t)) {
            $vi = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($t)
            $n = [string]$vi.ProductName; if (-not $n.Trim()) { $n = [string]$vi.FileDescription }
        }
    } catch {}
    if (-not $n.Trim()) { $n = $base }
    $n = $n -replace '[\s\-_]*\bv?\d+(\.\d+)+', ' '
    $n = $n -replace '[_\.]+', ' ' -creplace '(?<=[a-z])(?=[A-Z][a-z])', ' '
    $n = $n -replace '(?i)\b(web\s*)?(setup|installer|installation|install|launcher|bootstrapper|downloader|x64|x86|win64|win32|64\s*bit|32\s*bit|amd64)\b', ' '
    $n = $n -replace '(?i)\bv?\d+(\s*\.\s*\d+)+\b', ' ' -replace '[\(\)\[\]]', ' ' -replace '\s+', ' '
    $n = $n.Trim(' ', '-', '_')
    $known = @{ 'lghub' = 'Logitech G HUB'; 'lg hub' = 'Logitech G HUB'; 'chatgpt' = 'ChatGPT'; 'chat gpt' = 'ChatGPT'; 'fivem' = 'FiveM'; 'obs64' = 'OBS Studio'; 'cs2' = 'Counter-Strike 2'; 'gta5' = 'GTA V'; 'r5apex' = 'Apex Legends'; 'valorant' = 'Valorant'; 'robloxplayerbeta' = 'Roblox'; 'javaw' = 'Minecraft' }
    if ($known.ContainsKey($n.ToLower())) { return $known[$n.ToLower()] }
    if (-not $n) { $n = $base }
    if ($n.Length -gt 1 -and $n -ceq $n.ToLower()) { $n = $n.Substring(0, 1).ToUpper() + $n.Substring(1) }
    $n
}
