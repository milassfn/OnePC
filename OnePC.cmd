# ---------- analyse du dernier live (journal d'OBS) ----------
function Add-LogLine($host2, $state, $title, $txt) {
    $col = @{ ok = '#34D399'; warn = '#FBBF24'; bad = '#F87171'; info = '#9C9CA6' }[$state]
    $dp = New-Object System.Windows.Controls.DockPanel; $dp.Margin = New-Object System.Windows.Thickness 0, 4, 0, 6
    $e = New-Object System.Windows.Shapes.Ellipse; $e.Width = 10; $e.Height = 10; $e.Fill = $brush.ConvertFromString($col); $e.Margin = New-Object System.Windows.Thickness 0, 5, 10, 0; $e.VerticalAlignment = 'Top'; [System.Windows.Controls.DockPanel]::SetDock($e, 'Left')
    $sp = New-Object System.Windows.Controls.StackPanel
    $a = New-Object System.Windows.Controls.TextBlock; $a.Text = $title; $a.FontWeight = 'SemiBold'; $a.TextWrapping = 'Wrap'
    $b = New-Object System.Windows.Controls.TextBlock; $b.Text = $txt; $b.Foreground = $brush.ConvertFromString('#CACAD2'); $b.TextWrapping = 'Wrap'
    [void]$sp.Children.Add($a); if ($txt) { [void]$sp.Children.Add($b) }; [void]$dp.Children.Add($e); [void]$dp.Children.Add($sp); [void]$host2.Children.Add($dp)
}
function Run-ObsLog {
    $hb = UI 'ObsLogBody'; $hb.Children.Clear()
    $logs = @(Get-ChildItem -LiteralPath (Join-Path $obsCfgDir 'logs') -Filter '*.txt' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 15)
    $f = $null; $txt = ''
    foreach ($l in $logs) { try { $c = [System.IO.File]::ReadAllText($l.FullName) } catch { continue }; if ($c -match 'dropped frames due to insufficient bandwidth|Streaming Start') { $f = $l; $txt = $c; break } }
    if (-not $f) { Add-LogLine $hb 'info' 'Aucun live trouvé' "OBS n'a pas encore de journal de live. Fais un live (même court), puis reviens ici."; return }
    Add-LogLine $hb 'info' ('Live du ' + $f.LastWriteTime.ToString('dd/MM/yyyy à HH:mm')) ''
    $pct = { param($rx) $m = [regex]::Matches($txt, $rx); if ($m.Count) { $g = $m[$m.Count - 1].Groups; if ($g['p'].Success) { [double]($g['p'].Value -replace ',', '.') } elseif ($g['a'].Success -and [double]$g['b'].Value -gt 0) { [math]::Round(100 * [double]$g['a'].Value / [double]$g['b'].Value, 1) } else { 0.0 } } else { -1.0 } }
    $net = & $pct 'insufficient bandwidth[^:]*:\s*\d+\s*\((?<p>[\d\.,]+)%\)'
    $enc = & $pct 'skipped frames due to encoding lag:\s*(?<a>\d+)/(?<b>\d+)(?:\s*\((?<p>[\d\.,]+)%\))?'
    $ren = & $pct 'lagged frames due to rendering lag[^:]*:\s*\d+\s*\((?<p>[\d\.,]+)%\)'
    $bad = 0
    if ($net -ge 1) { $bad++; Add-LogLine $hb $(if ($net -ge 5) { 'bad' } else { 'warn' }) "$net % d'images perdues à cause du réseau" "Ta connexion n'arrivait pas à envoyer tout le débit. Baisse le débit vidéo (l'assistant le fait), ou passe en câble si tu es en Wi-Fi." }
    elseif ($net -ge 0) { Add-LogLine $hb 'ok' 'Réseau : pas de souci' "Moins de 1 % d'images perdues par la connexion." }
    if ($enc -ge 1) { $bad++; Add-LogLine $hb $(if ($enc -ge 5) { 'bad' } else { 'warn' }) "$enc % d'images sautées : l'encodeur était surchargé" "OBS n'arrivait pas à compresser la vidéo assez vite. Passe sur l'encodeur de ta carte graphique, ou baisse la résolution ou les FPS : l'assistant choisit pour toi." }
    elseif ($enc -ge 0) { Add-LogLine $hb 'ok' 'Encodeur : pas de souci' "L'encodage a suivi sans problème." }
    if ($ren -ge 1) { $bad++; Add-LogLine $hb $(if ($ren -ge 5) { 'bad' } else { 'warn' }) "$ren % d'images ratées au rendu : le jeu prenait toute la carte graphique" "Bloque les FPS de ton jeu (par exemple à 144 ou à la fréquence de ton écran) pour laisser un peu de carte graphique à OBS. Lancer OBS en administrateur aide aussi." }
    elseif ($ren -ge 0) { Add-LogLine $hb 'ok' 'Rendu : pas de souci' 'La carte graphique avait assez de marge pour OBS.' }
    if ($bad -eq 0 -and ($net -ge 0 -or $enc -ge 0)) { Add-LogLine $hb 'ok' 'Ton dernier live était propre 👌' 'Rien à corriger.' }
    if ($txt -match 'Disconnected|Reconnecting') { Add-LogLine $hb 'warn' 'Le live a été coupé au moins une fois' 'OBS a dû se reconnecter : coupure de ta connexion ou de ta box.' }
}
