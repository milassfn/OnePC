function Show-Me {
    $name = [string]$cfg.Pseudo; if (-not $name.Trim()) { $name = 'Choisis ton pseudo' }
    (UI 'MeName').Text = $name
    $gpuN = ([string]$mainGpu.Name) -replace '^(NVIDIA|AMD)\s+', '' -replace '\(TM\)|\(R\)', ''
    $cpuN = ([string]$cpu.Name) -replace '\(TM\)|\(R\)|CPU|Processor|\d+-Core|@.*$', '' -replace '\s+', ' '
    (UI 'MeLine').Text = ($gpuN.Trim() + '   ·   ' + $cpuN.Trim() + '   ·   ' + [math]::Round($ramGo) + ' Go')
    Set-MeAvatar; Set-MeBanner
    $st = Get-PcState
    (UI 'MeState').Text = $st.Word; (UI 'MeState').Foreground = $brush.ConvertFromString($st.Col); (UI 'MeStateDot').Fill = $brush.ConvertFromString($st.Col)
    (UI 'MeStateWhy').Text = 'État du PC : ' + $st.Why
    # chiffres
    $h = Read-Kv $statFile
    $days = 0; try { $days = [int][math]::Floor(((Get-Date) - [datetime]::ParseExact([string]$cfg.Since, 'dd/MM/yyyy', [cultureinfo]::InvariantCulture)).TotalDays) } catch {}
    $play = Read-Kv $playFile; $tot = 0.0; foreach ($kv in @($play.GetEnumerator())) { $tot += [double]$kv.Value }
    $totTxt = Format-Play $tot; if ($tot -lt 60) { $totTxt = '0 min' }
    $ms = UI 'MeStats'; $ms.Children.Clear()
    [void]$ms.Children.Add((New-MeTile ("$days j") ("avec OnePC (depuis le " + [string]$cfg.Since + ")") '#38BDF8'))
    [void]$ms.Children.Add((New-MeTile ([int]$h['clean']) 'nettoyage(s) du PC' '#34D399'))
    [void]$ms.Children.Add((New-MeTile ([int]$h['drv']) 'vérification(s) de pilotes' '#FBBF24'))
    [void]$ms.Children.Add((New-MeTile ([int]$h['games']) 'jeu(x) lancé(s) depuis l''appli' '#F472B6'))
    [void]$ms.Children.Add((New-MeTile ([int]$h['uninst']) 'application(s) désinstallée(s)' '#FB923C'))
    [void]$ms.Children.Add((New-MeTile $totTxt 'de jeu mesuré' '#A78BFA'))
    # jeux
    $mg = UI 'MeGames'; $mg.Children.Clear()
    $list = @()
    if ($epicOk -and $fnDir) { $list += @{ Name = 'Fortnite'; G = $null } }
    foreach ($g in $cfg.Games) { $list += @{ Name = [string]$g.Name; G = $g } }
    $list = @($list | Sort-Object { -[double]$play[$_.Name] })
    if ($list.Count -eq 0) {
        $e = New-Object System.Windows.Controls.TextBlock; $e.Text = "Aucun jeu pour l'instant : ajoute-les dans l'onglet Jeux."; $e.Foreground = $brush.ConvertFromString('#CACAD2')
        [void]$mg.Children.Add($e)
    }
    $max = 1.0; foreach ($x in $list) { if ([double]$play[$x.Name] -gt $max) { $max = [double]$play[$x.Name] } }
    $first = $true
    foreach ($x in $list) {
        $bd = New-Object System.Windows.Controls.Border; $bd.Padding = New-Object System.Windows.Thickness 0, 9, 0, 9
        if (-not $first) { $bd.BorderBrush = $brush.ConvertFromString('#222227'); $bd.BorderThickness = New-Object System.Windows.Thickness 0, 1, 0, 0 }
        $first = $false
        $gr = New-Object System.Windows.Controls.Grid
        foreach ($w in 220, 0, 130, 84) { $cd = New-Object System.Windows.Controls.ColumnDefinition; if ($w -eq 0) { $cd.Width = New-Object System.Windows.GridLength ([double]1), ([System.Windows.GridUnitType]::Star) } else { $cd.Width = New-Object System.Windows.GridLength ([double]$w) }; [void]$gr.ColumnDefinitions.Add($cd) }
        $t1 = New-Object System.Windows.Controls.TextBlock; $t1.Text = $x.Name; $t1.FontWeight = 'SemiBold'; $t1.VerticalAlignment = 'Center'; $t1.TextTrimming = 'CharacterEllipsis'
        $sec = [double]$play[$x.Name]
        $track = New-Object System.Windows.Controls.Grid; $track.Height = 6; $track.VerticalAlignment = 'Center'; $track.Margin = New-Object System.Windows.Thickness 0, 0, 16, 0
        $c1 = New-Object System.Windows.Controls.ColumnDefinition; $c2 = New-Object System.Windows.Controls.ColumnDefinition
        $ratio = [math]::Max(0.0, [math]::Min(1.0, $sec / $max)); if ($sec -lt 60) { $ratio = 0.0 }
        $c1.Width = New-Object System.Windows.GridLength ([double][math]::Max(0.0001, $ratio)), ([System.Windows.GridUnitType]::Star); $c2.Width = New-Object System.Windows.GridLength ([double][math]::Max(0.0001, 1 - $ratio)), ([System.Windows.GridUnitType]::Star)
        [void]$track.ColumnDefinitions.Add($c1); [void]$track.ColumnDefinitions.Add($c2)
        $bg = New-Object System.Windows.Controls.Border; $bg.CornerRadius = New-Object System.Windows.CornerRadius 3; $bg.Background = $brush.ConvertFromString('#2A2A31'); [System.Windows.Controls.Grid]::SetColumnSpan($bg, 2)
        $fl = New-Object System.Windows.Controls.Border; $fl.CornerRadius = New-Object System.Windows.CornerRadius 3; $fl.Background = $brush.ConvertFromString($accent)
        [void]$track.Children.Add($bg); if ($ratio -gt 0) { [void]$track.Children.Add($fl) }
        $t2 = New-Object System.Windows.Controls.TextBlock; $t2.Text = Format-Play $sec; $t2.Foreground = $brush.ConvertFromString('#CACAD2'); $t2.VerticalAlignment = 'Center'
        $bt = New-Object System.Windows.Controls.Button; $bt.Style = $win.FindResource('Mini'); $bt.Content = 'Lancer'; $bt.Tag = $x; $bt.VerticalAlignment = 'Center'
        $bt.Add_Click({ param($sender, $e) $t = $sender.Tag; if ($t.G) { Start-Game $t.G $false } else { Start-Fortnite $false }; (UI 'MeMsg').Text = 'Lancement de ' + $t.Name + '...' })
        $i = 0; foreach ($el in $t1, $track, $t2, $bt) { [System.Windows.Controls.Grid]::SetColumn($el, $i); [void]$gr.Children.Add($el); $i++ }
        $bd.Child = $gr; [void]$mg.Children.Add($bd)
    }
}
