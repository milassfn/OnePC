    $have = ''; if (Test-Path -LiteralPath $lnkPath) { $have = [string]$wsh.CreateShortcut($lnkPath).TargetPath }
    $haveIcon = ''; if (Test-Path -LiteralPath $lnkPath) { $haveIcon = [string]$wsh.CreateShortcut($lnkPath).IconLocation }
    if ($have -ne $want -or $haveIcon -notlike '*onepc-b.ico*') {
