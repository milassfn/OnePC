# ---------- Plantages ----------
$crashCode = {
    param($x)
    $since = (Get-Date).AddDays(-30)
    $out = @()
    try {
        Get-WinEvent -FilterHashtable @{ LogName = 'System'; Id = 41, 1001, 6008; StartTime = $since } -MaxEvents 60 -ErrorAction Stop | ForEach-Object {
            if ($_.Id -eq 41 -and $_.ProviderName -match 'Kernel-Power') { $out += [pscustomobject]@{ T = $_.TimeCreated; K = 'Arrêt brutal'; D = "Le PC s'est éteint sans s'arrêter proprement (coupure, plantage ou bouton d'alimentation)." } }
            elseif ($_.Id -eq 1001 -and $_.ProviderName -match 'BugCheck|WER-SystemErrorReporting') {
                $code = ''; try { $code = [string]$_.Properties[0].Value } catch {}
                $out += [pscustomobject]@{ T = $_.TimeCreated; K = 'Écran bleu'; D = "Code d'erreur : " + ($code -split ' ')[0] }
            }
            elseif ($_.Id -eq 6008) { $out += [pscustomobject]@{ T = $_.TimeCreated; K = 'Arrêt inattendu'; D = "Windows signale que l'arrêt précédent n'était pas prévu." } }
        }
    } catch {}
    try {
        Get-WinEvent -FilterHashtable @{ LogName = 'Application'; ProviderName = 'Application Error', 'Application Hang'; StartTime = $since } -MaxEvents 60 -ErrorAction Stop | ForEach-Object {
            $app = ''; try { $app = [string]$_.Properties[0].Value } catch {}
            $kind = 'Application plantée'; if ($_.ProviderName -eq 'Application Hang') { $kind = 'Application bloquée' }
            $out += [pscustomobject]@{ T = $_.TimeCreated; K = $kind; D = $app }
        }
    } catch {}
    $out | Sort-Object T -Descending | Select-Object -First 80
}
function Load-Crashes {
    (UI 'CrashScan').IsEnabled = $false; (UI 'CrashMsg').Text = 'Lecture du journal de Windows...'
    Start-Bg $crashCode 0 {
        param($r)
        (UI 'CrashScan').IsEnabled = $true
        $rows = @($r | Where-Object { $_.K } | ForEach-Object { Row $_.T.ToString('dd/MM/yyyy HH:mm', [cultureinfo]::InvariantCulture) $_.D $_.K })
        (UI 'CrashList').ItemsSource = $rows
        $sys = @($r | Where-Object { $_.K -in 'Écran bleu', 'Arrêt brutal', 'Arrêt inattendu' }).Count
        if ($rows.Count -eq 0) { (UI 'CrashMsg').Text = "Aucun plantage enregistré sur les 30 derniers jours." }
        else { (UI 'CrashMsg').Text = "" + $rows.Count + " événement(s), dont $sys concernant Windows lui-même (écrans bleus, arrêts brutaux). La même application qui revient souvent mérite une réinstallation ou une mise à jour." }
    }
}
