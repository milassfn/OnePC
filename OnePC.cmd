# Action de tâche planifiée qui lance un script sans faire clignoter de fenêtre noire
function New-HiddenTaskAction($ps1) {
    $v = [string]$ps1 + '.vbs'
    $line = 'CreateObject("WScript.Shell").Run "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File ""' + [string]$ps1 + '""", 0, False'
    Set-Content -LiteralPath $v -Value $line -Encoding Unicode
    New-ScheduledTaskAction -Execute 'wscript.exe' -Argument ('"' + $v + '"')
}
function Repair-TaskAction($taskName, $ps1) {
    # tâche créée par une ancienne version : on remplace son action pour supprimer le clignotement
    try {
        $t = Get-ScheduledTask -TaskName $taskName -ErrorAction Stop
        if ((Test-Path -LiteralPath $ps1) -and [string]$t.Actions[0].Execute -match 'powershell') { Set-ScheduledTask -TaskName $taskName -Action (New-HiddenTaskAction $ps1) -ErrorAction Stop | Out-Null }
    } catch {}
}
