# ---------- OBS Studio ----------
$obsCfgDir = Join-Path $env:APPDATA 'obs-studio'
function Find-Obs {
    $dirs = @()
    foreach ($k in 'HKLM:\SOFTWARE\OBS Studio', 'HKLM:\SOFTWARE\WOW6432Node\OBS Studio') {
        try { $v = [string](Get-Item -LiteralPath $k -ErrorAction Stop).GetValue(''); if ($v) { $dirs += $v } } catch {}
    }
    $dirs += (Join-Path $env:ProgramFiles 'obs-studio'); if (${env:ProgramFiles(x86)}) { $dirs += (Join-Path ${env:ProgramFiles(x86)} 'obs-studio') }
    foreach ($d in $dirs) { $e = Join-Path $d 'bin\64bit\obs64.exe'; if (Test-Path -LiteralPath $e) { return $e } }
    return ''
}
function Read-Ini($path) {
    $h = @{}; $sec = ''
    try {
        foreach ($l in (Get-Content -LiteralPath $path -Encoding UTF8 -ErrorAction Stop)) {
            $t = ([string]$l).Trim().TrimStart([char]0xFEFF)
            if ($t -match '^\[(.+)\]$') { $sec = $Matches[1] }
            elseif ($t -match '^([^=]+)=(.*)$') { $h[$sec + '.' + $Matches[1].Trim()] = $Matches[2].Trim() }
        }
    } catch {}
    $h
}
function Get-ObsProfile {
    $dir = ''; $name = ''
    foreach ($f in 'user.ini', 'global.ini') {
        $g = Read-Ini (Join-Path $obsCfgDir $f)
        if ($g['Basic.ProfileDir']) { $dir = $g['Basic.ProfileDir']; $name = $g['Basic.Profile']; break }
    }
    $root = Join-Path $obsCfgDir 'basic\profiles'
    $ini = ''
    if ($dir) { $ini = Join-Path (Join-Path $root $dir) 'basic.ini' }
    if (-not $ini -or -not (Test-Path -LiteralPath $ini)) {
        $first = Get-ChildItem -LiteralPath $root -Directory -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($first) { $ini = Join-Path $first.FullName 'basic.ini'; $name = $first.Name }
    }
    if (-not $ini -or -not (Test-Path -LiteralPath $ini)) { return $null }
    $p = Read-Ini $ini; $p['_Name'] = $name
    $p
}
function Get-ObsRecDir($p) {
    $d = ''
    if ($p) { if ($p['Output.Mode'] -eq 'Advanced') { $d = $p['AdvOut.RecFilePath'] } else { $d = $p['SimpleOutput.FilePath'] } }
    if (-not $d) { $d = [Environment]::GetFolderPath('MyVideos') }
    ([string]$d).Replace('/', '\')
}
$script:obsExe = ''
function Show-Obs {
    $script:obsExe = Find-Obs
    $running = [bool](Get-Process -Name 'obs64' -ErrorAction SilentlyContinue)
    foreach ($b in 'ObsRun', 'ObsRec', 'ObsStream', 'ObsReplay') { (UI $b).IsEnabled = ([bool]$script:obsExe -and -not $running) }
    (UI 'ObsClose').IsEnabled = $running
    if (-not $script:obsExe) { (UI 'ObsState').Text = "OBS n'est pas installé"; (UI 'ObsPath').Text = "Clique sur « Télécharger OBS » plus bas pour l'installer (gratuit)." }
    else {
        if ($running) { (UI 'ObsState').Text = 'OBS est ouvert' } else { (UI 'ObsState').Text = 'OBS est fermé' }
        (UI 'ObsPath').Text = $script:obsExe
    }
    $p = Get-ObsProfile
    $rows = @()
    if ($p) {
        $rows += Row 'Profil' ([string]$p['_Name']) ''
        if ($p['Video.BaseCX']) { $rows += Row 'Résolution de la scène' ("" + $p['Video.BaseCX'] + " x " + $p['Video.BaseCY']) '' }
        if ($p['Video.OutputCX']) { $rows += Row 'Résolution de sortie' ("" + $p['Video.OutputCX'] + " x " + $p['Video.OutputCY']) '' }
        $fps = $p['Video.FPSCommon']; if ($p['Video.FPSType'] -eq '1' -and $p['Video.FPSInt']) { $fps = $p['Video.FPSInt'] }
        if ($fps) { $rows += Row 'Images par seconde' ([string]$fps) '' }
        $adv = ($p['Output.Mode'] -eq 'Advanced')
        $rows += Row 'Mode de sortie' $(if ($adv) { 'Avancé' } else { 'Simple' }) ''
        if ($adv) {
            if ($p['AdvOut.Encoder']) { $rows += Row 'Encodeur du stream' ([string]$p['AdvOut.Encoder']) '' }
            if ($p['AdvOut.RecEncoder']) { $rows += Row "Encodeur de l'enregistrement" ([string]$p['AdvOut.RecEncoder']) '' }
            if ($p['AdvOut.RecFormat2']) { $rows += Row 'Format des vidéos' ([string]$p['AdvOut.RecFormat2']) '' }
        } else {
            if ($p['SimpleOutput.StreamEncoder']) { $rows += Row 'Encodeur du stream' ([string]$p['SimpleOutput.StreamEncoder']) '' }
            if ($p['SimpleOutput.VBitrate']) { $rows += Row 'Débit vidéo du stream' ("" + $p['SimpleOutput.VBitrate'] + " kbit/s") '' }
            if ($p['SimpleOutput.RecQuality']) { $rows += Row "Qualité de l'enregistrement" ([string]$p['SimpleOutput.RecQuality']) '' }
            if ($p['SimpleOutput.RecFormat2']) { $rows += Row 'Format des vidéos' ([string]$p['SimpleOutput.RecFormat2']) '' }
        }
        $rows += Row 'Dossier des enregistrements' (Get-ObsRecDir $p) ''
    } else { $rows += Row 'Réglages' "Aucun profil OBS trouvé : lance OBS une première fois pour qu'il crée ses réglages." '' }
    (UI 'ObsList').ItemsSource = $rows
}
function Start-Obs($flag, $what) {
    if (-not $script:obsExe) { Show-Obs; return }
    if (Get-Process -Name 'obs64' -ErrorAction SilentlyContinue) {
        (UI 'ObsMsg').Text = "OBS est déjà ouvert : utilise directement sa fenêtre" + $(if ($flag) { " pour $what." } else { "." })
        return
    }
    try {
        if ($flag) { Start-Process -FilePath $script:obsExe -WorkingDirectory (Split-Path -Parent $script:obsExe) -ArgumentList $flag }
        else { Start-Process -FilePath $script:obsExe -WorkingDirectory (Split-Path -Parent $script:obsExe) }
        (UI 'ObsMsg').Text = "Lancement d'OBS" + $(if ($flag) { " : il va $what dès l'ouverture." } else { "..." })
        (UI 'ObsState').Text = 'OBS est ouvert'
    } catch { (UI 'ObsMsg').Text = "Impossible de lancer OBS." }
}
