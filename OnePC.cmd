}
function Start-Boost($name, $proc) {
    Set-Profile '8c5e7fda-e8bf-4a96-9a85-a6e23a8c635a' 'Jeu' $true
    $closed = Close-GameApps
    if ($proc) { $script:watch = @{ Proc = $proc; Name = $name; Since = Get-Date; Seen = $false } }
    $closed
}
function Check-GameWatch {
    $w = $script:watch
    if (-not $w) { return }
    if (Get-Process -Name $w.Proc -ErrorAction SilentlyContinue) { $w.Seen = $true; return }
    if ($w.Seen) {
        $script:watch = $null
        Set-Profile '381b4222-f694-41f0-9685-ff5bb260df2e' 'Chill' $false
        (UI 'GameMsg').Text = $w.Name + " est fermé : profil normal remis automatiquement."
        Notify 'OnePC' ($w.Name + " est fermé : profil normal remis.")
    } elseif (((Get-Date) - $w.Since).TotalMinutes -gt 10) { $script:watch = $null }
}
# ---------- Temps de jeu (jeux lancés depuis l'appli) ----------
$script:play = $null
function Start-PlayTrack($name, $proc) {
    Add-Stat 'games' 1
    if (-not $proc) { return }
    $script:play = @{ Name = [string]$name; Proc = [string]$proc; Since = Get-Date; Mark = $null }
}
function Get-GameProc($path) {
    try {
        $p = [string]$path
        if ($p -match '\.lnk$') { if (-not $script:wsh) { $script:wsh = New-Object -ComObject WScript.Shell }; $p = [string]$script:wsh.CreateShortcut($p).TargetPath }
        if ($p -match '\.exe$') { return [System.IO.Path]::GetFileNameWithoutExtension($p) }
    } catch {}
    return ''
}
function Check-Play {
    $p = $script:play
    if (-not $p) { return }
    $now = Get-Date
    if (Get-Process -Name $p.Proc -ErrorAction SilentlyContinue) {
        if (-not $p.Mark) { $p.Mark = $now; return }
        $sec = ($now - $p.Mark).TotalSeconds
        if ($sec -ge 60) { if ($sec -lt 300) { $h = Read-Kv $playFile; $h[$p.Name] = [double]$h[$p.Name] + $sec; Write-Kv $playFile $h }; $p.Mark = $now }
    } elseif ($p.Mark) {
        $sec = ($now - $p.Mark).TotalSeconds
        if ($sec -gt 0 -and $sec -lt 600) { $h = Read-Kv $playFile; $h[$p.Name] = [double]$h[$p.Name] + $sec; Write-Kv $playFile $h }
        $script:play = $null
    } elseif (($now - $p.Since).TotalMinutes -gt 10) { $script:play = $null }
}
function Format-Play($sec) {
    $m = [int][math]::Floor([double]$sec / 60)
    if ($m -lt 1) { return 'pas encore joué' }
    if ($m -lt 60) { return "$m min" }
    return ('' + [int][math]::Floor($m / 60) + ' h ' + ($m % 60).ToString('00'))
}
