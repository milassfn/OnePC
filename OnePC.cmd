$script:apps = $null; $script:appsBySize = $false
function Show-Apps {
    $q = (UI 'AppSearch').Text.Trim()
    if ($q) { (UI 'AppHint').Visibility = 'Collapsed' } else { (UI 'AppHint').Visibility = 'Visible' }
    $rows = @($script:apps)
    if ($q) { $rows = @($rows | Where-Object { $_.Name.IndexOf($q, [StringComparison]::OrdinalIgnoreCase) -ge 0 -or $_.Publisher.IndexOf($q, [StringComparison]::OrdinalIgnoreCase) -ge 0 }) }
    if ($script:appsBySize) { $rows = @($rows | Sort-Object Kb -Descending) } else { $rows = @($rows | Sort-Object Name) }
    (UI 'AppList').ItemsSource = $rows
    $script:appSel = @{}; Update-AppSel
}
$script:appSel = @{}
function Update-AppSel {
    $n = $script:appSel.Count
    (UI 'AppUnSel').IsEnabled = ($n -gt 0 -and -not $script:batch)
    if ($n -gt 0) { (UI 'AppUnSel').Content = "Désinstaller la sélection ($n)" } else { (UI 'AppUnSel').Content = 'Désinstaller la sélection' }
}
function Get-UninstCmd($it) {
    $u = [string]$it.Cmd; $auto = $false
    if ($u -match 'msiexec') {
        $g = [regex]::Match($u, '\{[0-9A-Fa-f\-]{36}\}').Value
        if ($g) { $u = "msiexec.exe /x $g /passive /norestart"; $auto = $true } else { $u = $u -replace '/I\s*\{', '/X{' }
    } elseif ($it.Quiet) { $u = [string]$it.Quiet; $auto = $true }
    @{ U = $u; Auto = $auto }
}
function Find-SteamGame($id) {
    try {
        $steam = [string](Get-ItemProperty -LiteralPath 'HKCU:\Software\Valve\Steam' -ErrorAction Stop).SteamPath
        if (-not $steam) { return $null }
        $steam = $steam.Replace('/', '\')
        $libs = @($steam)
        $vdf = Join-Path $steam 'steamapps\libraryfolders.vdf'
        if (Test-Path -LiteralPath $vdf) { foreach ($mm in [regex]::Matches((Get-Content -LiteralPath $vdf -Raw), '"path"\s+"([^"]+)"')) { $libs += $mm.Groups[1].Value.Replace('\\', '\') } }
        foreach ($lib in ($libs | Select-Object -Unique)) {
            $mf = Join-Path $lib ("steamapps\appmanifest_" + $id + ".acf")
            if (-not (Test-Path -LiteralPath $mf)) { continue }
            $t = Get-Content -LiteralPath $mf -Raw
            if ($t -notmatch '"installdir"\s+"([^"]+)"') { continue }
            $name = $Matches[1]
            # nom de dossier strict : pas de séparateur, pas d'espace ni de point en début ou en fin
            if (-not $name -or $name -ne $name.Trim(' ', '.') -or $name -match '[\\/:*?"<>|]') { continue }
            try {
                $common = [System.IO.Path]::GetFullPath((Join-Path $lib 'steamapps\common')).TrimEnd('\') + '\'
                $dir = [System.IO.Path]::GetFullPath((Join-Path $lib ("steamapps\common\" + $name)))
            } catch { continue }
            if ($dir.Length -le $common.Length -or -not $dir.StartsWith($common, [StringComparison]::OrdinalIgnoreCase)) { continue }
            # dossier partagé avec un autre jeu Steam (ex. famille Half-Life) : on ne le supprime pas nous-mêmes
            $sharedDir = $false
            foreach ($om in @(Get-ChildItem -LiteralPath (Join-Path $lib 'steamapps') -Filter 'appmanifest_*.acf' -File -ErrorAction SilentlyContinue)) {
                if ($om.Name -ieq ("appmanifest_" + $id + ".acf")) { continue }
                try { $ot = Get-Content -LiteralPath $om.FullName -Raw; if ($ot -match '"installdir"\s+"([^"]+)"' -and $Matches[1] -ieq $name) { $sharedDir = $true; break } } catch {}
            }
            if ($sharedDir) { return $null }
            return @{ Lib = $lib; Manifest = $mf; Dir = $dir; Id = [string]$id }
        }
    } catch {}
    return $null
}
$steamDelCode = {
    param($a)
    try {
        # suppression qui ne suit jamais un lien (jonction / lien symbolique) vers un autre dossier
        function RmTree($d) {
            $di = New-Object System.IO.DirectoryInfo $d
            if ($di.Attributes -band [System.IO.FileAttributes]::ReparsePoint) { $di.Delete(); return }
            foreach ($f in $di.GetFiles()) { try { $f.Attributes = 'Normal' } catch {}; $f.Delete() }
            foreach ($sd in $di.GetDirectories()) { RmTree $sd.FullName }
            try { $di.Attributes = 'Directory' } catch {}
            $di.Delete()
        }
        if (Test-Path -LiteralPath $a.Dir) {
            try { [System.IO.Directory]::Delete($a.Dir, $true) } catch { RmTree $a.Dir }
        }
        Remove-Item -LiteralPath $a.Manifest -Force -ErrorAction SilentlyContinue
        foreach ($sub in 'workshop\content', 'shadercache', 'downloading', 'temp') {
            $x = Join-Path $a.Lib ("steamapps\" + $sub + "\" + $a.Id)
            if (Test-Path -LiteralPath $x) { try { [System.IO.Directory]::Delete($x, $true) } catch {} }
        }
        'OK'
    } catch { 'ERR'; $_.Exception.Message }
}
function Remove-SteamGame($it, $id) {
    $g = Find-SteamGame $id
    if (-not $g) {
        if (Ask ("Je ne retrouve pas le dossier de « " + $it.Name + " » dans tes bibliothèques Steam.`r`nOuvrir Steam pour le désinstaller ?")) { Start-Process ("steam://uninstall/" + $id) }
        return
    }
    $dirPrefix = $g.Dir.TrimEnd('\') + '\'
    if (Get-Process | Where-Object { try { $_.Path -and $_.Path.StartsWith($dirPrefix, [StringComparison]::OrdinalIgnoreCase) } catch { $false } }) { (UI 'AppsMsg').Text = "« " + $it.Name + " » est en cours d'exécution : ferme le jeu avant de le désinstaller."; return }
    if (-not (Ask ("Désinstaller « " + $it.Name + " » directement, sans ouvrir Steam ?`r`n`r`nCe dossier sera supprimé définitivement :`r`n" + $g.Dir + "`r`n`r`nTes sauvegardes dans le cloud Steam et le jeu dans ta bibliothèque ne sont pas touchés : tu pourras le réinstaller quand tu veux."))) { return }
    $script:unApp = $it; $script:unBusy = $true
    (UI 'AppsMsg').Text = "Suppression de « " + $it.Name + " » en cours... Les gros jeux prennent une ou deux minutes."
    Start-Bg $steamDelCode $g {
        param($r)
        $it = $script:unApp; $script:unBusy = $false
        if ($r.Count -eq 0 -or $r[0] -ne 'OK') {
            $why = ''; if ($r.Count -ge 2) { $why = [string]$r[1] }
            (UI 'AppsMsg').Text = "La suppression de « " + $it.Name + " » n'a pas abouti : $why"
            return
        }
        # retirer aussi l'entrée du jeu dans la liste des programmes de Windows
        $key = 'Registry::' + [string]$it.RegKey
        if ($it.RegKey -and (Test-Path -LiteralPath $key)) {
            try { Remove-Item -LiteralPath $key -Recurse -Force -ErrorAction Stop }
            catch { [void](Run-Console ("Remove-Item -LiteralPath '" + $key.Replace("'", "''") + "' -Recurse -Force") -HiddenWait) }
        }
        Log ("Jeu Steam désinstallé directement : " + $it.Name)
        Load-AppList
        $tail = ''; if (Get-Process -Name 'steam' -ErrorAction SilentlyContinue) { $tail = " Steam l'affichera comme désinstallé à son prochain redémarrage." }
        (UI 'AppsMsg').Text = "« " + $it.Name + " » est désinstallé." + $tail
    }
}
$uninstCode = {
    param($cmd)
    $cmd = [string]$cmd
    if ($cmd -notmatch '^\s*"' -and $cmd -notmatch '^\s*msiexec' -and $cmd -match '^(.+?\.exe)(\s.*)?$' -and (Test-Path -LiteralPath $Matches[1])) { $cmd = '"' + $Matches[1] + '"' + $Matches[2] }
    try { Start-Process -FilePath $env:ComSpec -ArgumentList ('/c "' + $cmd + '"') -WindowStyle Hidden -Wait } catch {}
    Start-Sleep -Seconds 3
    'fini'
}
function Test-LeftoverSafe($p) {
    $p = [string]$p
    try { $full = [System.IO.Path]::GetFullPath($p) } catch { return $false }
    if ($full.TrimEnd('\') -ne $p.TrimEnd('\')) { return $false }
    try { if ((Get-Item -LiteralPath $p -Force -ErrorAction Stop).Attributes -band [System.IO.FileAttributes]::ReparsePoint) { return $false } } catch { return $false }
    foreach ($root in $env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:ProgramData, $env:LOCALAPPDATA, $env:APPDATA) {
        if (-not $root) { continue }
        $r = $root.TrimEnd('\') + '\'
        if ($p.Length -gt $r.Length -and $p.StartsWith($r, [StringComparison]::OrdinalIgnoreCase)) {
            $parts = @($p.Substring($r.Length) -split '\\' | Where-Object { $_ })
            if ($parts.Count -eq 0) { return $false }
            if ($parts[0] -match '^(Microsoft.*|Windows.*|WindowsApps|Packages|Temp|OnePC)$') { return $false }
            if ($parts[0] -match '^(Common Files|Programs)$' -and $parts.Count -lt 2) { return $false }
            return $true
        }
    }
    return $false
}
function Test-LocShared($loc) {
    # vrai si une application encore installée utilise ce dossier, un de ses sous-dossiers ou un dossier parent
    $lp = ([string]$loc).TrimEnd('\') + '\'
    foreach ($o in @($script:apps)) {
        $ol = ([string]$o.Loc).Trim().Trim('"').TrimEnd('\'); if (-not $ol) { continue }
        $op = $ol + '\'
        if ($op.StartsWith($lp, [StringComparison]::OrdinalIgnoreCase) -or $lp.StartsWith($op, [StringComparison]::OrdinalIgnoreCase)) { return $true }
    }
    return $false
}
function Get-StartLinks {
    $h = @{}
    foreach ($d in [Environment]::GetFolderPath('CommonPrograms'), [Environment]::GetFolderPath('Programs')) {
        if (-not $d) { continue }
        foreach ($l in @(Get-ChildItem -LiteralPath $d -Recurse -Filter *.lnk -ErrorAction SilentlyContinue)) {
            if ($l.BaseName -notmatch 'uninstall|sinstaller|readme|help|aide|website|site web|manual|license') { $h[$l.BaseName.ToLower()] = $l.FullName }
        }
    }
    $h
}
$icoDir = Join-Path $appDir 'icons'
try { if (-not (Test-Path -LiteralPath $icoDir)) { New-Item -ItemType Directory -Path $icoDir -Force | Out-Null } } catch {}
$script:wsh = $null
function Get-IcoPng($path) {
    # renvoie le chemin d'une petite image de l'icône du programme (gardée en cache), ou rien
    try {
        $p = [string]$path
        if (-not $p -or -not (Test-Path -LiteralPath $p)) { return $null }
        if ($p -match '\.(ico|png)$') { return $p }
        $f = Join-Path $icoDir (($p.ToLower().GetHashCode()).ToString('x8') + '.png')
        if (Test-Path -LiteralPath $f) { return $f }
        $src = $p
        if ($p -match '\.lnk$') {
            if (-not $script:wsh) { $script:wsh = New-Object -ComObject WScript.Shell }
            $lk = $script:wsh.CreateShortcut($p)
            $ic = ([string]$lk.IconLocation -replace ',\s*-?\d+$', '').Trim()
            $ic = [Environment]::ExpandEnvironmentVariables($ic)
            if ($ic -match '\.ico$' -and (Test-Path -LiteralPath $ic)) { return $ic }
            if ($ic -match '\.exe$' -and (Test-Path -LiteralPath $ic)) { $src = $ic }
            elseif ($lk.TargetPath -and (Test-Path -LiteralPath $lk.TargetPath)) { $src = [string]$lk.TargetPath }
        }
        $i = [System.Drawing.Icon]::ExtractAssociatedIcon($src)
        $b = $i.ToBitmap(); $b.Save($f, [System.Drawing.Imaging.ImageFormat]::Png); $b.Dispose(); $i.Dispose()
        return $f
    } catch { return $null }
}
function Load-AppList {
    $links = Get-StartLinks
    $seen = @{}; $list = @()
    $roots = 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall', 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall'
    foreach ($root in $roots) {
        foreach ($k in @(Get-ChildItem -LiteralPath $root -ErrorAction SilentlyContinue)) {
            try {
                $name = [string]$k.GetValue('DisplayName'); $un = [string]$k.GetValue('UninstallString')
                if (-not $name -or -not $un) { continue }
                if ($k.GetValue('SystemComponent') -eq 1 -or $k.GetValue('ParentKeyName') -or $k.GetValue('ReleaseType')) { continue }
                if ($seen.ContainsKey($name)) { continue }
                $seen[$name] = 1
                $kb = 0; try { $kb = [double]$k.GetValue('EstimatedSize') } catch {}
                $size = '-'; if ($kb -ge 1048576) { $size = ([math]::Round($kb / 1048576, 1)).ToString([cultureinfo]'fr-FR') + " Go" } elseif ($kb -gt 0) { $size = "" + [math]::Max(1, [math]::Round($kb / 1024)) + " Mo" }
                $date = ''; $d = [string]$k.GetValue('InstallDate')
                if ($d -match '^(\d{4})(\d{2})(\d{2})$' -and [int]$Matches[2] -ge 1 -and [int]$Matches[2] -le 12 -and [int]$Matches[3] -ge 1 -and [int]$Matches[3] -le 31) { $date = $Matches[3] + '/' + $Matches[2] + '/' + $Matches[1] }
                $run = ''; $ln = $name.ToLower()
                if ($links.ContainsKey($ln)) { $run = $links[$ln] }
                else { if ($ln.Length -ge 4 -and $ln -notmatch 'runtime|webview|redistributable|driver|pilote|sdk|helper|service|update|chipset') { foreach ($lk in $links.Keys) { if ($lk.Length -ge 4 -and (($ln.StartsWith($lk + ' ')) -or ($lk.StartsWith($ln + ' ')))) { $run = $links[$lk]; break } } } }
                if (-not $run) {
                    $ic = (([string]$k.GetValue('DisplayIcon')) -replace ',\s*-?\d+$', '').Trim('"')
                    if ($ic -match '\.exe$' -and $ic -notmatch 'unins|uninst|setup|install|msiexec' -and (Test-Path -LiteralPath $ic)) { $run = $ic }
                }
                $icoSrc = $run
                if (-not $icoSrc) { $icoSrc = (([string]$k.GetValue('DisplayIcon')) -replace ',\s*-?\d+$', '').Trim('"') }
                $list += [pscustomobject]@{ Ico = (Get-IcoPng $icoSrc); Run = $run; RegKey = [string]$k.Name; Quiet = [string]$k.GetValue('QuietUninstallString'); Loc = [string]$k.GetValue('InstallLocation'); Name = $name; Version = [string]$k.GetValue('DisplayVersion'); Publisher = [string]$k.GetValue('Publisher'); Kb = $kb; Size = $size; Date = $date; Cmd = $un }
            } catch {}
        }
    }
    $script:apps = $list
    $tot = ($list | Measure-Object Kb -Sum).Sum
    (UI 'AppsInfo').Text = "" + $list.Count + " applications, environ " + ([math]::Round($tot / 1048576, 1)).ToString([cultureinfo]'fr-FR') + " Go au total (les applis du Microsoft Store et les jeux installés par un lanceur ne sont pas tous comptés)."
    Show-Apps
}
