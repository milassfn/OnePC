        <!-- ===== Disques ===== -->
        <ScrollViewer x:Name="PageDisk" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,8" Visibility="Collapsed"><StackPanel Margin="26,4,22,12" MaxWidth="1250">
          <TextBlock Text="Disques" Style="{StaticResource H}" Margin="0,0,0,2"/>
          <TextBlock Text="État de santé et place restante" Style="{StaticResource Dim}" Margin="0,0,0,12"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="SANTÉ DES DISQUES" Style="{StaticResource Tag}" Foreground="#FBBF24"/>
              <ItemsControl x:Name="PhysList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#222227" BorderThickness="0,1,0,0" Padding="0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="#8E8E98"/>
                        <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#8E8E98"/>
                        <TextBlock Grid.Column="3" Text="{Binding Health}" Foreground="#FBBF24"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="PhysMsg" Style="{StaticResource Dim}"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="PhysDetail" Style="{StaticResource Ghost}" Content="Santé détaillée : usure et heures (admin)"/></StackPanel>
              <ItemsControl x:Name="PhysDetailList" ItemTemplate="{StaticResource Row3}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="PARTITIONS" Style="{StaticResource Tag}" Foreground="#F472B6"/>
              <StackPanel x:Name="VolHost"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="CE QUI PREND LE PLUS DE PLACE" Style="{StaticResource Tag}" Foreground="#38BDF8"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BigUser" Style="{StaticResource Action}" Content="Analyser mon dossier utilisateur"/>
                <Button x:Name="BigC" Style="{StaticResource Ghost}" Content="Tout le disque C:"/>
                <Button x:Name="BigOther" Style="{StaticResource Ghost}" Content="Autre dossier..."/>
              </StackPanel>
              <TextBlock x:Name="BigMsg" Text="L'analyse d'un disque entier peut prendre quelques minutes. Rien n'est modifié." Foreground="#8E8E98" FontSize="12" Margin="0,10,0,6" TextWrapping="Wrap"/>
              <ItemsControl x:Name="BigDirs">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Size}" Foreground="#FBBF24" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl x:Name="BigFiles" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#222227" BorderThickness="0,1,0,0" Padding="0,6">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Size}" Foreground="#FBBF24" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Dir}" Foreground="#6C6C76" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Afficher" Style="{StaticResource Mini}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel></ScrollViewer>

        <!-- ===== Applications ===== -->
        <Grid x:Name="PageApps" Grid.Row="1" Margin="26,4,26,20" MaxWidth="1250" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Applications installées" Style="{StaticResource H}" Margin="0,0,0,2"/>
            <TextBlock x:Name="AppsInfo" Text="Lecture de la liste..." Style="{StaticResource Dim}" Margin="0,0,0,12"/>
            <DockPanel Margin="0,0,0,6">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AppUnSel" Style="{StaticResource Action}" Content="Désinstaller la sélection" IsEnabled="False"/>
                <Button x:Name="AppSort" Style="{StaticResource Ghost}" Content="Trier par taille"/>
                <Button x:Name="AppRefresh" Style="{StaticResource Ghost}" Content="Actualiser"/>
                <Button x:Name="AppStore" Style="{StaticResource Ghost}" Content="Applis du Microsoft Store" Margin="0"/>
              </StackPanel>
              <Border Background="#17171B" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8" Width="210" HorizontalAlignment="Left">
                <Grid>
                  <TextBlock x:Name="AppHint" Text="Rechercher une application..." Foreground="#6C6C76" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <TextBox x:Name="AppSearch" Background="Transparent" Foreground="#E8E8EC" CaretBrush="#E8E8EC" BorderThickness="0" Padding="9,8" VerticalContentAlignment="Center"/>
                </Grid>
              </Border>
            </DockPanel>
            <TextBlock x:Name="AppsMsg" Text=" " Foreground="#B8B8C0" FontSize="12" Margin="0,0,0,8"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,22,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="APPLICATION" Style="{StaticResource Tag}" Margin="0" Foreground="#8E8E98"/>
                <TextBlock Grid.Column="1" Text="ÉDITEUR" Style="{StaticResource Tag}" Margin="0" Foreground="#8E8E98"/>
                <TextBlock Grid.Column="2" Text="TAILLE" Style="{StaticResource Tag}" Margin="0" Foreground="#8E8E98"/>
                <TextBlock Grid.Column="3" Text="INSTALLÉE LE" Style="{StaticResource Tag}" Margin="0" Foreground="#8E8E98"/>
              </Grid>
              <ScrollViewer VerticalScrollBarVisibility="Visible">
                <ItemsControl x:Name="AppList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#222227" BorderThickness="0,1,0,0" Padding="0,8">
                        <Grid Margin="0,0,14,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/>
                          </Grid.ColumnDefinitions>
                          <DockPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Cocher pour désinstaller plusieurs applications d'un coup"/>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="7" Background="#1D1D22" Margin="0,0,10,0">
                              <Image Source="{Binding Ico}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Version}" Foreground="#6C6C76" FontSize="11"/>
                            </StackPanel>
                          </DockPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Publisher}" Foreground="#8E8E98" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#FBBF24" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding Date}" Foreground="#8E8E98" VerticalAlignment="Center"/>
                          <Button Grid.Column="4" Content="Lancer" Style="{StaticResource Mini}"/>
                          <Button Grid.Column="5" Content="Désinstaller" Style="{StaticResource Mini}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>

        <!-- ===== Jeux ===== -->
        <ScrollViewer x:Name="PageGames" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,8" Visibility="Collapsed"><StackPanel Margin="26,4,22,12" MaxWidth="1250">
          <TextBlock Text="Jeux" Style="{StaticResource H}" Margin="0,0,0,2"/>
          <TextBlock Text="Lance ton jeu directement depuis OnePC" Style="{StaticResource Dim}" Margin="0,0,0,12"/>
          <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
            <Border Height="96" CornerRadius="12,12,0,0" ClipToBounds="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#0B1B3A" Offset="0"/><GradientStop Color="#1D4E89" Offset="0.45"/><GradientStop Color="#38BDF8" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,24,0" Fill="#22FFFFFF"/>
                <Ellipse Width="150" Height="150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,-100" Fill="#16FFFFFF"/>
                <Rectangle Height="3" VerticalAlignment="Bottom" Fill="#FF5A3C"/>
                <TextBlock Text="FORTNITE" FontSize="38" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="24,0,0,0">
                  <TextBlock.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="#000000"/></TextBlock.Effect>
                </TextBlock>
              </Grid>
            </Border>
            <DockPanel Margin="20">
              <Border DockPanel.Dock="Left" Width="72" Height="72" CornerRadius="14" Background="#222228" Margin="0,0,18,0" VerticalAlignment="Top">
                <Grid>
                  <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#FF5A3C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image x:Name="GameIcon" Width="48" Height="48"/>
                </Grid>
              </Border>
              <StackPanel>
                <TextBlock Text="Fortnite" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="GamePath" Style="{StaticResource Dim}" Margin="0,3,0,14" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="GamePlay" Style="{StaticResource Action}" Content="Lancer Fortnite"/>
                  <Button x:Name="GamePlayBoost" Style="{StaticResource Ghost}" Content="Optimiser et lancer"/>
                  <Button x:Name="GameEnd" Style="{StaticResource Ghost}" Content="Fin de session : revenir en normal"/>
                </StackPanel>
                <TextBlock x:Name="GameMsg" Text=" " Foreground="#B8B8C0" FontSize="12" Margin="0,12,0,0"/>
                <TextBlock x:Name="GameInfo" Foreground="#8E8E98" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="FnSave" Style="{StaticResource Ghost}" Content="Sauvegarder mes réglages Fortnite"/>
                  <Button x:Name="FnRestore" Style="{StaticResource Ghost}" Content="Restaurer la dernière sauvegarde"/>
                </StackPanel>
                <TextBlock x:Name="FnMsg" Text="Sauvegarde le fichier de réglages graphiques et d'affichage de Fortnite dans Documents." Foreground="#8E8E98" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="Mes autres jeux" Style="{StaticResource H}" Margin="0,18,0,10"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <WrapPanel x:Name="GameHost"/>
              <StackPanel Orientation="Horizontal"><Button x:Name="GameAdd" Style="{StaticResource Ghost}" Content="Ajouter un jeu..."/></StackPanel>
              <TextBlock x:Name="GameMsg2" Text="Choisis le .exe du jeu ou son raccourci. « Optimisé » active le profil Jeu, ferme les applis mémorisées, et remet le profil normal quand le jeu se ferme." Foreground="#8E8E98" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel></ScrollViewer>

        <!-- ===== Rangement ===== -->
        <ScrollViewer x:Name="PageTidy" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,8" Visibility="Collapsed"><StackPanel Margin="26,4,22,12" MaxWidth="1250">
          <TextBlock Text="Rangement des fichiers" Style="{StaticResource H}" Margin="0,0,0,2"/>
          <TextBlock Text="Trie les fichiers en vrac d'un dossier dans des sous-dossiers par type. Rien n'est supprimé, et tu peux annuler." Style="{StaticResource Dim}" Margin="0,0,0,12"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="DOSSIER À RANGER" Style="{StaticResource Tag}" Foreground="#38BDF8"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="TidyDl" Style="{StaticResource Ghost}" Content="Téléchargements"/>
                <Button x:Name="TidyDesk" Style="{StaticResource Ghost}" Content="Bureau"/>
                <Button x:Name="TidyDocs" Style="{StaticResource Ghost}" Content="Documents"/>
                <Button x:Name="TidyOther" Style="{StaticResource Ghost}" Content="Autre dossier..."/>
              </StackPanel>
              <TextBlock x:Name="TidyPath" Text="Choisis un dossier pour voir ce qui sera rangé." Foreground="#CACAD2" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="CE QUI SERA RANGÉ" Style="{StaticResource Tag}" Foreground="#34D399"/>
              <ItemsControl x:Name="TidyList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#222227" BorderThickness="0,1,0,0" Padding="0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="190"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="#FBBF24"/>
                        <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#8E8E98"/>
                        <TextBlock Grid.Column="3" Text="{Binding Sample}" Foreground="#6C6C76" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="TidyInfo" Text=" " Foreground="#8E8E98" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="TidyGo" Style="{StaticResource Action}" Content="Ranger ce dossier" IsEnabled="False"/>
                <Button x:Name="TidyUndo" Style="{StaticResource Ghost}" Content="Annuler le dernier rangement"/>
                <Button x:Name="TidyOpen" Style="{StaticResource Ghost}" Content="Ouvrir le dossier" IsEnabled="False"/>
              </StackPanel>
              <TextBlock x:Name="TidyMsg" Text=" " Foreground="#B8B8C0" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="SAUVEGARDE" Style="{StaticResource Tag}" Foreground="#FB923C"/>
<TextBlock TextWrapping="Wrap" Foreground="#CACAD2" Margin="0,0,0,10" Text="Copie un dossier important vers une clé USB ou un autre disque. Les fichiers déjà copiés et inchangés sont sautés, et rien n'est jamais supprimé dans la destination."/>
<StackPanel Orientation="Horizontal"><Button x:Name="BackSrc" Style="{StaticResource Ghost}" Content="Dossier à sauvegarder..."/><Button x:Name="BackDst" Style="{StaticResource Ghost}" Content="Destination..."/><Button x:Name="BackGo" Style="{StaticResource Action}" Content="Sauvegarder maintenant"/></StackPanel>
<TextBlock x:Name="BackInfo" Text=" " Foreground="#B8B8C0" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel></ScrollViewer>

        <!-- ===== Fond d'écran ===== -->
