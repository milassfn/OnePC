# ---------- Calendrier d'entretien ----------
function Show-Cal {
    $hostP = UI 'CalHost'; $hostP.Children.Clear()
    $icons = @{ clean = 0xE74D; drv = 0xE950; backup = 0xE74E; restore = 0xE81C; cache = 0xE774; repair = 0xE90F }
    $late = 0; $inner = 232
    $opt = @()
    foreach ($r in @(Get-CalState)) {
        $days = [int]$r.Item.Days; $age = [int]$r.Age
        if ($days -eq 0) { $w = ($r.When -replace '\s+\(.*$', ''); if ($age -lt 0) { $w = 'jamais' }; $opt += ($r.Item.N + ' : ' + $w); continue }
        # couleur et phrase selon le temps écoulé
        $col = '#3DDC84'; $ratio = 0.0; $big = ''; $sub = ''
        if ($days -eq 0) {
            $col = '#8E8E98'
            if ($age -lt 0) { $big = 'Pas encore lancée' } else { $big = ($r.When -replace '\s+\(.*$', ''); $big = $big.Substring(0, 1).ToUpper() + $big.Substring(1) }
            $sub = 'À lancer seulement quand le PC bugge'
        } elseif ($age -lt 0) {
            $col = '#FBBF24'; $ratio = 1.0; $late++
            $big = 'Jamais fait'; $sub = "Conseillé tous les $days jours"
        } else {
            $ratio = [math]::Min(1.0, $age / [double]$days)
            $big = ($r.When -replace '\s+\(.*$', ''); $big = $big.Substring(0, 1).ToUpper() + $big.Substring(1)
            $left = $days - $age
            if ($left -lt 0) { $col = '#FF5A6E'; $late++; $sub = 'En retard de ' + (-$left) + ' jour(s)' }
            elseif ($left -le [math]::Max(2, [int]($days * 0.2))) { $col = '#FBBF24'; $sub = "À refaire dans $left jour(s)" }
            else { $sub = "Prochain dans $left jours" }
        }
        $card = New-Object System.Windows.Controls.Border
        $card.Width = $inner + 32; $card.Margin = New-Object System.Windows.Thickness 0, 0, 12, 12; $card.Padding = New-Object System.Windows.Thickness 16, 14, 16, 14
        $card.Background = $brush.ConvertFromString('#1D1D22'); $card.BorderBrush = $brush.ConvertFromString('#2E2E35'); $card.BorderThickness = New-Object System.Windows.Thickness 1
        $card.CornerRadius = New-Object System.Windows.CornerRadius 12
        $sp = New-Object System.Windows.Controls.StackPanel
        # en-tête : icône + nom
        $head = New-Object System.Windows.Controls.StackPanel; $head.Orientation = 'Horizontal'
        $ib = New-Object System.Windows.Controls.Border; $ib.Width = 34; $ib.Height = 34; $ib.CornerRadius = New-Object System.Windows.CornerRadius 9
        $ib.Background = $brush.ConvertFromString('#26262C'); $ib.Margin = New-Object System.Windows.Thickness 0, 0, 10, 0
        $ic = New-Object System.Windows.Controls.TextBlock; $ic.Text = [string][char]$icons[$r.Item.K]; $ic.FontFamily = New-Object System.Windows.Media.FontFamily 'Segoe MDL2 Assets'
        $ic.FontSize = 16; $ic.Foreground = $brush.ConvertFromString($col); $ic.HorizontalAlignment = 'Center'; $ic.VerticalAlignment = 'Center'
        $ib.Child = $ic
        $nm = New-Object System.Windows.Controls.TextBlock; $nm.Text = $r.Item.N; $nm.FontWeight = 'SemiBold'; $nm.VerticalAlignment = 'Center'; $nm.TextTrimming = 'CharacterEllipsis'; $nm.MaxWidth = $inner - 46
        [void]$head.Children.Add($ib); [void]$head.Children.Add($nm)
        # grand texte + sous-texte
        $tb = New-Object System.Windows.Controls.TextBlock; $tb.Text = $big; $tb.FontSize = 20; $tb.FontWeight = 'Bold'; $tb.Margin = New-Object System.Windows.Thickness 0, 12, 0, 0
        $ts = New-Object System.Windows.Controls.TextBlock; $ts.Text = $sub; $ts.Foreground = $brush.ConvertFromString($col); $ts.FontSize = 12; $ts.Margin = New-Object System.Windows.Thickness 0, 2, 0, 10
        # barre de temps écoulé
        $track = New-Object System.Windows.Controls.Border; $track.Height = 6; $track.Width = $inner; $track.HorizontalAlignment = 'Left'
        $track.CornerRadius = New-Object System.Windows.CornerRadius 3; $track.Background = $brush.ConvertFromString('#2A2A31')
        $fill = New-Object System.Windows.Controls.Border; $fill.Height = 6; $fill.HorizontalAlignment = 'Left'; $fill.CornerRadius = New-Object System.Windows.CornerRadius 3
        $fill.Width = [math]::Max(0, [math]::Round($inner * $ratio)); $fill.Background = $brush.ConvertFromString($col)
        $track.Child = $fill
        # pied : date + bouton
        $foot = New-Object System.Windows.Controls.DockPanel; $foot.Margin = New-Object System.Windows.Thickness 0, 12, 0, 0
        $bt = New-Object System.Windows.Controls.Button; $bt.Style = $win.FindResource('Mini'); $bt.Tag = [string]$r.Item.K
        $bt.Content = 'Faire maintenant'
        $bt.Add_Click({ param($sender, $e) Start-CalItem ([string]$sender.Tag) $false; Show-Cal })
        [System.Windows.Controls.DockPanel]::SetDock($bt, 'Right')
        $dt = New-Object System.Windows.Controls.TextBlock; $dt.Foreground = $brush.ConvertFromString('#6C6C76'); $dt.FontSize = 11.5; $dt.VerticalAlignment = 'Center'
        if ($r.Date) { $dt.Text = 'Le ' + $r.Date.ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture) } else { $dt.Text = ' ' }
        [void]$foot.Children.Add($bt); [void]$foot.Children.Add($dt)
        foreach ($el in $head, $tb, $ts) { [void]$sp.Children.Add($el) }
        if ($days -gt 0) { [void]$sp.Children.Add($track) }
        [void]$sp.Children.Add($foot)
        $card.Child = $sp; $card.ToolTip = $r.Item.Tip
        [void]$hostP.Children.Add($card)
    }
    $script:calLate = $late
    if ($late -eq 0) { (UI 'CalInfo').Text = "Ton PC est bien entretenu : rien à faire pour le moment." }
    else { (UI 'CalInfo').Text = "$late chose(s) à faire. La barre se remplit avec le temps écoulé depuis la dernière fois." }
    (UI 'CalOpt').Text = 'Optionnel, quand tu en as besoin :   ' + ($opt -join '   ·   ')
}
function Start-CalItem($k, $noAsk) {
    switch ($k) {
        'clean' { if ($noAsk) { Start-Clean -NoAsk } else { Start-Clean } }
        'cache' { if ($noAsk) { Start-Cache $true } elseif (Ask "Vider le cache des navigateurs ?`r`nFerme-les avant pour tout nettoyer. Mots de passe, favoris et historique ne sont pas touchés.") { Start-Cache $true } }
        'drv'   { Show-Page 'Drv'; if ((UI 'DrvAutoGo').IsEnabled) { (UI 'DrvAutoGo').RaiseEvent((New-Object System.Windows.RoutedEventArgs ([System.Windows.Controls.Primitives.ButtonBase]::ClickEvent))) } }
    }
}
(UI 'CalAll').Add_Click({
    $todo = @(Get-CalState | Where-Object { $_.Item.Days -gt 0 -and $_.Level -gt 0 })
    $all = $false
    if ($todo.Count -eq 0) {
        if (-not (Ask "Rien n'est en retard. Tout refaire quand même ?`r`n`r`n - Nettoyage du PC (temporaires, cache Windows Update, corbeille vidée définitivement)`r`n - Cache des navigateurs`r`n - Vérification des pilotes")) { return }
        $all = $true; $todo = @(Get-CalState | Where-Object { $_.Item.Days -gt 0 })
    } else {
        $lines = @($todo | ForEach-Object { ' - ' + $_.Item.N + '  (' + $_.Item.Tip + ')' })
        if (-not (Ask ("Faire maintenant ce qui est à faire ?`r`n`r`n" + ($lines -join "`r`n") + "`r`n`r`nLe nettoyage vide la corbeille définitivement et ouvre une fenêtre administrateur. Pour les pilotes, l'appli vérifie d'abord et te redemande avant d'installer."))) { return }
    }
    $keys = @($todo | ForEach-Object { $_.Item.K })
