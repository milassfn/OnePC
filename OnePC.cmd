}
$adrenalin = ''
foreach ($k in $gpuReg) { if ($k.RadeonSoftwareVersion) { $adrenalin = [string]$k.RadeonSoftwareVersion } }
$amdCpu = ($cpu.Manufacturer -match 'AMD') -or ($cpu.Name -match 'AMD|Ryzen')
if ($amdGpu -or $amdCpu) {
