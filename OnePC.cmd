$script:obsUp = 0.0; $script:obsHw = $null; $script:obsTile = @{}
function Set-Tile($n, $state, $val, $txt, $title, $detail, $fix) {
    $col = @{ ok = '#34D399'; warn = '#FBBF24'; bad = '#F87171'; none = '#2E2E35' }[$state]
