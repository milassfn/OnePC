        }
    })
}
$win.Add_ContentRendered({
    if ($script:oldFile) { Toast "Tu as lancé un ancien fichier : c'est la version installée, plus récente, qu'il faut ouvrir avec le raccourci OnePC du Bureau." }
    # une vérification automatique par jour au maximum
    if ([string]$cfg.UpdAsked -ne (Get-Date).ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture)) { Check-Update $false }
})

# ---------- Écran de bienvenue (premier lancement) ----------
$welSteps = @(
    @{ Icon = ''; Tag = 'BIENVENUE'; Title = "Bienvenue dans OnePC"; Page = 'Home'
       Text = "Tout ton PC au même endroit : surveillance, pilotes, nettoyage, jeux et raccourcis. Tout ce que l'appli modifie est noté dans l'Historique et peut être annulé depuis les Réglages. Voici les trois choses à faire en premier." },
    @{ Icon = [string][char]0xE9D9; Tag = 'ÉTAPE 1 SUR 3'; Title = 'Regarde la santé de ton PC'; Page = 'Home'
       Text = "Dans Accueil, clique sur « Analyser mon PC ». En quelques secondes tu sais ce qui va bien et ce qui est à corriger : températures, disque, mémoire, programmes au démarrage." },
    @{ Icon = [string][char]0xE950; Tag = 'ÉTAPE 2 SUR 3'; Title = 'Mets tes pilotes à jour'; Page = 'Drv'
       Text = "Dans Pilotes, un seul bouton s'occupe de tout dans l'ordre : la carte graphique chez NVIDIA ou AMD, puis le processeur, puis le reste. Si tout est déjà à jour, il te le dit et ne touche à rien." },
    @{ Icon = [string][char]0xE7FC; Tag = 'ÉTAPE 3 SUR 3'; Title = 'Prépare tes jeux'; Page = 'Games'
       Text = "Dans Jeux, « Optimiser et lancer » active le profil Jeu, ferme les applis inutiles et remet tout en normal quand tu quittes. Choisis d'abord les applis à fermer dans l'onglet Alléger. Bon jeu !" }
)
$script:welI = 0
function Show-Wel {
    $st = $welSteps[$script:welI]
    (UI 'WelStep').Text = $st.Tag; (UI 'WelTitle').Text = $st.Title; (UI 'WelText').Text = $st.Text
    (UI 'WelIcon').Text = $st.Icon
    if ($script:welI -eq 0) { (UI 'WelLogo').Visibility = 'Visible'; try { (UI 'WelLogo').Source = (UI 'SideLogo').Source } catch {} } else { (UI 'WelLogo').Visibility = 'Collapsed' }
    (UI 'WelBack').Visibility = 'Visible'; if ($script:welI -eq 0) { (UI 'WelBack').Visibility = 'Collapsed' }
    (UI 'WelNameBox').Visibility = 'Collapsed'; if ($script:welI -eq 0) { (UI 'WelNameBox').Visibility = 'Visible'; if (-not (UI 'WelName').Text) { (UI 'WelName').Text = [string]$cfg.Pseudo } }
    $last = ($script:welI -eq $welSteps.Count - 1)
    (UI 'WelNext').Content = 'Suivant'; if ($last) { (UI 'WelNext').Content = "C'est parti" }
    (UI 'WelSkip').Visibility = 'Visible'; if ($last) { (UI 'WelSkip').Visibility = 'Hidden' }
    $dots = UI 'WelDots'; $dots.Children.Clear()
    for ($i = 0; $i -lt $welSteps.Count; $i++) {
        $d = New-Object System.Windows.Controls.Border
        $d.Height = 6; $d.CornerRadius = New-Object System.Windows.CornerRadius 3; $d.Margin = New-Object System.Windows.Thickness 3, 0, 3, 0
        if ($i -eq $script:welI) { $d.Width = 22; $d.Background = $brush.ConvertFromString($accent) } else { $d.Width = 6; $d.Background = $brush.ConvertFromString('#3A3A44') }
        [void]$dots.Children.Add($d)
    }
    try { Show-Page $st.Page } catch {}
}
function Open-Wel {
    $script:welI = 0; Show-Wel
    (UI 'WelHost').Visibility = 'Visible'
    try {
        $fa = New-Object System.Windows.Media.Animation.DoubleAnimation
        $fa.From = 0.0; $fa.To = 1.0; $fa.Duration = [System.Windows.Duration][TimeSpan]::FromMilliseconds(250)
        (UI 'WelHost').BeginAnimation([System.Windows.UIElement]::OpacityProperty, $fa)
    } catch {}
}
function Close-Wel { (UI 'WelHost').Visibility = 'Collapsed'; if (-not $cfg.Welcome) { $cfg.Welcome = $true; Save-Cfg } }
(UI 'WelNext').Add_Click({ if ($script:welI -eq 0 -and (UI 'WelName').Text.Trim()) { Set-Pseudo (UI 'WelName').Text }; if ($script:welI -ge $welSteps.Count - 1) { Close-Wel } else { $script:welI++; Show-Wel } })
(UI 'WelBack').Add_Click({ if ($script:welI -gt 0) { $script:welI--; Show-Wel } })
(UI 'WelSkip').Add_Click({ Close-Wel; Show-Page 'Home' })
(UI 'SetWelcome').Add_Click({ Open-Wel })
$win.Add_ContentRendered({ if (-not $cfg.Welcome) { try { Open-Wel } catch {} } else { Check-CalReminder } })
$first = [string]$cfg.StartPage; if (-not $pages.ContainsKey($first)) { $first = 'Home' }
Show-Page $first
$timer.Start()
try { if ($splash) { $splash.Close() } } catch {}
$script:restarting = $false
$win.Show()
$script:toastOn = $true
try {
    $fade = New-Object System.Windows.Media.Animation.DoubleAnimation
    $fade.From = 0.0; $fade.To = 1.0; $fade.Duration = [System.Windows.Duration][TimeSpan]::FromMilliseconds(350)
    (UI 'Root').BeginAnimation([System.Windows.UIElement]::OpacityProperty, $fade)
} catch {}
[System.Windows.Threading.Dispatcher]::Run()
if ($script:restarting) { [Environment]::Exit(0) }

} catch {
    try { if ($splash) { $splash.Close() } } catch {}
    [void][System.Windows.MessageBox]::Show("Erreur au lancement :`r`n`r`n" + $_.Exception.Message, 'OnePC')
}
# FIN-ONEPC
