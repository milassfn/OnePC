            <Border Style="{StaticResource Card}" Padding="18,14">
              <DockPanel>
                <Button x:Name="DrvAutoGo" DockPanel.Dock="Right" Style="{StaticResource Action}" Content="Rechercher les mises à jour" Margin="14,0,0,0" VerticalAlignment="Center"/>
