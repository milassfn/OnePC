function Get-CustDesign {
    $t = 'grad'; if ((UI 'CustType').SelectedItem) { $t = [string](UI 'CustType').SelectedItem.Tag }
    $a = $script:custA; $b = $script:custB
    if ($t -in 'grad', 'grid', 'stripes') { return @{ N = 'Personnalisé'; T = $t; C = $a, $b } }
