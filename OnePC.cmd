                  <TextBlock x:Name="PadConn" Text=" " Style="{StaticResource Dim}" Margin="0,0,0,10"/>
                  <TextBlock x:Name="PadTip" Text=" " TextWrapping="Wrap" Foreground="#CACAD2" FontSize="12.5" LineHeight="19" Margin="0,0,0,14"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="PadDetect" Style="{StaticResource Ghost}" Content="Détecter ma manette"/>
                    <Button x:Name="PadPhoto" Style="{StaticResource Ghost}" Content="Mettre ma photo"/>
