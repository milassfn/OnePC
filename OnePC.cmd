    if (Connect-Obs) { $v = Obs-Req 'GetVersion' $null; (UI 'ObsLink').Text = '● OnePC est connecté à OBS' + $(if ($v) { ' ' + $v.obsVersion } else { '' }); (UI 'ObsLink').Foreground = $brush.ConvertFromString('#34D399'); (UI 'ObsConnect').Visibility = 'Collapsed'; (UI 'LiveStream').IsEnabled = $true; (UI 'LiveRec').IsEnabled = $true; (UI 'ObsSetup').Visibility = 'Collapsed'; (UI 'ObsSetupHelp').Visibility = 'Collapsed'; if (-not $cfg.ObsLinked) { $cfg.ObsLinked = $true; Save-Cfg } }
    else { (UI 'ObsLink').Text = 'OnePC n''est pas encore connecté à OBS : clique sur « Connecter OnePC à OBS ».'; (UI 'ObsLink').Foreground = $brush.ConvertFromString('#FBBF24'); (UI 'ObsConnect').Visibility = 'Visible'; (UI 'LiveStream').IsEnabled = $false; (UI 'LiveRec').IsEnabled = $false; (UI 'ObsSetup').Visibility = 'Visible' }
