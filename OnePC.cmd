# ---------- Outils communs ----------
function Run-Console($code, [switch]$Admin, [switch]$HiddenWait) {
    $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($code))
    $a = '-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $enc
    try {
        if ($HiddenWait) { Start-Process powershell -Verb RunAs -WindowStyle Hidden -Wait -ArgumentList $a }
        elseif ($Admin)  { Start-Process powershell -Verb RunAs -ArgumentList $a }
        else             { Start-Process powershell -ArgumentList $a }
        return $true
    } catch { return $false }
}
function Show-Box($text, [bool]$yesNo, $inputDefault = $null) {
    try {
        $x = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
