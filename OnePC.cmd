$script:job = $null; $script:jobHandle = $null
function Start-DrvSearch {
    if ($script:job) { return }
    (UI 'BtnSearch').IsEnabled = $false; (UI 'BtnInstall').IsEnabled = $false
    $log.Text = 'Recherche en cours (peut prendre 1 à 2 minutes)...'
    $script:job = [powershell]::Create()
    [void]$script:job.AddScript({
        try {
            $s = New-Object -ComObject Microsoft.Update.Session
            $r = $s.CreateUpdateSearcher().Search("IsInstalled=0 and Type='Driver'")
            $out = @(); foreach ($u in $r.Updates) { $out += $u.Title }
            $out
        } catch { "ERREUR: " + $_.Exception.Message }
    })
    $script:jobHandle = $script:job.BeginInvoke()
}
(UI 'BtnSearch').Add_Click({ Start-DrvSearch })
(UI 'BtnInstall').Add_Click({
    $ok = if (Ask "Télécharger et installer les pilotes proposés par Windows Update ?`r`nUne fenêtre administrateur va s'ouvrir.") { 'Yes' } else { 'No' }
    if ($ok -ne 'Yes') { return }
    $code = @'
$Host.UI.RawUI.WindowTitle = "Installation des pilotes"
Write-Host "Recherche des pilotes..." -ForegroundColor Cyan
$s = New-Object -ComObject Microsoft.Update.Session
$res = $s.CreateUpdateSearcher().Search("IsInstalled=0 and Type='Driver'")
if ($res.Updates.Count -eq 0) { Write-Host "Aucun pilote a installer." -ForegroundColor Green }
else {
    $c = New-Object -ComObject Microsoft.Update.UpdateColl
    foreach ($u in $res.Updates) {
        Write-Host (" - " + $u.Title)
        if (-not $u.EulaAccepted) { $u.AcceptEula() }
        [void]$c.Add($u)
    }
    Write-Host "Telechargement..." -ForegroundColor Cyan
    $d = $s.CreateUpdateDownloader(); $d.Updates = $c; [void]$d.Download()
    Write-Host "Installation (ne ferme pas la fenetre)..." -ForegroundColor Cyan
    $i = $s.CreateUpdateInstaller(); $i.Updates = $c; $r = $i.Install()
    Write-Host "Termine." -ForegroundColor Green
    if ($r.RebootRequired) { Write-Host "Un redemarrage est necessaire pour finir." -ForegroundColor Yellow }
}
Read-Host "Appuie sur Entree pour fermer"
'@
    $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($code))
    try { Start-Process powershell -Verb RunAs -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $enc; Log 'Installation des pilotes proposés par Windows Update lancée' }
    catch { $log.Text = 'Installation annulée (droits administrateur refusés).' }
})

# ---------- Outils communs ----------
function Run-Console($code, [switch]$Admin, [switch]$HiddenWait) {
    $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($code))
    $a = '-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $enc
    try {
        if ($HiddenWait) { Start-Process powershell -Verb RunAs -WindowStyle Hidden -Wait -ArgumentList $a }
        elseif ($Admin)  { Start-Process powershell -Verb RunAs -ArgumentList $a }
        else             { Start-Process powershell -ArgumentList $a }
        return $true
    } catch { return $false }
}
function Show-Box($text, [bool]$yesNo, $inputDefault = $null) {
    try {
        $x = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
  <Border x:Name="Card" Margin="18" Background="#16161A" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="12" MinWidth="380" MaxWidth="520">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000"/></Border.Effect>
    <StackPanel>
      <Border x:Name="Head" Background="#1C1C22" CornerRadius="12,12,0,0" Padding="18,12">
        <StackPanel Orientation="Horizontal">
          <Border Width="8" Height="8" CornerRadius="4" Background="$accent" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock Text="OnePC" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="Msg" Margin="22,18,22,6" Foreground="#E4E4EA" FontSize="13.5" TextWrapping="Wrap" LineHeight="20"/>
      <TextBox x:Name="In" Visibility="Collapsed" Margin="22,8,22,0" Padding="8,6" Background="#0E0E11" Foreground="#FFFFFF" BorderBrush="#34343C" CaretBrush="#FFFFFF" FontSize="13.5" MaxLength="40"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14,18,18">
        <Border x:Name="No" CornerRadius="7" Background="#222228" BorderBrush="#34343C" BorderThickness="1" Padding="22,8" Margin="0,0,10,0" Cursor="Hand">
          <TextBlock Text="Non" Foreground="#E4E4EA" FontSize="13" FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="Yes" CornerRadius="7" Background="$accent" Padding="24,8" Cursor="Hand">
          <TextBlock x:Name="YesT" Text="Oui" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
"@
        $d = [Windows.Markup.XamlReader]::Parse($x)
        if ($win -and $win.IsVisible) { $d.Owner = $win } else { $d.WindowStartupLocation = 'CenterScreen'; $d.Topmost = $true }
        $d.FindName('Msg').Text = [string]$text
        if (-not $yesNo) { $d.FindName('No').Visibility = 'Collapsed'; $d.FindName('YesT').Text = 'OK' }
        $d.Tag = $false
        $inBox = $d.FindName('In')
        if ($null -ne $inputDefault) {
            $inBox.Visibility = 'Visible'; $inBox.Text = [string]$inputDefault; $d.FindName('YesT').Text = 'OK'; $d.FindName('No').Child.Text = 'Annuler'
            $d.Add_ContentRendered({ [void]$inBox.Focus(); $inBox.SelectAll() }.GetNewClosure())
        }
        $d.FindName('Yes').Add_MouseLeftButtonUp({ $d.Tag = $true; $d.Close() }.GetNewClosure())
        $d.FindName('No').Add_MouseLeftButtonUp({ $d.Close() }.GetNewClosure())
        $d.FindName('Head').Add_MouseLeftButtonDown({ try { $d.DragMove() } catch {} }.GetNewClosure())
        $d.Add_KeyDown({ param($o, $e) if ($e.Key -eq 'Return') { $d.Tag = $true; $d.Close() } elseif ($e.Key -eq 'Escape') { $d.Close() } }.GetNewClosure())
        [void]$d.ShowDialog()
        if ($null -ne $inputDefault) { if ($d.Tag) { return [string]$inBox.Text } else { return $null } }
        return [bool]$d.Tag
    } catch {
        if ($yesNo) { return ([System.Windows.MessageBox]::Show($text, 'OnePC', 'YesNo', 'Question')) -eq 'Yes' }
        [void][System.Windows.MessageBox]::Show($text, 'OnePC'); return $true
    }
}
function Ask($text) { Show-Box $text $true }
function Show-Picker($title, $intro, $items) {
    if (-not $items -or @($items).Count -eq 0) { return @() }
    try {
        $x = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="560" MaxHeight="640" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
  <Border x:Name="Card" Margin="18" Background="#16161A" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="12">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000"/></Border.Effect>
    <StackPanel>
      <Border x:Name="Head" Background="#1C1C22" CornerRadius="12,12,0,0" Padding="18,12">
        <StackPanel Orientation="Horizontal">
          <Border Width="8" Height="8" CornerRadius="4" Background="$accent" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="Ttl" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="Intro" Margin="22,16,22,8" Foreground="#CACAD2" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
      <StackPanel Orientation="Horizontal" Margin="22,0,22,6">
        <TextBlock x:Name="All" Text="Tout cocher" Foreground="$accent" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,16,0"/>
        <TextBlock x:Name="None" Text="Tout décocher" Foreground="#9A9AA4" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
      </StackPanel>
      <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="22,0,22,0">
        <StackPanel x:Name="List"/>
      </ScrollViewer>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,16,18,18">
        <Border x:Name="No" CornerRadius="7" Background="#222228" BorderBrush="#34343C" BorderThickness="1" Padding="22,8" Margin="0,0,10,0" Cursor="Hand">
          <TextBlock Text="Annuler" Foreground="#E4E4EA" FontSize="13" FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="Yes" CornerRadius="7" Background="$accent" Padding="22,8" Cursor="Hand">
          <TextBlock Text="Installer la sélection" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
"@
        $d = [Windows.Markup.XamlReader]::Parse($x)
        if ($win -and $win.IsVisible) { $d.Owner = $win } else { $d.WindowStartupLocation = 'CenterScreen'; $d.Topmost = $true }
        $d.FindName('Ttl').Text = [string]$title
        $d.FindName('Intro').Text = [string]$intro
        $list = $d.FindName('List')
        $cbs = New-Object System.Collections.ArrayList
        foreach ($it in @($items)) {
            $cb = New-Object System.Windows.Controls.CheckBox
            $cb.Content = [string]$it
            $cb.IsChecked = $true
            $cb.Foreground = 'White'
            $cb.FontSize = 13
            $cb.Margin = '0,7,0,7'
            $cb.Padding = '6,0,0,0'
            [void]$list.Children.Add($cb)
            [void]$cbs.Add($cb)
        }
        $d.Tag = $false
        $d.FindName('All').Add_MouseLeftButtonUp({ foreach ($c in $cbs) { $c.IsChecked = $true } }.GetNewClosure())
        $d.FindName('None').Add_MouseLeftButtonUp({ foreach ($c in $cbs) { $c.IsChecked = $false } }.GetNewClosure())
        $d.FindName('Yes').Add_MouseLeftButtonUp({ $d.Tag = $true; $d.Close() }.GetNewClosure())
        $d.FindName('No').Add_MouseLeftButtonUp({ $d.Close() }.GetNewClosure())
        $d.FindName('Head').Add_MouseLeftButtonDown({ try { $d.DragMove() } catch {} }.GetNewClosure())
        $d.Add_KeyDown({ param($o, $e) if ($e.Key -eq 'Escape') { $d.Close() } }.GetNewClosure())
        [void]$d.ShowDialog()
        if (-not $d.Tag) { return $null }
        $sel = @(); foreach ($c in $cbs) { if ($c.IsChecked) { $sel += [string]$c.Content } }
        return $sel
    } catch { return $null }
}
$script:jobs = New-Object System.Collections.ArrayList
function Start-Bg($code, $arg, $done) {
    $p = [powershell]::Create()
    [void]$p.AddScript($code).AddArgument($arg)
    [void]$script:jobs.Add(@{ P = $p; H = $p.BeginInvoke(); Done = $done })
}

# ---------- Programmes : fermer ----------
$protected = 'System', 'Idle', 'Registry', 'smss', 'csrss', 'wininit', 'winlogon', 'services', 'lsass', 'svchost', 'dwm', 'explorer', 'fontdrvhost', 'Memory Compression', 'MsMpEng', 'powershell'
(UI 'ProcList').AddHandler([System.Windows.Controls.Primitives.ButtonBase]::ClickEvent, [System.Windows.RoutedEventHandler] {
    param($sender, $e)
    $it = $e.OriginalSource.DataContext
    if (-not $it -or -not $it.Raw) { return }
    $name = [string]$it.Raw
    if ($protected -contains $name) { (UI 'ProcMsg').Text = "« $name » fait partie de Windows : je ne le ferme pas."; return }
    if (-not (Ask "Fermer « $name » ?`r`nCe qui n'est pas enregistré dans ce programme sera perdu.")) { return }
    try { Stop-Process -Name $name -Force -ErrorAction Stop; Log "Programme fermé : $name"; (UI 'ProcMsg').Text = "« $name » a été fermé." }
    catch { (UI 'ProcMsg').Text = "Impossible de fermer « $name » (droits insuffisants ou déjà fermé)." }
})

