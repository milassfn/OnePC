        else { $t = "Pilote graphique installé : " + $amdGpu.DriverVersion + ", du " + (DrvDate $amdGpu) }
        $t += "`r`nCompare ce numéro avec celui affiché sur le site d'AMD : s'il est plus petit, une mise à jour existe."
    } else { $t = "Pas de carte Radeon : seul le pilote chipset du processeur est concerné." }
    (UI 'AmdVer').Text = $t
} else {
