                    <Border Grid.Column="2" Background="#1C1C22" CornerRadius="10" Padding="16,12">
                      <StackPanel>
                        <TextBlock Text="Accélération de la souris" Foreground="#CACAD2" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MouseAccelVal" Text="..." FontSize="22" FontWeight="SemiBold" Margin="0,8,0,8"/>
                        <Button x:Name="MouseAccel" Style="{StaticResource Ghost}" Content="Désactiver" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <TextBlock Text="« Améliorer la précision du pointeur » de Windows. Désactivée, un même geste donne toujours le même mouvement : indispensable pour viser." TextWrapping="Wrap" Foreground="#8E8E98" FontSize="12"/>
                      </StackPanel>
                    </Border>
                  </Grid>
