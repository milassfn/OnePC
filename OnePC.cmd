# ---------- test d'envoi ----------
function Test-Upload($then) {
    (UI 'TileNetVal').Text = 'Test en cours...'; (UI 'TileNetTxt').Text = 'Envoi de quelques Mo (10 s environ).'
    $script:upThen = $then
    Start-Bg {
        param($a)
        try {
            [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
            $data = New-Object byte[] (8MB); (New-Object Random).NextBytes($data)
            $best = 0.0
            foreach ($i in 1..2) {
                $req = [System.Net.HttpWebRequest]::Create('https://speed.cloudflare.com/__up'); $req.Method = 'POST'; $req.ContentType = 'application/octet-stream'; $req.Timeout = 30000; $req.UserAgent = 'OnePC'
                $req.ContentLength = $data.Length; $sw = [Diagnostics.Stopwatch]::StartNew()
                $st = $req.GetRequestStream(); $st.Write($data, 0, $data.Length); $st.Close()
                $resp = $req.GetResponse(); $resp.Close(); $sw.Stop()
                $m = $data.Length * 8 / $sw.Elapsed.TotalSeconds / 1e6; if ($m -gt $best) { $best = $m }
            }
            $best
        } catch { -1 }
    } 0 {
        param($r)
        $v = 0.0; try { $v = [double](@($r)[0]) } catch {}
        if ($v -gt 0) { $script:obsUp = $v; $cfg.ObsUp = [math]::Round($v, 2); Save-Cfg; (UI 'ObsMsg').Text = "Débit d'envoi mesuré : $([math]::Round($v,1)) Mbit/s." }
        else { (UI 'ObsMsg').Text = "Le test de débit n'a pas marché (pas d'Internet ou pare-feu)." }
        Update-ObsScore
        if ($script:upThen) { & $script:upThen }
    }
}
