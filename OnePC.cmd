function Enable-ObsWs {
    # active le serveur WebSocket d'OBS dans ses propres réglages (OBS fermé) ; on ne change que l'interrupteur « activé »
    $done = $false
    $jf = Join-Path $obsCfgDir 'plugin_config\obs-websocket\config.json'
    if (Test-Path -LiteralPath $jf) {
        try { $raw = [System.IO.File]::ReadAllText($jf)
            if ($raw -match '"server_enabled"\s*:\s*false') { $raw = $raw -replace '"server_enabled"\s*:\s*false', '"server_enabled": true'; [System.IO.File]::WriteAllText($jf, $raw, (New-Object System.Text.UTF8Encoding $false)) }
            if ($raw -match '"server_enabled"\s*:\s*true') { $done = $true } } catch {}
    }
    $gf = Join-Path $obsCfgDir 'global.ini'
    if (Test-Path -LiteralPath $gf) {
        try { $raw = [System.IO.File]::ReadAllText($gf)
            if ($raw -match '(?m)^ServerEnabled=false') { $raw = $raw -replace '(?m)^ServerEnabled=false', 'ServerEnabled=true'; [System.IO.File]::WriteAllText($gf, $raw, (New-Object System.Text.UTF8Encoding $true)); $done = $true } } catch {}
    }
    $done
}
function Start-ObsLink {
    if (-not $script:obsExe) { $script:obsExe = Find-Obs }
    if (-not $script:obsExe) { (UI 'ObsSetupState').Text = "Installe d'abord OBS (bouton en haut)."; return }
    if (Connect-Obs) { Show-ObsLink; return }
    if (Get-Process -Name 'obs64' -ErrorAction SilentlyContinue) {
        if (-not (Ask "OnePC va fermer OBS quelques secondes, activer la connexion, puis le relancer.`r`n`r`nSi tu es en live ou en train d'enregistrer, arrête d'abord. Continuer ?")) { return }
        foreach ($x in @(Get-Process -Name 'obs64' -ErrorAction SilentlyContinue)) { try { [void]$x.CloseMainWindow() } catch {} }
        for ($i = 0; $i -lt 40 -and (Get-Process -Name 'obs64' -ErrorAction SilentlyContinue); $i++) { Start-Sleep -Milliseconds 200 }
        if (Get-Process -Name 'obs64' -ErrorAction SilentlyContinue) { (UI 'ObsSetupState').Text = "OBS ne s'est pas fermé : ferme-le toi-même, puis reclique."; return }
    }
    [void](Enable-ObsWs)
    Start-Obs '' ''
    (UI 'ObsSetupState').Text = 'Connexion en cours... (10 secondes)'; (UI 'ObsAutoLink').IsEnabled = $false
    $script:obsWaitN = 0; $script:obsWait.Start()
}
(UI 'ObsAutoLink').Add_Click({ Start-ObsLink })
$script:obsWait = New-Object System.Windows.Threading.DispatcherTimer; $script:obsWait.Interval = [TimeSpan]::FromSeconds(2)
$script:obsWait.Add_Tick({
