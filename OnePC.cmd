                    <Button x:Name="MouseGaming" Style="{StaticResource Action}" Content="Réglage gaming (conseillé)"/>
                    <Button x:Name="MouseOrig" Style="{StaticResource Ghost}" Content="Remettre comme avant"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <!-- ===== Aide ===== -->
        <ScrollViewer x:Name="PageHelp" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,8" Visibility="Collapsed">
          <StackPanel Margin="26,4,22,12" MaxWidth="1250">
            <TextBlock Text="Aide &amp; support" Style="{StaticResource H}" Margin="0,0,0,2"/>
            <TextBlock Text="Un souci ? Les solutions aux problèmes fréquents, ou un ticket avec ton diagnostic en un clic" Style="{StaticResource Dim}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}" Padding="22" BorderBrush="#5865F2" BorderThickness="1.5">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#8B93FF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock Text="BESOIN D'AIDE ?" Style="{StaticResource Tag}" Foreground="#8B93FF"/>
                </StackPanel>
                <TextBlock Text="Ouvre un ticket sur le Discord avec ton diagnostic" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="#CACAD2" LineHeight="20" Margin="0,0,0,14" Text="Le diagnostic résume ton PC (Windows, carte graphique et pilote, RAM, disques, connexion, plantages récents). Colle-le dans ton ticket : on voit tout de suite le problème, sans te poser dix questions. Il ne contient rien de personnel : ni ton nom, ni tes fichiers, ni ta clé."/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="HelpTicket" Style="{StaticResource Action}" Content="Ouvrir un ticket avec mon diagnostic"/>
                  <Button x:Name="HelpCopy" Style="{StaticResource Ghost}" Content="Copier mon diagnostic"/>
                </StackPanel>
                <TextBlock x:Name="HelpMsg" Text=" " Foreground="#34D399" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <Border x:Name="HelpPreviewBox" Visibility="Collapsed" Background="#0E0E11" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" BorderBrush="#26262C" BorderThickness="1">
                  <TextBox x:Name="HelpPreview" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="#B8B8C0" FontFamily="Consolas" FontSize="11.5" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                </Border>
              </StackPanel>
            </Border>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="PROBLÈMES FRÉQUENTS" Style="{StaticResource Tag}" Foreground="#FBBF24"/>
                  <TextBlock Text="Clique sur ton souci pour voir la solution" Style="{StaticResource Dim}" Margin="0,2,0,6"/>
                  <StackPanel x:Name="FaqList"/>
                  <TextBlock Text="Toujours pas réglé ? Ouvre un ticket avec ton diagnostic, en haut de la page." Style="{StaticResource Dim}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="ANNONCES" Style="{StaticResource Tag}" Foreground="#F472B6"/>
                  <TextBlock Text="Les nouveautés de OnePC et du serveur" Style="{StaticResource Dim}" Margin="0,2,0,6"/>
                  <StackPanel x:Name="NewsList"><TextBlock Text="Chargement..." Foreground="#8E8E98"/></StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <!-- ===== Optimisation ===== -->
        <ScrollViewer x:Name="PageOpti" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,8" Visibility="Collapsed"><StackPanel Margin="26,4,22,12" MaxWidth="1250">
          <TextBlock Text="Optimisation" Style="{StaticResource H}" Margin="0,0,0,2"/>
          <TextBlock Text="Nettoyage, mode jeu, mises à jour des logiciels et réparation de Windows" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
