                  <Canvas Width="240" Height="46"><Polygon x:Name="AreaRam" Fill="#FBBF24" Opacity="0.14"/><Polyline x:Name="LineRam" Stroke="#FBBF24" StrokeThickness="1.8"/></Canvas>
