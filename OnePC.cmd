# ---------- Pilote graphique en un clic ----------
$drvVendor = ''; $drvGpuName = ''; $drvInstalled = ''
if ($nvGpu) { $drvVendor = 'NV'; $drvGpuName = [string]$nvGpu.Name; $drvInstalled = [string]$nvv }
elseif ($amdGpu) { $drvVendor = 'AMD'; $drvGpuName = [string]$amdGpu.Name; $drvInstalled = [string]$adrenalin }
function Test-Laptop {
    try {
        foreach ($c in @(Get-CimInstance Win32_SystemEnclosure -ErrorAction Stop)) { foreach ($t in @($c.ChassisTypes)) { if (@(8, 9, 10, 11, 12, 14, 18, 21, 30, 31, 32) -contains [int]$t) { return $true } } }
        return $false
    } catch { return [bool](Get-CimInstance Win32_Battery -ErrorAction SilentlyContinue) }
}
# Processeur AMD : pilotes chipset officiels (page AMD selon la carte mère)
$chipPage = ''; $chipName = ''
if ([string]$cpu.Name -match 'AMD') {
    $bp = ([string]($mb | Select-Object -First 1).Product).ToUpper()
    $cm = [regex]::Match($bp, '(A320|B350|X370|B450|X470|A520|B550|X570|A620|B650E|B650|X670E|X670|B840|B850|X870E|X870)')
    if ($cm.Success) {
        $chipName = $cm.Value; $sock = 'am4'; if ($chipName -match '^(A620|B650|X670|B840|B850|X870)') { $sock = 'am5' }
        $chipPage = "https://www.amd.com/en/support/downloads/drivers.html/chipsets/$sock/" + $chipName.ToLower() + '.html'
    } else {
        $gen = 0; $gm = [regex]::Match([string]$cpu.Name, 'Ryzen\s+\d\s+(?:PRO\s+)?(\d)\d{3}'); if ($gm.Success) { $gen = [int]$gm.Groups[1].Value }
        if ($gen -ge 7) { $chipPage = 'https://www.amd.com/en/support/downloads/drivers.html/chipsets/am5/b650.html' }
        elseif ($gen -ge 1) { $chipPage = 'https://www.amd.com/en/support/downloads/drivers.html/chipsets/am4/b550.html' }
    }
    # portable, ou processeur de portable monté dans un mini-PC : c'est le fabricant de la machine qui fournit ces pilotes
    if ((Test-Laptop) -or (-not $chipName -and [string]$cpu.Name -match '\d{4}(U|H|HS|HX|HK|P)\b')) { $chipPage = '' }
}
function Get-ChipInstalled {
    foreach ($root in 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*') {
        foreach ($k in @(Get-ItemProperty -Path $root -ErrorAction SilentlyContinue)) { if ([string]$k.DisplayName -match '^AMD[ _]Chipset[ _]Software') { return [string]$k.DisplayVersion } }
    }
    return ''
}
function Get-DrvIntro {
    $l = @()
    if ($drvVendor) { $b = 'NVIDIA'; if ($drvVendor -eq 'AMD') { $b = 'AMD' }; $v = Get-DrvInstalled; if (-not $v) { $v = 'version inconnue' }; $l += "1. Carte graphique $b : $v installée, vérifiée chez $b" }
    else { $l += "1. Carte graphique : ni NVIDIA ni AMD, vérifiée chez Windows Update" }
    if ($chipPage) { $v = Get-ChipInstalled; if (-not $v) { $v = 'pas installés' }; $l += "2. Processeur / chipset AMD : $v, vérifiés chez AMD" }
    elseif ([string]$cpu.Name -match 'Intel') { $l += "2. Processeur Intel : ses pilotes passent par Windows Update" }
    else { $l += "2. Processeur : ses pilotes passent par Windows Update" }
    $l += "3. Autres pilotes (réseau, audio, Bluetooth...) : Windows Update"
    $l -join "`r`n"
}
(UI 'DrvAutoGpu').Text = (@($drvGpuName, ([string]$cpu.Name).Trim()) | Where-Object { $_ }) -join '   +   '
if (-not $drvVendor) { (UI 'DrvAutoGpu').Text = ([string]$mainGpu.Name + '   +   ' + ([string]$cpu.Name).Trim()) }
$drvCheckCode = {
    param($a)
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36'
    try {
        $wc = New-Object System.Net.WebClient; $wc.Encoding = [System.Text.Encoding]::UTF8; $wc.Headers['User-Agent'] = $ua
        if ($a.Vendor -eq 'NV') {
            $name = ($a.Gpu -replace '^NVIDIA\s+', '').Trim()
            [xml]$x = $wc.DownloadString('https://www.nvidia.com/Download/API/lookupValueSearch.aspx?TypeID=3')
            $cands = @($x.LookupValueSearch.LookupValues.LookupValue | Where-Object { $_.Name -eq $name })
            if ($cands.Count -eq 0) { 'ERR'; "Ta carte « $name » n'est pas dans la liste de NVIDIA."; return }
            $found = @()
            foreach ($c in $cands) {
                try {
                    $wc.Headers['User-Agent'] = $ua
                    $u = 'https://gfwsl.geforce.com/services_toolkit/services/com/nvidia/services/AjaxDriverService.php?func=DriverManualLookup&psid=' + $c.ParentID + '&pfid=' + $c.Value + '&osID=' + $a.OsId + '&languageCode=1036&beta=0&isWHQL=1&dltype=-1&dch=1&upCRD=0&sort1=0&numberOfResults=1'
                    $j = $wc.DownloadString($u) | ConvertFrom-Json
                    if ([string]$j.Success -eq '1' -and $j.IDS) { $d = $j.IDS[0].downloadInfo; if ($d.DownloadURL) { $found += [pscustomobject]@{ V = [string]$d.Version; U = [string]$d.DownloadURL } } }
                } catch {}
            }
            if ($found.Count -eq 0) { 'ERR'; "NVIDIA ne propose pas de pilote pour cette carte sur cette version de Windows."; return }
            $want = 'desktop'; if ($a.Laptop) { $want = 'notebook' }
            $pick = $found | Where-Object { $_.U -match $want } | Select-Object -First 1
            if (-not $pick) { $pick = $found[0] }
            'OK'; $pick.V; $pick.U
        } else {
            $wc.Headers['Accept-Language'] = 'en-US,en;q=0.9'
            $html = $wc.DownloadString('https://www.amd.com/en/support/download/drivers.html')
            $mm = [regex]::Match($html, 'https://drivers\.amd\.com/drivers/installer/[^"''<>\s]+?minimalsetup[^"''<>\s]+?\.exe')
            if (-not $mm.Success) { 'ERR'; "Le lien de l'installateur AMD est introuvable sur le site d'AMD."; return }
            $v = ''; $vm = [regex]::Match($mm.Value, 'adrenalin-edition-(\d+\.\d+\.\d+)'); if ($vm.Success) { $v = $vm.Groups[1].Value }
            'OK'; $v; $mm.Value
        }
    } catch { 'ERR'; ("Impossible de joindre le site du fabricant : " + $_.Exception.Message) }
}
function Test-Newer($new, $old) {
    try {
        $a = [version](([regex]::Match([string]$new, '\d+(\.\d+)+')).Value); $b = [version](([regex]::Match([string]$old, '\d+(\.\d+)+')).Value)
        return ($a -gt $b)
    } catch { return $true }
}
function Get-DrvInstalled {
    try {
        if ($drvVendor -eq 'NV') {
            $g = Get-CimInstance Win32_VideoController | Where-Object { $_.Name -match 'NVIDIA' } | Select-Object -First 1
            $dg = ([string]$g.DriverVersion) -replace '\.', ''
            if ($dg.Length -ge 5) { $l5 = $dg.Substring($dg.Length - 5); return ($l5.Substring(0, 3) + '.' + $l5.Substring(3)) }
        } elseif ($drvVendor -eq 'AMD') {
            foreach ($k in @(Get-ItemProperty -Path "$classKey\0*" -ErrorAction SilentlyContinue)) { if ($k.RadeonSoftwareVersion) { return [string]$k.RadeonSoftwareVersion } }
        }
    } catch {}
    return [string]$drvInstalled
}
