# ---------- Notifications dans la fenêtre ----------
$script:toastLast = ''; $script:toastAt = [datetime]::MinValue; $script:toastOn = $false
function Toast($text) {
    try {
        $text = ([string]$text).Trim()
        if (-not $script:toastOn -or -not $text -or -not $win.IsVisible) { return }
        if ($text -eq $script:toastLast -and ((Get-Date) - $script:toastAt).TotalSeconds -lt 4) { return }
        $script:toastLast = $text; $script:toastAt = Get-Date
        $host2 = UI 'ToastHost'
        while ($host2.Children.Count -ge 3) { $host2.Children.RemoveAt(0) }
        $col = $accent
        if ($text -match "impossible|introuvable|n'a pas|erreur|échou|refus|trop ") { $col = '#F87171' }
        elseif ($text -match 'terminé|activé|remis|enregistr|fermé|désinstallé|supprim|appliqu|actualis|copié|lanc') { $col = '#34D399' }
        $card = New-Object System.Windows.Controls.Border
        $card.Background = $brush.ConvertFromString('#1C1C22'); $card.BorderBrush = $brush.ConvertFromString('#34343C'); $card.BorderThickness = New-Object System.Windows.Thickness 1
        $card.CornerRadius = New-Object System.Windows.CornerRadius 10; $card.Margin = New-Object System.Windows.Thickness 0, 8, 0, 0
        $card.HorizontalAlignment = 'Right'; $card.MaxWidth = 380
        $fx = New-Object System.Windows.Media.Effects.DropShadowEffect; $fx.BlurRadius = 18; $fx.ShadowDepth = 3; $fx.Opacity = 0.5; $fx.Color = [System.Windows.Media.Colors]::Black
        $card.Effect = $fx
        $dock = New-Object System.Windows.Controls.DockPanel
        $bar = New-Object System.Windows.Controls.Border
        $bar.Width = 4; $bar.CornerRadius = New-Object System.Windows.CornerRadius 10, 0, 0, 10; $bar.Background = $brush.ConvertFromString($col)
        [System.Windows.Controls.DockPanel]::SetDock($bar, 'Left')
        $tb = New-Object System.Windows.Controls.TextBlock
        $tb.Text = $text; $tb.TextWrapping = 'Wrap'; $tb.Foreground = $brush.ConvertFromString('#E8E8EC'); $tb.FontSize = 12.5
        $tb.Margin = New-Object System.Windows.Thickness 12, 10, 14, 10
        [void]$dock.Children.Add($bar); [void]$dock.Children.Add($tb); $card.Child = $dock
        [void]$host2.Children.Add($card)
        $in = New-Object System.Windows.Media.Animation.DoubleAnimation
        $in.From = 0.0; $in.To = 1.0; $in.Duration = [System.Windows.Duration][TimeSpan]::FromMilliseconds(200)
        $card.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $in)
        $secs = [math]::Min(8, 3.5 + $text.Length / 40)
        $t = New-Object System.Windows.Threading.DispatcherTimer
        $t.Interval = [TimeSpan]::FromSeconds($secs); $t.Tag = $card
        $t.Add_Tick({
            param($sender, $e)
            $sender.Stop()
            try { (UI 'ToastHost').Children.Remove($sender.Tag) } catch {}
        })
        $t.Start()
    } catch {}
}
try {
    $tbType = [System.Windows.Controls.TextBlock]
    $dpd = [System.ComponentModel.DependencyPropertyDescriptor]::FromProperty([System.Windows.Controls.TextBlock]::TextProperty, $tbType)
    foreach ($nm in ([regex]::Matches($xaml, 'x:Name="(\w*Msg\d?)"') | ForEach-Object { $_.Groups[1].Value } | Select-Object -Unique)) {
        $el = UI $nm
        if ($el -is $tbType) {
            $dpd.AddValueChanged($el, [EventHandler] {
                param($sender, $e)
                $t = [string]$sender.Text
                if ($t.Trim() -and -not $t.TrimEnd().EndsWith('...')) { Toast $t }
            })
        }
    }
} catch {}
# ---------- Mon profil ----------
$avatarFile = Join-Path $appDir 'avatar.png'
function Get-PcState {
    $why = @(); $lvl = 0
    if ([int]$sync.CpuT -ge 88) { $lvl = 2; $why += 'processeur à ' + $sync.CpuT + ' °C' }
    if ([int]$sync.GpuT -ge 88) { $lvl = 2; $why += 'carte graphique à ' + $sync.GpuT + ' °C' }
    if ([int]$sync.DiskFree -lt 10) { $lvl = 2; $why += 'disque système presque plein (' + $sync.DiskFree + ' % libre)' }
    $late = @(Get-CalState | Where-Object { $_.Item.Days -gt 0 -and $_.Level -gt 0 })
    if ($late.Count) { if ($lvl -lt 1) { $lvl = 1 }; $why += 'entretien à faire : ' + (($late | ForEach-Object { $_.Item.N.ToLower() }) -join ', ') }
    $word = 'En forme', 'À entretenir', 'À surveiller'; $cols = '#3DDC84', '#FBBF24', '#FF5A6E'
    $txt = 'Températures normales, disque avec de la place, entretien à jour.'
    if ($why.Count) { $txt = ($why -join ' ; '); $txt = $txt.Substring(0, 1).ToUpper() + $txt.Substring(1) + '.' }
    @{ Word = $word[$lvl]; Col = $cols[$lvl]; Why = $txt }
}
$script:meBanner = -1
function Set-MeBanner {
    try {
        Add-Type -AssemblyName System.Drawing
        $i = [int]$cfg.Banner; if ($i -lt 0 -or $i -ge $walls.Count) { $i = 0 }
        if ($script:meBanner -eq $i) { return }
        $script:meBanner = $i
        $bmp = New-Object System.Drawing.Bitmap 1280, 300
        $g = [System.Drawing.Graphics]::FromImage($bmp); Draw-Wall $g 1280 300 $walls[$i]; $g.Dispose()
        $ms = New-Object System.IO.MemoryStream
        $bmp.Save($ms, [System.Drawing.Imaging.ImageFormat]::Png); $bmp.Dispose(); $ms.Position = 0
        $bi = New-Object System.Windows.Media.Imaging.BitmapImage
        $bi.BeginInit(); $bi.StreamSource = $ms; $bi.CacheOption = 'OnLoad'; $bi.EndInit(); $bi.Freeze()
        $ib = New-Object System.Windows.Media.ImageBrush $bi; $ib.Stretch = 'UniformToFill'
        (UI 'MeBanner').Background = $ib
    } catch { (UI 'MeBanner').Background = $brush.ConvertFromString($accentDark) }
}
function Set-MeAvatar {
    $name = [string]$cfg.Pseudo
    $shown = $false
    if (Test-Path -LiteralPath $avatarFile) {
        try {
            $bi = New-Object System.Windows.Media.Imaging.BitmapImage
            $bi.BeginInit(); $bi.StreamSource = New-Object System.IO.MemoryStream (, [System.IO.File]::ReadAllBytes($avatarFile)); $bi.CacheOption = 'OnLoad'; $bi.DecodePixelWidth = 256; $bi.EndInit(); $bi.Freeze()
            $ib = New-Object System.Windows.Media.ImageBrush $bi; $ib.Stretch = 'UniformToFill'
            (UI 'MeAvatar').Background = $ib; (UI 'MeLetter').Visibility = 'Collapsed'; $shown = $true
        } catch {}
    }
    if (-not $shown) {
        (UI 'MeAvatar').Background = $brush.ConvertFromString($accent); (UI 'MeLetter').Visibility = 'Visible'
        $l = '?'; if ($name.Trim()) { $l = $name.Trim().Substring(0, 1).ToUpper() }
        (UI 'MeLetter').Text = $l
