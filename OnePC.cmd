function Set-WinTheme($light) {
    try {
        $k = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize'
        if (-not (Test-Path -LiteralPath $k)) { New-Item -Path $k -Force | Out-Null }
        if ([int]$cfg.ThemeOrig -eq -1) {
            $curTheme = 1; try { $curTheme = [int](Get-ItemProperty -LiteralPath $k -Name AppsUseLightTheme -ErrorAction Stop).AppsUseLightTheme } catch {}
            $cfg.ThemeOrig = $curTheme; Save-Cfg
        }
        Set-ItemProperty -LiteralPath $k -Name AppsUseLightTheme -Value $light -Type DWord
        Set-ItemProperty -LiteralPath $k -Name SystemUsesLightTheme -Value $light -Type DWord
        if (-not ('PCM.Msg' -as [type])) {
            Add-Type -Namespace PCM -Name Msg -MemberDefinition '[DllImport("user32.dll", CharSet = CharSet.Unicode, SetLastError = true)] public static extern IntPtr SendMessageTimeout(IntPtr hWnd, uint Msg, UIntPtr wParam, string lParam, uint fuFlags, uint uTimeout, out UIntPtr lpdwResult);'
        }
        $res = [UIntPtr]::Zero
        # Deux annonces à la suite : la barre des tâches du 2e écran rate parfois la première
        foreach ($what in 'ImmersiveColorSet', 'WindowsThemeElement', 'ImmersiveColorSet') {
            [void][PCM.Msg]::SendMessageTimeout([IntPtr]0xffff, 0x1A, [UIntPtr]::Zero, $what, 2, 1000, [ref]$res)
            Start-Sleep -Milliseconds 250
        }
        Log ("Thème Windows : " + $(if ($light) { 'clair' } else { 'sombre' })); if ($light) { (UI 'ThemeMsg').Text = "Windows est passé en mode clair. Si un écran n'a pas suivi, clique sur « Un écran n'a pas changé ? »." } else { (UI 'ThemeMsg').Text = "Windows est passé en mode sombre. Si un écran n'a pas suivi, clique sur « Un écran n'a pas changé ? »." }
    } catch { (UI 'ThemeMsg').Text = "Impossible de changer le thème de Windows." }
}
