        string cmd = Path.Combine(dir, "OnePC.cmd");
        ProcessStartInfo psi = new ProcessStartInfo("powershell.exe", "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command \"iex (Get-Content -Raw -Encoding UTF8 -LiteralPath $env:SELF)\"");
        psi.UseShellExecute = false; psi.CreateNoWindow = true;
        psi.EnvironmentVariables["SELF"] = cmd;
        Process.Start(psi);
    }
}
'@
            $cp = New-Object System.CodeDom.Compiler.CompilerParameters
            $cp.GenerateExecutable = $true; $cp.OutputAssembly = $exe
            $cp.CompilerOptions = '/target:winexe /win32icon:"' + $ico2 + '"'
            [void]$cp.ReferencedAssemblies.Add('System.dll')
            $cres = (New-Object Microsoft.CSharp.CSharpCodeProvider).CompileAssemblyFromSource($cp, $cs)
            if (-not $cres.Errors.HasErrors) { Set-Content -LiteralPath $exeMark -Value '2' }
