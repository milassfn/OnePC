              </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,12">
              <StackPanel>
                <TextBlock x:Name="TagRam" Text="RAM · 60 s" Style="{StaticResource Tag}" Foreground="#FBBF24"/>
