# ---------- Disques : ce qui prend le plus de place ----------
$bigCode = {
    param($root)
    $top = New-Object 'System.Collections.Generic.List[object]'
    $dirs = @{}; $min = 0
    $stack = New-Object 'System.Collections.Generic.Stack[object]'
    $stack.Push([pscustomobject]@{ P = $root; K = '' })
    while ($stack.Count -gt 0) {
        $cur = $stack.Pop()
        try {
            $di = New-Object System.IO.DirectoryInfo $cur.P
            foreach ($f in $di.GetFiles()) {
                $len = $f.Length
                $key = $cur.K; if (-not $key) { $key = '(fichiers à la racine)' }
                $dirs[$key] = [double]$dirs[$key] + $len
                if ($len -gt $min) {
                    $top.Add([pscustomobject]@{ S = $len; P = $f.FullName })
                    if ($top.Count -gt 300) {
                        $keep = @($top | Sort-Object S -Descending | Select-Object -First 60)
                        $top.Clear(); foreach ($t in $keep) { $top.Add($t) }
                        $min = $keep[-1].S
                    }
                }
            }
            foreach ($d in $di.GetDirectories()) {
                if ($d.Attributes -band [System.IO.FileAttributes]::ReparsePoint) { continue }
                $k = $cur.K; if (-not $k) { $k = $d.Name }
                $stack.Push([pscustomobject]@{ P = $d.FullName; K = $k })
            }
        } catch {}
    }
    foreach ($k in ($dirs.Keys | Sort-Object { $dirs[$_] } -Descending | Select-Object -First 12)) { [pscustomobject]@{ Kind = 'D'; Name = $k; S = $dirs[$k] } }
    foreach ($t in ($top | Sort-Object S -Descending | Select-Object -First 50)) { [pscustomobject]@{ Kind = 'F'; Name = $t.P; S = $t.S } }
}
function Start-Big($root) {
    if (-not $root -or -not (Test-Path -LiteralPath $root)) { return }
    foreach ($b in 'BigUser', 'BigC', 'BigOther') { (UI $b).IsEnabled = $false }
    (UI 'BigMsg').Text = "Analyse de $root en cours... tu peux changer d'onglet en attendant."
    (UI 'BigDirs').ItemsSource = $null; (UI 'BigFiles').ItemsSource = $null
    $script:bigRoot = $root
    Start-Bg $bigCode $root {
        param($r)
        foreach ($b in 'BigUser', 'BigC', 'BigOther') { (UI $b).IsEnabled = $true }
        (UI 'BigDirs').ItemsSource = @($r | Where-Object { $_.Kind -eq 'D' } | ForEach-Object { [pscustomobject]@{ Size = (Mo $_.S); Name = $_.Name } })
        (UI 'BigFiles').ItemsSource = @($r | Where-Object { $_.Kind -eq 'F' } | ForEach-Object {
            [pscustomobject]@{ Size = (Mo $_.S); Name = [System.IO.Path]::GetFileName($_.Name); Dir = [System.IO.Path]::GetDirectoryName($_.Name); Path = $_.Name }
        })
        (UI 'BigMsg').Text = "Analyse de " + $script:bigRoot + " terminée : les 12 plus gros dossiers, puis les 50 plus gros fichiers. « Afficher » ouvre l'emplacement du fichier."
    }
}
