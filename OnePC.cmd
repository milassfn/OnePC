(UI 'AppList').AddHandler([System.Windows.Controls.Primitives.ButtonBase]::ClickEvent, [System.Windows.RoutedEventHandler] {
    param($sender, $e)
    $it = $e.OriginalSource.DataContext
    if (-not $it -or -not $it.Cmd) { return }
    if ($e.OriginalSource -is [System.Windows.Controls.CheckBox]) {
        $key = [string]$it.RegKey
        if ($e.OriginalSource.IsChecked) { $script:appSel[$key] = $it } else { $script:appSel.Remove($key) }
        Update-AppSel; return
    }
    if ($script:batch) { (UI 'AppsMsg').Text = "Une désinstallation groupée est en cours : attends qu'elle finisse."; return }
    if ($script:unBusy -and [string]$e.OriginalSource.Content -ne 'Lancer') { (UI 'AppsMsg').Text = "Une désinstallation est déjà en cours : attends qu'elle finisse avant d'en lancer une autre."; return }
    if ([string]$e.OriginalSource.Content -eq 'Lancer') {
        if (-not $it.Run) { (UI 'AppsMsg').Text = "Je n'ai pas trouvé comment lancer « " + $it.Name + " » : cherche-la dans le menu Démarrer."; return }
        try { Start-Process -FilePath $it.Run; (UI 'AppsMsg').Text = "Lancement de « " + $it.Name + " »..." }
        catch { (UI 'AppsMsg').Text = "Impossible de lancer « " + $it.Name + " »." }
        return
    }
    $u = [string]$it.Cmd; $auto = $false
    if ($u -match 'steam://uninstall/(\d+)') { Remove-SteamGame $it $Matches[1]; return }
    if ($u -match 'msiexec') {
        $g = [regex]::Match($u, '\{[0-9A-Fa-f\-]{36}\}').Value
        if ($g) { $u = "msiexec.exe /x $g /passive /norestart"; $auto = $true } else { $u = $u -replace '/I\s*\{', '/X{' }
    } elseif ($it.Quiet) { $u = [string]$it.Quiet; $auto = $true }
    $how = "Son programme de désinstallation va s'ouvrir : suis ses étapes."
    if ($auto) { $how = "La désinstallation se fait toute seule, sans questions." }
    if (-not (Ask ("Désinstaller « " + $it.Name + " » ?`r`n$how"))) { return }
    $script:unApp = $it; $script:unBusy = $true
    (UI 'AppsMsg').Text = "Désinstallation de « " + $it.Name + " » en cours..."
    Start-Bg $uninstCode $u {
        param($r)
        $it = $script:unApp; $script:unBusy = $false
        Load-AppList
        if ($script:apps | Where-Object { $_.Name -eq $it.Name }) {
            (UI 'AppsMsg').Text = "« " + $it.Name + " » est encore dans la liste : la désinstallation a été annulée, ou elle n'a pas fini. Clique sur Actualiser dans un instant."
            return
        }
        Log ("Application désinstallée : " + $it.Name)
        (UI 'AppsMsg').Text = "« " + $it.Name + " » est désinstallée."
        $loc = ([string]$it.Loc).Trim().Trim('"').TrimEnd('\')
        if ($loc -and (Test-Path -LiteralPath $loc) -and (Test-LeftoverSafe $loc) -and -not (Test-LocShared $loc)) {
            $sz = 0; try { Get-ChildItem -LiteralPath $loc -Recurse -Force -File -ErrorAction SilentlyContinue | ForEach-Object { $sz += $_.Length } } catch {}
            if (Ask ("« " + $it.Name + " » a laissé son dossier derrière elle :`r`n$loc`r`n(" + (Mo $sz) + ")`r`n`r`nLe supprimer aussi ?")) {
                $ok = $false
                try { [System.IO.Directory]::Delete($loc, $true); $ok = $true }
                catch { $ok = (Run-Console ("[System.IO.Directory]::Delete('" + $loc.Replace("'", "''") + "', `$true)") -HiddenWait) -and -not (Test-Path -LiteralPath $loc) }
                if ($ok) { Log ("Dossier restant supprimé : " + $loc); (UI 'AppsMsg').Text = "« " + $it.Name + " » est désinstallée et son dossier est supprimé." }
                else { (UI 'AppsMsg').Text = "« " + $it.Name + " » est désinstallée, mais son dossier n'a pas pu être supprimé." }
            }
        }
    }
})

# ---------- Applications : désinstaller plusieurs applis d'un coup ----------
$script:batch = $null; $script:unBusy = $false
function Step-Batch {
    try { Step-BatchCore } catch { $script:batch = $null; try { Load-AppList } catch {}; (UI 'AppsMsg').Text = "La désinstallation groupée s'est arrêtée sur une erreur : " + $_.Exception.Message }
}
function Step-BatchCore {
    $b = $script:batch
    if ($b.Queue.Count -eq 0) {
        $script:batch = $null
        Load-AppList
        $left = @($b.All | Where-Object { $n = $_.Name; $script:apps | Where-Object { $_.Name -eq $n } })
        $gone = $b.All.Count - $left.Count
        foreach ($x in $b.All) { if ($left -notcontains $x) { Log ("Application désinstallée : " + $x.Name) } }
        $msg = "$gone application(s) désinstallée(s) sur " + $b.All.Count + "."
        if ($left.Count) { $msg += " Encore présentes (annulées ou pas finies) : " + (($left | ForEach-Object { $_.Name }) -join ', ') + "." }
        (UI 'AppsMsg').Text = $msg
        return
    }
    $it = $b.Queue[0]; $b.Queue.RemoveAt(0); $b.Cur = $it
    $pos = $b.All.Count - $b.Queue.Count
    (UI 'AppsMsg').Text = "Désinstallation $pos sur " + $b.All.Count + " : « " + $it.Name + " »..."
    if ([string]$it.Cmd -match 'steam://uninstall/(\d+)') {
        $g = Find-SteamGame $Matches[1]
        $running = $false
        if ($g) { $pre = $g.Dir.TrimEnd('\') + '\'; $running = [bool](Get-Process | Where-Object { try { $_.Path -and $_.Path.StartsWith($pre, [StringComparison]::OrdinalIgnoreCase) } catch { $false } }) }
        if (-not $g -or $running) { Step-Batch; return }
        Start-Bg $steamDelCode $g {
            param($r)
            $it = $script:batch.Cur
            if ($r.Count -gt 0 -and $r[0] -eq 'OK') {
                $key = 'Registry::' + [string]$it.RegKey
                if ($it.RegKey -and (Test-Path -LiteralPath $key)) { try { Remove-Item -LiteralPath $key -Recurse -Force -ErrorAction Stop } catch { [void](Run-Console ("Remove-Item -LiteralPath '" + $key.Replace("'", "''") + "' -Recurse -Force") -HiddenWait) } }
            }
            Step-Batch
        }
        return
    }
    Start-Bg $uninstCode (Get-UninstCmd $it).U { param($r) Step-Batch }
}
(UI 'AppUnSel').Add_Click({
    $sel = @($script:appSel.Values | Sort-Object Name)
    if ($sel.Count -eq 0 -or $script:batch) { return }
    if ($script:unBusy) { (UI 'AppsMsg').Text = "Une désinstallation est déjà en cours : attends qu'elle finisse."; return }
    $lines = @($sel | ForEach-Object {
        $how = 'ouvre son propre désinstalleur'
        if ([string]$_.Cmd -match 'steam://uninstall/') { $how = 'jeu Steam, dossier supprimé directement' } elseif ((Get-UninstCmd $_).Auto) { $how = 'automatique' }
        " - " + $_.Name + "  (" + $how + ")"
    })
    $shown = $lines; if ($lines.Count -gt 14) { $shown = @($lines[0..12]) + (" ... et " + ($lines.Count - 13) + " autres") }
    if (-not (Ask ("Désinstaller ces " + $sel.Count + " applications, l'une après l'autre ?`r`n`r`n" + ($shown -join "`r`n") + "`r`n`r`nCelles marquées « ouvre son propre désinstalleur » te demanderont de cliquer dans leur fenêtre."))) { return }
    $q = New-Object System.Collections.ArrayList; foreach ($x in $sel) { [void]$q.Add($x) }
    $script:batch = @{ Queue = $q; All = $sel; Cur = $null }
    (UI 'AppUnSel').IsEnabled = $false
    Step-Batch
})

# ---------- Conseils d'upgrade : uniquement à partir de ce qui est mesuré sur ce PC ----------
$upgCode = {
    param($a)
    function NewRow($n, $d, $l) { [pscustomobject]@{ Name = $n; Detail = $d; Level = $l } }
    # --- disque système ---
    try {
        $sys = ([string]$env:SystemDrive).TrimEnd(':')
        $num = (Get-Partition -DriveLetter $sys -ErrorAction Stop | Select-Object -First 1).DiskNumber
        $pd = Get-PhysicalDisk -ErrorAction Stop | Where-Object { [string]$_.DeviceId -eq [string]$num } | Select-Object -First 1
        if ($pd) {
            $mt = [string]$pd.MediaType; $bus = [string]$pd.BusType
            if ($mt -eq 'HDD') { NewRow 'Disque de Windows' ("Windows est installé sur un disque dur mécanique (" + $pd.FriendlyName + "). Le remplacer par un SSD est le changement qui se sent le plus : démarrage, chargements, tout.") 2 }
            elseif ($mt -eq 'SSD' -and $bus -eq 'NVMe') { NewRow 'Disque de Windows' ("SSD NVMe (" + $pd.FriendlyName + ") : c'est le type le plus rapide, rien à changer.") 0 }
            elseif ($mt -eq 'SSD') { NewRow 'Disque de Windows' ("SSD " + $bus + " (" + $pd.FriendlyName + ") : largement suffisant. Passer en NVMe ne change presque rien en jeu.") 0 }
            else { NewRow 'Disque de Windows' ("Type de disque non reconnu par Windows (" + $pd.FriendlyName + ") : pas de conseil possible.") 0 }
        }
        $v = Get-CimInstance Win32_LogicalDisk -Filter ("DeviceID='" + $sys + ":'")
        if ($v.Size) {
            $freePct = [math]::Round($v.FreeSpace * 100 / $v.Size)
            if ($freePct -lt 10) { NewRow 'Place sur le disque' ("Il ne reste que $freePct % de libre sur " + $sys + ": (" + [math]::Round($v.FreeSpace / 1GB) + " Go). Fais du ménage, ou ajoute un deuxième disque pour les jeux.") 2 }
            elseif ($freePct -lt 20) { NewRow 'Place sur le disque' ("Il reste $freePct % de libre sur " + $sys + ": . Ça passe, mais un deuxième disque pour les jeux serait confortable.") 1 }
        }
    } catch { NewRow 'Disque de Windows' "Windows n'a pas donné le type du disque : pas de conseil possible." 0 }
    # --- mémoire ---
    try {
        $mods = @(Get-CimInstance Win32_PhysicalMemory)
        $tot = 0; foreach ($x in $mods) { $tot += [double]$x.Capacity }
        $go = [math]::Round($tot / 1GB)
        $slots = 0; try { foreach ($ar in @(Get-CimInstance Win32_PhysicalMemoryArray)) { $slots += [int]$ar.MemoryDevices } } catch {}
        $free = ''; if ($slots -gt $mods.Count) { $free = ' Il reste ' + ($slots - $mods.Count) + ' emplacement(s) libre(s) sur la carte mère.' }
        $peak = ''; if ($a.RamPeak -gt 0) { $peak = " Pic mesuré depuis l'ouverture de OnePC : " + $a.RamPeak + ' %.' }
        if ($go -lt 12) { NewRow 'Mémoire (RAM)' ("$go Go : c'est juste pour jouer aujourd'hui, la plupart des jeux récents demandent 16 Go." + $peak + $free) 2 }
        elseif ($go -lt 24 -and $a.RamPeak -ge 88) { NewRow 'Mémoire (RAM)' ("$go Go, et elle s'est remplie à " + $a.RamPeak + " % : en ajouter serait utile, surtout si tu joues avec Discord, un navigateur ou OBS ouverts." + $free) 1 }
        else { NewRow 'Mémoire (RAM)' ("$go Go : suffisant." + $peak) 0 }
        if ($mods.Count -eq 1 -and $go -ge 8) { NewRow 'Barrettes de RAM' ("Une seule barrette de $go Go : la mémoire tourne en simple canal. Ajouter une barrette identique active le double canal et donne des FPS plus réguliers, surtout avec un processeur AMD ou une puce graphique intégrée." + $free) 1 }
        $slow = @($mods | Where-Object { [int]$_.Speed -gt 0 -and [int]$_.ConfiguredClockSpeed -gt 0 -and ([int]$_.Speed - [int]$_.ConfiguredClockSpeed) -ge 200 })
        if ($slow.Count) { NewRow 'Vitesse de la RAM' ("Tes barrettes sont données pour " + $slow[0].Speed + " MHz mais tournent à " + $slow[0].ConfiguredClockSpeed + " MHz. Active le profil XMP / EXPO / DOCP dans le BIOS : c'est gratuit.") 1 }
    } catch {}
    # --- carte graphique / processeur : seulement à partir de l'utilisation mesurée ---
    if ($a.GameMin -ge 5) {
        $base = "Mesuré sur " + $a.GameMin + " min de jeu pendant cette session : carte graphique à " + $a.GpuAvg + " % en moyenne, processeur à " + $a.CpuAvg + " %."
        if ($a.GpuAvg -ge 93) { NewRow 'Carte graphique' ($base + " Elle tourne à fond : c'est elle qui fixe tes FPS. Si tu veux plus de FPS, c'est elle qu'il faut changer ; changer le processeur n'apporterait presque rien.") 1 }
        elseif ($a.GpuAvg -lt 80) { NewRow 'Processeur / limite de FPS' ($base + " La carte graphique n'est pas utilisée à fond : quelque chose la freine. Si tu as une limite de FPS ou la V-Sync, c'est normal. Sinon c'est le processeur qui limite, et c'est lui qu'il faudrait changer en premier.") 1 }
        else { NewRow 'Carte graphique et processeur' ($base + " Les deux sont bien équilibrés pour ce jeu.") 0 }
    } else {
        NewRow 'Carte graphique et processeur' "Pas encore assez de mesures. Joue au moins 5 minutes avec OnePC ouverte (réduite, ça marche), puis reclique ici : l'appli te dira lequel des deux limite tes FPS." 0
    }
    # --- températures ---
    if ($a.CpuT -ge 90) { NewRow 'Refroidissement du processeur' ("" + $a.CpuT + " °C en ce moment : c'est trop. Dépoussière, vérifie le ventilateur, et pense à changer la pâte thermique ou le ventirad avant tout autre achat.") 2 }
    if ($a.GpuT -ge 88) { NewRow 'Refroidissement de la carte graphique' ("" + $a.GpuT + " °C en ce moment : c'est chaud. Dépoussière le boîtier et vérifie que l'air circule avant tout autre achat.") 2 }
}
(UI 'BtnUpg').Add_Click({
    (UI 'BtnUpg').IsEnabled = $false
    (UI 'ScanSummary').Text = 'Analyse de ton matériel en cours...'
    $n = 0; $sg = 0.0; $sc = 0.0
    for ($i = 0; $i -lt $hGpu.Count; $i++) { if ($hGpu[$i] -ge 60) { $n++; $sg += $hGpu[$i]; $sc += $hCpu[$i] } }
    $ga = 0; $ca = 0; if ($n) { $ga = [int][math]::Round($sg / $n); $ca = [int][math]::Round($sc / $n) }
    $rp = 0; foreach ($x in $hRam) { if ($x -gt $rp) { $rp = $x } }
    Start-Bg $upgCode @{ GameMin = [int][math]::Floor($n / 60); GpuAvg = $ga; CpuAvg = $ca; RamPeak = [int]$rp; CpuT = [int]$sync.CpuT; GpuT = [int]$sync.GpuT } {
        param($r)
        (UI 'BtnUpg').IsEnabled = $true
        $cols = '#3DDC84', '#FBBF24', '#FF5A6E'; $labels = 'Rien à changer', 'À améliorer', 'En premier'
        $rows = @($r | Where-Object { $_.Name } | Sort-Object Level -Descending | ForEach-Object {
            [pscustomobject]@{ Name = $_.Name; Detail = $_.Detail; Status = $labels[$_.Level]; Brush = $brush.ConvertFromString($cols[$_.Level]) }
        })
        (UI 'ScanList').ItemsSource = $rows
        (UI 'ScanTag').Text = "CONSEILS D'UPGRADE"
        (UI 'ScanCard').Visibility = 'Visible'
        $top = @($r | Where-Object { $_.Level -eq 2 }); $mid = @($r | Where-Object { $_.Level -eq 1 })
        $head = "Rien d'urgent à changer sur ce PC."
        if ($top.Count) { $head = "À changer en premier : " + (($top | ForEach-Object { $_.Name }) -join ', ') + "." }
        elseif ($mid.Count) { $head = "Rien d'urgent. À améliorer si tu veux : " + (($mid | ForEach-Object { $_.Name }) -join ', ') + "." }
        (UI 'ScanSummary').Text = $head + " Ces conseils viennent uniquement de ce que l'appli mesure sur ton PC, pas de comparatifs."
    }
})

# ---------- Rapport du PC ----------
$reportCode = {
    param($a)
    function E($t) { [System.Net.WebUtility]::HtmlEncode([string]$t) }
    function Go($b) { if ($b -ge 1TB) { ([math]::Round($b / 1TB, 2)).ToString([cultureinfo]'fr-FR') + ' To' } else { ([math]::Round($b / 1GB, 1)).ToString([cultureinfo]'fr-FR') + ' Go' } }
    $sec = New-Object System.Collections.ArrayList
    function Sec($title, $rows) {
        $h = '<section><h2>' + (E $title) + '</h2><table>'
        foreach ($r in $rows) { $h += '<tr><th>' + (E $r[0]) + '</th><td>' + (E $r[1]) + '</td>' + $(if ($r.Count -gt 2) { '<td class="d">' + (E $r[2]) + '</td>' } else { '' }) + '</tr>' }
        [void]$sec.Add($h + '</table></section>')
    }
    try {
        $os = Get-CimInstance Win32_OperatingSystem; $cs = Get-CimInstance Win32_ComputerSystem; $bios = Get-CimInstance Win32_BIOS
        $mb = Get-CimInstance Win32_BaseBoard | Select-Object -First 1; $cpu = Get-CimInstance Win32_Processor | Select-Object -First 1
        $up = (Get-Date) - $os.LastBootUpTime
        $rows = @()
        $rows += , @('Modèle', (([string]$cs.Manufacturer + ' ' + [string]$cs.Model).Trim()))
        $rows += , @('Windows', ([string]$os.Caption + ' (build ' + $os.BuildNumber + ')'))
        $rows += , @('Installé le', ([datetime]$os.InstallDate).ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture))
        $rows += , @('Allumé depuis', ('' + $up.Days + ' j ' + $up.Hours + ' h'))
        Sec 'Système' $rows
        $rows = @()
        $rows += , @('Processeur', ([string]$cpu.Name).Trim(), ('' + $cpu.NumberOfCores + ' cœurs / ' + $cpu.NumberOfLogicalProcessors + ' threads'))
        foreach ($g in @(Get-CimInstance Win32_VideoController | Where-Object { $_.Name -notmatch 'Virtual|Remote|Basic' })) { $rows += , @('Carte graphique', [string]$g.Name, ('pilote ' + $g.DriverVersion)) }
        $rows += , @('Carte mère', (([string]$mb.Manufacturer + ' ' + [string]$mb.Product).Trim()))
        $rows += , @('BIOS', ([string]$bios.SMBIOSBIOSVersion), $(try { ([datetime]$bios.ReleaseDate).ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture) } catch { '' }))
        $mods = @(Get-CimInstance Win32_PhysicalMemory)
        $tot = 0; foreach ($x in $mods) { $tot += [double]$x.Capacity }
        $rows += , @('Mémoire', ('' + [math]::Round($tot / 1GB) + ' Go'), ('' + $mods.Count + ' barrette(s)'))
        foreach ($x in $mods) { $rows += , @('  Barrette', ('' + [math]::Round($x.Capacity / 1GB) + ' Go  ' + ([string]$x.Manufacturer).Trim() + ' ' + ([string]$x.PartNumber).Trim()), ('' + $x.ConfiguredClockSpeed + ' MHz')) }
        Sec 'Matériel' $rows
        $rows = @()
        if ($a.CpuT -gt 0) { $rows += , @('Processeur', ('' + $a.CpuT + ' °C')) } else { $rows += , @('Processeur', 'non lisible sur ce PC') }
        if ($a.GpuT -gt 0) { $rows += , @('Carte graphique', ('' + $a.GpuT + ' °C')) } else { $rows += , @('Carte graphique', 'non lisible sur ce PC') }
        $rows += , @('Charge au moment du rapport', ('CPU ' + $a.Cpu + ' %, GPU ' + $a.Gpu + ' %, mémoire ' + $a.Ram + ' %'))
        Sec 'Températures' $rows
        $rows = @()
        try {
            foreach ($d in @(Get-PhysicalDisk -ErrorAction Stop)) {
                $hs = [string]$d.HealthStatus; $fr = @{ Healthy = 'Bon état'; Warning = 'À surveiller'; Unhealthy = 'Défaillant' }[$hs]; if (-not $fr) { $fr = $hs }
                $rows += , @(([string]$d.FriendlyName), ((Go $d.Size) + '  ' + [string]$d.MediaType + '  ' + [string]$d.BusType), $fr)
            }
        } catch { foreach ($d in @(Get-CimInstance Win32_DiskDrive)) { $rows += , @(([string]$d.Model), (Go $d.Size), [string]$d.Status) } }
        Sec 'Disques : santé' $rows
        $rows = @()
        foreach ($v in @(Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3')) {
            $pct = 0; if ($v.Size) { $pct = [math]::Round(100 - $v.FreeSpace * 100 / $v.Size) }
            $rows += , @(([string]$v.DeviceID + ' ' + [string]$v.VolumeName), ((Go ($v.Size - $v.FreeSpace)) + ' utilisés sur ' + (Go $v.Size)), ('' + $pct + ' % plein'))
        }
        Sec 'Partitions' $rows
        $rows = @(); $seen = @{}
        $labels = @{ DISPLAY = 'Graphique'; NET = 'Réseau'; MEDIA = 'Audio'; BLUETOOTH = 'Bluetooth'; HDC = 'Stockage'; SCSIADAPTER = 'Stockage'; PROCESSOR = 'Processeur' }
        foreach ($d in @(Get-CimInstance Win32_PnPSignedDriver | Where-Object { $labels.ContainsKey([string]$_.DeviceClass) -and $_.DeviceName } | Sort-Object DeviceClass, DeviceName)) {
            $k = [string]$d.DeviceName; if ($seen[$k]) { continue }; $seen[$k] = 1
            if ($k -match 'WAN Miniport|Virtual|Kernel Debug|Wi-Fi Direct') { continue }
            $dt = ''; try { $dt = ([datetime]$d.DriverDate).ToString('dd/MM/yyyy', [cultureinfo]::InvariantCulture) } catch {}
            $rows += , @(($labels[[string]$d.DeviceClass] + ' : ' + $k), ('version ' + $d.DriverVersion), $dt)
        }
        Sec 'Pilotes' $rows
        try {
            $bat = Get-CimInstance Win32_Battery -ErrorAction Stop | Select-Object -First 1
            if ($bat) { Sec 'Batterie' @(, @('Charge', ('' + $bat.EstimatedChargeRemaining + ' %'))) }
        } catch {}
    } catch { [void]$sec.Add('<section><h2>Erreur</h2><p>' + (E $_.Exception.Message) + '</p></section>') }
    $css = 'body{background:#0e0e11;color:#e8e8ec;font-family:Segoe UI,Arial,sans-serif;margin:0;padding:32px}main{max-width:900px;margin:auto}h1{font-size:28px;margin:0}p.s{color:#8e8e98;margin:6px 0 26px}section{background:#16161a;border:1px solid #2e2e36;border-radius:12px;padding:18px 22px;margin-bottom:16px}h2{font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:' + $a.Accent + ';margin:0 0 10px}table{width:100%;border-collapse:collapse;font-size:14px}th{text-align:left;font-weight:600;color:#cacad2;padding:7px 14px 7px 0;width:34%;vertical-align:top}td{padding:7px 0;border:0}tr+tr th,tr+tr td{border-top:1px solid #222227}td.d{color:#8e8e98;text-align:right;white-space:nowrap;padding-left:14px}footer{color:#6c6c76;font-size:12px;text-align:center;margin-top:22px}@media print{body{background:#fff;color:#000}section{background:#fff;border-color:#ccc}th{color:#000}td.d{color:#444}}'
    $html = '<!doctype html><html lang="fr"><head><meta charset="utf-8"><title>Rapport du PC</title><style>' + $css + '</style></head><body><main><h1>Rapport du PC</h1><p class="s">Généré le ' + (Get-Date).ToString('dd/MM/yyyy à HH:mm') + " avec OnePC. Aucun numéro de série ni donnée personnelle dans cette fiche.</p>" + ($sec -join '') + "<footer>OnePC</footer></main></body></html>"
    try {
        if (-not (Test-Path -LiteralPath $a.Dir)) { New-Item -ItemType Directory -Path $a.Dir -Force | Out-Null }
        $file = Join-Path $a.Dir ('Rapport-PC-' + (Get-Date).ToString('yyyy-MM-dd-HHmm') + '.html')
        [System.IO.File]::WriteAllText($file, $html, (New-Object System.Text.UTF8Encoding $true))
        'OK'; $file
    } catch { 'ERR'; $_.Exception.Message }
}
